{
  "name": "cedia",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/host",
    "apps/macos",
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build-cedia.ts",
    "brand:icons": "bun scripts/generate-brand-icons.ts",
    "build:agent": "bun scripts/build-agent-window.ts",
    "build:mac": "bun scripts/build-cedia.ts --runtime --desktop",
    "build:portable": "bun scripts/build-cedia.ts --portable",
    "check:packaged": "bun scripts/check-packaged-shell.ts",
    "check:omp-coverage": "bun scripts/check-omp-coverage.ts",
    "check:repo": "node scripts/ci-validate.mjs",
    "check:terminal": "bun scripts/terminal-conformance.ts",
    "eval:shadow": "bun scripts/typesafe-shadow-eval.ts",
    "host": "node apps/host/src/cli.ts",
    "package:mac": "bun scripts/build-cedia.ts --package",
    "prepare:desktop": "bun scripts/prepare-desktop.ts",
    "prepare:omp": "bun scripts/prepare-omp-runtime.ts",
    "smoke:omp": "bun scripts/omp-smoke.ts",
    "smoke:omp:ast": "bun scripts/omp-native-ast-smoke.ts",
    "smoke:omp:codeoss": "bun scripts/omp-codeoss-editor-smoke.ts",
    "smoke:omp:editor": "bun scripts/omp-native-editor-smoke.ts",
    "smoke:omp:g1": "bun scripts/omp-g1-smoke.ts",
    "smoke:omp:live": "bun scripts/omp-live-turn.ts",
    "smoke:omp:permissions": "bun scripts/omp-native-permission-smoke.ts",
    "smoke:omp:queue": "bun scripts/omp-queue-smoke.ts",
    "smoke:omp:ui": "bun scripts/omp-ui-smoke.ts",
    "smoke:omp:turn-bridge": "bun scripts/omp-turn-bridge-smoke.ts",
    "smoke:omp:virtual": "bun scripts/omp-virtual-ui-smoke.ts",
    "smoke:omp:slash": "bun scripts/omp-slash-smoke.ts",
    "smoke:agent-window:live": "bun scripts/agent-window-live-smoke.ts",
    "cedia-omp": "bun scripts/cedia-omp.ts",
    "smoke:portable": "bun scripts/portable-runtime-smoke.ts",
    "smoke:relay": "bun scripts/relay-smoke.ts",
    "test": "bun test packages/omp-adapter packages/relay apps/host apps/macos/test scripts/lib",
    "test:mobile": "cd apps/ios && bun run test",
    "typecheck": "tsc --noEmit",
    "smoke:browser-packaged": "bun scripts/omp-packaged-browser-proof.ts",
    "smoke:browser-relay-packaged": "bun scripts/omp-relay-browser-proof.ts",
    "smoke:lifecycle-packaged": "bun scripts/omp-packaged-lifecycle-proof.ts",
    "smoke:cli-live": "bun scripts/omp-cli-live-proof.ts",
    "smoke:crash": "bun scripts/omp-crash-proof.ts",
    "smoke:host-crash-adoption": "bun scripts/omp-host-crash-adoption-proof.ts",
    "smoke:packaged-app-owner-adoption": "bun scripts/omp-packaged-app-owner-adoption-proof.ts",
    "smoke:packaged-owned-host-adoption": "bun scripts/omp-packaged-owned-host-adoption-proof.ts",
    "smoke:dirty-carry": "bun scripts/omp-dirty-carry-proof.ts",
  "smoke:dirty-picker-packaged": "bun scripts/omp-dirty-picker-packaged-proof.ts",
  "smoke:live-approval": "bun scripts/omp-live-approval-proof.ts",
    "smoke:roles-window": "bun scripts/omp-roles-window-proof.ts",
    "smoke:restore-window": "bun scripts/omp-restore-window-proof.ts",
    "smoke:send-race": "bun scripts/omp-send-race-proof.ts",
    "smoke:send-race-packaged": "bun scripts/omp-send-race-packaged-proof.ts",
    "smoke:packaged-catalog-overlay": "bun scripts/omp-packaged-catalog-overlay-proof.ts",
    "smoke:provider-accounts-live": "bun scripts/omp-provider-accounts-live-proof.ts"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "1.3.10",
    "@types/node": "22.20.2",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "@xterm/headless": "6.1.0-beta.302",
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "base64-js": "1.5.1",
    "qrcode": "1.5.4",
    "tweetnacl": "1.0.3",
    "ws": "8.20.0"
  }
}
