+}
+
+.monaco-workbench.cedia-workbench .part.activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-label:not(.codicon) {
+	font-size: 14px;
+	line-height: 32px;
+}
+
+.monaco-workbench.cedia-workbench .part.activitybar > .content :not(.monaco-menu) > .monaco-action-bar .badge .badge-content {
