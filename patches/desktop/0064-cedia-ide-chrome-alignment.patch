+.monaco-workbench.cedia-workbench .part.activitybar {
+	background-color: var(--vscode-activityBar-background);
+	box-shadow: none;
+}
+
+.monaco-workbench.cedia-workbench .part.activitybar.left {
+	border-right: 1px solid var(--vscode-activityBar-border, var(--vscode-panel-border));
+}
+
+.monaco-workbench.cedia-workbench .part.activitybar.right {
+	border-left: 1px solid var(--vscode-activityBar-border, var(--vscode-panel-border));
+}
+
+.monaco-workbench.cedia-workbench .part.activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-label {
+	width: 32px;
+	height: 32px;
