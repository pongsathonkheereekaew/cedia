+++ b/packages/coding-agent/test/cedia-extensions-bridge.test.ts
@@ -0,0 +1,145 @@
+/**
+ * Cedia's extension-catalog projection (plan §8.2 O06).
+ *
+ * Fixtures drive the read with a project MCP file plus a hermetic agent dir, and the
+ * registered operation through the bridge with an injected handler. No session is
+ * started, no provider is involved, and the real user profile is never touched.
+ */
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import { mkdtempSync, mkdirSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { setAgentDir } from "@oh-my-pi/pi-utils";
+import {
+	createCediaCapabilityBridge,
+	type CediaCapabilityBridgeOptions,
+} from "../src/modes/rpc/cedia-capability-bridge";
+import { readCediaExtensions } from "../src/modes/rpc/cedia-extensions-bridge";
+
+let projectDir = "";
+let userAgentDir = "";
+let previousAgentDir: string | undefined;
+
+beforeEach(() => {
+	projectDir = mkdtempSync(join(tmpdir(), "cedia-extensions-project-"));
+	userAgentDir = mkdtempSync(join(tmpdir(), "cedia-extensions-user-"));
+	previousAgentDir = process.env.OMP_AGENT_DIR;
+	process.env.OMP_AGENT_DIR = userAgentDir;
+	setAgentDir(userAgentDir);
+	mkdirSync(join(projectDir, ".omp"), { recursive: true });
+	writeFileSync(
+		join(projectDir, ".omp", "mcp.json"),
+		JSON.stringify({
+			mcpServers: {
+				"fixture-echo": { command: "echo", args: ["hi"] },
+				"flag-off": { command: "echo", args: ["off"], enabled: false },
+			},
+		}),
+	);
+	writeFileSync(join(userAgentDir, "mcp.json"), JSON.stringify({ mcpServers: {} }));
+});
+
+afterEach(() => {
+	if (previousAgentDir === undefined) delete process.env.OMP_AGENT_DIR;
+	else process.env.OMP_AGENT_DIR = previousAgentDir;
+	rmSync(projectDir, { recursive: true, force: true });
+	rmSync(userAgentDir, { recursive: true, force: true });
+});
+
+function sessionFixture(disabledIds: string[] = []) {
+	return {
+		sessionManager: { getCwd: () => projectDir },
+		settings: { get: (key: string) => (key === "disabledExtensions" ? disabledIds : undefined) },
+		effectiveExtensionRoots: { explicit: [], mode: "merge", configured: [projectDir], configuredLevel: "project" },
+	};
+}
+
+describe("Cedia extension-catalog bridge", () => {
+	it("projects discovered records with states and the live root policy", async () => {
+		const data = await readCediaExtensions(sessionFixture() as never);
+		const echo = data.extensions.find(entry => entry.id === "mcp:fixture-echo");
+		expect(echo).toMatchObject({ kind: "mcp", name: "fixture-echo", state: "active" });
+		const off = data.extensions.find(entry => entry.id === "mcp:flag-off");
+		expect(off).toMatchObject({ kind: "mcp", state: "disabled" });
+		expect(data.roots).toMatchObject({ mode: "merge", configuredLevel: "project" });
+		expect(data.total).toBe(data.extensions.length);
+		expect(data.truncated).toBe(false);
+	});
+
+	it("honors the session disabled list and never carries the raw discovery bag", async () => {
+		const data = await readCediaExtensions(sessionFixture(["mcp:fixture-echo"]) as never);
+		expect(data.extensions.find(entry => entry.id === "mcp:fixture-echo")).toMatchObject({ state: "disabled" });
+		for (const entry of data.extensions) {
+			expect(entry).not.toHaveProperty("raw");
+			expect(Object.keys(entry).sort()).toEqual(
+				["description", "descriptionTruncated", "disabledReason", "displayName", "id", "kind", "name", "path", "shadowedBy", "source", "state"].filter(key => key in entry).sort(),
+			);
+		}
+	});
+
+	it("toggles a non-MCP row through the session disabled list", async () => {
+		const { readCediaExtensions, setCediaExtensionEnabled } = await import("../src/modes/rpc/cedia-extensions-bridge");
+		const { mkdirSync, writeFileSync } = await import("node:fs");
+		const { join } = await import("node:path");
+		mkdirSync(join(projectDir, ".omp", "skills", "fixture-helper"), { recursive: true });
+		writeFileSync(
+			join(projectDir, ".omp", "skills", "fixture-helper", "SKILL.md"),
+			"---\nname: fixture-helper\ndescription: Helps with fixtures.\n---\n\n# Helper\n",
+		);
+		let disabled: string[] = [];
+		const session = {
+			sessionManager: { getCwd: () => projectDir },
+			settings: {
+				get: (key: string) => (key === "disabledExtensions" ? [...disabled] : undefined),
+				set: (key: string, value: unknown) => {
+					if (key === "disabledExtensions" && Array.isArray(value)) disabled = [...value] as string[];
+				},
+				flush: async () => {},
+			},
+			effectiveExtensionRoots: { explicit: [], mode: "merge", configured: [projectDir], configuredLevel: "project" },
+		};
+		const before = await readCediaExtensions(session as never);
+		expect(before.extensions.find(entry => entry.id === "skill:fixture-helper")).toMatchObject({ state: "active" });
+		const afterDisable = await setCediaExtensionEnabled(session as never, undefined, "skill:fixture-helper", false);
+		expect(disabled).toEqual(["skill:fixture-helper"]);
+		expect(afterDisable.extensions.find(entry => entry.id === "skill:fixture-helper")).toMatchObject({ state: "disabled" });
+		const afterEnable = await setCediaExtensionEnabled(session as never, undefined, "skill:fixture-helper", true);
+		expect(disabled).toEqual([]);
+		expect(afterEnable.extensions.find(entry => entry.id === "skill:fixture-helper")).toMatchObject({ state: "active" });
+		// Unknown ids are refused before any write.
+		await expect(setCediaExtensionEnabled(session as never, undefined, "skill:nope", false)).rejects.toThrow(/Unknown extension/);
+		expect(disabled).toEqual([]);
+	});
+
+	it("advertises extensions.list as a controller-visible O06 session read", () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"extensions.list": () => ({ roots: { explicit: [], mode: "merge", configured: [], configuredLevel: "user" }, extensions: [], truncated: false, total: 0 }),
+				"settings.revision": () => "fixture-revision",
+			},
+		} as unknown as CediaCapabilityBridgeOptions);
+		const row = built.table().capabilities.find(entry => entry.id === "extensions.list");
+		expect(row).toMatchObject({
+			id: "extensions.list",
+			family: "O06",
+			scope: "session",
+			apply: "immediate",
+			principal: "controller",
+			state: "available",
+			surfaces: ["agent", "ide", "web", "iphone"],
+		});
+	});
+
+	it("runs extensions.list through cedia_control with no payload", async () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"extensions.list": () => ({ roots: { explicit: [], mode: "merge", configured: [], configuredLevel: "user" }, extensions: [], truncated: false, total: 0 }),
+				"settings.revision": () => "fixture-revision",
+			},
+		} as unknown as CediaCapabilityBridgeOptions);
+		const outcome = await built.control({ operation: "extensions.list" });
+		expect(outcome).toMatchObject({ ok: true, operation: "extensions.list" });
+	});
+});
