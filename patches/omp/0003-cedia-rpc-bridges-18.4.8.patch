+				},
+				stdin: "pipe",
+				stdout: "pipe",
+				stderr: "pipe",
+			},
+		);
+		const stderrPromise = new Response(child.stderr).text();
+		const recordPath = path.join(directory, "owner.json");
+		let record: Record<string, unknown> | undefined;
+		try {
+			for (let attempt = 0; attempt < 300 && !record; attempt++) {
+				try {
+					record = JSON.parse(await fs.readFile(recordPath, "utf8")) as Record<string, unknown>;
+				} catch {
+					await delay(50);
+				}
+			}
+			if (!record) throw new Error(`owner did not publish endpoint: ${await stderrPromise}`);
+			child.stdin.end();
+			await delay(100);
+			const expectedIdentity = {
+				sessionId: record.sessionId,
+				incarnation: record.incarnation,
+				pid: record.pid,
+				ownerStartedAt: record.ownerStartedAt,
+				processStartIdentity: record.processStartIdentity,
+			};
+			const first = await connect(String(record.socket));
+			first.write(
+				`${JSON.stringify({ protocolVersion: 3, token: record.token, request: "claim_controller", id: "approval-claim-1", expectedIdentity })}\n`,
+			);
+			let firstClaim = await readLine(first);
+			for (let attempt = 0; firstClaim.error === "primary_active" && attempt < 100; attempt++) {
+				await delay(20);
+				first.write(
+					`${JSON.stringify({ protocolVersion: 3, token: record.token, request: "claim_controller", id: `approval-claim-1-${attempt}`, expectedIdentity })}\n`,
+				);
+				firstClaim = await readLine(first);
+			}
+			expect(firstClaim.ok).toBe(true);
+			const message = await readLine(first);
+			const request = message.type === "controller_frame" ? (message.frame as Record<string, unknown>) : undefined;
+			expect(request?.method).toBe("confirm");
+			const requestId = String(request?.id);
+			first.write(
+				`${JSON.stringify({ protocolVersion: 3, token: record.token, request: "controller_sidechannel", leaseId: firstClaim.leaseId, id: "malformed-reply", frame: { type: "extension_ui_response", id: requestId, confirmed: true, cancelled: true } })}\n`,
+			);
+			expect((await readLine(first)).error).toBe("unknown_sidechannel");
+			first.write(
+				`${JSON.stringify({ protocolVersion: 3, token: record.token, request: "release_controller", leaseId: firstClaim.leaseId, id: "approval-release-1" })}\n`,
+			);
+			expect((await readLine(first)).ok).toBe(true);
+			first.destroy();
+			const second = await connect(String(record.socket));
+			second.write(
+				`${JSON.stringify({ protocolVersion: 3, token: record.token, request: "claim_controller", id: "approval-claim-2", expectedIdentity })}\n`,
+			);
+			const secondClaim = await readLine(second);
+			expect(secondClaim.ok).toBe(true);
+			second.write(
+				`${JSON.stringify({ protocolVersion: 3, token: record.token, request: "controller_sidechannel", leaseId: secondClaim.leaseId, id: "stale-reply", frame: { type: "extension_ui_response", id: requestId, confirmed: true } })}\n`,
+			);
+			expect((await readLine(second)).error).toBe("unknown_sidechannel");
+			second.write(
+				`${JSON.stringify({ protocolVersion: 3, token: record.token, request: "release_controller", leaseId: secondClaim.leaseId, id: "approval-release-2" })}\n`,
+			);
+			expect((await readLine(second)).ok).toBe(true);
+			second.destroy();
+		} finally {
+			child.kill();
+			await child.exited.catch(() => {});
+			await stderrPromise;
+			await fs.rm(directory, { recursive: true, force: true });
+			await fs.rm(profile, { recursive: true, force: true });
+		}
+	}, 60_000);
+});
diff --git a/packages/coding-agent/test/cedia-pause-bridge.test.ts b/packages/coding-agent/test/cedia-pause-bridge.test.ts
