diff --git a/packages/coding-agent/src/config/cedia-settings-service.ts b/packages/coding-agent/src/config/cedia-settings-service.ts
new file mode 100644
index 0000000000..34213fee63
--- /dev/null
+++ b/packages/coding-agent/src/config/cedia-settings-service.ts
@@ -0,0 +1,435 @@
+/**
+ * UI-neutral settings service behind OMP's Cedia settings bridge (plan §6.4.1 S2).
+ *
+ * One owner for settings inventory, reads, mutations and reset previews over a
+ * Settings instance. The RPC bridge (cedia-capability-bridge) and the RPC mode
+ * handlers both delegate here, so the session runtime and the taskless
+ * configuration-only entry answer from the same code. This module never starts an
+ * execution session, loads executable packages or contacts a model: every path
+ * below touches only the settings registry, the configuration layers and the
+ * config files OMP itself owns.
+ */
+import { createHash } from "node:crypto";
+import * as path from "node:path";
+import { orderedSettings } from "./all-settings";
+import { lookup, type AnySetting } from "./registry";
+import { Settings } from "./settings";
+import { getSettingApplyTiming } from "./settings-apply-timing";
+import type {
+	RpcCediaSettingsKey,
+	RpcCediaSettingsMutatePayload,
+	RpcCediaSettingsScope,
+	RpcCediaSettingsValue,
+} from "../modes/rpc/rpc-types";
+
+/**
+ * The one settings path OMP can write into a project layer.
+ *
+ * `Settings` writes the global layer for every path; `setModelRole` is the
+ * documented exception and writes `modelRoles` into the project's config when
+ * `modelRoleStorage` is `project`. Everything else Cedia reads here is a
+ * global-layer value, so this table is the whole exception rather than a
+ * guess about each key. A guarded OMP-owned project writer for other
+ * supported project settings lands in S3; until then they stay read-only.
+ */
+export const PROJECT_WRITABLE_SETTING_PATHS: ReadonlySet<string> = new Set(["modelRoles"]);
+
+/** Largest settings value handed to a client; larger answers report their size. */
+export const CEDIA_SETTINGS_VALUE_MAX_BYTES = 8_192;
+
+/** Key names inside a set value that must never travel through generic settings. */
+const NESTED_SECRET_KEY_PATTERN = /token|secret|passwd|password|apikey|api_key|privatekey|clientsecret/i;
+
+/** Refusal codes the bridge maps to wire errors without inventing new vocabulary. */
+export const SETTINGS_UNKNOWN_PATH = "cedia_settings_unknown_path";
+export const SETTINGS_STALE_REVISION = "cedia_settings_stale_revision";
+export const SETTINGS_REJECTED = "cedia_settings_rejected";
+export const SETTINGS_CREDENTIAL_WRITE = "cedia_settings_credential_write";
+
+export class CediaSettingsError extends Error {
+	readonly code: string;
+	constructor(code: string, message: string) {
+		super(message);
+		this.name = "CediaSettingsError";
+		this.code = code;
+	}
+}
+
+/** Monotonic revision of the effective settings: sha256 of configured path/value pairs. */
+export function settingsRevisionOfInstance(settings: Settings): string {
+	const configured = orderedSettings()
+		.filter(handle => settings.isConfigured(handle))
+		.sort((a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0))
+		.map(handle => [handle.id, handle.layered(settings)]);
+	return createHash("sha256").update(JSON.stringify(configured)).digest("hex").slice(0, 32);
+}
+
+/** JSON-safe copy for the wire; unserializable statics are omitted, never sent raw. */
+function jsonSafe(value: unknown): { ok: true; value: unknown } | { ok: false } {
+	try {
+		return { ok: true, value: value === undefined ? undefined : (JSON.parse(JSON.stringify(value)) as unknown) };
+	} catch {
+		return { ok: false };
+	}
+}
+
+function definitionDefault(handle: AnySetting): unknown {
+	const definition = (handle as { definition?: { default?: unknown } }).definition;
+	return definition?.default;
+}
+
+/** Every settings path the schema defines, with the metadata a control needs. */
+export function buildSettingsInventory(): RpcCediaSettingsKey[] {
+	return orderedSettings()
+		.map(handle => {
+			const ui = handle.ui as { tab?: unknown; group?: unknown; label?: unknown; description?: unknown } | undefined;
+			const values = handle.type === "enum" ? (handle as { enumValues?: readonly string[] }).enumValues : undefined;
+			const safeDefault = handle.isCredential ? undefined : jsonSafe(definitionDefault(handle));
+			const row: RpcCediaSettingsKey = {
+				path: handle.id,
+				type: handle.type,
+				credential: handle.isCredential,
+				ui: ui !== undefined,
+				...(typeof ui?.tab === "string" ? { tab: ui.tab } : {}),
+				projectWritable: PROJECT_WRITABLE_SETTING_PATHS.has(handle.id),
+				...(values === undefined ? {} : { values: [...values] }),
+				apply: getSettingApplyTiming(handle.id),
+				...(typeof ui?.label === "string" && ui.label.length > 0 ? { label: ui.label } : {}),
+				...(typeof ui?.description === "string" && ui.description.length > 0
+					? { description: ui.description }
+					: {}),
+				...(typeof ui?.group === "string" && ui.group.length > 0 ? { group: ui.group } : {}),
+				...(safeDefault === undefined || !safeDefault.ok || safeDefault.value === undefined
+					? {}
+					: { defaultJson: safeDefault.value }),
+				...(typeof handle.envName === "string" && handle.envName.length > 0 ? { envVar: handle.envName } : {}),
+			};
+			return row;
+		})
+		.sort((left, right) => (left.path < right.path ? -1 : left.path > right.path ? 1 : 0));
+}
+
+function walkSegments(root: unknown, segments: readonly string[]): unknown {
+	let current = root;
+	for (const segment of segments) {
+		if (current === null || typeof current !== "object" || Array.isArray(current)) return undefined;
+		current = (current as Record<string, unknown>)[segment];
+		if (current === undefined) return undefined;
+	}
+	return current;
+}
+
+/**
+ * One effective settings value with provenance and stored-versus-effective state.
+ *
+ * Credential paths answer redacted with no value, exactly like native config
+ * listing; oversized values report their size. `storedGlobal` is the saved
+ * global-layer value when one exists, so a client can show when it is masked
+ * by a stronger layer; it is omitted under the same redaction rules as `value`.
+ */
+export function readSettingsValue(
+	settings: Settings,
+	path: string,
+	scope: RpcCediaSettingsScope,
+): RpcCediaSettingsValue {
+	const handle = lookup(path);
+	if (handle === undefined)
+		throw new CediaSettingsError(SETTINGS_UNKNOWN_PATH, `${path} is not a setting this runtime defines`);
+	const configured = settings.isConfigured(handle);
+	// OMP's own getProvenance never reports env: an env-sourced value reads as
+	// default (or its masked layer) there. The layers-only value differs from the
+	// effective value only when the environment supplies it — envFallback yields
+	// otherwise — so that difference is the env signal, whatever it masks.
+	let provenance = settings.getProvenance(handle);
+	if (!handle.isCredential) {
+		try {
+			const layeredSerialized = JSON.stringify(handle.layered(settings));
+			const effectiveSerialized = JSON.stringify(handle.get(settings));
+			if (layeredSerialized !== effectiveSerialized) provenance = "env";
+		} catch {
+			// Unserializable statics keep the runtime's own answer.
+		}
+	}
+	const revision = settingsRevisionOfInstance(settings);
+	const safeDefault = handle.isCredential ? undefined : jsonSafe(definitionDefault(handle));
+	const base = {
+		path,
+		credential: handle.isCredential,
+		configured,
+		settingsRevision: revision,
+		scope,
+		provenance,
+		...(!safeDefault?.ok || safeDefault.value === undefined ? {} : { defaultJson: safeDefault.value }),
+	} as const;
+	if (handle.isCredential) return { ...base, credential: true, redacted: true };
+	const value = handle.get(settings);
+	const serialized = JSON.stringify(value);
+	const storedRaw = walkSegments(settings.getGlobalSettings(), handle.segments);
+	const safeStored = storedRaw === undefined ? undefined : jsonSafe(storedRaw);
+	const stored =
+		safeStored?.ok &&
+		safeStored.value !== undefined &&
+		JSON.stringify(safeStored.value) !== undefined &&
+		(JSON.stringify(safeStored.value) ?? "").length <= CEDIA_SETTINGS_VALUE_MAX_BYTES
+			? { storedGlobal: safeStored.value }
+			: {};
+	if (serialized !== undefined && serialized.length > CEDIA_SETTINGS_VALUE_MAX_BYTES)
+		return {
+			...base,
+			credential: false,
+			redacted: false,
+			tooLarge: true as const,
+			bytes: serialized.length,
+			...stored,
+		};
+	const safe = jsonSafe(value);
+	if (!safe.ok)
+		return {
+			...base,
+			credential: false,
+			redacted: false,
+			tooLarge: true as const,
+			bytes: serialized?.length ?? 0,
+			...stored,
+		};
+	return { ...base, credential: false, redacted: false, value: safe.value, ...stored };
+}
+
+function assertNoNestedSecrets(value: unknown, path: string): void {
+	const seen: string[] = [];
+	const visit = (node: unknown): void => {
+		if (Array.isArray(node)) {
+			for (const entry of node) visit(entry);
+			return;
+		}
+		if (node !== null && typeof node === "object") {
+			for (const [key, entry] of Object.entries(node)) {
+				if (NESTED_SECRET_KEY_PATTERN.test(key)) seen.push(key);
+				visit(entry);
+			}
+		}
+	};
+	visit(value);
+	if (seen.length > 0)
+		throw new CediaSettingsError(
+			SETTINGS_CREDENTIAL_WRITE,
+			`${path} carries nested secret fields (${[...new Set(seen)].slice(0, 4).join(", ")}): credentials use the provider-auth owner, never generic settings`,
+		);
+}
+
+export interface PreparedChange {
+	handle: AnySetting;
+	operation: "set" | "unset";
+	value?: unknown;
+}
+
+/**
+ * Validate every change before any of them is written; throws on the first refusal.
+ *
+ * Shared by the bridge validator (which reports the message before dispatch)
+ * and the mutation itself (which re-validates after loading, so a change the
+ * validator never saw cannot slip through a reordered call).
+ */
+export function prevalidateChanges(changes: RpcCediaSettingsMutatePayload["changes"]): PreparedChange[] {
+	if (!Array.isArray(changes) || changes.length === 0 || changes.length > 256)
+		throw new CediaSettingsError(SETTINGS_REJECTED, "A mutation carries 1-256 changes");
+	return changes.map(change => {
+		if (change === null || typeof change !== "object")
+			throw new CediaSettingsError(SETTINGS_REJECTED, "A mutation change must be an object");
+		const handle = lookup(change.path);
+		if (handle === undefined)
+			throw new CediaSettingsError(
+				SETTINGS_UNKNOWN_PATH,
+				`${String((change as { path?: unknown }).path)} is not a setting this runtime defines`,
+			);
+		if (handle.isCredential)
+			throw new CediaSettingsError(
+				SETTINGS_CREDENTIAL_WRITE,
+				`${handle.id} is a credential path: the provider-auth surface owns it, and a settings control never reads or writes it`,
+			);
+		if (change.operation === "unset") return { handle, operation: "unset" as const };
+		if (change.operation !== "set" || !Object.hasOwn(change, "value"))
+			throw new CediaSettingsError(SETTINGS_REJECTED, `${handle.id} needs operation set with a value, or unset`);
+		assertNoNestedSecrets((change as { value: unknown }).value, handle.id);
+		try {
+			handle.assertWritable((change as { value: unknown }).value as never);
+		} catch (error) {
+			throw new CediaSettingsError(
+				SETTINGS_REJECTED,
+				error instanceof Error ? error.message : `${handle.id} rejects this value`,
+			);
+		}
+		return { handle, operation: "set" as const, value: (change as { value: unknown }).value };
+	});
+}
+
+const mutationChains = new Map<string, Promise<unknown>>();
+
+/** Serialize mutations per configuration source so two writers cannot interleave one file. */
+function serializeMutation<T>(key: string, work: () => Promise<T>): Promise<T> {
+	const prior = mutationChains.get(key) ?? Promise.resolve();
+	const next = prior.then(work, work);
+	mutationChains.set(
+		key,
+		next.catch(() => undefined),
+	);
+	return next;
+}
+
+/**
+ * Apply a validated global mutation atomically in memory, flush once, read back.
+ *
+ * The expected revision is compared after loading and before committing, so a
+ * disk change through OMP's own config CLI — or a second writer — fails this
+ * transaction instead of silently overwriting it. A failed flush never reports saved.
+ */
+export async function mutateGlobalSettings(
+	settings: Settings,
+	payload: RpcCediaSettingsMutatePayload,
+	scope: RpcCediaSettingsScope,
+): Promise<RpcCediaSettingsValue[]> {
+	if (payload.context.scope !== "global")
+		throw new CediaSettingsError(
+			SETTINGS_REJECTED,
+			"This writer serves the global scope; project writes use the guarded project writer",
+		);
+	const prepared = prevalidateChanges(payload.changes);
+	return serializeMutation("global", async () => {
+		// Re-read persisted layers first: a change made through OMP's own config
+		// CLI (or a second writer) after the caller's read fails this transaction
+		// instead of silently overwriting it. Malformed config throws here with
+		// nothing staged, so data and drafts are preserved.
+		await settings.reloadFromDisk();
+		if (typeof payload.expectedRevision === "string") {
+			const current = settingsRevisionOfInstance(settings);
+			if (payload.expectedRevision !== current)
+				throw new CediaSettingsError(
+					SETTINGS_STALE_REVISION,
+					`The effective settings are at revision ${current}, not ${payload.expectedRevision}`,
+				);
+		}
+		for (const change of prepared) {
+			if (change.operation === "unset") change.handle.unset(settings);
+			else change.handle.set(settings, change.value as never);
+		}
+		await settings.flush();
+		return prepared.map(change => readSettingsValue(settings, change.handle.id, scope));
+	});
+}
+
+/** Remove one persisted global override; returns the newly effective value. */
+export async function unsetGlobalSetting(
+	settings: Settings,
+	path: string,
+	expectedRevision: string | undefined,
+	scope: RpcCediaSettingsScope,
+): Promise<RpcCediaSettingsValue> {
+	const [readback] = await mutateGlobalSettings(
+		settings,
+		{
+			context: { scope: "global" },
+			...(expectedRevision === undefined ? {} : { expectedRevision }),
+			changes: [{ path, operation: "unset" }],
+		},
+		scope,
+	);
+	if (readback === undefined)
+		throw new CediaSettingsError(SETTINGS_UNKNOWN_PATH, `${path} is not a setting this runtime defines`);
+	return readback;
+}
+
+export interface ResetPreviewEntry {
+	/** The path that would be unset. */
+	path: string;
+	/** Whether the global layer saves an override for this path. */
+	globalConfigured: boolean;
+	/** The current effective answer, redacted under the same rules as a read. */
+	current: RpcCediaSettingsValue;
+}
+
+/**
+ * Preview an unset of the named paths: which global overrides exist, what is
+ * effective now, and the schema default each unset would reveal. Executing the
+ * unset reads back the newly effective values; the preview itself writes nothing.
+ */
+export function previewGlobalReset(
+	settings: Settings,
+	paths: readonly string[],
+	scope: RpcCediaSettingsScope,
+): ResetPreviewEntry[] {
+	if (!Array.isArray(paths) || paths.length === 0 || paths.length > 512)
+		throw new CediaSettingsError(SETTINGS_REJECTED, "A reset preview names 1-512 paths");
+	return paths.map(path => {
+		const current = readSettingsValue(settings, path, scope);
+		const handle = lookup(path);
+		const storedRaw = handle === undefined ? undefined : walkSegments(settings.getGlobalSettings(), handle.segments);
+		return { path, globalConfigured: storedRaw !== undefined && storedRaw !== null, current };
+	});
+}
+
+/** Resolve and validate a project directory the host already trusted. */
+export function assertTrustedProjectDir(projectDir: string): string {
+	if (typeof projectDir !== "string" || projectDir.length === 0)
+		throw new CediaSettingsError(SETTINGS_REJECTED, "A project mutation names its trusted directory");
+	const normalized = path.normalize(projectDir);
+	if (!path.isAbsolute(normalized))
+		throw new CediaSettingsError(SETTINGS_REJECTED, "A project directory must be absolute");
+	return normalized;
+}
+
+/** Load an isolated project Settings for reads; never the caller's live instance. */
+export async function loadProjectSettingsForRead(projectDir: string, agentDir?: string): Promise<Settings> {
+	return Settings.loadReadOnly({
+		cwd: assertTrustedProjectDir(projectDir),
+		...(agentDir === undefined ? {} : { agentDir }),
+	});
+}
+
+export interface ProjectMutationResult {
+	/** Values read back from the project scope after the flush. */
+	values: RpcCediaSettingsValue[];
+}
+
+/**
+ * Apply a validated project mutation through the guarded OMP-owned project writer.
+ *
+ * Each instance is loaded fresh for its trusted directory, checked against the
+ * expected revision, written through writeProjectValue/unsetProjectValue (which
+ * merge only the changed paths into the re-read project file, preserving
+ * unknown fields), flushed, read back from the project scope and discarded via
+ * cancelPendingSaves. Imported/overlay/environment sources stay read-only:
+ * only the project file is ever written.
+ */
+export async function mutateProjectSettings(
+	projectDir: string,
+	changes: RpcCediaSettingsMutatePayload["changes"],
+	expectedRevision: string | undefined,
+	agentDir?: string,
+): Promise<ProjectMutationResult> {
+	const dir = assertTrustedProjectDir(projectDir);
+	const prepared = prevalidateChanges(changes);
+	return serializeMutation(`project:${dir}`, async () => {
+		// loadIsolated, never init: init is the process-global singleton and a second
+		// call would return the entry's own instance with the wrong cwd and layers.
+		const settings = await Settings.loadIsolated({ cwd: dir, ...(agentDir === undefined ? {} : { agentDir }) });
+		try {
+			await settings.reloadFromDisk();
+			if (typeof expectedRevision === "string") {
+				const current = settingsRevisionOfInstance(settings);
+				if (expectedRevision !== current)
+					throw new CediaSettingsError(
+						SETTINGS_STALE_REVISION,
+						`The project settings are at revision ${current}, not ${expectedRevision}`,
+					);
+			}
+			for (const change of prepared) {
+				if (change.operation === "unset") settings.unsetProjectValue(change.handle);
+				else settings.writeProjectValue(change.handle, change.value);
+			}
+			await settings.flush();
+			return { values: prepared.map(change => readSettingsValue(settings, change.handle.id, "project")) };
+		} finally {
+			settings.cancelPendingSaves();
+		}
+	});
+}
