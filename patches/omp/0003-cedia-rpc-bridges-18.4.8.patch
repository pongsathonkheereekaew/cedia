@@ -0,0 +1,79 @@
+/**
+ * Cedia's prewalk-state projection (plan §8.2 O07).
+ *
+ * Fixtures drive the read directly plus the registered operation through the bridge with
+ * an injected handler. No runtime, model or provider is involved.
+ */
+import { describe, expect, it } from "bun:test";
+import {
+	createCediaCapabilityBridge,
+	type CediaCapabilityBridgeOptions,
+	type CediaCapabilityHandlers,
+} from "../src/modes/rpc/cedia-capability-bridge";
+import { readCediaPrewalkState } from "../src/modes/rpc/cedia-prewalk-bridge";
+
+describe("Cedia prewalk-state projection", () => {
+	it("reads disarmed as false for undefined and null", () => {
+		expect(readCediaPrewalkState({ getPrewalkState: () => undefined })).toEqual({ armed: false });
+		expect(readCediaPrewalkState({ getPrewalkState: () => null })).toEqual({ armed: false });
+	});
+
+	it("reads any object state as armed", () => {
+		expect(readCediaPrewalkState({ getPrewalkState: () => ({ target: "@smol" }) })).toEqual({ armed: true });
+	});
+
+	it("refuses a non-object answer instead of defaulting", () => {
+		expect(() => readCediaPrewalkState({ getPrewalkState: () => "armed" })).toThrow(/object or undefined/);
+	});
+
+	it("advertises prewalk.state.get with the O07 controller contract", () => {
+		const noop = () => undefined;
+		const handlers = new Proxy({} as CediaCapabilityHandlers, {
+			get: (_target, property: string) => {
+				if (property === "prewalk.state.get")
+					return () => {
+						return { armed: false };
+					};
+				if (property === "settings.revision") return () => "fixture-revision";
+				return noop;
+			},
+		});
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers,
+		} satisfies CediaCapabilityBridgeOptions);
+		const rows = new Map(
+			built
+				.table()
+				.capabilities.filter(row => row.id.startsWith("prewalk."))
+				.map(row => [row.id, row]),
+		);
+		expect([...rows.keys()]).toEqual(["prewalk.state.get"]);
+		expect(rows.get("prewalk.state.get")).toMatchObject({
+			family: "O07",
+			scope: "session",
+			apply: "immediate",
+			principal: "controller",
+			state: "available",
+			surfaces: ["agent", "ide", "web", "iphone"],
+		});
+	});
+
+	it("runs prewalk.state.get through the bridge without a payload", async () => {
+		const noop = () => undefined;
+		const handlers = new Proxy({} as CediaCapabilityHandlers, {
+			get: (_target, property: string) => {
+				if (property === "prewalk.state.get") return () => ({ armed: true });
+				if (property === "settings.revision") return () => "fixture-revision";
+				return noop;
+			},
+		});
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers,
+		} satisfies CediaCapabilityBridgeOptions);
+		const result = await built.control({ operation: "prewalk.state.get" });
+		expect(result.ok).toBe(true);
+		if (result.ok) expect(result.result).toEqual({ armed: true });
+	});
+});
diff --git a/packages/coding-agent/test/cedia-provider-auth.test.ts b/packages/coding-agent/test/cedia-provider-auth.test.ts
new file mode 100644
index 0000000000..6c9610c130
--- /dev/null
+++ b/packages/coding-agent/test/cedia-provider-auth.test.ts
@@ -0,0 +1,71 @@
+import { describe, expect, it } from "bun:test";
+import { cediaAuthProviders } from "../src/modes/rpc/rpc-mode";
+
+/**
+ * The projection is the only thing Cedia's settings page reads, and it is the
+ * boundary where credential material must not escape. These cases pin both the
+ * facts a row shows and the absence of anything secret.
+ */
+function view(input: {
+	ids: string[];
+	stored?: Record<string, { credential: { type: "api_key" | "oauth" } }[]>;
+	origins?: Record<string, { kind: string; envVar?: string }>;
+	resolvable?: string[];
+}) {
+	return {
+		list: () => input.ids,
+		listStoredCredentials: (provider?: string) =>
+			(provider === undefined ? [] : (input.stored?.[provider] ?? [])).map((entry, index) => ({
+				id: index,
+				provider: provider ?? "",
+				credential: entry.credential,
+				disabledCause: null,
+			})),
+		getCredentialOrigin: (provider: string) => input.origins?.[provider],
+		hasResolvableAuth: (provider: string) => (input.resolvable ?? []).includes(provider),
+	} as unknown as Parameters<typeof cediaAuthProviders>[0];
+}
+
+describe("Cedia provider-auth projection", () => {
+	it("reports a stored API key as a kind and an origin, never as a value", () => {
+		const result = cediaAuthProviders(
+			view({
+				ids: ["anthropic"],
+				stored: { anthropic: [{ credential: { type: "api_key" } }] },
+				origins: { anthropic: { kind: "api_key" } },
+				resolvable: ["anthropic"],
+			}),
+		);
+
+		const row = result.providers.find(candidate => candidate.id === "anthropic")!;
+		expect(row.id).toBe("anthropic");
+		expect(row.authenticated).toBe(true);
+		expect(row.credentialKinds).toEqual(["api_key"]);
+		expect(row.origin).toBe("api_key");
+		// No secret field and no credential object may appear on the row.
+		expect(Object.keys(row).sort()).toEqual(
+			["authenticated", "available", "credentialKinds", "id", "methods", "name", "origin"].sort(),
+		);
+	});
+
+	it("keeps an OAuth provider signable and reports an env origin with its variable", () => {
+		const result = cediaAuthProviders(
+			view({ ids: [], origins: { anthropic: { kind: "env", envVar: "ANTHROPIC_API_KEY" } } }),
+		);
+		const row = result.providers.find(candidate => candidate.id === "anthropic");
+		expect(row?.methods).toContain("oauth");
+		expect(row?.origin).toBe("env");
+		expect(row?.envVar).toBe("ANTHROPIC_API_KEY");
+	});
+
+	it("offers an API key only where OMP can resolve one", () => {
+		const result = cediaAuthProviders(view({ ids: [] }));
+		expect(result.providers.filter(row => row.methods.includes("api_key")).length).toBeGreaterThan(0);
+		// Every listed row is actionable: a provider nothing can authenticate from
+		// here is left out rather than drawn as a control with no method.
+		expect(result.providers.every(row => row.methods.length > 0)).toBe(true);
+		expect(result.providers.every(row => row.methods.includes("oauth") || row.methods.includes("api_key"))).toBe(true);
+		const ids = result.providers.map(row => row.id);
+		expect(ids).toEqual([...ids].sort());
+	});
+});
diff --git a/packages/coding-agent/test/cedia-python-bridge.test.ts b/packages/coding-agent/test/cedia-python-bridge.test.ts
new file mode 100644
index 0000000000..edcaadea7f
--- /dev/null
+++ b/packages/coding-agent/test/cedia-python-bridge.test.ts
@@ -0,0 +1,64 @@
+/**
+ * Cedia's Python execution projection (plan §8.2 O11).
+ *
+ * These fixtures stub the session's kernel calls — no runtime, kernel or provider. The point
+ * is the projection boundary: code is validated before the kernel sees it, the answer carries
+ * the bounded result with display outputs counted (never embedded), and aborting confirms
+ * delivery without inventing what ran.
+ */
+import { describe, expect, it } from "bun:test";
+import type { AgentSession } from "../src/session/agent-session";
+import {
+	CEDIA_PYTHON_MAX_CHARS,
+	abortCediaPython,
+	execCediaPython,
+} from "../src/modes/rpc/cedia-python-bridge";
+
+function fixture(result: unknown = { output: "3\n", exitCode: 0, cancelled: false, truncated: false, displayOutputs: [] }) {
+	const calls: string[] = [];
+	const session = {
+		executePython: async (code: string) => {
+			calls.push(`exec:${code}`);
+			return result;
+		},
+		abortEval: () => {
+			calls.push("abort");
+		},
+	} as unknown as AgentSession;
+	return { session, calls };
+}
+
+describe("Cedia Python execution projection", () => {
+	it("answers the bounded result with display outputs counted", async () => {
+		const f = fixture({ output: "3\n", exitCode: 0, cancelled: false, truncated: true, displayOutputs: [{}, {}] });
+		expect(await execCediaPython(f.session, "print(1 + 2)")).toEqual({
+			exitCode: 0,
+			output: "3\n",
+			outputTruncated: true,
+			cancelled: false,
+			displayOutputs: 2,
+		});
+		expect(f.calls).toEqual(["exec:print(1 + 2)"]);
+	});
+
+	it("reports a null exit code and a cancelled run honestly", async () => {
+		const f = fixture({ output: "", exitCode: undefined, cancelled: true, truncated: false, displayOutputs: [] });
+		expect(await execCediaPython(f.session, "while True: pass")).toMatchObject({
+			exitCode: null,
+			cancelled: true,
+		});
+	});
+
+	it("refuses empty, non-string and oversized code before the kernel sees it", async () => {
+		const f = fixture();
+		await expect(execCediaPython(f.session, "  ")).rejects.toThrow(/non-empty string/);
+		await expect(execCediaPython(f.session, "x".repeat(CEDIA_PYTHON_MAX_CHARS + 1))).rejects.toThrow(/exceeds/);
+		expect(f.calls).toEqual([]);
+	});
+
+	it("confirms abort delivery without inventing what ran", () => {
+		const f = fixture();
+		expect(abortCediaPython(f.session)).toEqual({ aborted: true });
+		expect(f.calls).toEqual(["abort"]);
+	});
+});
diff --git a/packages/coding-agent/test/cedia-queue-bridge.test.ts b/packages/coding-agent/test/cedia-queue-bridge.test.ts
new file mode 100644
index 0000000000..fac19b3542
--- /dev/null
+++ b/packages/coding-agent/test/cedia-queue-bridge.test.ts
@@ -0,0 +1,154 @@
+/**
+ * Cedia's queue projection (plan §8.2 O01).
+ *
+ * The point of these fixtures is that Cedia never owns the queue: the projection reads the
+ * session's own `getQueuedMessages()`, a drop calls OMP's own removal, and the answer says what
+ * was removed so a window can restore the text the way the terminal's dequeue keybinding does.
+ * The fixtures are SDK-free, so no runtime, model or provider is involved.
+ */
+import { describe, expect, it } from "bun:test";
+import type { AgentSession } from "../src/session/agent-session";
+import type { RestoredQueuedMessage } from "../src/session/agent-session-types";
+import {
+	CEDIA_QUEUE_MAX_ITEMS,
+	CEDIA_QUEUE_MAX_TEXT_CHARS,
+	dropCediaQueueItems,
+	readCediaQueue,
+} from "../src/modes/rpc/cedia-queue-bridge";
+
+interface QueueFixture {
+	steering: string[];
+	followUp: string[];
+	/** Optional image-bearing projection returned by the session's authoritative queue read. */
+	detailedSteering?: RestoredQueuedMessage[];
+	detailedFollowUp?: RestoredQueuedMessage[];
+	/** Items the next remove hands back, mirroring the session's own restore shape. */
+	restored?: RestoredQueuedMessage[];
+	calls: string[];
+}
+
+function session(fixture: QueueFixture): AgentSession {
+	return {
+		getQueuedMessageDetails: () => {
+			fixture.calls.push("getQueuedMessageDetails");
+			return {
+				steering: fixture.detailedSteering ?? fixture.steering.map(text => ({ text })),
+				followUp: fixture.detailedFollowUp ?? fixture.followUp.map(text => ({ text })),
+			};
+		},
+		getQueuedMessages: () => {
+			fixture.calls.push("getQueuedMessages");
+			return { steering: fixture.steering, followUp: fixture.followUp };
+		},
+		popLastQueuedMessage: () => {
+			fixture.calls.push("popLastQueuedMessage");
+			const next = fixture.restored?.shift();
+			if (next === undefined) return undefined;
+			const index = fixture.steering.lastIndexOf(next.text);
+			if (index >= 0) fixture.steering.splice(index, 1);
+			else fixture.followUp.splice(fixture.followUp.indexOf(next.text), 1);
+			return next;
+		},
+		clearQueue: () => {
+			fixture.calls.push("clearQueue");
+			const restored = fixture.restored ?? [...fixture.steering, ...fixture.followUp].map(text => ({ text }));
+			fixture.steering = [];
+			fixture.followUp = [];
+			return { steering: restored, followUp: [] as RestoredQueuedMessage[] };
+		},
+	} as unknown as AgentSession;
+}
+
+describe("Cedia queue projection", () => {
+	it("projects the runtime's own queue and never invents a row", () => {
+		const fixture: QueueFixture = { steering: ["steer one"], followUp: ["follow one", "follow two"], calls: [] };
+		expect(readCediaQueue(session(fixture))).toEqual({
+			steering: [{ text: "steer one", truncated: false, images: 0 }],
+			followUp: [
+				{ text: "follow one", truncated: false, images: 0 },
+				{ text: "follow two", truncated: false, images: 0 },
+			],
+		});
+		expect(fixture.calls).toEqual(["getQueuedMessageDetails"]);
+	});
+
+	it("projects authoritative image counts without changing queue order", () => {
+		const image = { type: "image" as const, data: "AAA", mimeType: "image/png" };
+		const fixture: QueueFixture = {
+			steering: ["steer one"],
+			followUp: ["follow one", "follow two"],
+			detailedSteering: [{ text: "steer one", images: [image] }],
+			detailedFollowUp: [{ text: "follow one" }, { text: "follow two", images: [image, image] }],
+			calls: [],
+		};
+
+		expect(readCediaQueue(session(fixture))).toEqual({
+			steering: [{ text: "steer one", truncated: false, images: 1 }],
+			followUp: [
+				{ text: "follow one", truncated: false, images: 0 },
+				{ text: "follow two", truncated: false, images: 2 },
+			],
+		});
+		expect(fixture.calls).toEqual(["getQueuedMessageDetails"]);
+	});
+
+	it("bounds a long submission and names the cut instead of hiding it", () => {
+		const long = "x".repeat(CEDIA_QUEUE_MAX_TEXT_CHARS + 10);
+		const fixture: QueueFixture = { steering: [long], followUp: [], calls: [] };
+		const queue = readCediaQueue(session(fixture));
+		expect(queue.steering[0]?.truncated).toBe(true);
+		expect(queue.steering[0]?.text.length).toBe(CEDIA_QUEUE_MAX_TEXT_CHARS);
+	});
+
+	it("bounds how many submissions one answer lists", () => {
+		const fixture: QueueFixture = {
+			steering: Array.from({ length: CEDIA_QUEUE_MAX_ITEMS + 5 }, (_, index) => `steer ${index}`),
+			followUp: [],
+			calls: [],
+		};
+		expect(readCediaQueue(session(fixture)).steering.length).toBe(CEDIA_QUEUE_MAX_ITEMS);
+	});
+
+	it("answers what a single drop removed, and the queue that remains", () => {
+		const fixture: QueueFixture = {
+			steering: ["steer one", "steer two"],
+			followUp: ["follow one"],
+			restored: [
+				{
+					text: "steer two",
+					cediaIntentId: "turn-steer-two",
+					images: [{ type: "image", data: "AAA", mimeType: "image/png" }],
+				},
+			],
+			calls: [],
+		};
+		const answer = dropCediaQueueItems(session(fixture), "last");
+		expect(answer.dropped).toEqual([{ text: "steer two", truncated: false, images: 1 }]);
+		expect(answer.droppedIntentIds).toEqual(["turn-steer-two"]);
+		expect(answer.steering).toEqual([{ text: "steer one", truncated: false, images: 0 }]);
+		expect(fixture.calls).toEqual(["popLastQueuedMessage", "getQueuedMessageDetails"]);
+	});
+
+	it("reports an empty drop rather than a silent success", () => {
+		const fixture: QueueFixture = { steering: [], followUp: [], calls: [] };
+		expect(dropCediaQueueItems(session(fixture), "last").dropped).toEqual([]);
+	});
+
+	it("drains every user submission with a clear, and reports each one it removed", () => {
+		const fixture: QueueFixture = {
+			steering: ["steer one"],
+			followUp: ["follow one"],
+			restored: [
+				{ text: "steer one", cediaIntentId: "turn-steer-one" },
+				{ text: "follow one", cediaIntentId: "turn-follow-one" },
+			],
+			calls: [],
+		};
+		const answer = dropCediaQueueItems(session(fixture), "all");
+		expect(answer.dropped?.map(row => row.text)).toEqual(["steer one", "follow one"]);
+		expect(answer.droppedIntentIds).toEqual(["turn-steer-one", "turn-follow-one"]);
+		expect(answer.steering).toEqual([]);
+		expect(answer.followUp).toEqual([]);
+		expect(fixture.calls).toEqual(["clearQueue", "getQueuedMessageDetails"]);
+	});
+});
diff --git a/packages/coding-agent/test/cedia-settings-service.test.ts b/packages/coding-agent/test/cedia-settings-service.test.ts
new file mode 100644
index 0000000000..d6816f5eb9
--- /dev/null
+++ b/packages/coding-agent/test/cedia-settings-service.test.ts
@@ -0,0 +1,200 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import * as fs from "node:fs";
+import * as path from "node:path";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { lookup } from "@oh-my-pi/pi-coding-agent/config/registry";
+import { TempDir } from "@oh-my-pi/pi-utils";
+import { beginSettingsTest, restoreSettingsTestState, type SettingsTestState } from "./helpers/settings-test-state";
+import {
+	CediaSettingsError,
+	buildSettingsInventory,
+	mutateGlobalSettings,
+	mutateProjectSettings,
+	previewGlobalReset,
+	prevalidateChanges,
+	readSettingsValue,
+	settingsRevisionOfInstance,
+	unsetGlobalSetting,
+} from "../src/config/cedia-settings-service";
+
+/**
+ * The settings service behind the Cedia bridge (plan §6.4.1 S2/S3).
+ *
+ * Inventory carries schema metadata with no configured values; reads report
+ * provenance and stored-versus-effective state; mutations validate every
+ * change before any is written, flush once, and read back from the owner.
+ * Project scope resolves an explicit trusted directory and writes only the
+ * project file, preserving unknown fields.
+ */
+describe("Cedia settings service", () => {
+	let state: SettingsTestState | undefined;
+	let tempDir: TempDir;
+	let agentDir: string;
+	let cwd: string;
+
+	beforeEach(() => {
+		state = beginSettingsTest();
+		tempDir = TempDir.createSync("@pi-cedia-settings-");
+		agentDir = tempDir.join("agent");
+		cwd = tempDir.join("project");
+		for (const dir of [agentDir, cwd]) fs.mkdirSync(dir, { recursive: true });
+	});
+
+	afterEach(() => {
+		restoreSettingsTestState(state);
+		state = undefined;
+		Bun.gc(true);
+		tempDir.removeSync();
+	});
+
+	async function load(): Promise<Settings> {
+		return Settings.loadIsolated({ agentDir, cwd });
+	}
+
+	it("builds an inventory with schema metadata and no configured values", async () => {
+		const settings = await load();
+		const keys = buildSettingsInventory();
+		expect(keys.length).toBeGreaterThan(500);
+		const cycleOrder = keys.find(key => key.path === "cycleOrder");
+		expect(cycleOrder?.type).toBe("array");
+		// TUI metadata comes from the schema, never invented.
+		const endpoint = keys.find(key => key.path === "searxng.endpoint");
+		expect(endpoint?.label).toBe("SearXNG Endpoint");
+		expect(typeof endpoint?.description).toBe("string");
+		expect(endpoint?.envVar).toBe("SEARXNG_ENDPOINT");
+		// Schema defaults are static facts, identical for every user.
+		expect(cycleOrder).toMatchObject({ defaultJson: ["smol", "default", "slow"] });
+		// No row carries a configured value, and credentials carry no default.
+		for (const key of keys) {
+			expect(Object.keys(key)).not.toContain("value");
+			if (key.credential) expect(key.defaultJson).toBeUndefined();
+		}
+		// The revision identifies the effective settings a write may name.
+		expect(settingsRevisionOfInstance(settings)).toMatch(/^[0-9a-f]{32}$/);
+		settings.cancelPendingSaves();
+	});
+
+	it("reads provenance, stored-versus-effective state and scope", async () => {
+		const settings = await load();
+		const fresh = readSettingsValue(settings, "cycleOrder", "global");
+		expect(fresh).toMatchObject({ path: "cycleOrder", configured: false, provenance: "default", scope: "global" });
+		expect(fresh.value).toEqual(["smol", "default", "slow"]);
+		expect(fresh.storedGlobal).toBeUndefined();
+		// A credential answers redacted with no value, default or stored layer.
+		const broker = readSettingsValue(settings, "auth.broker.token", "global");
+		expect(broker).toMatchObject({ credential: true, redacted: true, configured: false });
+		expect(Object.hasOwn(broker, "value")).toBe(false);
+		expect(Object.hasOwn(broker, "storedGlobal")).toBe(false);
+		expect(Object.hasOwn(broker, "defaultJson")).toBe(false);
+		// An unknown path is refused, never answered as redacted.
+		expect(() => readSettingsValue(settings, "not.a.setting", "global")).toThrow(CediaSettingsError);
+		settings.cancelPendingSaves();
+	});
+
+	it("shows a saved global value masked by a stronger layer", async () => {
+		const settings = await load();
+		const handle = lookup("cycleOrder")!;
+		handle.set(settings, ["global/pick"]);
+		await settings.flush();
+		// A runtime override masks the saved global without removing it.
+		handle.override(settings, ["runtime/pick"]);
+		const masked = readSettingsValue(settings, "cycleOrder", "global");
+		expect(masked.provenance).toBe("runtime");
+		expect(masked.value).toEqual(["runtime/pick"]);
+		expect(masked.storedGlobal).toEqual(["global/pick"]);
+		handle.override(settings, undefined);
+		const unmasked = readSettingsValue(settings, "cycleOrder", "global");
+		expect(unmasked.provenance).toBe("global");
+		expect(unmasked.value).toEqual(["global/pick"]);
+		settings.cancelPendingSaves();
+	});
+
+	it("validates every change before any is written", async () => {
+		const settings = await load();
+		const before = settingsRevisionOfInstance(settings);
+		// Unknown paths, credentials, nested secrets and bad values refuse first.
+		expect(() => prevalidateChanges([{ path: "not.a.setting", operation: "set", value: 1 }])).toThrow(
+			/not a setting/,
+		);
+		expect(() => prevalidateChanges([{ path: "auth.broker.token", operation: "set", value: "sk-x" }])).toThrow(
+			/credential/,
+		);
+		expect(() => prevalidateChanges([{ path: "cycleOrder", operation: "set", value: { token: "sk-x" } }])).toThrow(
+			/secret/,
+		);
+		await expect(
+			mutateGlobalSettings(
+				settings,
+				{ context: { scope: "global" }, changes: [{ path: "not.a.setting", operation: "set", value: 1 }] },
+				"global",
+			),
+		).rejects.toThrow(/not a setting/);
+		// Nothing was staged or flushed by the refused transaction.
+		expect(settingsRevisionOfInstance(settings)).toBe(before);
+		settings.cancelPendingSaves();
+	});
+
+	it("writes, unsets and reads back through the owner with revision checks", async () => {
+		const settings = await load();
+		const before = settingsRevisionOfInstance(settings);
+		const [written] = await mutateGlobalSettings(
+			settings,
+			{
+				context: { scope: "global" },
+				expectedRevision: before,
+				changes: [{ path: "cycleOrder", operation: "set", value: ["user/pick"] }],
+			},
+			"global",
+		);
+		expect(written).toMatchObject({ path: "cycleOrder", configured: true, provenance: "global", scope: "global" });
+		expect(written?.value).toEqual(["user/pick"]);
+		expect(written?.storedGlobal).toEqual(["user/pick"]);
+		expect(written?.settingsRevision).not.toBe(before);
+		// A stale revision fails instead of overwriting.
+		await expect(
+			mutateGlobalSettings(
+				settings,
+				{
+					context: { scope: "global" },
+					expectedRevision: before,
+					changes: [{ path: "cycleOrder", operation: "set", value: ["stale"] }],
+				},
+				"global",
+			),
+		).rejects.toThrow(/revision/);
+		expect(readSettingsValue(settings, "cycleOrder", "global").value).toEqual(["user/pick"]);
+		// Unset removes the override and reveals the default again.
+		const preview = previewGlobalReset(settings, ["cycleOrder"], "global");
+		expect(preview[0]?.globalConfigured).toBe(true);
+		const reread = await unsetGlobalSetting(settings, "cycleOrder", written?.settingsRevision, "global");
+		expect(reread).toMatchObject({ configured: false, provenance: "default" });
+		expect(reread.value).toEqual(["smol", "default", "slow"]);
+		settings.cancelPendingSaves();
+	});
+
+	it("writes project scope into the project file, preserving unknown fields", async () => {
+		const projectFile = path.join(cwd, ".omp", "config.yml");
+		fs.mkdirSync(path.dirname(projectFile), { recursive: true });
+		await Bun.write(projectFile, "unrelatedTool:\n  keepMe: true\n");
+		const first = await Settings.loadReadOnly({ cwd, agentDir });
+		const revision = settingsRevisionOfInstance(first);
+		first.cancelPendingSaves();
+		const result = await mutateProjectSettings(
+			cwd,
+			[{ path: "cycleOrder", operation: "set", value: ["project/pick"] }],
+			revision,
+			agentDir,
+		);
+		expect(result.values[0]).toMatchObject({ path: "cycleOrder", scope: "project", provenance: "project" });
+		expect(result.values[0]?.value).toEqual(["project/pick"]);
+		// Unknown project fields survive the structured update.
+		const reread = await Settings.loadReadOnly({ cwd, agentDir });
+		expect(readSettingsValue(reread, "cycleOrder", "project").value).toEqual(["project/pick"]);
+		const raw = await Bun.file(projectFile).text();
+		expect(raw).toContain("keepMe");
+		// A relative directory never resolves past the host.
+		await expect(
+			mutateProjectSettings("../escape", [{ path: "cycleOrder", operation: "unset" }], undefined),
+		).rejects.toThrow(/absolute/);
+	});
+});
diff --git a/packages/coding-agent/test/cedia-tools-catalog-bridge.test.ts b/packages/coding-agent/test/cedia-tools-catalog-bridge.test.ts
