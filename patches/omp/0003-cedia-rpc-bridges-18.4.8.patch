+							ok: false,
+							code: "cedia_control_stale_settings_revision",
+							error: `The effective settings are at revision ${current}, not ${expected}`,
+						};
+				}
+			}
+			return {
+				ok: true,
+				operation: operation.id,
+				capabilityRevision: revision,
+				result: await operation.run((payload as Record<string, unknown> | undefined) ?? {}),
+			};
+		},
+	};
+}
