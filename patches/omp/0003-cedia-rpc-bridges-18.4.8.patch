+				calls++;
+				if (calls === 1) {
+					firstCall.resolve();
+					await releaseFirstCall.promise;
+				}
+				return { content: ["done"] };
+			},
+		});
+		const originalPrepare = agent.prepareQueuedMessages;
+		if (!originalPrepare) throw new Error("Expected AgentSession to install queued preparation");
+		const events: AgentSessionEvent[] = [];
+		session!.subscribe(event => events.push(event));
+
+		const first = session!.prompt("A", { cediaIntentId: "A" });
+		await firstCall.promise;
+		await session!.followUp("B", undefined, { cediaIntentId: "B" });
+		agent.prepareQueuedMessages = async (messages, signal) => {
+			const preparation = await originalPrepare(messages, signal);
+			// Abort after the real wrapper has prepared the batch, before Agent can invoke commit.
+			// Do not await: abort() waits for the loop that is currently awaiting this preparation.
+			void session!.abort();
+			return preparation;
+		};
+		releaseFirstCall.resolve();
+		await first;
+		await session!.waitForIdle();
+
+		expect(boundaryShapes(events)).toEqual([
+			{ type: "cedia_turn_boundary", completedIntentIds: ["A"], runningIntentIds: [] },
+		]);
+		expect(session!.getCediaTurnQueue().current?.intentId).toBeUndefined();
+		expect(session!.getQueuedMessages().followUp).toEqual(["B"]);
