+				return { content: [{ type: "text", text: "released" }], details: {} };
+			},
+		};
+		await setup({
+			tools: [tool],
+			responses: [{ content: [{ type: "toolCall", name: "hold", arguments: {} }] }, { content: ["done"] }],
+		});
+		const events: AgentSessionEvent[] = [];
+		session!.subscribe(event => events.push(event));
+
+		const first = session!.prompt("A", { cediaIntentId: "A" });
+		await toolStarted.promise;
+		await session!.followUp("B", undefined, { cediaIntentId: "B" });
+		expect(boundaryShapes(events)).toEqual([]);
+		releaseTool.resolve();
+		await first;
+		await session!.waitForIdle();
+		expect(boundaryShapes(events)).toEqual([
+			{ type: "cedia_turn_boundary", completedIntentIds: ["A"], runningIntentIds: ["B"] },
+			{ type: "cedia_turn_boundary", completedIntentIds: ["B"], runningIntentIds: [] },
+		]);
+	});
+});
