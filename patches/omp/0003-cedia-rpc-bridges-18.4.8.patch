+		expect(outcome).toMatchObject({ ok: false, code: "cedia_control_invalid_payload" });
+		if (!outcome.ok) expect(outcome.error).toContain("credential");
+	});
+
+	it("validates reads by scope, and unsets plus previews through control", async () => {
+		const { built } = await settingsBridge();
+		const badScope = await built.control({
+			operation: "settings.get",
+			payload: { path: "cycleOrder", scope: "zone" },
+		});
+		expect(badScope).toMatchObject({ ok: false, code: "cedia_control_invalid_payload" });
+		const danglingDir = await built.control({
+			operation: "settings.get",
+			payload: { path: "cycleOrder", scope: "project" },
+		});
+		expect(danglingDir).toMatchObject({ ok: false, code: "cedia_control_invalid_payload" });
+
+		const set = await built.control({
+			operation: "settings.mutate",
+			payload: {
+				context: { scope: "global" },
+				changes: [{ path: "cycleOrder", operation: "set", value: ["bridge/pick"] }],
+			},
+		});
+		expect(set.ok).toBe(true);
+		const preview = await built.control({ operation: "settings.reset.preview", payload: { paths: ["cycleOrder"] } });
+		expect(preview.ok).toBe(true);
+		if (preview.ok) {
+			const entries = (preview.result as { entries?: unknown; 0?: unknown }).entries ?? preview.result;
+			const first = (Array.isArray(entries) ? entries[0] : (preview.result as unknown[])[0]) as {
+				path: string;
+				globalConfigured: boolean;
+			};
+			expect(first).toMatchObject({ path: "cycleOrder", globalConfigured: true });
+		}
+		const revision =
+			(set as { result: { settingsRevision: string }[] }).result[0]?.settingsRevision ??
+			(set as { result: { settingsRevision: string } }).result.settingsRevision;
+		const unset = await built.control({
+			operation: "settings.unset",
+			payload: { path: "cycleOrder", expectedRevision: revision },
+		});
+		expect(unset.ok).toBe(true);
+		if (unset.ok) {
+			expect((unset.result as { configured: boolean }).configured).toBe(false);
+		}
+		// A stale revision fails the whole transaction.
+		const stale = await built.control({
+			operation: "settings.unset",
+			payload: { path: "cycleOrder", expectedRevision: "deadbeef" },
+		});
+		expect(stale).toMatchObject({ ok: false, code: "cedia_control_stale_settings_revision" });
+	});
+
+	it("serves only the filtered operations on a settings-only bridge", async () => {
+		const { Settings } = await import("@oh-my-pi/pi-coding-agent/config/settings");
