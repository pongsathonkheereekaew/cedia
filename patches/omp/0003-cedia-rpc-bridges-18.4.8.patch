+			source: "packages/coding-agent/src/modes/rpc/rpc-mode.ts",
+			validate: noPayload("history.transcript"),
+			run: () => options.handlers["history.transcript"](),
+		},
+		{
+			id: "session.fresh",
+			family: "O02",
+			scope: "session",
+			apply: "immediate",
+			surfaces: ["agent", "ide"],
+			principal: "owner",
+			source: "packages/coding-agent/src/modes/rpc/rpc-mode.ts",
+			validate: noPayload("session.fresh"),
+			run: () => options.handlers["session.fresh"](),
+		},
+		...settingsExtendedOperations,
+		...treeOperations,
+		...toolsCatalogOperations,
