index 0000000000..ead2cb2d88
--- /dev/null
+++ b/packages/coding-agent/test/agent-session-queue-projection.test.ts
@@ -0,0 +1,117 @@
+import { afterEach, describe, expect, it, vi } from "bun:test";
+import { Agent, type AgentMessage } from "@oh-my-pi/pi-agent-core";
+import type { ImageContent } from "@oh-my-pi/pi-ai";
+import { getBundledModel } from "@oh-my-pi/pi-catalog/models";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import type { CustomMessage } from "@oh-my-pi/pi-tui/chat/messages";
+
+describe("AgentSession queued message projection", () => {
+	let session: AgentSession | undefined;
+	let authStorage: AuthStorage | undefined;
+
+	afterEach(async () => {
+		await session?.dispose();
+		session = undefined;
+		authStorage?.close();
+		authStorage = undefined;
+	});
+
+	async function createSession(): Promise<AgentSession> {
+		authStorage = await AuthStorage.create(":memory:");
+		authStorage.keys.setRuntime("anthropic", "test-key");
+		const modelRegistry = new ModelRegistry(authStorage);
+		const model = getBundledModel("anthropic", "claude-sonnet-4-5");
+		if (!model) throw new Error("Expected built-in anthropic model");
+		const agent = new Agent({ initialState: { model, systemPrompt: ["Test"], tools: [] } });
+		session = new AgentSession({
+			agent,
+			sessionManager: SessionManager.inMemory(),
+			settings: Settings.isolated({ "compaction.enabled": false }),
+			modelRegistry,
+		});
+		return session;
+	}
+
+	function queuedUser(text: string, images: ImageContent[] = [], steering = false): AgentMessage {
+		return {
+			role: "user",
+			content: [{ type: "text", text }, ...images],
+			...(steering ? { steering: true } : {}),
+			attribution: "user",
+			timestamp: Date.now(),
+		};
+	}
+
+	function customMessage(overrides: Partial<CustomMessage>): AgentMessage {
+		return {
+			role: "custom",
+			customType: "test-message",
+			content: "not a user row",
+			display: true,
+			timestamp: Date.now(),
+			...overrides,
+		};
+	}
+
+	it("projects image counts while retaining the text-only API and queue order", async () => {
+		const target = await createSession();
+		const image: ImageContent = { type: "image", data: "AAA", mimeType: "image/png" };
+		target.agent.steer(queuedUser("steer one", [image], true));
+		target.agent.followUp(queuedUser("follow one"));
+		target.agent.followUp(queuedUser("follow two", [image, image]));
+
+		expect(target.getQueuedMessageDetails()).toEqual({
+			steering: [{ text: "steer one", images: [image] }],
+			followUp: [
+				{ text: "follow one", images: undefined },
+				{ text: "follow two", images: [image, image] },
+			],
+		});
+		expect(target.getQueuedMessages()).toEqual({
+			steering: ["steer one"],
+			followUp: ["follow one", "follow two"],
+		});
+	});
+
+	it("keeps only visible user rows, including user custom messages, in the projection", async () => {
+		const target = await createSession();
+		target.agent.steer(customMessage({ content: "agent card", attribution: "agent" }));
+		target.agent.steer(
+			customMessage({
+				customType: "image-attachment-description",
+				content: "hidden image description",
+				display: false,
+				attribution: "user",
+			}),
+		);
+		target.agent.steer(customMessage({ content: "visible user note", attribution: "user" }));
+		target.agent.followUp(customMessage({ content: "visible follow-up", attribution: "user" }));
+
+		expect(target.getQueuedMessageDetails()).toEqual({
+			steering: [{ text: "visible user note", images: undefined }],
+			followUp: [{ text: "visible follow-up", images: undefined }],
+		});
+	});
+
+	it("lists live steering before queued steering without consuming either row", async () => {
+		const target = await createSession();
+		const image: ImageContent = { type: "image", data: "LIVE", mimeType: "image/webp" };
+		const live = queuedUser("live steer", [image], true);
+		target.agent.steer(queuedUser("queued steer", [], true));
+		const liveSteering = vi.spyOn(target.agent, "peekLiveSteeredMessages").mockReturnValue([live]);
+
+		expect(target.getQueuedMessageDetails()).toEqual({
+			steering: [
+				{ text: "live steer", images: [image] },
+				{ text: "queued steer", images: undefined },
+			],
+			followUp: [],
+		});
+		expect(target.agent.peekSteeringQueue()).toHaveLength(1);
+		liveSteering.mockRestore();
+	});
+});
diff --git a/packages/coding-agent/test/cedia-advisor-config-bridge.test.ts b/packages/coding-agent/test/cedia-advisor-config-bridge.test.ts
new file mode 100644
index 0000000000..071bda9082
--- /dev/null
+++ b/packages/coding-agent/test/cedia-advisor-config-bridge.test.ts
@@ -0,0 +1,128 @@
+/**
+ * Cedia's guarded `WATCHDOG.yml` writer (plan §8.2 O07).
+ *
+ * These fixtures use throwaway directories and a stub session — no runtime, model or provider.
+ * The point is the guard: raw editor text round-trips byte-exact, malformed text never reaches
+ * disk, and every write ends by applying the re-discovered roster through the session's own
+ * `applyAdvisorConfigs`, exactly as the terminal `/advisor configure` save path does.
+ */
+import { describe, expect, it } from "bun:test";
+import { mkdirSync, mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AgentSession } from "../src/session/agent-session";
+import {
+	CEDIA_ADVISOR_CONFIG_MAX_CHARS,
+	readCediaAdvisorConfig,
+	writeCediaAdvisorConfig,
+} from "../src/modes/rpc/cedia-advisor-config-bridge";
+
+function fixture() {
+	const root = mkdtempSync(join(tmpdir(), "cedia-advisor-config-"));
+	const projectDir = join(root, "project");
+	const agentDir = join(root, "agent");
+	mkdirSync(projectDir, { recursive: true });
+	mkdirSync(agentDir, { recursive: true });
+	const calls: unknown[][] = [];
+	const session = {
+		sessionManager: { getCwd: () => projectDir },
+		settings: { getAgentDir: () => agentDir },
+		applyAdvisorConfigs: (...args: unknown[]) => {
+			calls.push(args);
+			return (args[0] as unknown[]).length;
+		},
+	} as unknown as AgentSession;
+	return {
+		projectDir,
+		agentDir,
+		session,
+		calls,
+		path: join(projectDir, "WATCHDOG.yml"),
+		dispose: () => rmSync(root, { recursive: true, force: true }),
+	};
+}
+
+const VALID = "# probe config\nadvisors:\n  - name: probe\n";
+
+describe("Cedia advisor config bridge", () => {
+	it("reads a missing file as absent, never as an error", async () => {
+		const f = fixture();
+		try {
+			expect(await readCediaAdvisorConfig(f.session, "project")).toEqual({
+				scope: "project",
+				path: f.path,
+				exists: false,
+				text: "",
+			});
+			expect(f.calls).toEqual([]);
+		} finally {
+			f.dispose();
+		}
+	});
+
+	it("writes exactly the validated text and applies the re-discovered roster", async () => {
+		const f = fixture();
+		try {
+			const answer = await writeCediaAdvisorConfig(f.session, "project", VALID);
+			expect(answer).toMatchObject({ scope: "project", path: f.path, exists: true, advisors: 1 });
+			expect(await Bun.file(f.path).text()).toBe(VALID);
+			expect(f.calls).toHaveLength(1);
+			const roster = f.calls[0]![0] as { name: string }[];
+			expect(roster).toHaveLength(1);
+			expect(roster[0]!.name).toBe("probe");
+			const read = await readCediaAdvisorConfig(f.session, "project");
+			expect(read).toMatchObject({ scope: "project", path: f.path, exists: true, text: VALID });
+		} finally {
+			f.dispose();
+		}
+	});
+
+	it("refuses text that is not YAML and leaves no file behind", async () => {
+		const f = fixture();
+		try {
+			await expect(writeCediaAdvisorConfig(f.session, "project", "advisors: [unclosed")).rejects.toThrow(/not YAML/);
+			expect(await Bun.file(f.path).exists()).toBe(false);
+			expect(f.calls).toEqual([]);
+		} finally {
+			f.dispose();
+		}
+	});
+
+	it("refuses YAML that violates the schema and leaves no file behind", async () => {
+		const f = fixture();
+		try {
+			await expect(writeCediaAdvisorConfig(f.session, "project", "advisors: nope\n")).rejects.toThrow(/invalid/);
+			expect(await Bun.file(f.path).exists()).toBe(false);
+			expect(f.calls).toEqual([]);
+		} finally {
+			f.dispose();
+		}
+	});
+
+	it("removes the file on an empty write so discovery falls back", async () => {
+		const f = fixture();
+		try {
+			await writeCediaAdvisorConfig(f.session, "project", VALID);
+			expect(await Bun.file(f.path).exists()).toBe(true);
+			const answer = await writeCediaAdvisorConfig(f.session, "project", "  \n");
+			expect(answer).toMatchObject({ scope: "project", exists: false, advisors: 0 });
+			expect(await Bun.file(f.path).exists()).toBe(false);
+			expect(f.calls).toHaveLength(2);
+		} finally {
+			f.dispose();
+		}
+	});
+
+	it("refuses an unknown scope and oversized text before touching disk", async () => {
+		const f = fixture();
+		try {
+			await expect(readCediaAdvisorConfig(f.session, "global" as never)).rejects.toThrow(/scope project or user/);
+			await expect(writeCediaAdvisorConfig(f.session, "global" as never, VALID)).rejects.toThrow(/scope project or user/);
+			await expect(writeCediaAdvisorConfig(f.session, "project", "x".repeat(CEDIA_ADVISOR_CONFIG_MAX_CHARS + 1))).rejects.toThrow(/exceeds/);
+			expect(await Bun.file(f.path).exists()).toBe(false);
+			expect(f.calls).toEqual([]);
+		} finally {
+			f.dispose();
+		}
+	});
+});
diff --git a/packages/coding-agent/test/cedia-agent-roster.test.ts b/packages/coding-agent/test/cedia-agent-roster.test.ts
new file mode 100644
index 0000000000..64346132d5
--- /dev/null
+++ b/packages/coding-agent/test/cedia-agent-roster.test.ts
@@ -0,0 +1,84 @@
+import { describe, expect, it } from "bun:test";
+import { AgentRegistry } from "../src/registry/agent-registry";
+import { readCediaAgents } from "../src/modes/rpc/cedia-agents-bridge";
+
+/**
+ * Cedia's Agents view reads the runtime's own registry. These cases pin that the projection is the
+ * registry's answer - identity, the runtime's kind and status words, ancestry, the agent's own
+ * activity gist and the session file a transcript read needs - in a stable order, with nothing
+ * invented and no agent hidden.
+ */
+describe("Cedia agent roster", () => {
+	it("projects the registry's own roster in a stable order", () => {
+		const registry = new AgentRegistry();
+		registry.register({
+			id: "sub-1",
+			displayName: "Explore",
+			kind: "sub",
+			parentId: "main-1",
+			status: "running",
+			session: null,
+			sessionFile: "/tmp/child.jsonl",
+			createdAt: 100,
+			lastActivity: 900,
+			activity: "reading the seams",
+		});
+		registry.register({
+			id: "main-1",
+			displayName: "Main",
+			kind: "main",
+			status: "idle",
+			session: null,
+			sessionFile: "/tmp/main.jsonl",
+			createdAt: 50,
+			lastActivity: 500,
+		});
+		registry.register({
+			id: "parked-1",
+			displayName: "Parked worker",
+			kind: "sub",
+			status: "parked",
+			session: null,
+			createdAt: 10,
+			lastActivity: 20,
+		});
+
+		const roster = readCediaAgents(registry);
+		expect(roster.agents.map(agent => agent.id)).toEqual(["sub-1", "main-1", "parked-1"]);
+		expect(roster.agents[0]).toEqual({
+			id: "sub-1",
+			name: "Explore",
+			kind: "sub",
+			parentId: "main-1",
+			status: "running",
+			createdAt: 100,
+			lastActivity: 900,
+			activity: "reading the seams",
+			sessionFile: "/tmp/child.jsonl",
+		});
+		// A parked agent has no live session and therefore no transcript to read: the projection
+		// says so by leaving the field out rather than naming a file that does not exist.
+		expect(roster.agents[2]).toEqual({
+			id: "parked-1",
+			name: "Parked worker",
+			kind: "sub",
+			status: "parked",
+			createdAt: 10,
+			lastActivity: 20,
+		});
+	});
+
+	it("answers an empty roster when the runtime holds no agents, rather than inventing one", () => {
+		expect(readCediaAgents(new AgentRegistry())).toEqual({ agents: [] });
+	});
+
+	it("keeps the runtime's own status and kind words verbatim", () => {
+		const registry = new AgentRegistry();
+		registry.register({ id: "advisor-1", displayName: "Advisor", kind: "advisor", status: "idle", session: null, createdAt: 1, lastActivity: 1 });
+		const [agent] = readCediaAgents(registry).agents;
+		expect(agent?.kind).toBe("advisor");
+		expect(agent?.status).toBe("idle");
+		expect(agent && "activity" in agent).toBe(false);
+		expect(agent && "sessionFile" in agent).toBe(false);
+	});
+});
diff --git a/packages/coding-agent/test/cedia-agents-config-bridge.test.ts b/packages/coding-agent/test/cedia-agents-config-bridge.test.ts
