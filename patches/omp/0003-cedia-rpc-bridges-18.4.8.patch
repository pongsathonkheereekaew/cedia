@@ -0,0 +1,742 @@
+import { afterEach, describe, expect, test } from "bun:test";
+import { execFileSync } from "node:child_process";
+import * as fs from "node:fs/promises";
+import * as net from "node:net";
+import { tmpdir } from "node:os";
+import * as path from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import { startCediaOwnerBridge } from "../src/session/cedia-owner-bridge";
+
+const bridges: Array<{ close(): Promise<void> }> = [];
+afterEach(async () => {
+	await Promise.all(bridges.splice(0).map(bridge => bridge.close()));
+});
+
+function connect(socketPath: string): Promise<net.Socket> {
+	return new Promise((resolve, reject) => {
+		const socket = net.createConnection(socketPath, () => resolve(socket));
+		socket.once("error", reject);
+	});
+}
+
+async function readLine(socket: net.Socket): Promise<Record<string, unknown>> {
+	return new Promise((resolve, reject) => {
+		let data = "";
+		const onError = (error: Error) => {
+			socket.off("data", onData);
+			reject(error);
+		};
+		const onData = (chunk: Buffer) => {
+			data += chunk.toString("utf8");
+			const newline = data.indexOf("\n");
+			if (newline >= 0) {
+				socket.off("data", onData);
+				socket.off("error", onError);
+				resolve(JSON.parse(data.slice(0, newline)) as Record<string, unknown>);
+			}
+		};
+		socket.on("data", onData);
+		socket.once("error", onError);
+	});
+}
+
+function createStreamLineReader(stream: ReadableStream<Uint8Array>) {
+	const reader = stream.getReader();
+	let buffered = "";
+	return async (): Promise<Record<string, unknown>> => {
+		for (;;) {
+			const newline = buffered.indexOf("\n");
+			if (newline >= 0) {
+				const line = buffered.slice(0, newline);
+				buffered = buffered.slice(newline + 1);
+				return JSON.parse(line) as Record<string, unknown>;
+			}
+			const { done, value } = await reader.read();
+			if (done) throw new Error("owner stdout closed before a complete RPC frame");
+			buffered += new TextDecoder().decode(value, { stream: true });
+		}
+	};
+}
+
+describe("Cedia owner controller lease", () => {
+	test("publishes the operating-system process start identity in the owner record", async () => {
+		const directory = await fs.mkdtemp(path.join(tmpdir(), "cedia-owner-birth-"));
+		const bridge = await startCediaOwnerBridge({
+			directory,
+			sessionId: "session-birth",
+			incarnation: "inc-birth",
+			cwd: directory,
+		});
+		bridges.push(bridge);
+
+		const start = execFileSync("/bin/ps", ["-p", String(process.pid), "-o", "lstart="], {
+			encoding: "utf8",
+			env: { ...process.env, LC_ALL: "C", TZ: "UTC" },
+		})
+			.trim()
+			.replace(/\s+/g, " ");
+		const record = JSON.parse(await fs.readFile(path.join(directory, "owner.json"), "utf8")) as Record<
+			string,
+			unknown
+		>;
+
+		expect(record.protocolVersion).toBe(3);
+		expect(record.processStartIdentity).toBe(`darwin-ps-lstart:v1:${start}`);
+	});
+
+	test("publishes inspect-only mode and refuses controller claims", async () => {
+		const directory = await fs.mkdtemp(path.join(tmpdir(), "cedia-owner-inspect-"));
+		const bridge = await startCediaOwnerBridge({
+			directory,
+			sessionId: "session-inspect",
+			incarnation: "inc-inspect",
+			cwd: directory,
+			mode: "inspect_only",
+		});
+		bridges.push(bridge);
+		expect(bridge.record.mode).toBe("inspect_only");
+		const socket = await connect(bridge.record.socket);
+		const identity = {
+			sessionId: "session-inspect",
+			incarnation: "inc-inspect",
+			pid: process.pid,
+			processStartIdentity: bridge.record.processStartIdentity,
+			ownerStartedAt: bridge.record.ownerStartedAt,
+		};
+		socket.write(
+			`${JSON.stringify({ protocolVersion: 3, token: bridge.record.token, request: "identify", id: "identify-1" })}\n`,
+		);
+		const identified = await readLine(socket);
+		expect(identified.identity).toMatchObject({ ...identity, mode: "inspect_only" });
+		socket.write(
+			`${JSON.stringify({ protocolVersion: 3, token: bridge.record.token, request: "status", id: "status-1" })}\n`,
+		);
+		const status = await readLine(socket);
+		expect(status.identity).toMatchObject({ ...identity, mode: "inspect_only" });
+		socket.write(
+			`${JSON.stringify({ protocolVersion: 3, token: bridge.record.token, request: "claim_controller", id: "claim-1", expectedIdentity: identity })}\n`,
+		);
+		expect((await readLine(socket)).error).toBe("inspect_only");
+		socket.destroy();
+	});
+
+	test("rejects a controller claim with a different operating-system process start identity", async () => {
