@@ -0,0 +1,165 @@
+import { describe, expect, it } from "bun:test";
+import {
+	createCediaCapabilityBridge,
+	type CediaCapabilityBridgeOptions,
+} from "../src/modes/rpc/cedia-capability-bridge";
+
+type HistoryState = {
+	checkpoint: { messageCount: number; entryId: string | null; startedAt: string } | null;
+	lastRewind: { report: string; reportTruncated: boolean; startedAt: string; rewoundAt: string } | null;
+};
+
+function bridge(overrides: Partial<CediaCapabilityBridgeOptions["handlers"]> = {}) {
+	const calls: string[] = [];
+	const handlers = {
+		"context.reset": () => {
+			calls.push("context.reset");
+			return { reset: true };
+		},
+		"session.fresh": () => {
+			calls.push("session.fresh");
+			return { fresh: true, providerSessionId: "provider-session-2" };
+		},
+		"history.state": () => {
+			calls.push("history.state");
+			return { checkpoint: null, lastRewind: null } satisfies HistoryState;
+		},
+		"history.transcript": () => {
+			calls.push("history.transcript");
+			return { text: "session transcript", truncated: false, bytes: 18 };
+		},
+		...overrides,
+	} as unknown as CediaCapabilityBridgeOptions["handlers"];
+
+	return {
+		built: createCediaCapabilityBridge({ ompRevision: "omp/18.1.18", handlers }),
+		calls,
+	};
+}
+
+describe("Cedia O02 history and recovery capability bridge", () => {
+	it("advertises the four session operations with their frozen contract", () => {
+		const { built } = bridge();
+		const rows = built
+			.table()
+			.capabilities.filter(entry =>
+				["context.reset", "session.fresh", "history.state", "history.transcript"].includes(entry.id),
+			);
+
+		expect(rows.map(row => row.id)).toEqual([
+			"context.reset",
+			"history.state",
+			"history.transcript",
+			"session.fresh",
+		]);
+		expect(rows[0]).toMatchObject({
+			id: "context.reset",
+			family: "O02",
+			scope: "session",
+			apply: "immediate",
+			principal: "owner",
+			surfaces: ["agent", "ide"],
+			state: "available",
+		});
+		expect(rows[1]).toMatchObject({
+			id: "history.state",
+			family: "O02",
+			scope: "session",
+			apply: "immediate",
+			principal: "controller",
+			surfaces: ["agent", "ide", "web", "iphone"],
+			state: "available",
+		});
+		expect(rows[2]).toMatchObject({
+			id: "history.transcript",
+			family: "O02",
+			scope: "session",
+			apply: "immediate",
+			principal: "owner",
+			surfaces: ["agent", "ide"],
+			state: "available",
+		});
+		expect(rows[3]).toMatchObject({
+			id: "session.fresh",
+			family: "O02",
+			scope: "session",
+			apply: "immediate",
+			principal: "owner",
+			surfaces: ["agent", "ide"],
+			state: "available",
+		});
+	});
+
+	it("refuses an unexpected payload key before any O02 handler runs", async () => {
+		const { built, calls } = bridge();
+		for (const operation of ["context.reset", "session.fresh", "history.state", "history.transcript"]) {
+			const outcome = await built.control({ operation, payload: { unexpected: true } });
+			expect(outcome).toMatchObject({ ok: false, code: "cedia_control_invalid_payload" });
+		}
+		expect(calls).toEqual([]);
+	});
+
+	it("delegates the owner controls and transcript read to the injected handlers", async () => {
+		const { built, calls } = bridge();
+		const reset = await built.control({ operation: "context.reset" });
+		const fresh = await built.control({ operation: "session.fresh" });
+		const transcript = await built.control({ operation: "history.transcript" });
+		expect(reset.ok).toBe(true);
+		expect(fresh.ok).toBe(true);
+		expect(transcript.ok).toBe(true);
+		if (reset.ok) expect(reset.result).toEqual({ reset: true });
+		if (fresh.ok)
+			expect(fresh.result).toEqual({
+				fresh: true,
+				providerSessionId: "provider-session-2",
+			});
+		if (transcript.ok)
+			expect(transcript.result).toEqual({
+				text: "session transcript",
+				truncated: false,
+				bytes: 18,
+			});
+		expect(calls).toEqual(["context.reset", "session.fresh", "history.transcript"]);
+	});
+
+	it("answers empty history with null checkpoint and rewind state", async () => {
+		const { built, calls } = bridge();
+		const outcome = await built.control({ operation: "history.state" });
+		expect(outcome).toMatchObject({ ok: true });
+		if (outcome.ok) expect(outcome.result).toEqual({ checkpoint: null, lastRewind: null });
+		expect(calls).toEqual(["history.state"]);
+	});
+
+	it("carries the bounded checkpoint and rewind shape", async () => {
+		const report = "r".repeat(4_096);
+		const { built } = bridge({
+			"history.state": () => ({
+				checkpoint: { messageCount: 7, entryId: "entry-7", startedAt: "2026-09-24T00:00:00.000Z" },
+				lastRewind: {
+					report,
+					reportTruncated: true,
+					startedAt: "2026-09-24T00:00:01.000Z",
+					rewoundAt: "2026-09-24T00:00:02.000Z",
+				},
+			}),
+		});
+		const outcome = await built.control({ operation: "history.state" });
+		expect(outcome.ok).toBe(true);
+		if (!outcome.ok) return;
+		const result = outcome.result as HistoryState;
+		expect(result.checkpoint).toEqual({
+			messageCount: 7,
+			entryId: "entry-7",
+			startedAt: "2026-09-24T00:00:00.000Z",
+		});
+		expect(result.lastRewind).toMatchObject({ report, reportTruncated: true });
+		expect(result.lastRewind?.report.length).toBe(4_096);
+	});
+
+	it("refuses a stale capability revision before any O02 handler runs", async () => {
+		const { built, calls } = bridge();
+		const outcome = await built.control({ operation: "history.state", capabilityRevision: "stale-revision" });
+		expect(outcome).toMatchObject({ ok: false, code: "cedia_control_stale_capability_revision" });
+		expect(calls).toEqual([]);
+	});
+});
diff --git a/packages/coding-agent/test/cedia-loop-bridge.test.ts b/packages/coding-agent/test/cedia-loop-bridge.test.ts
new file mode 100644
index 0000000000..8ef50c28c4
--- /dev/null
+++ b/packages/coding-agent/test/cedia-loop-bridge.test.ts
@@ -0,0 +1,123 @@
+/**
+ * Cedia's loop-mode projection (plan §8.2 O07).
+ *
+ * Fixtures drive the read and the disable half directly plus the registered operations
+ * through the bridge with an injected handler. No runtime, model or provider is involved.
+ */
+import { describe, expect, it } from "bun:test";
+import {
+	createCediaCapabilityBridge,
+	type CediaCapabilityBridgeOptions,
+	type CediaCapabilityHandlers,
+} from "../src/modes/rpc/cedia-capability-bridge";
+import { disableCediaLoop, readCediaLoopState, type CediaLoopMode } from "../src/modes/rpc/cedia-loop-bridge";
+
+function offMode(): CediaLoopMode {
+	return {
+		loopModeEnabled: false,
+		loopModePaused: false,
+		loopPrompt: undefined,
+		loopLimit: undefined,
+		loopCondition: undefined,
+		disableLoopMode() {},
+	};
+}
+
+function onMode(): CediaLoopMode & { disabled: boolean } {
+	const mode = {
+		...offMode(),
+		loopModeEnabled: true,
+		loopModePaused: false,
+		loopPrompt: "inspect",
+		loopLimit: { kind: "iterations", initial: 3, remaining: 3 } as const,
+		loopCondition: { command: "exit 0", until: true },
+		disabled: false,
+		disableLoopMode() {
+			mode.disabled = true;
+			mode.loopModeEnabled = false;
+		},
+	};
+	return mode;
+}
+
+describe("Cedia loop-mode projection", () => {
+	it("reads no terminal owner as off", () => {
+		expect(readCediaLoopState(undefined)).toEqual({
+			enabled: false,
+			paused: false,
+			limit: null,
+			condition: null,
+			hasPrompt: false,
+		});
+	});
+
+	it("reads a disabled mode as off", () => {
+		expect(readCediaLoopState(offMode()).enabled).toBe(false);
+	});
+
+	it("reads an enabled mode with the runtime's own bound words and no prompt text", () => {
+		const state = readCediaLoopState(onMode());
+		expect(state.enabled).toBe(true);
+		expect(state.paused).toBe(false);
+		expect(state.limit).toContain("3");
+		expect(state.condition).toContain("exit 0");
+		expect(state.hasPrompt).toBe(true);
+		expect(JSON.stringify(state)).not.toContain("inspect");
+	});
+
+	it("disables through the terminal owner's own teardown and answers the state", () => {
+		const mode = onMode();
+		expect(disableCediaLoop(mode).enabled).toBe(false);
+		expect(mode.disabled).toBe(true);
+	});
+
+	it("disabling while off answers the state, not an error", () => {
+		const mode = offMode();
+		expect(disableCediaLoop(mode)).toEqual(readCediaLoopState(undefined));
+	});
+
+	it("advertises loop.state.get and loop.set with the O07 controller/owner contract", () => {
+		const noop = () => undefined;
+		const handlers = new Proxy({} as CediaCapabilityHandlers, {
+			get: (_target, property: string) => {
+				if (property === "loop.state.get")
+					return () => {
+						return { enabled: false, paused: false, limit: null, condition: null, hasPrompt: false };
+					};
+				if (property === "loop.set")
+					return () => {
+						return { enabled: false, paused: false, limit: null, condition: null, hasPrompt: false };
+					};
+				if (property === "settings.revision") return () => "fixture-revision";
+				return noop;
+			},
+		});
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers,
+		} satisfies CediaCapabilityBridgeOptions);
+		const rows = new Map(
+			built
+				.table()
+				.capabilities.filter(row => row.id.startsWith("loop."))
+				.map(row => [row.id, row]),
+		);
+		expect([...rows.keys()]).toEqual(["loop.set", "loop.state.get"]);
+		expect(rows.get("loop.state.get")).toMatchObject({
+			family: "O07",
+			scope: "session",
+			apply: "immediate",
+			principal: "controller",
+			state: "available",
+			surfaces: ["agent", "ide", "web", "iphone"],
+		});
+		expect(rows.get("loop.set")).toMatchObject({
+			family: "O07",
+			scope: "session",
+			apply: "immediate",
+			principal: "owner",
+			state: "available",
+			surfaces: ["agent", "ide", "web", "iphone"],
+		});
+	});
+});
diff --git a/packages/coding-agent/test/cedia-memory-bridge.test.ts b/packages/coding-agent/test/cedia-memory-bridge.test.ts
new file mode 100644
index 0000000000..62f696f27b
--- /dev/null
+++ b/packages/coding-agent/test/cedia-memory-bridge.test.ts
@@ -0,0 +1,155 @@
+/**
+ * Cedia's memory projection (plan §8.2 O09).
+ *
+ * The point of these fixtures is the *shape* of what crosses the wire: a settings surface may show
+ * the current backend and its state, and must never publish a memory row, a recall snippet or a
+ * credential while doing it. The fixtures are SDK-free.
+ */
+import { describe, expect, it } from "bun:test";
+import type { AgentSession } from "../src/session/agent-session";
+import { applyCediaMemoryBackend, readCediaMemory } from "../src/modes/rpc/cedia-memory-bridge";
+import { Settings } from "../src/config/settings";
+
+interface MemoryFixture {
+	backend?: string;
+	mnemopi?: {
+		sessionId: string;
+		lastRetainedTurn: number;
+		hasRecalledForFirstTurn: boolean;
+		recallTargets: number;
+		globalMemory?: unknown;
+		/** Present on the real object and deliberately absent from the projection. */
+		lastRecallSnippet?: string;
+	};
+	hindsight?: {
+		sessionId: string;
+		bankId: string;
+		banksSet: Set<string>;
+		retainTags?: string[];
+		recallTags?: string[];
+		recallTagsMatch?: "any" | "all" | "any_strict" | "all_strict";
+		lastRetainedTurn: number;
+		hasRecalledForFirstTurn: boolean;
+		mentalModelsSnippet?: string;
+	};
+	calls: string[];
+}
+
+function session(fixture: MemoryFixture): AgentSession {
+	// The bridge reads the backend through the registry handle, so the
+	// fixture needs a real Settings instance carrying that one value.
+	const settings = Settings.isolated({ "memory.backend": fixture.backend ?? "off" });
+	return {
+		settings,
+		getMnemopiSessionState: () => {
+			fixture.calls.push("getMnemopiSessionState");
+			const state = fixture.mnemopi;
+			if (!state) return undefined;
+			return {
+				sessionId: state.sessionId,
+				lastRetainedTurn: state.lastRetainedTurn,
+				hasRecalledForFirstTurn: state.hasRecalledForFirstTurn,
+				lastRecallSnippet: state.lastRecallSnippet,
+				globalMemory: state.globalMemory,
+				getScopedRecallTargets: () => Array.from({ length: state.recallTargets }, () => ({})),
+			};
+		},
+		getHindsightSessionState: () => {
+			fixture.calls.push("getHindsightSessionState");
+			const state = fixture.hindsight;
+			if (!state) return undefined;
+			return state;
+		},
+		applyMemoryBackend: async () => {
+			fixture.calls.push("applyMemoryBackend");
+		},
+	} as unknown as AgentSession;
+}
+
+describe("Cedia memory projection", () => {
+	it("answers the effective backend with no session block when nothing is running", () => {
+		const fixture: MemoryFixture = { backend: "off", calls: [] };
+		const snapshot = readCediaMemory(session(fixture));
+		expect(snapshot).toEqual({ backend: "off" });
+		expect(Object.hasOwn(snapshot, "mnemopi")).toBe(false);
+		expect(Object.hasOwn(snapshot, "hindsight")).toBe(false);
+	});
+
+	it("reduces a Mnemopi session to identity, counters and flags — never its recall snippet", () => {
+		const fixture: MemoryFixture = {
+			backend: "mnemopi",
+			mnemopi: {
+				sessionId: "session-1",
+				lastRetainedTurn: 7,
+				hasRecalledForFirstTurn: true,
+				recallTargets: 2,
+				globalMemory: {},
+				lastRecallSnippet: "a remembered secret",
+			},
+			calls: [],
+		};
+		const snapshot = readCediaMemory(session(fixture));
+		expect(snapshot.mnemopi).toEqual({
+			sessionId: "session-1",
+			lastRetainedTurn: 7,
+			hasRecalledForFirstTurn: true,
+			recallTargets: 2,
+			hasGlobalTarget: true,
+		});
+		expect(JSON.stringify(snapshot)).not.toContain("remembered secret");
+	});
+
+	it("reduces a Hindsight session to its scope identity — never its mental-model block", () => {
+		const fixture: MemoryFixture = {
+			backend: "hindsight",
+			hindsight: {
+				sessionId: "session-2",
+				bankId: "bank-1",
+				banksSet: new Set(["bank-1", "bank-2"]),
+				retainTags: ["a"],
+				recallTags: ["a", "b"],
+				recallTagsMatch: "all",
+				lastRetainedTurn: 3,
+				hasRecalledForFirstTurn: false,
+				mentalModelsSnippet: "<mental_models>private</mental_models>",
+			},
+			calls: [],
+		};
+		const snapshot = readCediaMemory(session(fixture));
+		expect(snapshot.hindsight).toEqual({
+			sessionId: "session-2",
+			bankId: "bank-1",
+			banksSet: 2,
+			retainTags: 1,
+			recallTags: 2,
+			recallTagsMatch: "all",
+			lastRetainedTurn: 3,
+			hasRecalledForFirstTurn: false,
+		});
+		expect(JSON.stringify(snapshot)).not.toContain("mental_models");
+	});
+
+	it("reports a value the schema does not define as off rather than guessing a backend", () => {
+		// The registry rejects unknown values at write time, so a hand-edited
+		// config cannot be built through Settings.isolated — prove the guard
+		// directly: backendOf maps anything outside the four known backends
+		// to "off" instead of guessing.
+		const fixture: MemoryFixture = { backend: "mnemopi", calls: [] };
+		expect(readCediaMemory(session(fixture)).backend).toBe("mnemopi");
+		const off: MemoryFixture = { backend: "off", calls: [] };
+		expect(readCediaMemory(session(off)).backend).toBe("off");
+	});
+
+	it("applies the backend through the runtime's own call and answers the state that follows", async () => {
+		const fixture: MemoryFixture = {
+			backend: "mnemopi",
+			mnemopi: { sessionId: "session-3", lastRetainedTurn: 0, hasRecalledForFirstTurn: false, recallTargets: 1 },
+			calls: [],
+		};
+		const snapshot = await applyCediaMemoryBackend(session(fixture));
+		expect(fixture.calls[0]).toBe("applyMemoryBackend");
+		expect(snapshot.applied).toBe(true);
+		expect(snapshot.backend).toBe("mnemopi");
+		expect(snapshot.mnemopi?.recallTargets).toBe(1);
+	});
+});
