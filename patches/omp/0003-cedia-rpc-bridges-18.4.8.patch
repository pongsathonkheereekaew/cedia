@@ -0,0 +1,247 @@
+/**
+ * Cedia's cleanse projection for OMP RPC mode (plan §8.2 O02).
+ *
+ * `/cleanse` detects project diagnostics with local checker commands and fixes them with
+ * weighted parallel subagents. The terminal carries this in an overlay panel with pickers;
+ * headless clients get the same run without the interactive half: explicit options select
+ * the target (a request, or every discovered checker via `all`), and progress plus the
+ * final report land in the held state. Like the terminal (which awaits the run on its own
+ * overlay), the dispatch answers the running state at once — a headless call must never
+ * occupy the transport for a whole repair batch — and cancellation flows through the
+ * run's own abort signal, which the terminal's Esc also drives.
+ *
+ * The wire carries bounded summaries only: checker identity and exit codes, per-agent
+ * status with a short detail, bounded diagnostics, and bounded log lines. Repair output
+ * bodies and full transcripts stay in the runtime.
+ */
+import { runCleanse } from "../../cleanse/index";
+import type { CleanseCheckerDescriptor } from "../../cleanse/checkers";
+import type {
+	CleanseAssignment,
+	CleanseCheckResult,
+	CleanseDiagnostic,
+	CleanseDiagnosticReport,
+	CleanseRunStatus,
+} from "../../cleanse/types";
+import type {
+	CleanseAgentOutcome,
+	CleanseStatusBoard,
+} from "@oh-my-pi/pi-tui/apps/cleanse-board";
+import type { AgentProgress } from "@oh-my-pi/pi-tui/tools/task";
+import type { RpcCediaCleanseData, RpcCediaCleanseReport } from "./rpc-types";
+
+/** Largest log tail a cleanse answer may carry. */
+export const CEDIA_CLEANSE_MAX_LOG_LINES = 200;
+
+/** Largest diagnostic list a cleanse report may carry per section. */
+export const CEDIA_CLEANSE_MAX_DIAGNOSTICS = 100;
+
+/** Largest per-agent detail a cleanse answer may carry. */
+export const CEDIA_CLEANSE_MAX_DETAIL_CHARS = 500;
+
+/** Largest repair outcome text a cleanse answer may carry per agent. */
+export const CEDIA_CLEANSE_MAX_OUTCOME_CHARS = 2000;
+
+export type CediaCleanseRunOptions = {
+	request?: string;
+	all?: boolean;
+	includeTests?: boolean;
+	maxAgents?: number;
+	model?: string;
+};
+
+type HeldAgent = {
+	name: string;
+	files: number;
+	status: string;
+	detail: string;
+};
+
+type HeldChecker = {
+	id: string;
+	label: string;
+	state: "running" | "done";
+	exitCode: number | null;
+	diagnostics: number;
+	durationMs: number | null;
+};
+
+function boundText(value: string, max: number): { text: string; truncated: boolean } {
+	if (value.length <= max) return { text: value, truncated: false };
+	return { text: value.slice(0, max), truncated: true };
+}
+
+function diagProjected(diag: CleanseDiagnostic): RpcCediaCleanseReport["diagnostics"][number] {
+	return {
+		checker: diag.checker,
+		...(diag.file === undefined ? {} : { file: diag.file }),
+		...(diag.line === undefined ? {} : { line: diag.line }),
+		...(diag.column === undefined ? {} : { column: diag.column }),
+		...(diag.code === undefined ? {} : { code: diag.code }),
+		severity: diag.severity,
+		message: diag.message,
+	};
+}
+
+function reportProjected(report: CleanseDiagnosticReport): Omit<RpcCediaCleanseReport, "status"> {
+	const checks = report.checks.map(check => ({
+		id: check.id,
+		label: check.label,
+		language: check.language,
+		exitCode: check.exitCode,
+		diagnostics: check.diagnostics.length,
+	}));
+	const diagnostics = report.diagnostics.slice(0, CEDIA_CLEANSE_MAX_DIAGNOSTICS).map(diagProjected);
+	const skipped = report.skipped.map(row => ({ label: row.label, language: row.language, reason: row.reason }));
+	return {
+		checks,
+		checksTruncated: false,
+		diagnostics,
+		diagnosticsTruncated: report.diagnostics.length > CEDIA_CLEANSE_MAX_DIAGNOSTICS,
+		diagnosticsTotal: report.diagnostics.length,
+		skipped,
+	};
+}
+
+/** A cleanse bridge: one run at a time, state held for the state read.
+ * The runner is injectable so fixtures can drive dispatch, progress and abort without
+ * spawning checkers or subagents; production passes nothing and gets `runCleanse`. */
+export function createCediaCleanseBridge(deps?: {
+	run?: typeof runCleanse;
+}): {
+	run(options: CediaCleanseRunOptions): Promise<RpcCediaCleanseData>;
+	read(): RpcCediaCleanseData;
+	abort(): RpcCediaCleanseData;
+} {
+	const runOne = deps?.run ?? runCleanse;
+	let running = false;
+	let finished: { status: CleanseRunStatus; report: CleanseDiagnosticReport } | undefined;
+	let failed: string | undefined;
+	let runSummary: string | undefined;
+	let phase: string | undefined;
+	const log: string[] = [];
+	const checkers = new Map<string, HeldChecker>();
+	const agents = new Map<string, HeldAgent>();
+	let aborter: AbortController | undefined;
+
+	function pushLog(text: string): void {
+		for (const line of text.split("\n")) {
+			const trimmed = line.length > 500 ? `${line.slice(0, 500)}…` : line;
+			log.push(trimmed);
+		}
+		while (log.length > CEDIA_CLEANSE_MAX_LOG_LINES) log.shift();
+	}
+
+	function agentDetail(progress: AgentProgress): string {
+		const parts = [progress.lastIntent, progress.task].filter(
+			(part): part is string => typeof part === "string" && part.trim().length > 0,
+		);
+		return boundText(parts[0] ?? progress.status, CEDIA_CLEANSE_MAX_DETAIL_CHARS).text;
+	}
+
+	function agentFiles(assignment: CleanseAssignment): number {
+		return assignment.groups.reduce((total, group) => total + group.diagnostics.length, 0);
+	}
+
+	const board: CleanseStatusBoard = {
+		interactive: false,
+		log: (text: string) => pushLog(text),
+		phase: (text: string | undefined) => {
+			phase = text;
+		},
+		checkerStarted: (checker: CleanseCheckerDescriptor) => {
+			checkers.set(checker.id, { id: checker.id, label: checker.label, state: "running", exitCode: null, diagnostics: 0, durationMs: null });
+		},
+		checkerFinished: (check: CleanseCheckResult, durationMs: number) => {
+			checkers.set(check.id, { id: check.id, label: check.label, state: "done", exitCode: check.exitCode, diagnostics: check.diagnostics.length, durationMs });
+			pushLog(`[${check.label}] exit ${check.exitCode ?? "?"}: ${check.diagnostics.length} diagnostics`);
+		},
+		repairFinished: () => {
+			pushLog("Repair phase finished; verifying.");
+		},
+		agentStarted: (name: string, assignment: CleanseAssignment) => {
+			agents.set(name, { name, files: agentFiles(assignment), status: "running", detail: "" });
+		},
+		agentProgress: (name: string, progress: AgentProgress) => {
+			const current = agents.get(name);
+			agents.set(name, { name, files: current?.files ?? 0, status: progress.status, detail: agentDetail(progress) });
+		},
+		agentFinished: (outcome: CleanseAgentOutcome, _assignment: CleanseAssignment) => {
+			const current = agents.get(outcome.name);
+			const error = boundText(outcome.error ?? "", CEDIA_CLEANSE_MAX_DETAIL_CHARS).text;
+			agents.set(outcome.name, {
+				name: outcome.name,
+				files: current?.files ?? 0,
+				status: outcome.success ? "done" : "failed",
+				detail: error.length > 0 ? error : current?.detail ?? "",
+			});
+			pushLog(`${outcome.name}: ${outcome.success ? "done" : "failed"}`);
+		},
+		close: () => {
+			phase = undefined;
+		},
+	};
+
+	function read(): RpcCediaCleanseData {
+		return {
+			state: running ? "running" : finished !== undefined ? "done" : failed !== undefined ? "failed" : "idle",
+			request: runSummary ?? null,
+			phase: phase ?? null,
+			checkers: [...checkers.values()],
+			agents: [...agents.values()],
+			log,
+			report: finished !== undefined ? { status: finished.status, ...reportProjected(finished.report) } : null,
+			reason: failed ?? null,
+		};
+	}
+
+	async function run(options: CediaCleanseRunOptions): Promise<RpcCediaCleanseData> {
+		if (running) throw new Error("A cleanse run is already active — abort it first.");
+		const maxAgents = options.maxAgents ?? 32;
+		if (!Number.isInteger(maxAgents) || maxAgents <= 0) throw new Error("--agents must be a positive integer");
+		const request = options.request?.trim() || undefined;
+		// Without an explicit target the run covers every discovered checker, exactly like the
+		// terminal's "run all" choice and the CLI's `--all`: no interactive picker exists headless.
+		const all = request !== undefined ? true : (options.all ?? true);
+		running = true;
+		finished = undefined;
+		failed = undefined;
+		runSummary = request ?? "all discovered checkers";
+		checkers.clear();
+		agents.clear();
+		const controller = new AbortController();
+		aborter = controller;
+		// Fire and forget, like the terminal overlay: the call answers the running state at
+		// once and the held report lands on completion. Awaiting the batch here would occupy
+		// the transport for the whole repair.
+		void runOne(
+			{ request, all, includeTests: options.includeTests, maxAgents, ...(options.model === undefined ? {} : { model: options.model }) },
+			{
+				board,
+				print: text => pushLog(text),
+				printError: text => pushLog(`error: ${text}`),
+			},
+			controller.signal,
+		)
+			.then(result => {
+				finished = { status: result.status, report: result.report };
+			})
+			.catch((error: unknown) => {
+				failed = error instanceof Error ? error.message : String(error);
+			})
+			.finally(() => {
+				running = false;
+				aborter = undefined;
+			});
+		return read();
+	}
+
+	function abort(): RpcCediaCleanseData {
+		// Aborting with nothing running answers the state, not an error — like disabling
+		// an already-off loop. The panel polls the state for the landing either way.
+		aborter?.abort();
+		return read();
+	}
+
+	return { run, read, abort };
+}
