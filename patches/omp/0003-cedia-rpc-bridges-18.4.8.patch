+		"extensions.list": () => ({ roots: { explicit: [], mode: "merge", configured: [], configuredLevel: "user" }, extensions: [], truncated: false, total: 0 }),
+		"extensions.set": () => ({ roots: { explicit: [], mode: "merge", configured: [], configuredLevel: "user" }, extensions: [], truncated: false, total: 0 }),
+		"omfg.state.get": noop,
+		"omfg.draft": noop,
+		"omfg.save": noop,
+		"omfg.abort": noop,
+		"model.roles.set": noop,
+		"auth.api-key.set": noop,
