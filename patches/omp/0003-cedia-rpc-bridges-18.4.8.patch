+/**
+ * Cedia's native-client bridge for OMP RPC mode.
+ *
+ * This bridge is intentionally narrow: OMP keeps ownership of the agent loop
+ * and asks the embedding host for a structured permission decision through the
+ * existing host-tool transport.  The internal tool definition is never handed
+ * to the model/tool registry; the host dispatcher registers it directly.
+ */
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import type {
+	ClientBridge,
+	ClientBridgeEditorApplyParams,
+	ClientBridgeEditorApplyResponse,
+	ClientBridgeEditorDocumentSnapshot,
+	ClientBridgeEditorSnapshotResponse,
+	ClientBridgeNativeEditor,
+	ClientBridgePermissionOption,
+	ClientBridgePermissionOutcome,
+	ClientBridgePermissionToolCall,
+} from "../../session/client-bridge";
+import { RpcHostToolBridge } from "./host-tools";
+import type { RpcHostToolDefinition } from "./rpc-types";
+
+/** Maximum time a native permission prompt may wait for the embedding host. */
+export const CEDIA_NATIVE_PERMISSION_TIMEOUT_MS = 120_000;
+
+/** Maximum time a native editor snapshot/apply may wait for the host. */
+export const CEDIA_NATIVE_EDITOR_TIMEOUT_MS = 120_000;
+
+/**
+ * Internal host-tool definition used only by Cedia's RPC dispatcher.
+ *
+ * Keep this out of `set_host_tools`: exposing it to the model would create a
+ * second permission/tool surface instead of routing OMP's own permission gate
+ * through the host.
+ */
+export const CEDIA_NATIVE_PERMISSION_DEFINITION: RpcHostToolDefinition = {
+	name: "cedia_native_permission",
+	label: "Cedia native permission",
+	description: "Internal Cedia permission bridge; not a model-facing tool.",
+	hidden: true,
+	parameters: {
+		type: "object",
+		properties: {
+			kind: { const: "permission" },
+			toolCall: { type: "object" },
+			options: { type: "array", items: { type: "object" } },
+		},
+		required: ["kind", "toolCall", "options"],
+		additionalProperties: false,
+	},
+};
+
+/**
+ * Internal host-tool definition for the native editor facade. This is kept
+ * distinct from ACP's unversioned fs/read_text_file and fs/write_text_file
+ * methods so an editor snapshot cannot silently degrade into a disk read.
+ * The Cedia host registers it directly and deliberately excludes it from
+ * `set_host_tools` model-visible definitions.
+ */
+export const CEDIA_NATIVE_EDITOR_DEFINITION: RpcHostToolDefinition = {
+	name: "cedia_native_editor",
+	label: "Cedia native editor",
+	description: "Internal Cedia dirty-buffer snapshot/apply bridge; not a model-facing tool.",
+	hidden: true,
+	parameters: {
+		type: "object",
+		oneOf: [
+			{
+				type: "object",
+				properties: {
+					kind: { const: "snapshot" },
+					path: { type: "string" },
+				},
+				required: ["kind", "path"],
+				additionalProperties: false,
+			},
+			{
+				type: "object",
+				properties: {
+					kind: { const: "apply" },
+					path: { type: "string" },
+					handle: {
+						type: "object",
+						properties: { id: { type: "string" }, uri: { type: "string" } },
+						required: ["id", "uri"],
+						additionalProperties: false,
+					},
+					expectedVersion: { type: "integer", minimum: 0 },
+					expectedHash: { type: "string", pattern: "^[0-9a-fA-F]{64}$" },
+					content: { type: "string" },
+				},
+				required: ["kind", "path", "handle", "expectedVersion", "expectedHash", "content"],
+				additionalProperties: false,
+			},
+			{
+				type: "object",
+				properties: {
+					kind: { const: "apply_disk" },
+					path: { type: "string" },
+					expectedCanonicalPath: { type: "string" },
+					expectedText: { type: "string" },
+					content: { type: "string" },
+				},
+				required: ["kind", "path", "expectedCanonicalPath", "expectedText", "content"],
+				additionalProperties: false,
+			},
+			{
+				type: "object",
+				properties: {
+					kind: { const: "create" },
+					path: { type: "string" },
+					content: { type: "string" },
+				},
+				required: ["kind", "path"],
+				additionalProperties: false,
+			},
+			{
+				type: "object",
+				properties: {
+					kind: { const: "delete" },
+					path: { type: "string" },
+					handle: {
+						type: "object",
+						properties: { id: { type: "string" }, uri: { type: "string" } },
+						required: ["id", "uri"],
+						additionalProperties: false,
+					},
+					expectedVersion: { type: "integer", minimum: 0 },
+					expectedHash: { type: "string", pattern: "^[0-9a-fA-F]{64}$" },
+				},
+				required: ["kind", "path", "handle", "expectedVersion", "expectedHash"],
+				additionalProperties: false,
+			},
+			{
+				type: "object",
+				properties: {
+					kind: { const: "move" },
+					path: { type: "string" },
+					destination: { type: "string" },
+					handle: {
+						type: "object",
+						properties: { id: { type: "string" }, uri: { type: "string" } },
+						required: ["id", "uri"],
+						additionalProperties: false,
+					},
+					expectedVersion: { type: "integer", minimum: 0 },
+					expectedHash: { type: "string", pattern: "^[0-9a-fA-F]{64}$" },
+				},
+				required: ["kind", "path", "destination", "handle", "expectedVersion", "expectedHash"],
+				additionalProperties: false,
+			},
+		],
+	},
+};
+
+/** Optional test/runtime tuning; production defaults to two minutes. */
+export interface CediaPermissionBridgeOptions {
+	/** Deadline in milliseconds. Values are capped at the production bound. */
+	timeoutMs?: number;
+}
+
+const PERMISSION_OPTION_KINDS = new Set<ClientBridgePermissionOption["kind"]>([
+	"allow_once",
+	"allow_always",
+	"reject_once",
+	"reject_always",
+]);
+
+type CombinedSignal = {
+	signal: AbortSignal;
+	isAborted: () => boolean;
+	dispose: () => void;
+};
+
+function makeCombinedSignal(parent: AbortSignal | undefined, timeoutMs: number): CombinedSignal {
+	const controller = new AbortController();
+	const deadline = performance.now() + timeoutMs;
+	let timedOut = false;
+	let disposed = false;
+	const abort = (reason: unknown): void => {
+		if (!controller.signal.aborted) controller.abort(reason);
+	};
+	const onParentAbort = (): void => abort(parent?.reason ?? new Error("Permission request cancelled"));
+	if (parent?.aborted) onParentAbort();
+	else parent?.addEventListener("abort", onParentAbort, { once: true });
+	const timer = setTimeout(() => {
+		timedOut = true;
+		abort(new Error("Cedia native permission request timed out"));
+	}, timeoutMs);
+	timer.unref?.();
+
+	return {
+		signal: controller.signal,
+		isAborted: () =>
+			controller.signal.aborted || timedOut || performance.now() >= deadline || parent?.aborted === true,
+		dispose: () => {
+			if (disposed) return;
+			disposed = true;
+			clearTimeout(timer);
+			parent?.removeEventListener("abort", onParentAbort);
+		},
+	};
+}
+
+function normalizeTimeout(value: number | undefined): number {
+	const timeoutMs = value ?? CEDIA_NATIVE_PERMISSION_TIMEOUT_MS;
+	if (!Number.isFinite(timeoutMs) || timeoutMs <= 0) {
+		throw new TypeError("Cedia native permission timeout must be a positive finite number");
+	}
+	return Math.min(Math.floor(timeoutMs), CEDIA_NATIVE_PERMISSION_TIMEOUT_MS);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return !!value && typeof value === "object" && !Array.isArray(value);
+}
+
+function textOutcome(result: unknown): unknown {
+	if (!isRecord(result) || !Array.isArray(result.content)) {
+		throw new Error("Cedia native permission response was malformed: missing content");
+	}
+	const content = result.content;
+	if (
+		content.length !== 1 ||
+		!isRecord(content[0]) ||
+		content[0].type !== "text" ||
+		typeof content[0].text !== "string"
+	) {
+		throw new Error("Cedia native permission response was malformed: expected one JSON text block");
+	}
+	try {
+		return JSON.parse(content[0].text) as unknown;
+	} catch {
+		throw new Error("Cedia native permission response was malformed: invalid JSON");
+	}
+}
+
+function parsePermissionOutcome(
+	result: unknown,
+	options: readonly ClientBridgePermissionOption[],
+): ClientBridgePermissionOutcome {
+	const parsed = textOutcome(result);
+	if (!isRecord(parsed) || typeof parsed.outcome !== "string") {
+		throw new Error("Cedia native permission response was malformed: missing outcome");
+	}
+	if (parsed.outcome === "cancelled") return { outcome: "cancelled" };
+	if (parsed.outcome !== "selected" || typeof parsed.optionId !== "string" || parsed.optionId.length === 0) {
+		throw new Error("Cedia native permission response was malformed: expected selected or cancelled outcome");
+	}
+
+	const selected = options.find(option => option.optionId === parsed.optionId);
+	if (!selected) {
+		throw new Error(`Cedia native permission response selected unknown option ID: ${parsed.optionId}`);
+	}
+	if (parsed.kind !== undefined && (typeof parsed.kind !== "string" || parsed.kind !== selected.kind)) {
+		throw new Error(`Cedia native permission response kind does not match option ${selected.optionId}`);
+	}
+	if (!PERMISSION_OPTION_KINDS.has(selected.kind)) {
+		throw new Error(`Cedia native permission option has unsupported kind: ${String(selected.kind)}`);
+	}
+	return { outcome: "selected", optionId: selected.optionId, kind: selected.kind };
+}
+
+/**
+ * Create the RPC-backed `ClientBridge` used by an OMP session running in Cedia.
+ * The bridge forwards a JSON snapshot of the tool-call and options and
+ * accepts only the structured `{ outcome, optionId, kind }` response emitted by
+ * the host handler.
+ */
+export function createCediaPermissionBridge(
+	hostToolBridge: RpcHostToolBridge,
+	options: CediaPermissionBridgeOptions = {},
+): ClientBridge {
+	if (!(hostToolBridge instanceof RpcHostToolBridge)) {
+		throw new TypeError("Cedia permission bridge requires an RpcHostToolBridge");
+	}
+	const timeoutMs = normalizeTimeout(options.timeoutMs);
+	const bridge: ClientBridge = {
+		capabilities: { requestPermission: true },
+		requestPermission: async (
+			toolCall: ClientBridgePermissionToolCall,
+			permissionOptions: ClientBridgePermissionOption[],
+			signal?: AbortSignal,
+		): Promise<ClientBridgePermissionOutcome> => {
+			if (signal?.aborted) return { outcome: "cancelled" };
+			const snapshot = JSON.parse(JSON.stringify({ toolCall, options: permissionOptions })) as {
+				toolCall: ClientBridgePermissionToolCall;
+				options: ClientBridgePermissionOption[];
+			};
+			const combined = makeCombinedSignal(signal, timeoutMs);
+			try {
+				const result = await hostToolBridge.requestExecution(
+					CEDIA_NATIVE_PERMISSION_DEFINITION,
+					snapshot.toolCall.toolCallId,
+					{ kind: "permission", toolCall: snapshot.toolCall, options: snapshot.options },
+					combined.signal,
+				);
+				if (combined.isAborted()) return { outcome: "cancelled" };
+				return parsePermissionOutcome(result, snapshot.options);
+			} catch (error) {
+				if (combined.isAborted()) return { outcome: "cancelled" };
+				throw error;
+			} finally {
+				combined.dispose();
+			}
+		},
+	};
+	return bridge;
+}
+
+function nonEmptyString(value: unknown, field: string): string {
+	if (typeof value !== "string" || value.length === 0) {
+		throw new Error(`Cedia native editor response was malformed: ${field} must be a non-empty string`);
+	}
+	return value;
+}
+
+function sha256(value: unknown, field: string): string {
+	const text = nonEmptyString(value, field);
+	if (!/^[0-9a-fA-F]{64}$/.test(text)) {
+		throw new Error(`Cedia native editor response was malformed: ${field} must be a SHA-256 hex digest`);
+	}
+	return text;
+}
+
+function documentSnapshot(value: unknown): ClientBridgeEditorDocumentSnapshot {
+	if (!isRecord(value)) {
+		throw new Error("Cedia native editor response was malformed: document must be an object or null");
+	}
+	if (!isRecord(value.handle)) {
+		throw new Error("Cedia native editor response was malformed: document.handle must be an object");
+	}
+	const handle = {
+		id: nonEmptyString(value.handle.id, "document.handle.id"),
+		uri: nonEmptyString(value.handle.uri, "document.handle.uri"),
+	};
+	const documentVersion = value.documentVersion;
+	if (typeof documentVersion !== "number" || !Number.isSafeInteger(documentVersion) || documentVersion < 0) {
+		throw new Error(
+			"Cedia native editor response was malformed: document.documentVersion must be a non-negative integer",
+		);
+	}
+	if (typeof value.text !== "string") {
+		throw new Error("Cedia native editor response was malformed: document.text must be a string");
+	}
+	if (typeof value.dirty !== "boolean") {
+		throw new Error("Cedia native editor response was malformed: document.dirty must be a boolean");
+	}
+	return {
+		handle,
+		path: nonEmptyString(value.path, "document.path"),
+		text: value.text,
+		documentVersion,
+		sha256: sha256(value.sha256, "document.sha256"),
+		dirty: value.dirty,
+		...(typeof value.isUntitled === "boolean" ? { isUntitled: value.isUntitled } : {}),
+		...(typeof value.uri === "string" && value.uri.length > 0 ? { uri: value.uri } : {}),
+	};
+}
+
+function isMissingPathError(error: unknown): boolean {
+	return (
+		!!error &&
+		typeof error === "object" &&
+		"code" in error &&
+		((error as { code?: unknown }).code === "ENOENT" || (error as { code?: unknown }).code === "ENOTDIR")
+	);
+}
+
+/**
+ * Canonicalize paths whose final file may not exist yet. Native editors can
+ * own an untitled buffer below a symlinked workspace directory, so resolving
+ * only the complete path would incorrectly treat the response as a different
+ * document. Permission and other filesystem errors are propagated deliberately
+ * instead of being converted into a permissive lexical comparison.
+ */
+async function canonicalDocumentPath(inputPath: string): Promise<string> {
+	const lexical = path.resolve(inputPath);
+	let ancestor = lexical;
+	for (;;) {
+		try {
+			const realAncestor = await fs.realpath(ancestor);
+			return path.resolve(realAncestor, path.relative(ancestor, lexical));
+		} catch (error) {
+			if (!isMissingPathError(error)) throw error;
+		}
+		const parent = path.dirname(ancestor);
+		if (parent === ancestor) {
+			throw new Error("Cedia native editor path could not resolve an existing ancestor");
+		}
+		ancestor = parent;
+	}
+}
+
+function isUntitledEditorPath(path: string): boolean {
+	return path.startsWith("untitled:");
+}
+
+async function pathsReferToSameDocument(requestedPath: string, responsePath: string, untitled = false): Promise<boolean> {
+	if (requestedPath === responsePath) return true;
+	if (untitled || isUntitledEditorPath(requestedPath) || isUntitledEditorPath(responsePath)) {
+		return requestedPath === responsePath;
+	}
+	const [requested, response] = await Promise.all([
+		canonicalDocumentPath(requestedPath),
+		canonicalDocumentPath(responsePath),
+	]);
+	return requested === response;
+}
+
+async function parseEditorSnapshotResponse(
+	result: unknown,
+	requestedPath: string,
+): Promise<ClientBridgeEditorSnapshotResponse> {
+	const parsed = textOutcome(result);
+	if (!isRecord(parsed) || !("document" in parsed)) {
+		throw new Error("Cedia native editor response was malformed: missing document");
+	}
+	const document = parsed.document === null ? null : documentSnapshot(parsed.document);
+	if (document && !(await pathsReferToSameDocument(requestedPath, document.path, document.isUntitled === true))) {
+		throw new Error("Cedia native editor response was malformed: document.path does not match the requested path");
+	}
+	return {
+		document,
+		...(parsed.editorWorkspace === true ? { editorWorkspace: true } : {}),
+	};
+}
+
+async function parseEditorApplyResponse(
+	result: unknown,
+	requestedPath: string,
+): Promise<ClientBridgeEditorApplyResponse> {
+	const parsed = textOutcome(result);
+	if (!isRecord(parsed)) throw new Error("Cedia native editor response was malformed: expected an object");
+	if (typeof parsed.text !== "string") {
+		throw new Error("Cedia native editor response was malformed: apply.text must be a string");
+	}
+	if (parsed.saved !== false) {
+		throw new Error("Cedia native editor response was malformed: apply.saved must be false");
+	}
+	if (parsed.undoPreserved !== true) {
+		throw new Error("Cedia native editor response was malformed: apply.undoPreserved must be true");
+	}
+	const document = documentSnapshot(parsed.document);
+	if (!(await pathsReferToSameDocument(requestedPath, document.path, document.isUntitled === true))) {
+		throw new Error(
+			"Cedia native editor response was malformed: apply.document.path does not match the requested path",
+		);
+	}
+	return {
+		text: parsed.text,
+		document,
+		saved: false,
+		undoPreserved: true,
+	};
+}
+
+function cloneEditorGuardParams(params: {
+	path: string;
+	handle: { id: string; uri: string };
+	expectedVersion: number;
+	expectedHash: string;
+}): {
+	path: string;
+	handle: { id: string; uri: string };
+	expectedVersion: number;
+	expectedHash: string;
+} {
+	if (!isRecord(params) || typeof params.path !== "string" || params.path.length === 0) {
+		throw new TypeError("Cedia native editor request requires a non-empty path");
+	}
+	if (!isRecord(params.handle)) throw new TypeError("Cedia native editor request requires a handle");
+	const id = nonEmptyString(params.handle.id, "handle.id");
+	const uri = nonEmptyString(params.handle.uri, "handle.uri");
+	if (
+		typeof params.expectedVersion !== "number" ||
+		!Number.isSafeInteger(params.expectedVersion) ||
+		params.expectedVersion < 0
+	) {
+		throw new TypeError("Cedia native editor request requires a non-negative integer expectedVersion");
+	}
+	if (typeof params.expectedHash !== "string" || !/^[0-9a-fA-F]{64}$/.test(params.expectedHash)) {
+		throw new TypeError("Cedia native editor request requires a SHA-256 expectedHash");
+	}
+	return {
+		path: params.path,
+		handle: { id, uri },
+		expectedVersion: params.expectedVersion,
+		expectedHash: params.expectedHash,
+	};
+}
+
+async function parseEditorCreateResponse(
+	result: unknown,
+	requestedPath: string,
+): Promise<ClientBridgeEditorApplyResponse> {
+	const parsed = textOutcome(result);
+	if (!isRecord(parsed)) throw new Error("Cedia native editor response was malformed: expected an object");
+	if (parsed.saved !== false) {
+		throw new Error("Cedia native editor response was malformed: create.saved must be false");
+	}
+	if (parsed.undoPreserved !== true) {
+		throw new Error("Cedia native editor response was malformed: create.undoPreserved must be true");
+	}
+	const document = documentSnapshot(parsed.document);
+	if (!(await pathsReferToSameDocument(requestedPath, document.path, document.isUntitled === true))) {
+		throw new Error("Cedia native editor response was malformed: create.document.path does not match the requested path");
+	}
+	return { text: document.text, document, saved: false, undoPreserved: true };
+}
+
+function parseEditorDeleteResponse(result: unknown, requestedPath: string): { deleted: true; path: string; uri: string } {
+	const parsed = textOutcome(result);
+	if (!isRecord(parsed) || parsed.deleted !== true) {
+		throw new Error("Cedia native editor response was malformed: delete.deleted must be true");
+	}
+	const path = nonEmptyString(parsed.path, "delete.path");
+	const uri = nonEmptyString(parsed.uri, "delete.uri");
+	if (path !== requestedPath && uri !== requestedPath) {
+		throw new Error("Cedia native editor response was malformed: delete.path does not match the requested path");
+	}
+	return { deleted: true, path, uri };
+}
+
+async function parseEditorMoveResponse(
+	result: unknown,
+	destination: string,
+): Promise<ClientBridgeEditorApplyResponse> {
+	const parsed = textOutcome(result);
+	if (!isRecord(parsed)) throw new Error("Cedia native editor response was malformed: expected an object");
+	if (parsed.saved !== false) {
+		throw new Error("Cedia native editor response was malformed: move.saved must be false");
+	}
+	if (parsed.undoPreserved !== true) {
+		throw new Error("Cedia native editor response was malformed: move.undoPreserved must be true");
+	}
+	const document = documentSnapshot(parsed.document);
+	if (!(await pathsReferToSameDocument(destination, document.path, document.isUntitled === true))) {
+		throw new Error("Cedia native editor response was malformed: move.document.path does not match the destination");
+	}
+	return { text: document.text, document, saved: false, undoPreserved: true };
+}
+
+function cloneEditorApplyParams(params: ClientBridgeEditorApplyParams): ClientBridgeEditorApplyParams {
+	if (!isRecord(params) || typeof params.path !== "string" || params.path.length === 0) {
+		throw new TypeError("Cedia native editor apply requires a non-empty path");
+	}
+	if (!isRecord(params.handle)) throw new TypeError("Cedia native editor apply requires a handle");
+	const id = nonEmptyString(params.handle.id, "handle.id");
+	const uri = nonEmptyString(params.handle.uri, "handle.uri");
+	if (typeof params.content !== "string") throw new TypeError("Cedia native editor apply requires string content");
+	if (
+		typeof params.expectedVersion !== "number" ||
+		!Number.isSafeInteger(params.expectedVersion) ||
+		params.expectedVersion < 0
+	) {
+		throw new TypeError("Cedia native editor apply requires a non-negative integer expectedVersion");
+	}
+	if (typeof params.expectedHash !== "string" || !/^[0-9a-fA-F]{64}$/.test(params.expectedHash)) {
+		throw new TypeError("Cedia native editor apply requires a SHA-256 expectedHash");
+	}
+	return JSON.parse(
+		JSON.stringify({
+			path: params.path,
+			handle: { id, uri },
+			expectedVersion: params.expectedVersion,
+			expectedHash: params.expectedHash,
+			content: params.content,
+		}),
+	) as ClientBridgeEditorApplyParams;
+}
+
+/**
+ * Create Cedia's guarded native editor capability. A missing document is a
+ * deliberate result (the path was never owned by a native editor) and is
+ * represented by `null`; transport, validation, and host errors reject so a
+ * caller cannot accidentally fall back to stale on-disk bytes.
+ */
+export function createCediaEditorBridge(
+	hostToolBridge: RpcHostToolBridge,
+	options: CediaPermissionBridgeOptions = {},
+): ClientBridge {
+	if (!(hostToolBridge instanceof RpcHostToolBridge)) {
+		throw new TypeError("Cedia editor bridge requires an RpcHostToolBridge");
+	}
+	const timeoutMs = normalizeTimeout(options.timeoutMs ?? CEDIA_NATIVE_EDITOR_TIMEOUT_MS);
+	const nativeEditor: ClientBridgeNativeEditor = {
+		applyDisk: async (params, parentSignal) => {
+			if (
+				!isRecord(params) ||
+				typeof params.path !== "string" ||
+				!path.isAbsolute(params.path) ||
+				typeof params.expectedCanonicalPath !== "string" ||
+				!path.isAbsolute(params.expectedCanonicalPath) ||
+				typeof params.expectedText !== "string" ||
+				typeof params.content !== "string" ||
+				Buffer.byteLength(params.expectedText) > 8 * 1024 * 1024 ||
+				Buffer.byteLength(params.content) > 8 * 1024 * 1024
+			)
+				throw new Error("Invalid guarded Cedia disk apply");
+			const snapshot = {
+				path: params.path,
+				expectedCanonicalPath: params.expectedCanonicalPath,
+				expectedText: params.expectedText,
+				content: params.content,
+			};
+			const combined = makeCombinedSignal(parentSignal, timeoutMs);
+			try {
+				const raw = await hostToolBridge.requestExecution(
+					CEDIA_NATIVE_EDITOR_DEFINITION,
+					`cedia_disk_apply:${snapshot.path}`,
+					{ kind: "apply_disk", ...snapshot },
+					combined.signal,
+				);
+				if (combined.isAborted())
+					throw new Error("Cedia disk apply timed out or was cancelled; outcome may have applied");
+				const result = textOutcome(raw);
+				if (
+					!isRecord(result) ||
+					result.saved !== true ||
+					result.text !== snapshot.content ||
+					result.canonicalPath !== snapshot.expectedCanonicalPath
+				)
+					throw new Error("Cedia disk apply outcome is unknown; inspect before retrying");
+				return { text: snapshot.content, saved: true, canonicalPath: snapshot.expectedCanonicalPath };
+			} finally {
+				combined.dispose();
+			}
+		},
+		snapshot: async ({ path: target }, parentSignal) => {
+			const combined = makeCombinedSignal(parentSignal, timeoutMs);
+			try {
+				const result = await hostToolBridge.requestExecution(
+					CEDIA_NATIVE_EDITOR_DEFINITION,
+					`cedia_editor_snapshot:${target}`,
+					{ kind: "snapshot", path: target },
+					combined.signal,
+				);
+				if (combined.isAborted())
+					throw new Error("Cedia native editor snapshot request timed out or was cancelled");
+				return parseEditorSnapshotResponse(result, target);
+			} finally {
+				combined.dispose();
+			}
+		},
+		apply: async (params, parentSignal) => {
+			const snapshot = cloneEditorApplyParams(params);
+			const combined = makeCombinedSignal(parentSignal, timeoutMs);
+			try {
+				const result = await hostToolBridge.requestExecution(
+					CEDIA_NATIVE_EDITOR_DEFINITION,
+					`cedia_editor_apply:${snapshot.path}`,
+					{ kind: "apply", ...snapshot },
+					combined.signal,
+				);
+				if (combined.isAborted()) throw new Error("Cedia native editor apply request timed out or was cancelled");
+				return parseEditorApplyResponse(result, snapshot.path);
+			} finally {
+				combined.dispose();
+			}
+		},
+		create: async (params, parentSignal) => {
+			if (!isRecord(params) || typeof params.path !== "string" || params.path.length === 0) {
+				throw new TypeError("Cedia native editor create requires a non-empty path");
+			}
+			if (params.content !== undefined && typeof params.content !== "string") {
+				throw new TypeError("Cedia native editor create requires string content");
+			}
+			const payload = { path: params.path, ...(typeof params.content === "string" ? { content: params.content } : {}) };
+			const combined = makeCombinedSignal(parentSignal, timeoutMs);
+			try {
+				const result = await hostToolBridge.requestExecution(
+					CEDIA_NATIVE_EDITOR_DEFINITION,
+					`cedia_editor_create:${payload.path}`,
+					{ kind: "create", ...payload },
+					combined.signal,
+				);
+				if (combined.isAborted()) throw new Error("Cedia native editor create request timed out or was cancelled");
+				return parseEditorCreateResponse(result, payload.path);
+			} finally {
+				combined.dispose();
+			}
+		},
+		delete: async (params, parentSignal) => {
+			const snapshot = cloneEditorGuardParams(params);
+			const combined = makeCombinedSignal(parentSignal, timeoutMs);
+			try {
+				const result = await hostToolBridge.requestExecution(
+					CEDIA_NATIVE_EDITOR_DEFINITION,
+					`cedia_editor_delete:${snapshot.path}`,
+					{ kind: "delete", ...snapshot },
+					combined.signal,
+				);
+				if (combined.isAborted()) throw new Error("Cedia native editor delete request timed out or was cancelled");
+				return parseEditorDeleteResponse(result, snapshot.path);
+			} finally {
+				combined.dispose();
+			}
+		},
+		move: async (params, parentSignal) => {
+			if (!isRecord(params) || typeof params.destination !== "string" || params.destination.length === 0) {
+				throw new TypeError("Cedia native editor move requires a destination");
+			}
+			const snapshot = { ...cloneEditorGuardParams(params), destination: params.destination };
+			const combined = makeCombinedSignal(parentSignal, timeoutMs);
+			try {
+				const result = await hostToolBridge.requestExecution(
+					CEDIA_NATIVE_EDITOR_DEFINITION,
+					`cedia_editor_move:${snapshot.path}`,
+					{ kind: "move", ...snapshot },
+					combined.signal,
+				);
+				if (combined.isAborted()) throw new Error("Cedia native editor move request timed out or was cancelled");
+				return parseEditorMoveResponse(result, snapshot.destination);
+			} finally {
+				combined.dispose();
+			}
+		},
+	};
+	return { capabilities: { nativeEditor: true }, nativeEditor };
+}
+
+/** Compose independent Cedia bridge capabilities without exposing hidden
+ * host-tool definitions to the model. This is used when editor and native
+ * permission flags are enabled together (or when only the editor flag is
+ * enabled but native operations still need the permission gate). */
+export function composeCediaClientBridges(...bridges: Array<ClientBridge | undefined>): ClientBridge | undefined {
+	const active = bridges.filter((bridge): bridge is ClientBridge => bridge !== undefined);
+	if (active.length === 0) return undefined;
+	const capabilities = active.reduce<ClientBridge["capabilities"]>(
+		(result, bridge) => ({ ...result, ...bridge.capabilities }),
+		{},
+	);
+	const composed: ClientBridge = {
+		capabilities,
+		...(active.some(bridge => bridge.deferAgentInitiatedTurns) ? { deferAgentInitiatedTurns: true } : {}),
+	};
+	for (const bridge of active) {
+		if (!composed.readTextFile && bridge.readTextFile) composed.readTextFile = bridge.readTextFile.bind(bridge);
+		if (!composed.writeTextFile && bridge.writeTextFile) composed.writeTextFile = bridge.writeTextFile.bind(bridge);
+		if (!composed.createTerminal && bridge.createTerminal)
+			composed.createTerminal = bridge.createTerminal.bind(bridge);
+		if (!composed.requestPermission && bridge.requestPermission)
+			composed.requestPermission = bridge.requestPermission.bind(bridge);
+		if (!composed.nativeEditor && bridge.nativeEditor) composed.nativeEditor = bridge.nativeEditor;
+	}
+	return composed;
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-context-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-context-bridge.ts
new file mode 100644
index 0000000000..b9887699aa
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-context-bridge.ts
@@ -0,0 +1,92 @@
+/**
+ * Cedia's context projection for OMP RPC mode (plan §8.2 O09).
+ *
+ * The context window is OMP's own accounting: `getContextBreakdown` splits what the next request
+ * would carry into the base prompt, the tools, the discovered context, the skills and the messages,
+ * and `getContextUsage` reports the same number against the model's window. This module only
+ * projects those numbers plus the runtime's own maintenance state, so a Cedia drawer cannot invent
+ * a token count or a compaction state:
+ *
+ * - the breakdown is answered as it is, or omitted when the session cannot compute it (no model, an
+ *   unanchored window) - never as zeroes that would read like an empty context;
+ * - `compacting` is the runtime's live manual/automatic maintenance flag and `speculation` is its
+ *   background speculative-compaction state, both read at the moment of the answer;
+ * - the two bounded controls are OMP's own operations. `drop-images` strips image content and
+ *   persists the rewrite, and `abort-compaction` requests a cancel and then reports the state that
+ *   actually follows, so a client is never told a compaction stopped when it did not.
+ */
+import type { AgentSession } from "../../session/agent-session";
+import type { ShakeMode, ShakeResult } from "../../session/shake-types";
+import type { RpcCediaContextData, RpcCediaContextUsage } from "./rpc-types";
+
+/** The shake strategies OMP defines; a mode outside this list is refused before any work runs. */
+export const CEDIA_SHAKE_MODES: readonly ShakeMode[] = ["elide", "images", "thinking"];
+
+/** Reduce the runtime's own breakdown to the fields a client may draw. */
+function usageOf(breakdown: ReturnType<AgentSession["getContextBreakdown"]>): RpcCediaContextUsage | undefined {
+	if (!breakdown) return undefined;
+	return {
+		contextWindow: breakdown.contextWindow,
+		anchored: breakdown.anchored,
+		usedTokens: breakdown.usedTokens,
+		systemPromptTokens: breakdown.systemPromptTokens,
+		systemToolsTokens: breakdown.systemToolsTokens,
+		systemContextTokens: breakdown.systemContextTokens,
+		skillsTokens: breakdown.skillsTokens,
+		messagesTokens: breakdown.messagesTokens,
+	};
+}
+
+/** The session's context accounting and maintenance state, as one snapshot. */
+export function readCediaContext(session: AgentSession): RpcCediaContextData {
+	const breakdown = usageOf(session.getContextBreakdown());
+	return {
+		...(breakdown === undefined ? {} : { usage: breakdown }),
+		compacting: session.isCompacting,
+		speculation: session.compactionSpeculation,
+	};
+}
+
+/**
+ * Strip image content from the current branch, as the runtime's own operation does.
+ *
+ * The answer carries the state that follows next to `removed`, so a client re-reads the context it
+ * just changed from this one answer instead of a second round trip that could observe a later state.
+ */
+export async function dropCediaContextImages(
+	session: AgentSession,
+): Promise<ReturnType<typeof readCediaContext> & { removed: number }> {
+	const { removed } = await session.dropImages();
+	return { ...readCediaContext(session), removed };
+}
+
+/**
+ * Request a cancel of active manual, automatic and handoff maintenance, then answer the maintenance
+ * state that follows. The request itself is not evidence that compaction stopped, so the answer
+ * carries the re-read state instead of a claim.
+ */
+export function abortCediaCompaction(session: AgentSession): RpcCediaContextData {
+	session.abortCompaction("cedia: context control");
+	return readCediaContext(session);
+}
+
+/**
+ * Reduce stored context with one of the runtime's own shake strategies.
+ *
+ * The answer is the runtime's own `ShakeResult` unchanged: it already carries counts and reclaimed
+ * tokens rather than content, and it names the session artifact holding the dropped originals when
+ * one was written, which is what makes this a bounded, reviewable action instead of a silent delete.
+ * `mode` is checked here as well as by the caller, so a strategy the runtime does not define can
+ * never reach `shake()`.
+ */
+export async function shakeCediaContext(
+	session: AgentSession,
+	mode: ShakeMode,
+): Promise<{ shake: ShakeResult } & RpcCediaContextData> {
+	if (!CEDIA_SHAKE_MODES.includes(mode)) throw new Error(`Unknown shake mode: ${String(mode)}`);
+	const shake = await session.shake(mode);
+	// The answer carries the context that follows beside the runtime's own result, so a client shows
+	// the reduced window and what was dropped from one response instead of a second read that could
+	// observe a later state.
+	return { ...readCediaContext(session), shake };
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-credits-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-credits-bridge.ts
new file mode 100644
index 0000000000..b79891c0b8
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-credits-bridge.ts
@@ -0,0 +1,116 @@
+/**
+ * Cedia's saved-reset projection and the one redeem it is allowed to make (plan §8.2 O03).
+ *
+ * A saved Codex reset is a scarce, perishable credit. OMP spends them on its own in two places
+ * (the blocked-account pass and the expiring-credit sweep), and Cedia's policy layer turns both off
+ * for a process it started - see `cedia-policy.ts`. This module is the other half of that rule: the
+ * *owner* can still spend one, and only by asking for it twice.
+ *
+ * - `credits.get` is the read: each stored account OMP knows about, its live available count, its
+ *   credits reduced to identity, status and expiry (never a token or a key), whether it is the
+ *   session's active account, and the account's own error string when its token refresh or listing
+ *   failed - a failure is reported, never flattened into "zero credits".
+ * - `credits.redeem` is the write, and it carries a wire-level confirmation: the payload must name
+ *   the account *and* set `confirm: true`. A client that forgets the flag is refused before any
+ *   provider call, so "explicitly confirmed" is a property of the request rather than a convention
+ *   only a user interface follows. The outcome is OMP's own code (`reset`, `already_redeemed`,
+ *   `no_credit`, `nothing_to_reset`, `no_account`, …) and is never translated into a friendlier lie.
+ */
+import type { AgentSession } from "../../session/agent-session";
+import type { ResetCreditTarget } from "../../session/auth-storage";
+import type { RpcCediaCreditsData, RpcCediaResetCredit } from "./rpc-types";
+
+/** Bound on how many accounts and credits one answer carries. */
+export const CEDIA_CREDITS_MAX_ITEMS = 20;
+
+/** One account row as the runtime reports it, reduced to what a client may draw. */
+function accountRow(account: {
+	credentialId?: number;
+	accountId?: string;
+	email?: string;
+	availableCount: number;
+	credits: readonly {
+		id: string;
+		resetType?: string;
+		status?: string;
+		grantedAt?: string;
+		expiresAt?: string;
+		title?: string;
+		description?: string;
+	}[];
+	active: boolean;
+	error?: string;
+}): RpcCediaCreditsData["accounts"][number] {
+	return {
+		...(account.credentialId === undefined ? {} : { credentialId: account.credentialId }),
+		...(account.accountId === undefined ? {} : { accountId: account.accountId }),
+		...(account.email === undefined ? {} : { email: account.email }),
+		availableCount: account.availableCount,
+		credits: account.credits.slice(0, CEDIA_CREDITS_MAX_ITEMS).map(credit => {
+			const row: RpcCediaResetCredit = {
+				id: credit.id,
+				...(credit.resetType === undefined ? {} : { resetType: credit.resetType }),
+				...(credit.status === undefined ? {} : { status: credit.status }),
+				...(credit.grantedAt === undefined ? {} : { grantedAt: credit.grantedAt }),
+				...(credit.expiresAt === undefined ? {} : { expiresAt: credit.expiresAt }),
+				...(credit.title === undefined ? {} : { title: credit.title }),
+				...(credit.description === undefined ? {} : { description: credit.description }),
+			};
+			return row;
+		}),
+		active: account.active,
+		...(account.error === undefined ? {} : { error: account.error }),
+	};
+}
+
+/** Every stored account's live saved-reset status, as OMP lists it. */
+export async function readCediaCredits(session: AgentSession): Promise<RpcCediaCreditsData> {
+	try {
+		const accounts = await session.listResetCredits();
+		return { accounts: accounts.slice(0, CEDIA_CREDITS_MAX_ITEMS).map(accountRow) };
+	} catch (error) {
+		// A listing that failed is not "no credits": the runtime's own message travels instead.
+		return { accounts: [], unavailable: error instanceof Error ? error.message : String(error) };
+	}
+}
+
+/**
+ * The account a redeem names: credential plus provider, as `ResetCreditTarget` requires.
+ *
+ * `provider` defaults to `"openai-codex"` — the saved-reset program this bridge existed for
+ * before per-provider listings arrived — but a client that lists (and sees per-account
+ * providers) names it explicitly instead of inheriting a guess.
+ */
+export interface CediaRedeemTarget {
+	readonly provider?: string;
+	readonly credentialId?: number;
+	readonly accountId?: string;
+	readonly email?: string;
+}
+
+/**
+ * Spend one saved reset for one account, and answer OMP's own outcome.
+ *
+ * The caller must have named the account and confirmed; this function does not ask again, because a
+ * runtime has no one to ask - the confirmation is what makes the request admissible in the first
+ * place, and it is checked by the bridge before this runs.
+ */
+export async function redeemCediaResetCredit(
+	session: AgentSession,
+	target: CediaRedeemTarget,
+): Promise<RpcCediaCreditsData["lastRedeem"]> {
+	const resolved: ResetCreditTarget = {
+		provider: target.provider ?? "openai-codex",
+		credentialId: target.credentialId ?? 0,
+		...(target.accountId === undefined ? {} : { accountId: target.accountId }),
+		...(target.email === undefined ? {} : { email: target.email }),
+	};
+	const outcome = await session.redeemResetCredit(resolved);
+	return {
+		ok: outcome.ok,
+		code: outcome.code,
+		...(outcome.accountId === undefined ? {} : { accountId: outcome.accountId }),
+		...(outcome.email === undefined ? {} : { email: outcome.email }),
+		...(outcome.creditId === undefined ? {} : { creditId: outcome.creditId }),
+	};
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-extensions-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-extensions-bridge.ts
new file mode 100644
index 0000000000..06e0bafe6f
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-extensions-bridge.ts
@@ -0,0 +1,147 @@
+/**
+ * Cedia's extension-catalog projection for OMP RPC mode (plan §8.2 O06).
+ *
+ * This is the read half of extension management: it answers the extension records the
+ * runtime discovers for the session project plus the live root policy, so a client can
+ * draw an honest catalog instead of guessing. It performs no enable/disable and starts
+ * no discovery pass beyond the load itself:
+ *
+ * - records come from the same `loadAllExtensions` the dashboard builds its rows from,
+ *   with the session's own `disabledExtensions` setting applied, so the states match;
+ * - roots come from the session's own `effectiveExtensionRoots` (explicit, mode,
+ *   configured layer) — the policy custom roots would arrive through, which stays open;
+ * - the wire carries identity, kind, display strings, source layer, state and reasons
+ *   only. The records' `raw` discovery bag stays in the runtime: for `mcp` rows it holds
+ *   the discovered server config, which a list probe must never carry.
+ *
+ * Enabling, disabling and custom roots change what a (re)started session discovers;
+ * they are a separate management surface with their own gate.
+ */
+import type { AgentSession } from "../../session/agent-session";
+import { getMCPConfigPath } from "@oh-my-pi/pi-utils";
+import { cfgDisabledExtensions } from "../../extensibility/settings";
+import { cfgMcpEnableProjectConfig } from "../../mcp/settings";
+import { setMcpServerEnabled } from "../../mcp/config-writer";
+import { applyMcpToggleRuntime, type MCPToggleManager } from "../components/extensions/mcp-runtime";
+import { loadAllExtensions } from "../components/extensions/state-manager";
+import type { RpcCediaExtensionData } from "./rpc-types";
+
+/** Largest extension description a list answer may carry per row. */
+export const CEDIA_EXTENSIONS_DESCRIPTION_MAX_CHARS = 500;
+
+/** Largest extension list an answer may carry. */
+export const CEDIA_EXTENSIONS_MAX_ROWS = 500;
+
+/** Read the session's own extension records for the Cedia wire. */
+export async function readCediaExtensions(session: AgentSession): Promise<RpcCediaExtensionData> {
+	const cwd = session.sessionManager.getCwd();
+	const disabled = cfgDisabledExtensions.get(session.settings);
+	const disabledIds = Array.isArray(disabled) ? disabled.filter((entry): entry is string => typeof entry === "string") : [];
+	const records = await loadAllExtensions(cwd, disabledIds);
+	const roots = session.effectiveExtensionRoots;
+	const extensions = [];
+	for (const record of records.slice(0, CEDIA_EXTENSIONS_MAX_ROWS)) {
+		if (!record || typeof record.id !== "string" || record.id.trim().length === 0) continue;
+		const description = typeof record.description === "string" ? record.description : "";
+		extensions.push({
+			id: record.id,
+			kind: record.kind,
+			name: typeof record.name === "string" ? record.name : record.id,
+			displayName: typeof record.displayName === "string" && record.displayName.trim().length > 0 ? record.displayName : record.id,
+			description: description.slice(0, CEDIA_EXTENSIONS_DESCRIPTION_MAX_CHARS),
+			descriptionTruncated: description.length > CEDIA_EXTENSIONS_DESCRIPTION_MAX_CHARS,
+			path: typeof record.path === "string" ? record.path : "",
+			source: {
+				provider: String(record.source?.provider ?? "unknown"),
+				providerName: String(record.source?.providerName ?? record.source?.provider ?? "unknown"),
+				level: record.source?.level ?? "project",
+			},
+			state: record.state,
+			...(record.disabledReason === undefined ? {} : { disabledReason: String(record.disabledReason) }),
+			...(record.shadowedBy === undefined ? {} : { shadowedBy: String(record.shadowedBy) }),
+		});
+	}
+	return {
+		roots: {
+			explicit: [...roots.explicit],
+			mode: roots.mode,
+			configured: [...roots.configured],
+			configuredLevel: roots.configuredLevel,
+		},
+		extensions,
+		truncated: records.length > CEDIA_EXTENSIONS_MAX_ROWS,
+		total: records.length,
+	};
+}
+
+/** Terminal owner surface the toggle reads the live MCP manager from, when negotiated. */
+export type CediaExtensionsMode = {
+	readonly mcpManager?: MCPToggleManager;
+};
+
+/**
+ * Enable or disable one extension by id, mirroring the dashboard's toggle paths.
+ *
+ * MCP rows persist through the canonical mcp.json writer and apply to the live manager
+ * (disconnect on disable; re-enable does not auto-connect — startup/reload still owns
+ * that, exactly like the terminal). Every other row persists through the session's own
+ * `disabledExtensions` setting. Shadowed rows are refused: they must not be toggleable.
+ * Answers the catalog that follows so the caller shows what the runtime applied.
+ */
+export async function setCediaExtensionEnabled(
+	session: AgentSession,
+	mode: CediaExtensionsMode | undefined,
+	id: string,
+	enabled: boolean,
+): Promise<RpcCediaExtensionData> {
+	const name = id.trim();
+	if (name.length === 0) throw new Error("Cedia extension toggle needs an extension id");
+	const cwd = session.sessionManager.getCwd();
+	const records = await loadAllExtensions(cwd, readDisabledIds(session));
+	const record = records.find(entry => entry.id === name);
+	if (!record) throw new Error(`Unknown extension: ${name}`);
+	if (record.state === "shadowed" || record.shadowedBy) {
+		throw new Error(`Extension ${name} is shadowed and cannot be toggled.`);
+	}
+	if (record.kind === "mcp") {
+		const server = name.startsWith("mcp:") ? name.slice("mcp:".length) : name;
+		await setMcpServerEnabled({
+			userPath: getMCPConfigPath("user", cwd),
+			projectPath: getMCPConfigPath("project", cwd),
+			name: server,
+			enabled,
+		});
+		const enableProjectConfig = cfgMcpEnableProjectConfig.get(session.settings);
+		await applyMcpToggleRuntime({
+			name: server,
+			enabled,
+			cwd,
+			manager: mode?.mcpManager,
+			session: { refreshMCPTools: tools => session.refreshMCPTools(tools) },
+			discovery: {
+				enableProjectConfig: enableProjectConfig === undefined ? true : enableProjectConfig === true,
+				filterExa: true,
+				filterBrowser: session.getEvalPreludes().some(definition => definition.name === "browser"),
+			},
+		});
+	} else {
+		const disabled = readDisabledIds(session);
+		const index = disabled.indexOf(name);
+		if (enabled && index !== -1) {
+			disabled.splice(index, 1);
+			cfgDisabledExtensions.set(session.settings, disabled);
+			await session.settings.flush();
+		} else if (!enabled && index === -1) {
+			disabled.push(name);
+			cfgDisabledExtensions.set(session.settings, disabled);
+			await session.settings.flush();
+		}
+	}
+	return readCediaExtensions(session);
+}
+
+function readDisabledIds(session: AgentSession): string[] {
+	const raw = cfgDisabledExtensions.get(session.settings);
+	if (!Array.isArray(raw)) return [];
+	return raw.filter((entry): entry is string => typeof entry === "string");
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-goal-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-goal-bridge.ts
new file mode 100644
index 0000000000..7e7d72a798
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-goal-bridge.ts
@@ -0,0 +1,319 @@
+/**
+ * Cedia's goal-mode bridge for OMP RPC mode (plan §8.2 O07).
+ *
+ * Goal mode is OMP's own: the objective, its status, its budget and its continuation are the
+ * runtime's state, and this bridge is a thin adapter so a client that is not the terminal UI can
+ * read it and ask for the same transitions `/goal` performs. Every gate the terminal UI applies is
+ * applied here as well, because a client-side control must not be able to bypass the runtime's
+ * lifecycle rules - entering goal mode while plan mode is active, or while goal mode is disabled
+ * in settings, is refused with the runtime's own reason.
+ *
+ * The continuation turn is opt-in exactly as it is for the terminal: OMP's own
+ * `goal.continuationModes` setting decides which run modes may auto-continue between turns, and
+ * this bridge answers to the `rpc` entry. With the shipped default (`["interactive"]`) a goal set
+ * from Cedia is an objective the agent pursues within the turns the owner sends, and nothing runs
+ * on its own.
+ */
+import type { AgentSession } from "../../session/agent-session";
+import type { RpcCediaGoalData, RpcCediaGoalRecord } from "./rpc-types";
+import { cfgGoalContinuationModes, cfgGoalEnabled } from "../../goals/settings";
+import type { GoalModeState } from "../../goals/state";
+
+/** Ready-frame value for the goal bridge. */
+export const CEDIA_GOAL_BRIDGE_VERSION = 1;
+
+/** The run-mode name the continuation opt-in is written under. */
+export const CEDIA_GOAL_CONTINUATION_MODE = "rpc";
+
+/** The tool OMP's own goal mode exposes while a goal is being pursued. */
+const GOAL_MODE_TOOL = "goal";
+
+/** Delay before a continuation turn, matching the terminal's own idle window. */
+const CONTINUATION_DELAY_MS = 800;
+
+export interface CediaGoalCommand {
+	readonly op: "get" | "set" | "replace" | "pause" | "resume" | "drop" | "complete" | "budget";
+	readonly objective?: string;
+	readonly tokenBudget?: number;
+}
+
+export interface CediaGoalBridgeOptions {
+	readonly session: AgentSession;
+	/** Report a failure a client cannot see any other way, never a silent one. */
+	readonly onError: (message: string) => void;
+}
+
+export interface CediaGoalBridge {
+	/** Run one operation and answer the runtime's own state after it. */
+	run(command: CediaGoalCommand): Promise<RpcCediaGoalData>;
+	/** Stop any scheduled continuation and release the subscription. */
+	dispose(): void;
+}
+
+/** OMP's goal record as the wire sees it: every field the runtime holds, nothing derived. */
+function goalRecord(state: GoalModeState | undefined): RpcCediaGoalRecord | null {
+	if (!state?.goal) return null;
+	const goal = state.goal;
+	return {
+		id: goal.id,
+		objective: goal.objective,
+		status: goal.status,
+		...(goal.tokenBudget === undefined ? {} : { tokenBudget: goal.tokenBudget }),
+		tokensUsed: goal.tokensUsed,
+		timeUsedSeconds: goal.timeUsedSeconds,
+		createdAt: goal.createdAt,
+		updatedAt: goal.updatedAt,
+	};
+}
+
+/** The whole of the runtime's goal state, as one reply shape every operation answers with. */
+export function readCediaGoal(session: AgentSession): RpcCediaGoalData {
+	const state = session.getGoalModeState();
+	return {
+		enabled: state?.enabled === true,
+		...(state?.mode === undefined ? {} : { mode: state.mode }),
+		...(state?.reason === undefined ? {} : { reason: state.reason }),
+		goal: goalRecord(state),
+	};
+}
+
+function goalFromModeData(modeData: Record<string, unknown> | undefined): GoalModeState["goal"] | undefined {
+	const value = modeData?.goal;
+	if (!value || typeof value !== "object" || Array.isArray(value)) return undefined;
+	const goal = value as Record<string, unknown>;
+	if (
+		typeof goal.id !== "string" ||
+		typeof goal.objective !== "string" ||
+		!(["active", "paused", "budget-limited", "complete", "dropped"] as const).includes(goal.status as never) ||
+		typeof goal.tokensUsed !== "number" ||
+		typeof goal.timeUsedSeconds !== "number" ||
+		typeof goal.createdAt !== "number" ||
+		typeof goal.updatedAt !== "number"
+	) return undefined;
+	return {
+		id: goal.id,
+		objective: goal.objective,
+		status: goal.status as GoalModeState["goal"]["status"],
+		...(typeof goal.tokenBudget === "number" ? { tokenBudget: goal.tokenBudget } : {}),
+		tokensUsed: goal.tokensUsed,
+		timeUsedSeconds: goal.timeUsedSeconds,
+		createdAt: goal.createdAt,
+		updatedAt: goal.updatedAt,
+	};
+}
+
+/**
+ * Build the bridge.
+ *
+ * The bridge keeps the tool set a goal-mode entry replaced, so leaving goal mode restores exactly
+ * what the session had before instead of guessing a default tool list.
+ */
+export function createCediaGoalBridge(options: CediaGoalBridgeOptions): CediaGoalBridge {
+	const { session, onError } = options;
+	let previousTools: string[] | undefined;
+	let continuationTimer: ReturnType<typeof setTimeout> | undefined;
+	let disposed = false;
+	let hydrated = false;
+
+	const cancelContinuation = (): void => {
+		if (continuationTimer === undefined) return;
+		clearTimeout(continuationTimer);
+		continuationTimer = undefined;
+	};
+
+	const enterGoalMode = async (state: GoalModeState): Promise<void> => {
+		if (previousTools === undefined) {
+			const enabled = session.getEnabledToolNames().filter(name => name !== GOAL_MODE_TOOL);
+			previousTools = enabled;
+		}
+		await session.setActiveToolsByName([...new Set([...previousTools, GOAL_MODE_TOOL])]);
+		session.setGoalModeState(state);
+	};
+
+	const leaveGoalMode = async (state: GoalModeState | undefined): Promise<void> => {
+		const restore = previousTools;
+		previousTools = undefined;
+		cancelContinuation();
+		session.setGoalModeState(state);
+		if (restore !== undefined) await session.setActiveToolsByName(restore);
+	};
+
+	/**
+	 * Schedule the continuation turn OMP asks for.
+	 *
+	 * Only a mode named in `goal.continuationModes` may auto-continue, so a client that has not
+	 * opted in never starts a turn the owner did not ask for - including after a restart, where the
+	 * setting is read again rather than remembered.
+	 */
+	const scheduleContinuation = (): void => {
+		if (disposed) return;
+		cancelContinuation();
+		const modes = cfgGoalContinuationModes.get(session.settings);
+		if (!Array.isArray(modes) || !modes.includes(CEDIA_GOAL_CONTINUATION_MODE)) return;
+		if (session.getPlanModeState()?.enabled) return;
+		const state = session.getGoalModeState();
+		if (!state?.enabled || state.goal.status !== "active") return;
+		if (session.isStreaming || session.isCompacting || session.hasPostPromptWork) return;
+		const prompt = session.goalRuntime.buildContinuationPrompt();
+		if (!prompt) return;
+		continuationTimer = setTimeout(() => {
+			continuationTimer = undefined;
+			if (disposed) return;
+			// The delay can outlive the idle window that scheduled it: a turn that started in the
+			// meantime must not receive this prompt as a second, unqueued submission.
+			if (session.isStreaming || session.isCompacting || session.hasPostPromptWork) return;
+			const latest = session.getGoalModeState();
+			if (!latest?.enabled || latest.goal.status !== "active") return;
+			void session
+				.sendCustomMessage({ customType: "goal-continuation", content: prompt, display: false }, { deliverAs: "nextTurn", triggerTurn: true })
+				.catch(error => onError(error instanceof Error ? error.message : String(error)));
+		}, CONTINUATION_DELAY_MS);
+		continuationTimer.unref?.();
+	};
+
+	const unsubscribe = session.subscribe(event => {
+		if (event.type !== "agent_end") return;
+		scheduleContinuation();
+	});
+
+	const restorePersistedGoal = async (): Promise<void> => {
+		if (hydrated) return;
+		const context = session.sessionManager.buildSessionContext();
+		if (context.mode !== "goal" && context.mode !== "goal_paused") {
+			hydrated = true;
+			return;
+		}
+		if (cfgGoalEnabled.get(session.settings) !== true) {
+			session.goalRuntime.clearAccounting();
+			session.sessionManager.appendModeChange("none");
+			hydrated = true;
+			return;
+		}
+		const goal = goalFromModeData(context.modeData);
+		if (!goal) {
+			session.sessionManager.appendModeChange("none");
+			hydrated = true;
+			return;
+		}
+		session.setGoalModeState({ enabled: context.mode === "goal", mode: "active", goal });
+		const restored = await session.goalRuntime.onThreadResumed();
+		if (restored?.goal) {
+			const enabled = session.getEnabledToolNames().filter(name => name !== GOAL_MODE_TOOL);
+			previousTools = enabled;
+			await session.setActiveToolsByName([...new Set([...enabled, GOAL_MODE_TOOL])]);
+			session.setGoalModeState(restored);
+		}
+		hydrated = true;
+	};
+
+	/** Every transition that changes which mode the session is in cancels a pending continuation. */
+	const refuseWhileOtherMode = (action: string): string | undefined => {
+		if (session.getPlanModeState()?.enabled) return `Cannot ${action} while plan mode is active. Exit plan mode first.`;
+		if (session.getVibeModeState()?.enabled) return `Cannot ${action} while vibe mode is active. Exit vibe mode first.`;
+		return undefined;
+	};
+
+	const startGoal = async (objective: string, tokenBudget: number | undefined, replace: boolean): Promise<RpcCediaGoalData> => {
+		const refusal = refuseWhileOtherMode(replace ? "replace the goal" : "start a goal");
+		if (refusal) throw new Error(refusal);
+		if (cfgGoalEnabled.get(session.settings) !== true) {
+			throw new Error("Goal mode is disabled. Enable it in settings (goal.enabled).");
+		}
+		const state = replace
+			? await session.goalRuntime.replaceGoal({ objective, ...(tokenBudget === undefined ? {} : { tokenBudget }) })
+			: await session.goalRuntime.createGoal({ objective, ...(tokenBudget === undefined ? {} : { tokenBudget }) });
+		await enterGoalMode(state);
+		// The objective is the turn, exactly as `/goal <objective>` submits it. A streaming session
+		// is steered so the goal joins the work in flight instead of queueing behind it.
+		if (session.isStreaming) {
+			await session.sendGoalModeContext({ deliverAs: "steer" });
+			void session.prompt(objective, { streamingBehavior: "steer" }).catch(error => onError(error instanceof Error ? error.message : String(error)));
+		} else {
+			void session.prompt(objective).catch(error => onError(error instanceof Error ? error.message : String(error)));
+		}
+		// A new goal is the one moment continuation is legitimate without waiting for a turn end.
+		scheduleContinuation();
+		return { ...readCediaGoal(session), startedTurn: true };
+	};
+
+	return {
+		async run(command: CediaGoalCommand): Promise<RpcCediaGoalData> {
+			await restorePersistedGoal();
+			switch (command.op) {
+				case "get":
+					return readCediaGoal(session);
+				case "set":
+				case "replace": {
+					const objective = typeof command.objective === "string" ? command.objective.trim() : "";
+					if (!objective) throw new Error("A goal needs an objective");
+					const existing = session.getGoalModeState();
+					if (command.op === "replace") return await startGoal(objective, command.tokenBudget, true);
+					// A `set` is OMP's own `/goal <objective>`, refusals included: an active goal is
+					// managed or dropped first, and a paused one is resumed or dropped. A client must
+					// not be able to overwrite an objective the owner is pursuing by asking for a
+					// "set" where the terminal would have said no.
+					const live =
+						existing?.goal !== undefined && existing.goal.status !== "dropped" && existing.goal.status !== "complete";
+					if (live) {
+						throw new Error(
+							existing?.enabled
+								? "Goal mode is already active. Use /goal to manage it, or /goal drop to start over."
+								: "Resume the current goal first, or drop it before setting a new objective.",
+						);
+					}
+					return await startGoal(objective, command.tokenBudget, false);
+				}
+				case "pause": {
+					if (session.getGoalModeState()?.goal === undefined) throw new Error("No active goal to pause.");
+					const state = await session.goalRuntime.pauseGoal();
+					await leaveGoalMode(state);
+					return readCediaGoal(session);
+				}
+				case "resume": {
+					const refusal = refuseWhileOtherMode("resume a goal");
+					if (refusal) throw new Error(refusal);
+					const state = await session.goalRuntime.resumeGoal();
+					await enterGoalMode(state);
+					scheduleContinuation();
+					return readCediaGoal(session);
+				}
+				case "drop": {
+					if (session.getGoalModeState()?.goal === undefined) throw new Error("No goal to drop.");
+					await session.goalRuntime.dropGoal();
+					await leaveGoalMode(undefined);
+					return readCediaGoal(session);
+				}
+				case "complete": {
+					await session.goalRuntime.completeGoalFromTool();
+					// The runtime keeps the completed record so a client can show what finished;
+					// only the tool set and any pending continuation are released here.
+					const state = session.getGoalModeState();
+					if (previousTools !== undefined) {
+						const restore = previousTools;
+						previousTools = undefined;
+						await session.setActiveToolsByName(restore);
+					}
+					cancelContinuation();
+					session.setGoalModeState(state);
+					return readCediaGoal(session);
+				}
+				case "budget": {
+					if (session.getGoalModeState()?.enabled !== true) {
+						throw new Error("No active goal to adjust the budget for.");
+					}
+					await session.goalRuntime.onBudgetMutated(command.tokenBudget);
+					return readCediaGoal(session);
+				}
+				default:
+					// The direct command is not validated by the capability bridge, so an unknown
+					// operation is refused here rather than answered with an empty success.
+					throw new Error(`cedia_goal does not know the operation ${String((command as { op?: unknown }).op)}`);
+			}
+		},
+		dispose(): void {
+			disposed = true;
+			cancelContinuation();
+			unsubscribe();
+		},
+	};
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-loop-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-loop-bridge.ts
new file mode 100644
index 0000000000..ba2199248b
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-loop-bridge.ts
@@ -0,0 +1,45 @@
+/**
+ * Cedia's loop-mode projection for OMP RPC mode (plan §8.2 O07).
+ *
+ * Loop mode belongs to the terminal owner: the same `InteractiveMode` the terminal's
+ * `/loop` runs on. Enabling stays on the prompt path (`/loop` with bounds dispatches
+ * headless through the RPC terminal owner, exactly as the terminal dispatches it), so
+ * this bridge carries only the state read and the disable half. Disabling calls the same
+ * `disableLoopMode` the terminal's own toggle calls; disabling while already off answers
+ * the state, never an error. No prompt text crosses the projection: `hasPrompt` names
+ * only whether a repeat prompt is armed.
+ */
+import { describeLoopCondition } from "../loop-condition";
+import { describeLoopLimitRuntime } from "../loop-limit";
+import type { LoopConditionConfig, LoopLimitRuntime } from "@oh-my-pi/pi-tui/status-line/loop";
+import type { RpcCediaLoopData } from "./rpc-types";
+
+/** The terminal owner's loop state, as Cedia may read it. */
+export type CediaLoopMode = {
+	readonly loopModeEnabled: boolean;
+	readonly loopModePaused: boolean;
+	readonly loopPrompt: string | undefined;
+	readonly loopLimit: LoopLimitRuntime | undefined;
+	readonly loopCondition: LoopConditionConfig | undefined;
+	disableLoopMode(message?: string): void;
+};
+
+/** Read OMP's loop state. No terminal owner, or a disabled mode, reads as off. */
+export function readCediaLoopState(mode: CediaLoopMode | undefined): RpcCediaLoopData {
+	if (!mode || !mode.loopModeEnabled) {
+		return { enabled: false, paused: false, limit: null, condition: null, hasPrompt: false };
+	}
+	return {
+		enabled: true,
+		paused: mode.loopModePaused,
+		limit: mode.loopLimit ? describeLoopLimitRuntime(mode.loopLimit) : null,
+		condition: mode.loopCondition ? describeLoopCondition(mode.loopCondition) : null,
+		hasPrompt: mode.loopPrompt !== undefined,
+	};
+}
+
+/** Disable OMP's loop mode through the terminal owner's own teardown. */
+export function disableCediaLoop(mode: CediaLoopMode | undefined): RpcCediaLoopData {
+	if (mode && mode.loopModeEnabled) mode.disableLoopMode();
+	return readCediaLoopState(mode);
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-memory-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-memory-bridge.ts
new file mode 100644
index 0000000000..03aaa10eb1
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-memory-bridge.ts
@@ -0,0 +1,82 @@
+/**
+ * Cedia's memory projection for OMP RPC mode (plan §8.2 O09).
+ *
+ * Memory belongs to OMP: the backend is the session's own `memory.backend` setting, and the two
+ * session states (Mnemopi's local SQLite banks, Hindsight's remote service) are OMP's own objects.
+ * Cedia's rule is that a settings surface may show the current backend and its state, and must never
+ * publish memory content or a credential while doing it. So this projection deliberately carries
+ * *shape, not content*:
+ *
+ * - the backend is the effective enum value from OMP's own schema;
+ * - a state is reduced to identity, counters and flags - session id, retained-turn counter,
+ *   whether the first-turn recall happened, how many recall/retain scopes exist - and never
+ *   `lastRecallSnippet`, `mentalModelsSnippet` or any stored row, which can carry user data;
+ * - `memory.apply` is the session's own `applyMemoryBackend()`, the call the runtime makes when the
+ *   backend changes, and it answers the state that follows rather than a claim.
+ *
+ * A backend Cedia has no state for reads as `backend` with no session block: an inactive backend is
+ * an honest absence, not an empty object pretending to be state.
+ */
+import type { AgentSession } from "../../session/agent-session";
+import { cfgMemoryBackend } from "../../memory-backend/settings";
+import type { RpcCediaMemoryData, RpcCediaMemoryScopeState } from "./rpc-types";
+
+/** The backend enum Cedia's schema publishes for `memory.backend`. */
+export type CediaMemoryBackend = "off" | "local" | "hindsight" | "mnemopi" | "sharpshooter";
+
+function backendOf(session: AgentSession): CediaMemoryBackend {
+	const value = cfgMemoryBackend.get(session.settings);
+	// A value the schema does not define cannot be produced by OMP's own setter, so this is a
+	// guard against a hand-edited config: it is reported as `off`-shaped absence, never guessed into
+	// another backend's state.
+	return value === "local" || value === "hindsight" || value === "mnemopi" || value === "sharpshooter"
+		? value
+		: "off";
+}
+
+function mnemopiState(session: AgentSession): RpcCediaMemoryScopeState | undefined {
+	const state = session.getMnemopiSessionState();
+	if (!state) return undefined;
+	return {
+		sessionId: state.sessionId,
+		lastRetainedTurn: state.lastRetainedTurn,
+		hasRecalledForFirstTurn: state.hasRecalledForFirstTurn,
+		recallTargets: state.getScopedRecallTargets().length,
+		hasGlobalTarget: state.globalMemory !== undefined,
+	};
+}
+
+function hindsightState(session: AgentSession): RpcCediaMemoryData["hindsight"] {
+	const state = session.getHindsightSessionState();
+	if (!state) return undefined;
+	return {
+		sessionId: state.sessionId,
+		bankId: state.bankId,
+		banksSet: state.banksSet.size,
+		retainTags: state.retainTags?.length ?? 0,
+		recallTags: state.recallTags?.length ?? 0,
+		...(state.recallTagsMatch === undefined ? {} : { recallTagsMatch: state.recallTagsMatch }),
+		lastRetainedTurn: state.lastRetainedTurn,
+		hasRecalledForFirstTurn: state.hasRecalledForFirstTurn,
+	};
+}
+
+/** The effective memory backend and the session state that belongs to it. */
+export function readCediaMemory(session: AgentSession): RpcCediaMemoryData {
+	const mnemopi = mnemopiState(session);
+	const hindsight = hindsightState(session);
+	return {
+		backend: backendOf(session),
+		...(mnemopi === undefined ? {} : { mnemopi }),
+		...(hindsight === undefined ? {} : { hindsight }),
+	};
+}
+
+/**
+ * Apply the selected memory backend to runtime state, tools and prompt, as the runtime's own
+ * `applyMemoryBackend()` does, and answer the state that follows.
+ */
+export async function applyCediaMemoryBackend(session: AgentSession): Promise<RpcCediaMemoryData> {
+	await session.applyMemoryBackend();
+	return { ...readCediaMemory(session), applied: true };
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-model-roles-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-model-roles-bridge.ts
new file mode 100644
index 0000000000..66b9843240
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-model-roles-bridge.ts
@@ -0,0 +1,31 @@
+/**
+ * Cedia's model-role application for OMP RPC mode (plan §8.2 O03).
+ *
+ * Configuring a role (`model.roles.set`) only writes the mapping; this bridge activates
+ * one: it resolves the named role through the session's own `getRoleModelCycle` and applies
+ * the entry through the session's own `applyRoleModel` — the same pair the TUI role picks
+ * and plan-execution application call. The answer is read back from the session after the
+ * switch, so a client sees the model that is active rather than the mapping it asked for.
+ * An unconfigured role is refused, never defaulted to the current model.
+ */
+import type { AgentSession } from "../../session/agent-session";
+import type { RpcCediaRoleApplyData } from "./rpc-types";
+
+/** Apply the model configured for one role as the session's active model. */
+export async function applyCediaRoleModel(
+	session: AgentSession,
+	role: string,
+): Promise<RpcCediaRoleApplyData> {
+	const name = role.trim();
+	if (name.length === 0) throw new Error("Cedia role apply needs a role name");
+	const cycle = session.getRoleModelCycle([name]);
+	const entry = cycle?.models.find(candidate => candidate.role === name);
+	if (!entry) throw new Error(`No model is configured for role "${name}"`);
+	await session.applyRoleModel(entry);
+	const active = session.model;
+	return {
+		role: name,
+		provider: active?.provider ?? entry.model.provider,
+		model: active?.id ?? entry.model.id,
+	};
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-omfg-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-omfg-bridge.ts
new file mode 100644
index 0000000000..56e8df1098
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-omfg-bridge.ts
@@ -0,0 +1,245 @@
+/**
+ * Cedia's rule-forging projection for OMP RPC mode (plan §8.2 O02).
+ *
+ * `/omfg` forges a TTSR rule from a complaint: the model drafts a candidate over an
+ * ephemeral turn, the candidate is validated against the assistant history, and the owner
+ * saves it into the project or global rules directory, where it is registered live. The
+ * terminal carries this in an overlay panel with pickers and confirms; headless clients
+ * get the same three halves with explicit parameters instead of interactive prompts:
+ *
+ * - `draft` runs the generate-and-validate loop (up to three attempts with failure
+ *   feedback, exactly like the terminal) over the session's own ephemeral turn and holds
+ *   the candidate. Like the terminal firing without awaiting, the call answers the
+ *   drafting state at once; the candidate lands in the held state. A `feedback` option
+ *   carries the terminal's amend loop: it regenerates from the held rule as the previous
+ *   revision rather than starting over.
+ * - `state` reads idle/drafting/ready/failed with the bounded draft for owner review.
+ * - `save` writes the held candidate to the named scope and registers it live. An
+ *   existing file is refused unless `overwrite` is set (the terminal's overwrite
+ *   confirm, as a parameter), and an unvalidated candidate is refused unless
+ *   `allowUnvalidated` is set (the terminal's save-anyway confirm, as a parameter).
+ *   Saving consumes the held candidate, like the terminal disposing on save.
+ *
+ * Rule names travel into file paths, so a name with a path separator is refused rather
+ * than escaped: the terminal trusts model output here, and the bridge deliberately does
+ * not repeat that trust across a control boundary.
+ */
+import * as path from "node:path";
+import { CONFIG_DIR_NAME, prompt } from "@oh-my-pi/pi-utils";
+import omfgUserPrompt from "../../prompts/system/omfg-user.md" with { type: "text" };
+import type { AgentSession } from "../../session/agent-session";
+import {
+	buildOmfgRuleForPath,
+	extractGeneratedRuleJson,
+	historyOutputs,
+	parseGeneratedRule,
+	validateParsedRuleAgainstAssistantHistory,
+	type ParsedGeneratedRule,
+} from "../controllers/omfg-rule";
+import { TtsrToolInspector } from "../../session/ttsr-outputs";
+import type { RpcCediaOmfgData, RpcCediaOmfgSaveData } from "./rpc-types";
+
+/** Largest rule draft an answer may carry for owner review. */
+export const CEDIA_OMFG_DRAFT_MAX_CHARS = 8192;
+
+/** Generate attempts per draft, matching the terminal loop. */
+const OMFG_MAX_ATTEMPTS = 3;
+
+export type CediaOmfgDraftOptions = {
+	complaint: string;
+	feedback?: string;
+};
+
+export type CediaOmfgSaveOptions = {
+	scope: "project" | "global";
+	overwrite?: boolean;
+	allowUnvalidated?: boolean;
+};
+
+type HeldOmfgCandidate = {
+	complaint: string;
+	fileContent: string;
+	ruleName: string;
+	validated: boolean;
+	validationFeedback: string | null;
+};
+
+function bound(value: string, max: number): { text: string; truncated: boolean } {
+	if (value.length <= max) return { text: value, truncated: false };
+	return { text: value.slice(0, max), truncated: true };
+}
+
+/** A rule-forging bridge bound to one session. Created per session like the btw bridge. */
+export function createCediaOmfgBridge(options: { session: AgentSession }): {
+	draft(options: CediaOmfgDraftOptions): Promise<RpcCediaOmfgData>;
+	read(): RpcCediaOmfgData;
+	save(options: CediaOmfgSaveOptions): Promise<RpcCediaOmfgSaveData>;
+	abort(): RpcCediaOmfgData;
+} {
+	const { session } = options;
+	let drafting = false;
+	let held: HeldOmfgCandidate | undefined;
+	let complaintEcho = "";
+	let complaintEchoTruncated = false;
+	let failed: string | undefined;
+	let aborter: AbortController | undefined;
+	// Same inspector the terminal `/omfg` overlay validates through: live tool
+	// definitions plus the session cwd, so rule matching sees what the runtime sees.
+	const inspector = new TtsrToolInspector(
+		() => session.agent.state.tools,
+		() => session.sessionManager.getCwd(),
+	);
+
+	function read(): RpcCediaOmfgData {
+		if (!held) {
+			return {
+				state: drafting ? "drafting" : failed !== undefined ? "failed" : "idle",
+				complaint: drafting || failed !== undefined ? complaintEcho : null,
+				complaintTruncated: complaintEchoTruncated,
+				draft: null,
+				draftTruncated: false,
+				ruleName: null,
+				validated: false,
+				validationFeedback: null,
+				savedPath: null,
+				reason: failed ?? null,
+			};
+		}
+		const draft = bound(held.fileContent, CEDIA_OMFG_DRAFT_MAX_CHARS);
+		return {
+			state: "ready",
+			complaint: complaintEcho,
+			complaintTruncated: complaintEchoTruncated,
+			draft: draft.text,
+			draftTruncated: draft.truncated,
+			ruleName: held.ruleName,
+			validated: held.validated,
+			validationFeedback: held.validationFeedback,
+			savedPath: null,
+			reason: null,
+		};
+	}
+
+	async function draft(options: CediaOmfgDraftOptions): Promise<RpcCediaOmfgData> {
+		const complaint = options.complaint.trim();
+		if (complaint.length === 0) throw new Error("Cedia rule forging needs a complaint");
+		if (drafting) throw new Error("A rule draft is already running");
+		if (!session.model) throw new Error("No active model available for rule forging.");
+		const feedback = options.feedback?.trim() || undefined;
+		const previousRule = feedback !== undefined ? held?.fileContent : undefined;
+		drafting = true;
+		held = undefined;
+		failed = undefined;
+		const echo = bound(complaint, CEDIA_OMFG_DRAFT_MAX_CHARS);
+		complaintEcho = echo.text;
+		complaintEchoTruncated = echo.truncated;
+		const controller = new AbortController();
+		aborter = controller;
+		// Fire and forget, like the terminal overlay: the call answers the drafting state at
+		// once and the held candidate lands when generation plus validation settle.
+		void runDraft({ complaint, feedback, previousRule }, controller.signal).catch(() => {
+			// runDraft records every outcome into the held state; this guards the shape.
+		});
+		return read();
+	}
+
+	async function runDraft(
+		options: { complaint: string; feedback?: string; previousRule?: string },
+		signal: AbortSignal,
+	): Promise<void> {
+		try {
+			const failedAttempts = options.feedback ? [options.feedback] : [];
+			let previousRule = options.previousRule;
+			let candidate: ParsedGeneratedRule | undefined;
+			let validated = false;
+			let validationFeedback: string | null = null;
+			for (let attempt = 1; attempt <= OMFG_MAX_ATTEMPTS; attempt++) {
+				if (signal.aborted) return;
+				const promptText = prompt.render(omfgUserPrompt, {
+					complaint: options.complaint,
+					feedback: failedAttempts.length > 0 ? failedAttempts.join("\n\n") : undefined,
+					previousRule,
+				});
+				const { replyText } = await session.runEphemeralTurn({ promptText, signal });
+				if (signal.aborted) return;
+				const parsed = parseGeneratedRule(replyText);
+				if ("error" in parsed) {
+					const failedRule = extractGeneratedRuleJson(replyText) ?? replyText.trim();
+					failedAttempts.push(`Attempt ${attempt} failed: invalid rule (${parsed.error}).`);
+					previousRule = failedRule;
+					continue;
+				}
+				const checked = await validateParsedRuleAgainstAssistantHistory(
+					parsed,
+					historyOutputs(session.messages, inspector),
+					parsed.rule.question !== undefined ? session.ruleJudge() : undefined,
+				);
+				candidate = checked.candidate;
+				if (checked.validation.matched) {
+					validated = true;
+					validationFeedback = null;
+					break;
+				}
+				validationFeedback = checked.validation.feedback ?? "The rule condition did not match any earlier assistant output.";
+				failedAttempts.push(`Attempt ${attempt} failed validation:\n${validationFeedback}`);
+				previousRule = candidate.fileContent;
+				if (attempt === OMFG_MAX_ATTEMPTS) break;
+			}
+			if (signal.aborted) return;
+			if (!candidate) {
+				failed = "The model did not return a valid TTSR rule.";
+				return;
+			}
+			held = {
+				complaint: options.complaint,
+				fileContent: candidate.fileContent,
+				ruleName: candidate.rule.name,
+				validated,
+				validationFeedback: validated ? null : validationFeedback,
+			};
+		} catch (error) {
+			if (signal.aborted) return;
+			failed = error instanceof Error ? error.message : String(error);
+		} finally {
+			drafting = false;
+			aborter = undefined;
+		}
+	}
+
+	async function save(options: CediaOmfgSaveOptions): Promise<RpcCediaOmfgSaveData> {
+		const current = held;
+		if (!current) throw new Error("No rule draft to save: draft one first.");
+		if (options.scope !== "project" && options.scope !== "global") {
+			throw new Error('Cedia rule save needs a scope of "project" or "global".');
+		}
+		if (!current.validated && options.allowUnvalidated !== true) {
+			throw new Error(
+				`The draft did not validate against the conversation${current.validationFeedback ? `: ${current.validationFeedback}` : ""}. Save with allowUnvalidated to save it anyway.`,
+			);
+		}
+		if (current.ruleName.includes("/") || current.ruleName.includes("\\") || current.ruleName.trim().length === 0) {
+			throw new Error("The draft rule name cannot be used as a file name.");
+		}
+		const filePath = options.scope === "global"
+			? path.join(session.settings.getAgentDir(), "rules", `${current.ruleName}.md`)
+			: path.join(session.sessionManager.getCwd(), CONFIG_DIR_NAME, "rules", `${current.ruleName}.md`);
+		if (!options.overwrite && await Bun.file(filePath).exists()) {
+			throw new Error(`${filePath} already exists. Save with overwrite to replace it.`);
+		}
+		await Bun.write(filePath, current.fileContent);
+		session.ttsrManager?.addRule(buildOmfgRuleForPath(current.ruleName, current.fileContent, filePath, options.scope === "global" ? "user" : "project"));
+		held = undefined;
+		complaintEcho = "";
+		complaintEchoTruncated = false;
+		failed = undefined;
+		return { saved: true, scope: options.scope, name: current.ruleName, path: filePath, validated: current.validated };
+	}
+
+	function abort(): RpcCediaOmfgData {
+		// Aborting with nothing drafting answers the state, like the cleanse abort.
+		aborter?.abort();
+		return read();
+	}
+
+	return { draft, read, save, abort };
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-pause-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-pause-bridge.ts
new file mode 100644
index 0000000000..575f53032a
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-pause-bridge.ts
@@ -0,0 +1,31 @@
+/**
+ * Cedia's run-pause projection for OMP RPC mode (plan §8.2 O01).
+ *
+ * Pausing engages the process-global pause gate every agent loop polls: the main run, subagents
+ * and the advisor freeze at their next safe point without aborting anything — in-flight provider
+ * streams and started tool executions run to completion — and resume wakes them all. Queued
+ * steering and follow-up submissions stay queued and deliver normally after resume, and aborting
+ * a parked run still unwinds it at once without releasing the gate. Cedia starts one runtime
+ * process per task session, so the process gate is that task's gate: there is no second run in
+ * the process to freeze by accident.
+ *
+ * The read answers the gate as it stands; the write drives it and answers the state that
+ * follows. Pausing while paused (or resuming while running) is not an error: the answer names
+ * the state, so a retried durable command replays the same receipt instead of failing.
+ */
+import { agentPauseGate } from "@oh-my-pi/pi-agent-core";
+import type { RpcCediaPauseData } from "./rpc-types";
+
+/** Whether the process gate is engaged, with the epoch ms the current pause began. */
+export function readCediaRunPause(): RpcCediaPauseData {
+	if (!agentPauseGate.paused) return { paused: false };
+	const pausedAt = agentPauseGate.pausedAt;
+	return pausedAt === undefined ? { paused: true } : { paused: true, pausedAt };
+}
+
+/** Engage or release the process gate and answer the state that follows. */
+export function setCediaRunPause(paused: boolean): RpcCediaPauseData {
+	if (paused) agentPauseGate.pause();
+	else agentPauseGate.resume();
+	return readCediaRunPause();
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-plan-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-plan-bridge.ts
new file mode 100644
index 0000000000..57be0a4cd9
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-plan-bridge.ts
@@ -0,0 +1,318 @@
+/**
+ * Cedia's session-mode bridge for OMP RPC mode (plan §8.2 O07).
+ *
+ * Plan and vibe mode are OMP's own: the mode state lives on the session, the plan file lives in the
+ * session's own local root, and the transitions are the ones `/plan` and `/vibe` perform. This
+ * bridge is a thin adapter so a client that is not the terminal can read that state, ask for those
+ * transitions, and answer the plan review a `write xd://propose` produces. It deliberately does not
+ * re-implement the mode machine: the transitions run through the same `handlePlanModeCommand` /
+ * `handleVibeModeCommand` the terminal's slash commands call, and the decision runs through the same
+ * `handlePlanApproval` the terminal's overlay drives.
+ *
+ * The one thing a non-terminal client cannot do is see or answer the terminal's own overlay, so the
+ * runtime hands the review - and the confirmation an unapproved draft would ask for - to the client
+ * instead (see `InteractiveMode.setPlanReviewDelegate` and `handlePlanModeCommand`'s
+ * `exitConfirmed`).
+ */
+import type { AgentSession } from "../../session/agent-session";
+import type { InteractiveNotice, PlanReviewDecision, PlanReviewRequest } from "../types";
+import type {
+	CediaPlanCommand,
+	RpcCediaPlanData,
+	RpcCediaPlanFrame,
+	RpcCediaPlanReview,
+	RpcCediaPlanState,
+} from "./rpc-types";
+
+/** Ready-frame value for the session-mode bridge. */
+export const CEDIA_PLAN_BRIDGE_VERSION = 1;
+
+/** Bound on the plan text this bridge puts on the wire; a longer plan is named as truncated. */
+export const CEDIA_PLAN_REVIEW_MAX_CHARS = 64 * 1024;
+
+/** The session's own terminal UI, while a Cedia virtual UI is attached to it. */
+export interface CediaPlanBridgeMode {
+	/** The terminal's three-state toggle parks here between "on" and "off". */
+	readonly planModePaused: boolean;
+	handlePlanModeCommand(
+		initialPrompt?: string,
+		input?: undefined,
+		options?: { exitConfirmed?: boolean },
+	): Promise<boolean>;
+	handleVibeModeCommand(initialPrompt?: string, input?: undefined): Promise<boolean>;
+	hasPlanModeDraft(): Promise<boolean>;
+	setPlanReviewDelegate(delegate: ((request: PlanReviewRequest) => Promise<PlanReviewDecision>) | null): void;
+	setRpcNoticeSink(sink: ((notice: InteractiveNotice) => void) | null): void;
+}
+
+export interface CediaPlanBridgeOptions {
+	readonly session: AgentSession;
+	/** The session's terminal owner while a Cedia virtual UI is attached; the mode machine lives there. */
+	readonly mode: () => CediaPlanBridgeMode | undefined;
+	/** Emit one streamed frame to the client. */
+	readonly output: (frame: RpcCediaPlanFrame) => void;
+}
+
+export interface CediaPlanBridge {
+	/** Run one operation; every operation answers the runtime's whole mode state. */
+	run(command: CediaPlanCommand): Promise<RpcCediaPlanData>;
+	/** Record one of the runtime's own notices, so a refusal keeps the runtime's words. */
+	notice(notice: InteractiveNotice): void;
+	/** Publish the current mode state, e.g. after the terminal surface ran `/plan` itself. */
+	emitState(): void;
+	/** Hold a plan the runtime proposed; resolves when the client decides. */
+	holdReview(request: PlanReviewRequest): Promise<PlanReviewDecision>;
+	/** Resolve a held review as cancelled and stop answering; the session is going away. */
+	dispose(reason: string): void;
+}
+
+/** Bound the plan text a client receives while leaving the truncation visible. */
+function boundPlanContent(planContent: string): { planContent: string; truncated: boolean } {
+	if (planContent.length <= CEDIA_PLAN_REVIEW_MAX_CHARS) return { planContent, truncated: false };
+	return { planContent: planContent.slice(0, CEDIA_PLAN_REVIEW_MAX_CHARS), truncated: true };
+}
+
+export function createCediaPlanBridge(options: CediaPlanBridgeOptions): CediaPlanBridge {
+	const { session, mode, output } = options;
+	let reviewSequence = 0;
+	let noticeSequence = 0;
+	let notices: { seq: number; notice: InteractiveNotice }[] = [];
+	let pending:
+		| { readonly review: RpcCediaPlanReview; readonly resolve: (decision: PlanReviewDecision) => void }
+		| undefined;
+	let disposed = false;
+
+	/** OMP's own plan-mode state, with only the fields the wire names. */
+	const readPlanState = (): RpcCediaPlanState | null => {
+		const paused = mode()?.planModePaused === true;
+		const state = session.getPlanModeState();
+		// Parked: the terminal's toggle cleared the state and the plan path, but plan mode still
+		// blocks the other two modes, so the client has to be able to see it.
+		if (!state) return paused ? { enabled: false, paused: true, workflow: "parallel", reentry: false } : null;
+		return {
+			enabled: state.enabled === true,
+			paused,
+			planFilePath: state.planFilePath,
+			workflow: state.workflow ?? "parallel",
+			reentry: state.reentry === true,
+		};
+	};
+
+	const readVibeState = (): { enabled: boolean } => ({
+		enabled: session.getVibeModeState()?.enabled === true,
+	});
+
+	const snapshot = (changed: boolean, reason?: string): RpcCediaPlanData => ({
+		plan: readPlanState(),
+		vibe: readVibeState(),
+		review: pending?.review ?? null,
+		changed,
+		...(reason === undefined ? {} : { reason }),
+	});
+
+	const emitState = (): void => {
+		if (disposed) return;
+		output({ type: "cedia_plan_state", payload: { plan: readPlanState(), vibe: readVibeState() } });
+	};
+
+	/** The newest notice the runtime produced after `afterSeq`, so a refusal keeps its own words. */
+	const takeNoticeAfter = (afterSeq: number): string | undefined => {
+		const found = notices.find(entry => entry.seq > afterSeq);
+		notices = notices.slice(-8);
+		return found?.notice.text;
+	};
+
+	/** The mode machine, or the reason this session cannot drive it. */
+	const requireMode = (): { ok: true; mode: CediaPlanBridgeMode } | { ok: false; reason: string } => {
+		if (disposed) return { ok: false, reason: "This session is shutting down." };
+		const owner = mode();
+		if (!owner) {
+			return {
+				ok: false,
+				reason:
+					"OMP's plan and vibe modes are owned by the session's terminal surface, and this session has no Cedia virtual UI attached.",
+			};
+		}
+		return { ok: true, mode: owner };
+	};
+
+	/** Resolve a held review; `dispose` cancels anything still open so nothing waits forever. */
+	const settlePending = (decision: PlanReviewDecision, reason?: string): void => {
+		const held = pending;
+		if (!held) return;
+		pending = undefined;
+		held.resolve(decision);
+		if (!disposed) {
+			output({
+				type: "cedia_plan_review_closed",
+				payload: {
+					reviewId: held.review.reviewId,
+					decision: decision.kind,
+					...(reason === undefined ? {} : { reason }),
+				},
+			});
+		}
+	};
+
+	return {
+		async run(command: CediaPlanCommand): Promise<RpcCediaPlanData> {
+			switch (command.op) {
+				case "read":
+					return snapshot(false);
+				case "enter": {
+					const owner = requireMode();
+					if (!owner.ok) return snapshot(false, owner.reason);
+					if (readPlanState()?.enabled === true) return snapshot(false);
+					const before = noticeSequence;
+					// Parked: the terminal's first toggle only clears the parking step, so plan mode
+					// takes the same second toggle to come back on.
+					if (owner.mode.planModePaused) {
+						await owner.mode.handlePlanModeCommand();
+						if (owner.mode.planModePaused) {
+							return snapshot(false, takeNoticeAfter(before) ?? "Plan mode stayed parked.");
+						}
+					}
+					await owner.mode.handlePlanModeCommand();
+					if (readPlanState()?.enabled !== true) {
+						return snapshot(false, takeNoticeAfter(before) ?? "Plan mode did not turn on.");
+					}
+					// The client may name the workflow and the plan file it wants; both are OMP's
+					// own state fields, written after the runtime's own transition succeeded.
+					if (command.workflow !== undefined || command.planFilePath !== undefined) {
+						const state = session.getPlanModeState();
+						if (state) {
+							session.setPlanModeState({
+								...state,
+								...(command.workflow === undefined ? {} : { workflow: command.workflow }),
+								...(command.planFilePath === undefined ? {} : { planFilePath: command.planFilePath }),
+							});
+						}
+					}
+					emitState();
+					return snapshot(true);
+				}
+				case "exit": {
+					const owner = requireMode();
+					if (!owner.ok) return snapshot(false, owner.reason);
+					const before = noticeSequence;
+					const running = readPlanState();
+					if (running?.enabled !== true && running?.paused !== true) return snapshot(false);
+					if (running.enabled) {
+						// The terminal asks before dropping an unapproved plan on its own overlay; a
+						// non-terminal client takes that decision itself and names it here.
+						if (command.confirm !== true && (await owner.mode.hasPlanModeDraft())) {
+							return snapshot(false, "Plan mode holds an unapproved plan draft, and exiting drops it.");
+						}
+						await owner.mode.handlePlanModeCommand(undefined, undefined, { exitConfirmed: true });
+						if (readPlanState()?.enabled === true) {
+							return snapshot(false, takeNoticeAfter(before) ?? "Plan mode did not turn off.");
+						}
+					}
+					// The terminal's toggle parks plan mode one step before off, where it still blocks
+					// vibe and goal mode. A client that asked to exit means off, so take the same
+					// second toggle the terminal's third `/plan` takes.
+					if (owner.mode.planModePaused) {
+						await owner.mode.handlePlanModeCommand();
+						if (owner.mode.planModePaused) {
+							return snapshot(false, takeNoticeAfter(before) ?? "Plan mode stayed parked after exiting.");
+						}
+					}
+					emitState();
+					return snapshot(true);
+				}
+				case "vibe.enter": {
+					const owner = requireMode();
+					if (!owner.ok) return snapshot(false, owner.reason);
+					if (readVibeState().enabled) return snapshot(false);
+					const before = noticeSequence;
+					await owner.mode.handleVibeModeCommand();
+					if (!readVibeState().enabled) {
+						return snapshot(false, takeNoticeAfter(before) ?? "Vibe mode did not turn on.");
+					}
+					emitState();
+					return snapshot(true);
+				}
+				case "vibe.exit": {
+					const owner = requireMode();
+					if (!owner.ok) return snapshot(false, owner.reason);
+					if (!readVibeState().enabled) return snapshot(false);
+					const before = noticeSequence;
+					await owner.mode.handleVibeModeCommand();
+					if (readVibeState().enabled) {
+						return snapshot(false, takeNoticeAfter(before) ?? "Vibe mode did not turn off.");
+					}
+					emitState();
+					return snapshot(true);
+				}
+				case "review.decide": {
+					const held = pending;
+					if (!held || held.review.reviewId !== command.reviewId) {
+						return snapshot(false, "That plan review is no longer open.");
+					}
+					settlePending(
+						command.decision === "approve"
+							? {
+									kind: "approve",
+									preserveContext: command.preserveContext === true,
+									compactBeforeExecute: command.compactBeforeExecute === true,
+								}
+							: command.decision === "refine"
+								? { kind: "refine", feedback: typeof command.feedback === "string" ? command.feedback : "" }
+								: { kind: "cancel" },
+					);
+					// The decision is accepted here. The transition it starts reports itself on the
+					// streamed state frame, and the next read answers the truth either way.
+					emitState();
+					return snapshot(true);
+				}
+				default:
+					return snapshot(
+						false,
+						`cedia_plan does not know the operation ${String((command as { op?: unknown }).op)}`,
+					);
+			}
+		},
+		notice(notice: InteractiveNotice): void {
+			noticeSequence++;
+			notices.push({ seq: noticeSequence, notice });
+			if (notices.length > 16) notices = notices.slice(-8);
+		},
+		emitState,
+		holdReview(request: PlanReviewRequest): Promise<PlanReviewDecision> {
+			const { planContent, truncated } = boundPlanContent(request.planContent);
+			// The runtime serializes approvals, so at most one review is open; a second one
+			// supersedes rather than silently answering the first.
+			if (pending) settlePending({ kind: "cancel" }, "A newer plan was proposed.");
+			reviewSequence++;
+			const review: RpcCediaPlanReview = {
+				reviewId: reviewSequence,
+				title: request.title,
+				planFilePath: request.planFilePath,
+				planContent,
+				truncated,
+				createdAt: Date.now(),
+			};
+			output({ type: "cedia_plan_review", payload: review });
+			return new Promise<PlanReviewDecision>(resolve => {
+				pending = { review, resolve };
+			});
+		},
+		dispose(reason: string): void {
+			disposed = true;
+			const owner = mode();
+			owner?.setPlanReviewDelegate(null);
+			owner?.setRpcNoticeSink(null);
+			settlePending({ kind: "cancel" }, reason);
+		},
+	};
+}
+
+/**
+ * Point a session's terminal owner at this bridge: its notices reach the client, and a plan the
+ * agent proposes is held for the client's decision instead of the terminal's overlay.
+ */
+export function attachCediaPlanReview(bridge: CediaPlanBridge, owner: CediaPlanBridgeMode | undefined): void {
+	if (!owner) return;
+	owner.setRpcNoticeSink(notice => bridge.notice(notice));
+	owner.setPlanReviewDelegate(async request => await bridge.holdReview(request));
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-prewalk-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-prewalk-bridge.ts
