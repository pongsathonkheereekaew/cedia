+/**
+ * Cedia's model-role application (plan §8.2 O03).
+ *
+ * Fixtures drive the apply half directly plus the registered operation through the
+ * bridge with an injected handler. No runtime, model or provider is involved.
+ */
+import { describe, expect, it } from "bun:test";
+import {
+	createCediaCapabilityBridge,
+	type CediaCapabilityBridgeOptions,
+} from "../src/modes/rpc/cedia-capability-bridge";
+import { applyCediaRoleModel } from "../src/modes/rpc/cedia-model-roles-bridge";
+
+function sessionFixture() {
+	const applied: { role: string }[] = [];
+	return {
+		applied,
+		getRoleModelCycle: (roleOrder: readonly string[]) => {
+			const models = roleOrder
+				.filter(role => role === "smol" || role === "default")
+				.map(role => ({
+					role,
+					model: { provider: "fixture", id: role === "smol" ? "fast-1" : "base-1" },
+					explicitThinkingLevel: false,
+				}));
+			if (models.length === 0) return undefined;
+			return { models, currentIndex: 0 };
+		},
+		applyRoleModel: async (entry: { role: string }) => {
+			applied.push({ role: entry.role });
+		},
+		model: { provider: "fixture", id: "fast-1" },
+	};
+}
+
+describe("Cedia model-role application", () => {
+	it("resolves the named role and applies it through the session", async () => {
+		const session = sessionFixture();
+		expect(await applyCediaRoleModel(session as never, "smol")).toEqual({
+			role: "smol",
+			provider: "fixture",
+			model: "fast-1",
+		});
+		expect(session.applied).toEqual([{ role: "smol" }]);
+	});
+
+	it("refuses an unconfigured role instead of defaulting to the current model", async () => {
+		const session = sessionFixture();
+		await expect(applyCediaRoleModel(session as never, "vision")).rejects.toThrow(/No model is configured for role/);
+		expect(session.applied).toEqual([]);
+	});
+
+	it("refuses a blank role name", async () => {
+		const session = sessionFixture();
+		await expect(applyCediaRoleModel(session as never, "  ")).rejects.toThrow(/needs a role name/);
+	});
+
+	it("advertises model.roles.apply with the O03 owner contract", () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"model.roles.apply": () => ({ role: "smol", provider: "fixture", model: "fast-1" }),
+				"settings.revision": () => "fixture-revision",
+			},
+		} as unknown as CediaCapabilityBridgeOptions);
+		const row = built.table().capabilities.find(entry => entry.id === "model.roles.apply");
+		expect(row).toMatchObject({
+			id: "model.roles.apply",
+			family: "O03",
+			scope: "session",
+			apply: "immediate",
+			principal: "owner",
+			state: "available",
+		});
+	});
+
+	it("runs model.roles.apply through cedia_control with a role payload", async () => {
+		const seen: unknown[] = [];
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"model.roles.apply": (payload: Record<string, unknown>) => {
+					seen.push(payload);
+					return { role: "smol", provider: "fixture", model: "fast-1" };
+				},
+				"settings.revision": () => "fixture-revision",
+			},
+		} as unknown as CediaCapabilityBridgeOptions);
+		const outcome = await built.control({ operation: "model.roles.apply", payload: { role: "smol" } });
+		expect(seen).toEqual([{ role: "smol" }]);
+		expect(outcome).toMatchObject({
+			ok: true,
+			operation: "model.roles.apply",
+			result: { role: "smol", provider: "fixture", model: "fast-1" },
+		});
+	});
+
+	it("refuses a role payload with unknown fields or a blank role", async () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"model.roles.apply": () => ({ role: "smol", provider: "fixture", model: "fast-1" }),
+				"settings.revision": () => "fixture-revision",
+			},
+		} as unknown as CediaCapabilityBridgeOptions);
+		for (const payload of [undefined, {}, { role: "  " }, { role: "smol", extra: 1 }]) {
+			const outcome = await built.control({ operation: "model.roles.apply", payload: payload as Record<string, unknown> });
+			expect(outcome).toMatchObject({ ok: false });
+		}
+	});
+});
diff --git a/packages/coding-agent/test/cedia-model-state-bridge.test.ts b/packages/coding-agent/test/cedia-model-state-bridge.test.ts
new file mode 100644
index 0000000000..850d00f0e5
--- /dev/null
+++ b/packages/coding-agent/test/cedia-model-state-bridge.test.ts
@@ -0,0 +1,301 @@
+import { describe, expect, it } from "bun:test";
+import {
+	createCediaCapabilityBridge,
+	type CediaCapabilityBridgeOptions,
+	type CediaCapabilityHandlers,
+} from "../src/modes/rpc/cedia-capability-bridge";
+
+function bridge() {
+	const calls: string[] = [];
+	let serviceTiers = {
+		families: ["openai", "anthropic", "google"],
+		tiers: ["auto", "default", "flex", "scale", "priority"],
+		current: [] as { family: string; tier: string | null }[],
+	};
+	let accounts: Record<string, unknown> = { supported: false, provider: null, accounts: [], truncated: false };
+	let pinAccepted = false;
+	const noop = (..._args: unknown[]) => undefined;
+	const handlers: CediaCapabilityHandlers = {
+		"model.roles.get": noop,
+		"model.state.get": () => {
+			calls.push("model.state.get");
+			return {
+				model: null,
+				effort: { configured: null, autoResolved: null, isAuto: false },
+				serviceTiers,
+			};
+		},
+		"model.service-tier.set": (payload: Record<string, unknown>) => {
+			calls.push(`model.service-tier.set:${String(payload.family)}:${String(payload.tier)}`);
+			serviceTiers = {
+				...serviceTiers,
+				current: [{ family: String(payload.family), tier: payload.tier === null ? null : String(payload.tier) }],
+			};
+			return { family: payload.family, tier: payload.tier, serviceTiers };
+		},
+		"auth.accounts.list": () => {
+			calls.push("auth.accounts.list");
+			return accounts;
+		},
+		"auth.account.pin": (payload: Record<string, unknown>) => {
+			calls.push(`auth.account.pin:${String(payload.credentialId)}`);
+			return { pinned: pinAccepted, list: accounts };
+		},
+		"auth.providers.list": noop,
+		"turn.queue.get": noop,
+		"queue.get": noop,
+		"queue.drop": noop,
+		"pause.get": noop,
+		"prewalk.state.get": () => ({ armed: false }),
+		"loop.state.get": () => ({ enabled: false, paused: false, limit: null, condition: null, hasPrompt: false }),
+		"loop.set": () => ({ enabled: false, paused: false, limit: null, condition: null, hasPrompt: false }),
+		"pause.set": noop,
+		"python.exec": noop,
+		"python.abort": noop,
+		"settings.get": noop,
+		"settings.revision": () => "fixture-revision",
+		"settings.set": noop,
+		"goal.get": noop,
+		"goal.set": noop,
+		"plan.get": noop,
+		"plan.set": noop,
+		"plan.review": noop,
+		"progress.get": noop,
+		"advisor.get": noop,
+		"advisor.set": noop,
+		"advisor.history": noop,
+		"advisor.config.get": noop,
+		"advisor.config.set": noop,
+		"agents.get": noop,
+		"policy.get": noop,
+		"context.get": noop,
+		"context.drop-images": noop,
+		"context.abort-compaction": noop,
+		"context.shake": noop,
+		"model.roles.apply": noop,
+		"btw.state.get": () => ({ state: "idle", question: null, questionTruncated: false, answer: null, answerTruncated: false, branchable: false, branchUnavailableReason: "no answered side question", reason: null }),
+		"btw.ask": noop,
