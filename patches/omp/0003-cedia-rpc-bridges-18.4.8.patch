+	});
+});
diff --git a/packages/coding-agent/test/cedia-btw-bridge.test.ts b/packages/coding-agent/test/cedia-btw-bridge.test.ts
new file mode 100644
index 0000000000..76136a7dac
--- /dev/null
+++ b/packages/coding-agent/test/cedia-btw-bridge.test.ts
@@ -0,0 +1,150 @@
+/**
+ * Cedia's side-question projection (plan §8.2 O02).
+ *
+ * Fixtures drive ask/state/branch directly plus the registered operations through the
+ * bridge with an injected handler. The ephemeral turn and the branch fork are session
+ * doubles; no runtime, model or provider is involved.
+ */
+import { describe, expect, it } from "bun:test";
+import {
+	createCediaCapabilityBridge,
+	type CediaCapabilityBridgeOptions,
+} from "../src/modes/rpc/cedia-capability-bridge";
+import { createCediaBtwBridge } from "../src/modes/rpc/cedia-btw-bridge";
+
+const IDLE = {
+	state: "idle" as const,
+	question: null,
+	questionTruncated: false,
+	answer: null,
+	answerTruncated: false,
+	branchable: false,
+	branchUnavailableReason: "no answered side question",
+	reason: null,
+};
+
+function sessionFixture(options: { answer?: string; branch?: { cancelled: boolean; sessionFile?: string }; streaming?: boolean } = {}) {
+	const calls: string[] = [];
+	return {
+		calls,
+		model: { provider: "fixture", id: "fixture-model" },
+		isStreaming: options.streaming ?? false,
+		sessionManager: {
+			getLeafId: () => "leaf-1",
+			getSessionId: () => "session-1",
+		},
+		runEphemeralTurn: async () => {
+			calls.push("runEphemeralTurn");
+			if (options.answer === undefined) throw new Error("fixture model is unavailable");
+			return {
+				replyText: options.answer,
+				assistantMessage: { role: "assistant", content: [{ type: "text", text: options.answer }] },
+			};
+		},
+		branchFromBtw: async (question: string, _message: unknown, leafId: string, sessionId: string) => {
+			calls.push(`branchFromBtw:${question}:${leafId}:${sessionId}`);
+			if (options.branch === undefined) throw new Error("fixture cannot branch");
+			return { cancelled: options.branch.cancelled, sessionFile: options.branch.sessionFile };
+		},
+	};
+}
+
+describe("Cedia side-question bridge", () => {
+	it("starts idle with nothing held", () => {
+		expect(createCediaBtwBridge({ session: sessionFixture() as never }).read()).toEqual(IDLE);
+	});
+
+	it("dispatches the ask at once and holds the answer when the run settles", async () => {
+		const session = sessionFixture({ answer: "Forty-two.", branch: { cancelled: false, sessionFile: "/tmp/branched.jsonl" } });
+		const bridge = createCediaBtwBridge({ session: session as never });
+		// Like the terminal firing without awaiting, the call answers the answering state;
+		// the held answer arrives on the next tick and `state` reports it.
+		const dispatched = await bridge.ask("What is the answer?");
+		expect(dispatched.state).toBe("answering");
+		await new Promise(resolve => setTimeout(resolve, 10));
+		expect(bridge.read()).toMatchObject({
+			state: "ready",
+			question: "What is the answer?",
+			answer: "Forty-two.",
+			branchable: true,
+			branchUnavailableReason: null,
+			reason: null,
+		});
+		expect(session.calls).toEqual(["runEphemeralTurn"]);
+		const branched = await bridge.branch();
+		expect(branched).toEqual({ cancelled: false, sessionFile: "/tmp/branched.jsonl" });
+	});
+
+	it("promotes the held answer with the real leaf and session identity", async () => {
+		const session = sessionFixture({ answer: "Yes.", branch: { cancelled: false, sessionFile: "/tmp/branched.jsonl" } });
+		const bridge = createCediaBtwBridge({ session: session as never });
+		await bridge.ask("Proceed?");
+		await new Promise(resolve => setTimeout(resolve, 10));
+		expect(await bridge.branch()).toEqual({ cancelled: false, sessionFile: "/tmp/branched.jsonl" });
+		expect(session.calls).toEqual(["runEphemeralTurn", "branchFromBtw:Proceed?:leaf-1:session-1"]);
+		// A consumed answer returns to idle: the transcript never saw either half.
+		expect(bridge.read()).toEqual(IDLE);
+	});
+
+	it("keeps a cancelled branch held instead of consuming it", async () => {
+		const session = sessionFixture({ answer: "Maybe.", branch: { cancelled: true } });
+		const bridge = createCediaBtwBridge({ session: session as never });
+		await bridge.ask("Try?");
+		await new Promise(resolve => setTimeout(resolve, 10));
+		expect(await bridge.branch()).toEqual({ cancelled: true, sessionFile: null });
+		expect(bridge.read().state).toBe("ready");
+	});
+
+	it("reports a failed ask honestly and refuses to branch it", async () => {
+		const session = sessionFixture();
+		const bridge = createCediaBtwBridge({ session: session as never });
+		expect((await bridge.ask("Anybody there?")).state).toBe("answering");
+		await new Promise(resolve => setTimeout(resolve, 10));
+		const asked = bridge.read();
+		expect(asked.state).toBe("failed");
+		expect(asked.answer).toBeNull();
+		expect(asked.reason).toContain("fixture model is unavailable");
+		expect(asked.branchable).toBe(false);
+		await expect(bridge.branch()).rejects.toThrow(/no answered side question/);
+	});
+
+	it("refuses a blank question, a missing model and a second concurrent ask", async () => {
+		const session = sessionFixture({ answer: "Late." });
+		const bridge = createCediaBtwBridge({ session: session as never });
+		await expect(bridge.ask("  ")).rejects.toThrow(/needs a question/);
+		const modelLess = { ...session, model: undefined };
+		await expect(createCediaBtwBridge({ session: modelLess as never }).ask("Q?")).rejects.toThrow(/No active model/);
+	});
+
+	it("bounds a long answer with its truncation named", async () => {
+		const session = sessionFixture({ answer: "x".repeat(20000) });
+		const bridge = createCediaBtwBridge({ session: session as never });
+		await bridge.ask("Long?");
+		await new Promise(resolve => setTimeout(resolve, 10));
+		const asked = bridge.read();
+		expect(asked.answer?.length).toBeLessThanOrEqual(16384);
+		expect(asked.answerTruncated).toBe(true);
+	});
+
+	it("advertises the three operations with the O02 controller/owner contract", () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"btw.state.get": () => IDLE,
+				"btw.ask": () => ({ ...IDLE, state: "ready" }),
+				"btw.branch": () => ({ cancelled: false, sessionFile: null }),
+				"settings.revision": () => "fixture-revision",
+			},
+		} as unknown as CediaCapabilityBridgeOptions);
+		const rows = new Map(
+			built
+				.table()
+				.capabilities.filter(row => row.id.startsWith("btw."))
+				.map(row => [row.id, row]),
+		);
+		expect([...rows.keys()]).toEqual(["btw.ask", "btw.branch", "btw.state.get"]);
+		expect(rows.get("btw.state.get")).toMatchObject({ family: "O02", principal: "controller" });
+		expect(rows.get("btw.ask")).toMatchObject({ family: "O02", principal: "owner" });
+		expect(rows.get("btw.branch")).toMatchObject({ family: "O02", principal: "owner" });
+	});
+});
