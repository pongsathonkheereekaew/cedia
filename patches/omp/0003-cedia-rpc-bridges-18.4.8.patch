+import { expect, test } from "bun:test";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import { initLoaderContext } from "../native/loader-state.js";
+
+test("Cedia compiled addons never share the upstream version cache", () => {
+	const oldCache = process.env.CEDIA_NATIVE_CACHE_DIR;
+	const oldCompiled = process.env.CEDIA_COMPILED_RUNTIME;
+	try {
+		delete process.env.CEDIA_NATIVE_CACHE_DIR;
+		process.env.CEDIA_COMPILED_RUNTIME = "1";
+		const compiled = initLoaderContext({ isCompiledBinary: true });
+		expect(compiled.nativesDir).toBe(join(homedir(), "Library", "Caches", "Cedia", "omp-natives"));
+		process.env.CEDIA_NATIVE_CACHE_DIR = "/tmp/cedia-private-native-cache";
+		expect(initLoaderContext({ isCompiledBinary: true }).nativesDir).toBe("/tmp/cedia-private-native-cache");
+		process.env.CEDIA_NATIVE_CACHE_DIR = "relative-cache";
+		expect(() => initLoaderContext({ isCompiledBinary: true })).toThrow(/absolute/);
+	} finally {
+		if (oldCache === undefined) delete process.env.CEDIA_NATIVE_CACHE_DIR;
+		else process.env.CEDIA_NATIVE_CACHE_DIR = oldCache;
+		if (oldCompiled === undefined) delete process.env.CEDIA_COMPILED_RUNTIME;
+		else process.env.CEDIA_COMPILED_RUNTIME = oldCompiled;
+	}
+});
