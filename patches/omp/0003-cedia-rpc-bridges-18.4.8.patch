+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { convertToLlm } from "@oh-my-pi/pi-coding-agent/session/messages";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+describe("Cedia turn-boundary identity", () => {
+	type MockModelOptions = NonNullable<Parameters<typeof createMockModel>[0]>;
+	let session: AgentSession | undefined;
+	let modelRegistry: ModelRegistry | undefined;
+	let tempDir: TempDir | undefined;
+
+	afterEach(async () => {
+		await session?.dispose();
+		session = undefined;
+		modelRegistry?.authStorage.close();
+		modelRegistry = undefined;
+		tempDir?.removeSync();
+		tempDir = undefined;
+	});
+
+	async function setup(options: {
+		followUpMode?: "all" | "one-at-a-time";
+		responses?: MockModelOptions["responses"];
+		handler?: MockModelOptions["handler"];
+		tools?: AgentTool[];
+	}) {
+		tempDir = TempDir.createSync("@pi-cedia-boundary-");
+		const authStorage = await AuthStorage.create(`${tempDir.path()}/auth.db`);
+		authStorage.keys.setRuntime("mock", "test-key");
+		modelRegistry = new ModelRegistry(authStorage, `${tempDir.path()}/models.yml`);
+		const mock = createMockModel({
+			provider: "mock",
+			id: "cedia-boundary-model",
+			responses: options.responses,
+			handler: options.handler,
+		});
+		const agent = new Agent({
+			initialState: {
+				model: mock.model,
+				systemPrompt: ["test"],
+				tools: options.tools ?? [],
+				messages: [],
+			},
+			getApiKey: () => "test-key",
+			convertToLlm,
+			streamFn: (model, context, streamOptions) => mock.stream(model, context, streamOptions),
+		});
+		session = new AgentSession({
+			agent,
+			sessionManager: SessionManager.inMemory(),
+			modelRegistry,
+			settings: Settings.isolated({ "compaction.enabled": false, "todo.enabled": false }),
+			toolRegistry: new Map(options.tools?.map(tool => [tool.name, tool])),
+			builtInToolNames: options.tools?.map(tool => tool.name),
+		});
+		if (options.followUpMode) session.setFollowUpMode(options.followUpMode, false);
+		return { agent, mock };
+	}
+
+	function boundaryEvents(events: AgentSessionEvent[]) {
+		return events.filter(
+			(event): event is Extract<AgentSessionEvent, { type: "cedia_turn_boundary" }> =>
+				event.type === "cedia_turn_boundary",
+		);
+	}
+
+	function boundaryShapes(events: AgentSessionEvent[]) {
+		return boundaryEvents(events).map(({ type, completedIntentIds, runningIntentIds }) => ({
+			type,
+			completedIntentIds,
+			runningIntentIds,
+		}));
+	}
+
+	it("promotes an all-mode follow-up batch only after the successful preparation commit", async () => {
+		const firstCall = Promise.withResolvers<void>();
+		const releaseFirstCall = Promise.withResolvers<void>();
+		let calls = 0;
+		await setup({
+			followUpMode: "all",
+			handler: async () => {
+				calls++;
+				if (calls === 1) {
+					firstCall.resolve();
+					await releaseFirstCall.promise;
+				}
+				return { content: ["done"] };
+			},
+		});
+		const events: AgentSessionEvent[] = [];
+		session!.subscribe(event => events.push(event));
+
+		const first = session!.prompt("A", { cediaIntentId: "A" });
+		await firstCall.promise;
+		await session!.followUp("B", undefined, { cediaIntentId: "B" });
+		await session!.followUp("C", undefined, { cediaIntentId: "C" });
+		releaseFirstCall.resolve();
