@@ -0,0 +1,139 @@
+import { describe, expect, it } from "bun:test";
+import type {
+	ClientBridgePermissionOption,
+	ClientBridgePermissionToolCall,
+} from "@oh-my-pi/pi-coding-agent/session/client-bridge";
+import {
+	CEDIA_NATIVE_PERMISSION_DEFINITION,
+	createCediaPermissionBridge,
+} from "@oh-my-pi/pi-coding-agent/modes/rpc/cedia-client-bridge";
+import { RpcHostToolBridge } from "@oh-my-pi/pi-coding-agent/modes/rpc/host-tools";
+import type { RpcHostToolCallRequest, RpcHostToolCancelRequest } from "@oh-my-pi/pi-coding-agent/modes/rpc/rpc-types";
+
+const toolCall: ClientBridgePermissionToolCall = {
+	toolCallId: "toolu_permission_1",
+	toolName: "bash",
+	title: "Run a command",
+	kind: "execute",
+	status: "pending",
+	rawInput: { command: "echo hello" },
+};
+
+const permissionOptions: ClientBridgePermissionOption[] = [
+	{ optionId: "allow_once", name: "Allow once", kind: "allow_once" },
+	{ optionId: "reject_once", name: "Reject", kind: "reject_once" },
+];
+
+function makeBridge() {
+	const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+	const host = new RpcHostToolBridge(frame => frames.push(frame));
+	const bridge = createCediaPermissionBridge(host, { timeoutMs: 50 });
+	return { bridge, host, frames };
+}
+
+function resultText(outcome: unknown) {
+	return { content: [{ type: "text" as const, text: JSON.stringify(outcome) }] };
+}
+
+function requestFrame(frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest>): RpcHostToolCallRequest {
+	const frame = frames[0];
+	if (!frame || frame.type !== "host_tool_call") throw new Error("Expected host_tool_call frame");
+	return frame;
+}
+
+function requestPermission(
+	bridge: ReturnType<typeof createCediaPermissionBridge>,
+	...args: Parameters<NonNullable<ReturnType<typeof createCediaPermissionBridge>["requestPermission"]>>
+) {
+	if (!bridge.requestPermission) throw new Error("Expected permission capability");
+	return bridge.requestPermission(...args);
+}
+
+describe("Cedia native permission ClientBridge", () => {
+	it("forwards exact tool call and options through RpcHostToolBridge", async () => {
+		const { bridge, host, frames } = makeBridge();
+		const execution = requestPermission(bridge, toolCall, permissionOptions);
+		const request = requestFrame(frames);
+
+		expect(request.toolName).toBe(CEDIA_NATIVE_PERMISSION_DEFINITION.name);
+		expect(request.toolCallId).toBe(toolCall.toolCallId);
+		expect(request.arguments).toEqual({ kind: "permission", toolCall, options: permissionOptions });
+		expect(request.arguments.toolCall).not.toBe(toolCall);
+		expect(request.arguments.options).not.toBe(permissionOptions);
+
+		host.handleResult({
+			type: "host_tool_result",
+			id: request.id,
+			result: resultText({ outcome: "selected", optionId: "allow_once", kind: "allow_once" }),
+		});
+
+		await expect(execution).resolves.toEqual({ outcome: "selected", optionId: "allow_once", kind: "allow_once" });
+	});
+
+	it("accepts a structured cancelled outcome", async () => {
+		const { bridge, host, frames } = makeBridge();
+		const execution = requestPermission(bridge, toolCall, permissionOptions);
+		const request = requestFrame(frames);
+
+		host.handleResult({
+			type: "host_tool_result",
+			id: request.id,
+			result: resultText({ outcome: "cancelled" }),
+		});
+
+		await expect(execution).resolves.toEqual({ outcome: "cancelled" });
+	});
+
+	it("sends a host-tool cancel and resolves cancelled when the caller aborts", async () => {
+		const { bridge, frames } = makeBridge();
+		const controller = new AbortController();
+		const execution = requestPermission(bridge, toolCall, permissionOptions, controller.signal);
+		const request = requestFrame(frames);
+
+		controller.abort();
+
+		expect(frames[1]).toMatchObject({ type: "host_tool_cancel", targetId: request.id });
+		await expect(execution).resolves.toEqual({ outcome: "cancelled" });
+	});
+
+	it("fails closed when the host selects an unknown option ID", async () => {
+		const { bridge, host, frames } = makeBridge();
+		const execution = requestPermission(bridge, toolCall, permissionOptions);
+		const request = requestFrame(frames);
+
+		host.handleResult({
+			type: "host_tool_result",
+			id: request.id,
+			result: resultText({ outcome: "selected", optionId: "allow_always", kind: "allow_always" }),
+		});
+
+		await expect(execution).rejects.toThrow(/unknown option ID/);
+	});
+
+	it("fails closed for malformed or mismatched structured outcomes", async () => {
+		const malformed = makeBridge();
+		const malformedExecution = requestPermission(malformed.bridge, toolCall, permissionOptions);
+		const malformedRequest = requestFrame(malformed.frames);
+		malformed.host.handleResult({
+			type: "host_tool_result",
+			id: malformedRequest.id,
+			result: { content: [{ type: "text", text: "allow" }] },
+		});
+		await expect(malformedExecution).rejects.toThrow(/malformed/);
+
+		const mismatched = makeBridge();
+		const mismatchedExecution = requestPermission(mismatched.bridge, toolCall, permissionOptions);
+		const mismatchedRequest = requestFrame(mismatched.frames);
+		mismatched.host.handleResult({
+			type: "host_tool_result",
+			id: mismatchedRequest.id,
+			result: resultText({ outcome: "selected", optionId: "allow_once", kind: "reject_once" }),
+		});
+		await expect(mismatchedExecution).rejects.toThrow(/kind does not match/);
+	});
+
+	it("returns cancelled at the bounded permission deadline", async () => {
+		const { bridge } = makeBridge();
+		await expect(requestPermission(bridge, toolCall, permissionOptions)).resolves.toEqual({ outcome: "cancelled" });
+	});
+});
diff --git a/packages/coding-agent/test/cedia-context-bridge.test.ts b/packages/coding-agent/test/cedia-context-bridge.test.ts
new file mode 100644
index 0000000000..1b44cebe13
--- /dev/null
+++ b/packages/coding-agent/test/cedia-context-bridge.test.ts
@@ -0,0 +1,142 @@
+/**
+ * Cedia's context projection (plan §8.2 O09).
+ *
+ * The fixtures are SDK-free: they prove that the projection reports the session's own numbers, that
+ * an unavailable breakdown stays absent instead of reading as zero, and that the two controls call
+ * the runtime's own operations and answer the state that follows rather than a claim.
+ */
+import { describe, expect, it } from "bun:test";
+import type { AgentSession } from "../src/session/agent-session";
+import type { ContextUsageBreakdown } from "../src/session/agent-session-types";
+import {
+	abortCediaCompaction,
+	dropCediaContextImages,
+	readCediaContext,
+	shakeCediaContext,
+} from "../src/modes/rpc/cedia-context-bridge";
+import type { ShakeResult } from "../src/session/shake-types";
+
+const BREAKDOWN: ContextUsageBreakdown = {
+	contextWindow: 200_000,
+	anchored: true,
+	usedTokens: 12_345,
+	systemPromptTokens: 1_000,
+	systemToolsTokens: 2_000,
+	systemContextTokens: 345,
+	skillsTokens: 500,
+	messagesTokens: 8_500,
+};
+
+interface ContextFixture {
+	breakdown?: ContextUsageBreakdown | undefined;
+	compacting?: boolean;
+	speculation?: "idle" | "running" | "armed";
+	removed?: number;
+	shake?: ShakeResult;
+	calls: string[];
+}
+
+function session(fixture: ContextFixture): AgentSession {
+	return {
+		getContextBreakdown: () => {
+			fixture.calls.push("getContextBreakdown");
+			return fixture.breakdown;
+		},
+		get isCompacting() {
+			return fixture.compacting ?? false;
+		},
+		get compactionSpeculation() {
+			return fixture.speculation ?? "idle";
+		},
+		dropImages: async () => {
+			fixture.calls.push("dropImages");
+			return { removed: fixture.removed ?? 0 };
+		},
+		abortCompaction: (reason?: unknown) => {
+			fixture.calls.push(`abortCompaction:${String(reason)}`);
+			// The runtime stops reporting compaction once the cancel lands; the fixture models that so
+			// the answer's re-read is what the test checks.
+			fixture.compacting = false;
+		},
+		shake: async (mode: string) => {
+			fixture.calls.push(`shake:${mode}`);
+			return fixture.shake ?? { mode, toolResultsDropped: 0, blocksDropped: 0, tokensFreed: 0 };
+		},
+	} as unknown as AgentSession;
+}
+
+describe("Cedia context projection", () => {
+	it("reports the runtime's own split, not a Cedia copy", () => {
+		const fixture: ContextFixture = { breakdown: BREAKDOWN, calls: [] };
+		expect(readCediaContext(session(fixture))).toEqual({
+			usage: {
+				contextWindow: 200_000,
+				anchored: true,
+				usedTokens: 12_345,
+				systemPromptTokens: 1_000,
+				systemToolsTokens: 2_000,
+				systemContextTokens: 345,
+				skillsTokens: 500,
+				messagesTokens: 8_500,
+			},
+			compacting: false,
+			speculation: "idle",
+		});
+	});
+
+	it("omits an unavailable breakdown instead of drawing zeroes", () => {
+		const fixture: ContextFixture = { breakdown: undefined, calls: [] };
+		const snapshot = readCediaContext(session(fixture));
+		expect(Object.hasOwn(snapshot, "usage")).toBe(false);
+		expect(snapshot.compacting).toBe(false);
+	});
+
+	it("carries the runtime's live maintenance state", () => {
+		const fixture: ContextFixture = { breakdown: BREAKDOWN, compacting: true, speculation: "armed", calls: [] };
+		expect(readCediaContext(session(fixture))).toMatchObject({ compacting: true, speculation: "armed" });
+	});
+
+	it("answers how many images the runtime removed", async () => {
+		const fixture: ContextFixture = { breakdown: BREAKDOWN, removed: 3, calls: [] };
+		const answer = await dropCediaContextImages(session(fixture));
+		expect(answer.removed).toBe(3);
+		// The answer carries the state that follows, so a client re-reads what it changed without a
+		// second round trip that could observe a later state.
+		expect(answer.usage?.messagesTokens).toBe(8_500);
+		expect(fixture.calls).toEqual(["dropImages", "getContextBreakdown"]);
+	});
+
+	it("answers the state after a cancel, not a claim that compaction stopped", () => {
+		const fixture: ContextFixture = { breakdown: BREAKDOWN, compacting: true, calls: [] };
+		const answer = abortCediaCompaction(session(fixture));
+		expect(fixture.calls[0]?.startsWith("abortCompaction:")).toBe(true);
+		expect(answer.compacting).toBe(false);
+		expect(answer.usage?.usedTokens).toBe(12_345);
+	});
+
+	it("reduces context with the runtime's own strategy and answers its own result", async () => {
+		const fixture: ContextFixture = {
+			shake: { mode: "elide", toolResultsDropped: 2, blocksDropped: 1, tokensFreed: 900, artifactId: "art-1" },
+			calls: [],
+		};
+		const result = await shakeCediaContext(session(fixture), "elide");
+		expect(fixture.calls).toEqual(["shake:elide", "getContextBreakdown"]);
+		// The runtime's result travels unchanged: counts, reclaimed tokens and the artifact that holds
+		// whatever it dropped. Nothing here is a Cedia estimate.
+		expect(result.shake).toEqual({
+			mode: "elide",
+			toolResultsDropped: 2,
+			blocksDropped: 1,
+			tokensFreed: 900,
+			artifactId: "art-1",
+		});
+		// The state that follows travels beside it, so the panel re-reads the window it just reduced.
+		expect(result.compacting).toBe(false);
+	});
+
+	it("refuses a strategy the runtime does not define before any work runs", async () => {
+		const fixture: ContextFixture = { calls: [] };
+		await expect(shakeCediaContext(session(fixture), "everything" as never)).rejects.toThrow("Unknown shake mode");
+		expect(fixture.calls).toEqual([]);
+	});
+});
diff --git a/packages/coding-agent/test/cedia-credit-policy.test.ts b/packages/coding-agent/test/cedia-credit-policy.test.ts
new file mode 100644
index 0000000000..854071ae8b
--- /dev/null
+++ b/packages/coding-agent/test/cedia-credit-policy.test.ts
@@ -0,0 +1,147 @@
+/**
+ * Cedia's credit policy layer (plan §2.8 "Product invariants versus shared terminal
+ * configuration").
+ *
+ * OMP can spend a saved Codex reset on its own: `codexResets.autoRedeem = "yes"` lets a usage fetch
+ * trigger a redemption, and `"unset"` asks once and persists the answer. Cedia's rule is narrower -
+ * an application the owner did not explicitly tell to spend must never spend - so these fixtures
+ * prove three things, all offline and with no credit ever touched:
+ *
+ * 1. the policy is a *read*: it answers an effective value and a reason and never writes the
+ *    owner's shared setting;
+ * 2. the same snapshot that plans an action under the stored value plans none under the guarded
+ *    effective value, because the planner is what the session hands the decision to;
+ * 3. the running session really asks for that effective value at every decision point, so a later
+ *    edit cannot quietly reintroduce a path that reads the raw stored mode.
+ */
+import { describe, expect, it } from "bun:test";
+import { readFileSync } from "node:fs";
+import type { UsageReport } from "@oh-my-pi/pi-ai";
+import {
+	CEDIA_CREDIT_GUARD_ENV,
+	cediaCreditPolicySnapshot,
+	effectiveCodexAutoRedeem,
+	readCediaCreditPolicy,
+} from "@oh-my-pi/pi-coding-agent/session/cedia-policy";
+import {
+	type CodexResetPlanInput,
+	planCodexResetRedemptions,
+	shouldEvaluateCodexAutoRedeem,
+} from "@oh-my-pi/pi-coding-agent/session/codex-auto-reset";
+
+const NOW = 1_700_000_040_000;
+const HOUR = 3_600_000;
+const DAY = 24 * HOUR;
+const ACCOUNT_ID = "acct-123";
+const EMAIL = "user@example.com";
+
+/** An account blocked on its weekly window with one saved credit - the plainest spendable case. */
+function report(): UsageReport {
+	return {
+		provider: "openai-codex",
+		fetchedAt: NOW,
+		limits: [
+			{
+				id: "openai-codex:primary",
+				label: "5 Hour",
+				scope: { provider: "openai-codex", accountId: ACCOUNT_ID },
+				window: { id: "5h", label: "5 Hour", resetsAt: NOW + 2 * HOUR },
+				amount: { usedFraction: 0.5, unit: "percent" },
+			},
+			{
+				id: "openai-codex:secondary",
+				label: "Weekly",
+				scope: { provider: "openai-codex", accountId: ACCOUNT_ID },
+				window: { id: "7d", label: "Weekly", resetsAt: NOW + 3 * DAY },
+				amount: { usedFraction: 1.0, unit: "percent" },
+			},
+		],
+		resetCredits: { availableCount: 1, credits: [{ status: "available", expiresAt: undefined }] },
+		metadata: { accountId: ACCOUNT_ID, email: EMAIL, limitReached: true, resetCreditCredentialId: 7 },
+	} as UsageReport;
+}
+
+function plannerInput(enabled: boolean): CodexResetPlanInput {
+	return {
+		nowMs: NOW,
+		trigger: "blocked",
+		provider: "openai-codex",
+		modelId: "gpt-5.3-codex",
+		settings: { enabled, minBlockedMinutes: 60, keepCredits: 0, salvageHorizonMs: 12 * HOUR },
+		identity: { accountId: ACCOUNT_ID, email: EMAIL },
+		reports: [report()],
+		attemptedKeys: new Set<string>(),
+		deferredUntilByKey: new Map<string, number>(),
+		lastAttemptAtByAccount: new Map<string, number>(),
+	};
+}
+
+describe("Cedia credit policy", () => {
+	it("is active only on a process Cedia started, and says which case it is in", () => {
+		expect(readCediaCreditPolicy({}).guardActive).toBe(false);
+		expect(readCediaCreditPolicy({}).reason).toContain("No Cedia credit guard");
+		expect(readCediaCreditPolicy({ [CEDIA_CREDIT_GUARD_ENV]: "0" }).guardActive).toBe(false);
+		const guarded = readCediaCreditPolicy({ [CEDIA_CREDIT_GUARD_ENV]: "1" });
+		expect(guarded.guardActive).toBe(true);
+		expect(guarded.reason).toContain("never spends");
+	});
+
+	it("overrides a stored yes, and leaves an owner's own no named as theirs", () => {
+		const guarded = readCediaCreditPolicy({ [CEDIA_CREDIT_GUARD_ENV]: "1" });
+		const unguarded = readCediaCreditPolicy({});
+
+		expect(effectiveCodexAutoRedeem("yes", guarded)).toEqual({ mode: "no", overridden: true });
+		expect(effectiveCodexAutoRedeem("unset", guarded)).toEqual({ mode: "no", overridden: true });
+		expect(effectiveCodexAutoRedeem("no", guarded)).toEqual({ mode: "no", overridden: false });
+		expect(effectiveCodexAutoRedeem("yes", unguarded)).toEqual({ mode: "yes", overridden: false });
+		expect(effectiveCodexAutoRedeem("unset", unguarded)).toEqual({ mode: "unset", overridden: false });
+	});
+
+	it("answers stored, effective and reason together, without writing the stored value", () => {
+		const snapshot = cediaCreditPolicySnapshot("yes", readCediaCreditPolicy({ [CEDIA_CREDIT_GUARD_ENV]: "1" }));
+		expect(snapshot).toMatchObject({ guardActive: true, stored: "yes", effective: "no", overridden: true });
+		expect(snapshot.reason.length).toBeGreaterThan(0);
+	});
+
+	it("plans no spend under the guard, for the snapshot that plans one without it", () => {
+		const guarded = readCediaCreditPolicy({ [CEDIA_CREDIT_GUARD_ENV]: "1" });
+		const stored = "yes";
+
+		// Without the guard this exact snapshot produces a real action: the pair is what makes the
+		// zero below meaningful rather than a fixture that could never have spent anything.
+		const unguardedPlan = planCodexResetRedemptions(
+			plannerInput(
+				shouldEvaluateCodexAutoRedeem(effectiveCodexAutoRedeem(stored, readCediaCreditPolicy({})).mode),
+			),
+		);
+		expect(unguardedPlan.actions.length).toBe(1);
+
+		const guardedPlan = planCodexResetRedemptions(
+			plannerInput(shouldEvaluateCodexAutoRedeem(effectiveCodexAutoRedeem(stored, guarded).mode)),
+		);
+		expect(guardedPlan.actions).toEqual([]);
+	});
+
+	it("keeps every decision point on the effective value, and the prompt behind the guard", () => {
+		const source = readFileSync(new URL("../src/session/agent-session.ts", import.meta.url), "utf8");
+		const effective = source.split("effectiveCodexAutoRedeem(").length - 1;
+
+		// Five effective-value call sites in the session: the Codex planner's
+		// `enabled`, the Claude planner's `enabled`, the blocked pass, the sweep
+		// pass and the prompt-confirmation path (the sixth lives in the policy
+		// module, where the snapshot resolves it). A place that reads the raw
+		// stored mode instead is what this guards against.
+		expect(effective).toBe(5);
+		expect(source).toContain("cediaCreditPolicySnapshot(cfgCodexResets.get(this.settings).autoRedeem");
+		// The prompt path answers before any UI: no question, no notice, no persisted answer.
+		const confirmBody = source.slice(source.indexOf("async #confirmAutoRedeem("));
+		const guardIndex = confirmBody.indexOf("this.#cediaCreditPolicy.guardActive");
+		const runnerIndex = confirmBody.indexOf("this.#extensionRunner");
+		expect(guardIndex).toBeGreaterThan(-1);
+		expect(runnerIndex).toBeGreaterThan(guardIndex);
+		// Nothing in the session may write the stored mode from a prompt any more while guarded: the
+		// registry-handle writes that remain are the terminal's own answer path, behind that early return.
+		expect(confirmBody.indexOf("cfgCodexResetsAutoRedeem.set(this.settings")).toBeGreaterThan(guardIndex);
+		expect(confirmBody.indexOf("cfgClaudeResetsAutoRedeem.set(this.settings")).toBeGreaterThan(guardIndex);
+	});
+});
diff --git a/packages/coding-agent/test/cedia-credits-bridge.test.ts b/packages/coding-agent/test/cedia-credits-bridge.test.ts
new file mode 100644
index 0000000000..8df179ddba
--- /dev/null
+++ b/packages/coding-agent/test/cedia-credits-bridge.test.ts
@@ -0,0 +1,116 @@
+/**
+ * Cedia's saved-reset projection (plan §8.2 O03).
+ *
+ * A saved reset is scarce and perishable, so the fixtures here pin the two things a client could
+ * get wrong: a listing that failed must not read as "zero credits", and the rows a client sees
+ * carry identity, status and expiry rather than anything from the credential store. No credit is
+ * spent in this file - the redeem's own confirmation rule lives beside the table that enforces it.
+ */
+import { describe, expect, it } from "bun:test";
+import { readFileSync } from "node:fs";
+import type { AgentSession } from "../src/session/agent-session";
+import { CEDIA_CREDITS_MAX_ITEMS, readCediaCredits, redeemCediaResetCredit } from "../src/modes/rpc/cedia-credits-bridge";
+
+interface Account {
+	credentialId?: number;
+	accountId?: string;
+	email?: string;
+	availableCount: number;
+	credits: { id: string; status?: string; expiresAt?: string; title?: string }[];
+	active: boolean;
+	error?: string;
+}
+
+function session(accounts: Account[] | (() => Promise<never>)): AgentSession {
+	return {
+		listResetCredits: async () => {
+			if (typeof accounts === "function") return await accounts();
+			return accounts;
+		},
+		redeemResetCredit: async (target: { accountId?: string; email?: string; credentialId?: number }) => ({
+			ok: true,
+			code: "reset",
+			accountId: target.accountId,
+			creditId: "credit-1",
+		}),
+	} as unknown as AgentSession;
+}
+
+describe("Cedia saved-reset projection", () => {
+	it("carries each account's live count, credit expiries and which one is active", async () => {
+		const data = await readCediaCredits(
+			session([
+				{
+					credentialId: 4,
+					accountId: "acct-1",
+					email: "owner@example.com",
+					availableCount: 2,
+					credits: [
+						{ id: "credit-a", status: "available", expiresAt: "2026-10-01T00:00:00.000Z", title: "One reset" },
+						{ id: "credit-b", status: "available" },
+					],
+					active: true,
+				},
+			]),
+		);
+		expect(data.unavailable).toBeUndefined();
+		expect(data.accounts).toHaveLength(1);
+		expect(data.accounts[0]).toMatchObject({
+			credentialId: 4,
+			accountId: "acct-1",
+			email: "owner@example.com",
+			availableCount: 2,
+			active: true,
+			credits: [
+				{ id: "credit-a", status: "available", expiresAt: "2026-10-01T00:00:00.000Z", title: "One reset" },
+				{ id: "credit-b", status: "available" },
+			],
+		});
+	});
+
+	it("keeps an account's own listing error instead of reporting zero credits", async () => {
+		const data = await readCediaCredits(
+			session([{ accountId: "acct-2", availableCount: 0, credits: [], active: false, error: "token refresh failed" }]),
+		);
+		expect(data.accounts[0]?.error).toBe("token refresh failed");
+		expect(data.accounts[0]?.availableCount).toBe(0);
+	});
+
+	it("keeps the runtime's message when the whole listing failed", async () => {
+		const data = await readCediaCredits(
+			session(async () => {
+				throw new Error("credit listing transport failed");
+			}),
+		);
+		expect(data.accounts).toEqual([]);
+		expect(data.unavailable).toBe("credit listing transport failed");
+	});
+
+	it("bounds accounts and credits per account", async () => {
+		const many: Account = {
+			accountId: "acct-many",
+			availableCount: CEDIA_CREDITS_MAX_ITEMS + 3,
+			credits: Array.from({ length: CEDIA_CREDITS_MAX_ITEMS + 3 }, (_, index) => ({ id: `credit-${index}` })),
+			active: false,
+		};
+		const data = await readCediaCredits(session(Array.from({ length: CEDIA_CREDITS_MAX_ITEMS + 3 }, () => many)));
+		expect(data.accounts.length).toBe(CEDIA_CREDITS_MAX_ITEMS);
+		expect(data.accounts[0]!.credits.length).toBe(CEDIA_CREDITS_MAX_ITEMS);
+		expect(data.accounts[0]!.availableCount).toBe(CEDIA_CREDITS_MAX_ITEMS + 3);
+	});
+
+	it("keeps the manual redeem out of the automatic guard", () => {
+		// The plan's rule is two-sided: no automatic spend, and an owner's confirmed one still works.
+		// The guard lives in the automatic planner/prompt/sweep entry points (`cedia-policy.ts`); the
+		// manual path must not consult it, or a guarded session could never redeem what the owner
+		// deliberately asked for. This assertion fails if a later edit routes this module through it.
+		const source = readFileSync(new URL("../src/modes/rpc/cedia-credits-bridge.ts", import.meta.url), "utf8");
+		expect(/from\s+"[^"]*cedia-policy"/.test(source)).toBe(false);
+		expect(source.includes("effectiveCodexAutoRedeem")).toBe(false);
+	});
+
+	it("answers OMP's own redeem outcome, untranslated", async () => {
+		const outcome = await redeemCediaResetCredit(session([]), { accountId: "acct-1" });
+		expect(outcome).toEqual({ ok: true, code: "reset", accountId: "acct-1", creditId: "credit-1" });
+	});
+});
diff --git a/packages/coding-agent/test/cedia-editor-bridge.test.ts b/packages/coding-agent/test/cedia-editor-bridge.test.ts
new file mode 100644
index 0000000000..9174137870
--- /dev/null
+++ b/packages/coding-agent/test/cedia-editor-bridge.test.ts
@@ -0,0 +1,251 @@
+import { describe, expect, it } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { RpcHostToolBridge } from "@oh-my-pi/pi-coding-agent/modes/rpc/host-tools";
+import {
+	CEDIA_NATIVE_EDITOR_DEFINITION,
+	createCediaEditorBridge,
+} from "@oh-my-pi/pi-coding-agent/modes/rpc/cedia-client-bridge";
+import type { RpcHostToolCallRequest, RpcHostToolCancelRequest } from "@oh-my-pi/pi-coding-agent/modes/rpc/rpc-types";
+import { removeWithRetries } from "@oh-my-pi/pi-utils";
+
+const document = {
+	handle: { id: "doc-1", uri: "file:///workspace/example.ts" },
+	path: "/workspace/example.ts",
+	text: "unsaved\r\ntext\r\n",
+	documentVersion: 17,
+	sha256: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
+	dirty: true,
+};
+
+function resultText(value: unknown) {
+	return { content: [{ type: "text" as const, text: JSON.stringify(value) }] };
+}
+
+function requestFrame(frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest>): RpcHostToolCallRequest {
+	const frame = frames[0];
+	if (!frame || frame.type !== "host_tool_call") throw new Error("Expected host_tool_call frame");
+	return frame;
+}
+
+describe("Cedia native editor ClientBridge", () => {
+	it("forwards a snapshot request and preserves dirty text metadata", async () => {
+		const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+		const host = new RpcHostToolBridge(frame => frames.push(frame));
+		const bridge = createCediaEditorBridge(host, { timeoutMs: 100 });
+		if (!bridge.nativeEditor) throw new Error("Expected native editor capability");
+
+		const pending = bridge.nativeEditor.snapshot({ path: document.path });
+		const request = requestFrame(frames);
+		expect(request.toolName).toBe(CEDIA_NATIVE_EDITOR_DEFINITION.name);
+		expect(request.arguments).toEqual({ kind: "snapshot", path: document.path });
+		host.handleResult({
+			type: "host_tool_result",
+			id: request.id,
+			result: resultText({ document }),
+		});
+
+		expect(await pending).toEqual({ document });
+	});
+
+	it("returns null for a path never owned by the native editor", async () => {
+		const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+		const host = new RpcHostToolBridge(frame => frames.push(frame));
+		const bridge = createCediaEditorBridge(host, { timeoutMs: 100 });
+		if (!bridge.nativeEditor) throw new Error("Expected native editor capability");
+
+		const pending = bridge.nativeEditor.snapshot({ path: "/workspace/headless.txt" });
+		const request = requestFrame(frames);
+		host.handleResult({ type: "host_tool_result", id: request.id, result: resultText({ document: null }) });
+
+		expect(await pending).toEqual({ document: null });
+	});
+
+	it("forwards editorWorkspace so missing create cannot fall back to disk", async () => {
