+/**
+ * Public entrypoint for Cedia's negotiated virtual terminal adapter.
+ *
+ * The implementation is kept alongside the virtual UI owner so the terminal
+ * framing and component lifecycle cannot drift apart.  This module gives
+ * launchers and tests a stable, focused import without exposing the RPC mode
+ * runner itself.
+ */
+export {
+	CEDIA_TERMINAL_MAX_INPUT_BYTES,
+	CEDIA_TERMINAL_MAX_OUTPUT_BYTES,
+	CEDIA_TERMINAL_MAX_COLUMNS,
+	CEDIA_TERMINAL_MAX_ROWS,
+	CEDIA_TERMINAL_MIN_COLUMNS,
+	CEDIA_TERMINAL_MIN_ROWS,
+	CediaVirtualTerminal,
+	type CediaTerminalCloseFrame,
+	type CediaTerminalOpenFrame,
+	type CediaTerminalOutputFrame,
+	type CediaVirtualUiFrame,
+	type CediaVirtualUiOptions,
+	type CediaVirtualUiOutput,
+} from "./rpc-virtual-ui";
