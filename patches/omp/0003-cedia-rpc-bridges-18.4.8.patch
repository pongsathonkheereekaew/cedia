+++ b/packages/coding-agent/test/cedia-cleanse-bridge.test.ts
@@ -0,0 +1,151 @@
+/**
+ * Cedia's cleanse projection (plan §8.2 O02).
+ *
+ * Fixtures drive run/state/abort with an injected runner plus the registered operations
+ * through the bridge with an injected handler. No checkers run, no subagents spawn, and
+ * no provider is involved.
+ */
+import { describe, expect, it } from "bun:test";
+import {
+	createCediaCapabilityBridge,
+	type CediaCapabilityBridgeOptions,
+} from "../src/modes/rpc/cedia-capability-bridge";
+import { createCediaCleanseBridge } from "../src/modes/rpc/cedia-cleanse-bridge";
+
+const IDLE = {
+	state: "idle" as const,
+	request: null,
+	phase: null,
+	checkers: [],
+	agents: [],
+	log: [],
+	report: null,
+	reason: null,
+};
+
+function immediateReportRunner() {
+	return async (
+		_options: unknown,
+		ui: { board: Record<string, (...args: any[]) => void>; print: (text: string) => void },
+		_signal: AbortSignal,
+	) => {
+		ui.board.checkerStarted({ id: "typescript", label: "TypeScript" });
+		ui.board.checkerFinished(
+			{ id: "typescript", label: "TypeScript", language: "TypeScript", cwd: "/tmp", command: "tsc", exitCode: 0, diagnostics: [] },
+			12,
+		);
+		ui.print("Clean: 1 checker passed.");
+		return {
+			exitCode: 0,
+			status: "clean",
+			report: {
+				checks: [{ id: "typescript", label: "TypeScript", language: "TypeScript", cwd: "/tmp", command: "tsc", exitCode: 0, diagnostics: [] }],
+				diagnostics: [],
+				skipped: [],
+			},
+		};
+	};
+}
+
+describe("Cedia cleanse bridge", () => {
+	it("starts idle with no report", () => {
+		expect(createCediaCleanseBridge({ run: immediateReportRunner() as never }).read()).toEqual(IDLE);
+	});
+
+	it("dispatches at once and lands the held report when the run settles", async () => {
+		const bridge = createCediaCleanseBridge({ run: immediateReportRunner() as never });
+		const dispatched = await bridge.run({});
+		expect(dispatched.state).toBe("running");
+		await new Promise(resolve => setTimeout(resolve, 10));
+		const done = bridge.read();
+		expect(done.state).toBe("done");
+		expect(done.request).toBe("all discovered checkers");
+		expect(done.checkers).toEqual([{ id: "typescript", label: "TypeScript", state: "done", exitCode: 0, diagnostics: 0, durationMs: 12 }]);
+		expect(done.report).toMatchObject({ status: "clean" });
+		expect(done.log).toContain("Clean: 1 checker passed.");
+	});
+
+	it("refuses a second run while one runs and aborts through the run signal", async () => {
+		let release!: () => void;
+		const gate = new Promise<void>(resolve => {
+			release = resolve;
+		});
+		const bridge = createCediaCleanseBridge({
+			run: (() => gate.then(() => ({ exitCode: 130, status: "cancelled", report: { checks: [], diagnostics: [], skipped: [] } }))) as never,
+		});
+		await bridge.run({ request: "slow" });
+		await expect(bridge.run({})).rejects.toThrow(/already active/);
+		expect(bridge.abort().state).toBe("running");
+		release();
+		await new Promise(resolve => setTimeout(resolve, 10));
+		expect(bridge.read().state).toBe("done");
+		expect(bridge.read().report).toMatchObject({ status: "cancelled" });
+	});
+
+	it("answers idle on abort with nothing running, and refuses bad run options", async () => {
+		const bridge = createCediaCleanseBridge({ run: immediateReportRunner() as never });
+		expect(bridge.abort().state).toBe("idle");
+		await expect(bridge.run({ maxAgents: 0 })).rejects.toThrow(/positive integer/);
+		await expect(bridge.run({ maxAgents: 1.5 })).rejects.toThrow(/positive integer/);
+	});
+
+	it("records a failed run honestly instead of leaving it running", async () => {
+		const bridge = createCediaCleanseBridge({
+			run: (async () => {
+				throw new Error("fixture exploded");
+			}) as never,
+		});
+		await bridge.run({});
+		await new Promise(resolve => setTimeout(resolve, 10));
+		const done = bridge.read();
+		expect(done.state).toBe("failed");
+		expect(done.reason).toContain("fixture exploded");
+	});
+
+	it("advertises the three operations with the O02 controller/owner contract", () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"cleanse.state.get": () => IDLE,
+				"cleanse.run": () => ({ ...IDLE, state: "running" }),
+				"cleanse.abort": () => IDLE,
+				"settings.revision": () => "fixture-revision",
+			},
+		} as unknown as CediaCapabilityBridgeOptions);
+		const rows = new Map(
+			built
+				.table()
+				.capabilities.filter(row => row.id.startsWith("cleanse."))
+				.map(row => [row.id, row]),
+		);
+		expect([...rows.keys()]).toEqual(["cleanse.abort", "cleanse.run", "cleanse.state.get"]);
+		expect(rows.get("cleanse.state.get")).toMatchObject({ family: "O02", principal: "controller" });
+		expect(rows.get("cleanse.run")).toMatchObject({ family: "O02", principal: "owner" });
+		expect(rows.get("cleanse.abort")).toMatchObject({ family: "O02", principal: "owner" });
+	});
+
+	it("runs cleanse.run through cedia_control with a validated target", async () => {
+		const seen: unknown[] = [];
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"cleanse.state.get": () => IDLE,
+				"cleanse.run": (payload: Record<string, unknown>) => {
+					seen.push(payload);
+					return { ...IDLE, state: "running" };
+				},
+				"cleanse.abort": () => IDLE,
+				"settings.revision": () => "fixture-revision",
+			},
+		} as unknown as CediaCapabilityBridgeOptions);
+		const outcome = await built.control({ operation: "cleanse.run", payload: { request: "ts errors", maxAgents: 4 } });
+		expect(seen).toEqual([{ request: "ts errors", maxAgents: 4 }]);
+		expect(outcome).toMatchObject({ ok: true, operation: "cleanse.run" });
+		const bare = await built.control({ operation: "cleanse.run" });
+		expect(bare).toMatchObject({ ok: true, operation: "cleanse.run" });
+		for (const payload of [{ request: "  " }, { maxAgents: 0 }, { all: "yes" }, { request: "x", extra: 1 }]) {
+			const refused = await built.control({ operation: "cleanse.run", payload: payload as Record<string, unknown> });
+			expect(refused).toMatchObject({ ok: false });
+		}
+	});
+});
