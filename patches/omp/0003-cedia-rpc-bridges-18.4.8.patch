diff --git a/packages/coding-agent/src/modes/rpc/cedia-advisor-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-advisor-bridge.ts
new file mode 100644
index 0000000000..a962562db5
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-advisor-bridge.ts
@@ -0,0 +1,81 @@
+/**
+ * Cedia's advisor projection for OMP RPC mode (plan §8.2 O07).
+ *
+ * The advisor is OMP's own: a second model that reviews each turn and injects notes. Its state,
+ * spend and transcript belong to the session, so this module only projects what the session already
+ * holds - `getAdvisorStats`, `isAdvisorEnabled` and `formatAdvisorHistoryAsText` - with two
+ * deliberate reductions: a model becomes provider/id/name (never the full runtime model object) and
+ * the transcript is bounded, with the truncation named rather than hidden.
+ *
+ * Turning the advisor on or off goes through `setAdvisorEnabled`, the same call `/advisor on|off`
+ * makes; the session's own rule that an advisor with no model assigned stays configured-but-inactive
+ * is reported, never smoothed over.
+ */
+import type { AgentSession } from "../../session/agent-session";
+import type { AdvisorStats } from "../../session/session-advisors";
+import type {
+	RpcCediaAdvisorData,
+	RpcCediaAdvisorHistoryData,
+	RpcCediaAdvisorModel,
+	RpcCediaAdvisorStat,
+} from "./rpc-types";
+
+/** Bound on the transcript text this bridge puts on the wire; a longer one is named as truncated. */
+export const CEDIA_ADVISOR_HISTORY_MAX_CHARS = 128 * 1024;
+
+/** A model reduced to the identity a client may display. */
+function advisorModel(model: AdvisorStats["model"]): RpcCediaAdvisorModel | undefined {
+	if (!model) return undefined;
+	return { provider: model.provider, id: model.id, ...(model.name ? { name: model.name } : {}) };
+}
+
+function advisorStat(stat: AdvisorStats["advisors"][number]): RpcCediaAdvisorStat {
+	return {
+		name: stat.name,
+		status: stat.status,
+		...(advisorModel(stat.model) === undefined ? {} : { model: advisorModel(stat.model)! }),
+		contextWindow: stat.contextWindow,
+		contextTokens: stat.contextTokens,
+		tokens: { ...stat.tokens },
+		cost: stat.cost,
+		messages: { ...stat.messages },
+		...(stat.sessionId === undefined ? {} : { sessionId: stat.sessionId }),
+	};
+}
+
+/** The session's advisor state, as the wire sees it. */
+export function readCediaAdvisor(session: AgentSession, changed = false): RpcCediaAdvisorData {
+	const stats = session.getAdvisorStats();
+	return {
+		enabled: session.isAdvisorEnabled() === true,
+		active: stats.active,
+		configured: stats.configured,
+		...(advisorModel(stats.model) === undefined ? {} : { model: advisorModel(stats.model)! }),
+		contextWindow: stats.contextWindow,
+		contextTokens: stats.contextTokens,
+		tokens: { ...stats.tokens },
+		cost: stats.cost,
+		messages: { ...stats.messages },
+		advisors: stats.advisors.map(advisorStat),
+		changed,
+	};
+}
+
+/** Turn the advisor on or off through the session's own switch, answering the state after it. */
+export function setCediaAdvisorEnabled(session: AgentSession, enabled: boolean): RpcCediaAdvisorData {
+	const before = session.isAdvisorEnabled() === true;
+	session.setAdvisorEnabled(enabled);
+	const after = session.isAdvisorEnabled() === true;
+	return readCediaAdvisor(session, before !== after);
+}
+
+/** The advisor transcript, bounded; null when the session has no active advisor. */
+export function readCediaAdvisorHistory(
+	session: AgentSession,
+	options: { readonly compact: boolean },
+): RpcCediaAdvisorHistoryData {
+	const text = session.formatAdvisorHistoryAsText({ compact: options.compact });
+	if (text === null) return { text: null, truncated: false };
+	if (text.length <= CEDIA_ADVISOR_HISTORY_MAX_CHARS) return { text, truncated: false };
+	return { text: text.slice(0, CEDIA_ADVISOR_HISTORY_MAX_CHARS), truncated: true };
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-advisor-config-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-advisor-config-bridge.ts
new file mode 100644
index 0000000000..95e4c7cb64
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-advisor-config-bridge.ts
@@ -0,0 +1,109 @@
+/**
+ * Cedia's guarded `WATCHDOG.yml` writer for OMP RPC mode (plan §8.2 O07).
+ *
+ * This is the `/advisor configure` save path without the terminal overlay: read one scope's
+ * file as raw text so an editor round-trips exactly what the user wrote, validate a write
+ * strictly before touching disk (the text must parse as YAML and satisfy the schema — a
+ * malformed file is refused with the reason, never written), write exactly the validated text,
+ * then re-discover the merged roster and apply it so live advisors reflect cross-level
+ * precedence without a restart. An empty write removes the file so discovery falls back to
+ * the remaining levels rather than leaving an empty config behind.
+ *
+ * `project` resolves under the session's cwd, `user` under the agent dir — the same two
+ * levels the terminal editor offers, including its `.yaml`-in-place fallback.
+ */
+import { type } from "@oh-my-pi/omptype";
+import { isEnoent } from "@oh-my-pi/pi-utils";
+import { YAML } from "bun";
+import {
+	discoverAdvisorConfigs,
+	resolveAdvisorConfigEditPath,
+	watchdogYamlSchema,
+} from "../../advisor/config";
+import type { AdvisorConfigScope } from "@oh-my-pi/pi-tui/overlays/advisor-config";
+import type { AgentSession } from "../../session/agent-session";
+import type { RpcCediaAdvisorConfigData } from "./rpc-types";
+
+/** Largest config text a write may carry; hand-written advisor files are kilobytes. */
+export const CEDIA_ADVISOR_CONFIG_MAX_CHARS = 64 * 1024;
+
+function scopeOf(value: unknown): AdvisorConfigScope {
+	if (value !== "project" && value !== "user") throw new Error("advisor.config needs scope project or user");
+	return value;
+}
+
+function directories(session: AgentSession): { projectDir: string; agentDir: string } {
+	return {
+		projectDir: session.sessionManager.getCwd(),
+		agentDir: session.settings.getAgentDir(),
+	};
+}
+
+/** Read one scope's file as raw editor text; a missing file reads as absent, never as an error. */
+export async function readCediaAdvisorConfig(
+	session: AgentSession,
+	scope: AdvisorConfigScope,
+): Promise<RpcCediaAdvisorConfigData> {
+	const resolved = scopeOf(scope);
+	const dirs = directories(session);
+	const path = await resolveAdvisorConfigEditPath(resolved, dirs);
+	let text: string;
+	try {
+		text = await Bun.file(path).text();
+	} catch (err) {
+		if (!isEnoent(err)) throw err;
+		return { scope: resolved, path, exists: false, text: "" };
+	}
+	return { scope: resolved, path, exists: true, text };
+}
+
+/**
+ * Validate raw editor text strictly, write exactly what was validated, and apply the
+ * re-discovered roster so the change takes effect without a restart. Answers the scope, the
+ * path, and how many advisors are active afterwards.
+ */
+export async function writeCediaAdvisorConfig(
+	session: AgentSession,
+	scope: AdvisorConfigScope,
+	text: string,
+): Promise<RpcCediaAdvisorConfigData & { advisors: number }> {
+	const resolved = scopeOf(scope);
+	const dirs = directories(session);
+	if (typeof text !== "string") throw new Error("advisor.config needs text as a string");
+	if (text.length > CEDIA_ADVISOR_CONFIG_MAX_CHARS)
+		throw new Error(`advisor.config text exceeds ${CEDIA_ADVISOR_CONFIG_MAX_CHARS} characters`);
+	if (text.trim().length === 0) {
+		const path = await resolveAdvisorConfigEditPath(resolved, dirs);
+		const { rm } = await import("node:fs/promises");
+		try {
+			await rm(path, { force: true });
+		} catch (err) {
+			if (!isEnoent(err)) throw err;
+		}
+		return { ...(await applyDiscovered(session, dirs)), scope: resolved, path, exists: false, text: "" };
+	}
+	let parsed: unknown;
+	try {
+		parsed = YAML.parse(text);
+	} catch (err) {
+		throw new Error(`advisor.config is not YAML: ${err instanceof Error ? err.message : String(err)}`);
+	}
+	const result = watchdogYamlSchema(parsed);
+	if (result instanceof type.errors) throw new Error(`advisor.config is invalid: ${result.summary}`);
+	const path = await resolveAdvisorConfigEditPath(resolved, dirs);
+	await Bun.write(path, text);
+	return { ...(await applyDiscovered(session, dirs)), scope: resolved, path, exists: true, text };
+}
+
+async function applyDiscovered(
+	session: AgentSession,
+	dirs: { projectDir: string; agentDir: string },
+): Promise<{ advisors: number }> {
+	const discovered = await discoverAdvisorConfigs(dirs.projectDir, dirs.agentDir);
+	const advisors = session.applyAdvisorConfigs(
+		discovered.advisors,
+		discovered.sharedInstructions,
+		discovered.sharedMaxNotesPerUpdate,
+	);
+	return { advisors };
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-agents-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-agents-bridge.ts
new file mode 100644
index 0000000000..ae04b6cc04
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-agents-bridge.ts
@@ -0,0 +1,34 @@
+/**
+ * Cedia's agent-roster projection for OMP RPC mode (plan §8.2 O07).
+ *
+ * The Agent Hub reads the runtime's global registry; this module projects the same registry into a
+ * bounded roster a non-terminal client can render - identity, the runtime's own kind and status
+ * words, ancestry, the agent's own activity gist and the child session file a transcript read needs.
+ * Nothing is derived: no health word of Cedia's own, no metric the registry does not hold, and no
+ * filter that would hide an agent the runtime is tracking.
+ *
+ * The child transcript itself is read through the runtime's existing `get_subagent_messages`
+ * command, which this module deliberately does not wrap: the session file this roster names is what
+ * that command takes, and paging stays the runtime's own byte-offset contract.
+ */
+import { AgentRegistry } from "../../registry/agent-registry";
+import type { RpcCediaAgentRef, RpcCediaAgentsData } from "./rpc-types";
+
+/** The bounded roster: one entry per agent the runtime's registry currently holds. */
+export function readCediaAgents(registry: AgentRegistry = AgentRegistry.global()): RpcCediaAgentsData {
+	const agents: RpcCediaAgentRef[] = registry.list().map(ref => ({
+		id: ref.id,
+		name: ref.displayName,
+		kind: ref.kind,
+		...(ref.parentId === undefined ? {} : { parentId: ref.parentId }),
+		status: ref.status,
+		createdAt: ref.createdAt,
+		lastActivity: ref.lastActivity,
+		...(ref.activity === undefined ? {} : { activity: ref.activity }),
+		...(ref.sessionFile === null ? {} : { sessionFile: ref.sessionFile }),
+	}));
+	// Stable order for a UI: most recently active first, then by id so two agents that share a
+	// timestamp cannot swap places between reads.
+	agents.sort((left, right) => right.lastActivity - left.lastActivity || left.id.localeCompare(right.id));
+	return { agents };
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-agents-config-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-agents-config-bridge.ts
new file mode 100644
index 0000000000..f1be1af682
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-agents-config-bridge.ts
@@ -0,0 +1,188 @@
+/**
+ * Cedia's per-agent config control for OMP RPC mode (plan §8.2 O07).
+ *
+ * The Agent Hub property strip lets the terminal enable/disable an agent and set its
+ * model/prewalk/advisor overrides; headless clients get the same control here, through
+ * the session's own settings with the hub's own persist semantics. Unlike the terminal
+ * (which edits an in-memory row and rewrites whole maps on each keystroke), the bridge
+ * takes one validated payload, names the agent it configures, and answers the effective
+ * config after the flush, so the answer is definitive. Refusals mirror the hub's domain:
+ * unknown agent names are refused with the lifecycle's own `Unknown agent` sentence.
+ */
+import type { Settings } from "../../config/settings";
+import { discoverAgents } from "../../task/discovery";
+import {
+	cfgTaskAgentAdvisor,
+	cfgTaskAgentModelOverrides,
+	cfgTaskAgentPrewalk,
+	cfgTaskDisabledAgents,
+} from "../../task/settings";
+
+/**
+ * The settings surface this bridge reads and writes, as plain paths.
+ *
+ * `Settings` no longer has generic `.get(path)`/`.set(path, value)` — reads go
+ * through each path's own registry handle (`cfgX.get(settings)`), so the bridge
+ * takes the narrow `{ get, set, flush }` surface below instead of `Settings`.
+ * `cediaAgentConfigDeps` adapts a live `Settings` instance to it.
+ */
+export interface CediaAgentConfigSettings {
+	get(path: "task.disabledAgents" | "task.agentModelOverrides" | "task.agentPrewalk" | "task.agentAdvisor"): unknown;
+	set(
+		path: "task.disabledAgents" | "task.agentModelOverrides" | "task.agentPrewalk" | "task.agentAdvisor",
+		value: unknown,
+	): void;
+	flush(): Promise<unknown> | unknown;
+}
+
+export interface CediaAgentConfigDeps {
+	readonly settings: CediaAgentConfigSettings;
+	readonly cwd: string;
+}
+
+/** Adapt a live `Settings` instance to the narrow surface this bridge needs. */
+export function cediaAgentConfigDeps(settings: Settings, cwd: string): CediaAgentConfigDeps {
+	return {
+		settings: {
+			get: (path: RecordKey | "task.disabledAgents"): unknown => {
+				switch (path) {
+					case "task.disabledAgents":
+						return cfgTaskDisabledAgents.get(settings);
+					case "task.agentModelOverrides":
+						return cfgTaskAgentModelOverrides.get(settings);
+					case "task.agentPrewalk":
+						return cfgTaskAgentPrewalk.get(settings);
+					case "task.agentAdvisor":
+						return cfgTaskAgentAdvisor.get(settings);
+				}
+			},
+			set: (path: RecordKey | "task.disabledAgents", value: unknown): void => {
+				switch (path) {
+					case "task.disabledAgents":
+						cfgTaskDisabledAgents.set(settings, value as string[]);
+						return;
+					case "task.agentModelOverrides":
+						cfgTaskAgentModelOverrides.set(settings, value as Record<string, string | string[]>);
+						return;
+					case "task.agentPrewalk":
+						cfgTaskAgentPrewalk.set(settings, value as Record<string, string>);
+						return;
+					case "task.agentAdvisor":
+						cfgTaskAgentAdvisor.set(settings, value as Record<string, string>);
+						return;
+				}
+			},
+			flush: () => settings.flush(),
+		},
+		cwd,
+	};
+}
+
+export interface CediaAgentConfigInput {
+	readonly agent: string;
+	readonly enabled?: boolean;
+	readonly model?: string;
+	readonly prewalk?: string;
+	readonly advisor?: string;
+}
+
+export interface CediaAgentConfigResult {
+	readonly agent: string;
+	readonly enabled: boolean;
+	readonly model?: string;
+	readonly prewalk?: string;
+	readonly advisor?: string;
+}
+
+type RecordKey = "task.agentModelOverrides" | "task.agentPrewalk" | "task.agentAdvisor";
+
+function recordKeyFor(property: "model" | "prewalk" | "advisor"): RecordKey {
+	if (property === "model") return "task.agentModelOverrides";
+	if (property === "prewalk") return "task.agentPrewalk";
+	return "task.agentAdvisor";
+}
+
+function readRecord(settings: CediaAgentConfigDeps["settings"], key: RecordKey): Record<string, string> {
+	const value = settings.get(key) as unknown;
+	if (value === null || typeof value !== "object" || Array.isArray(value)) return {};
+	const record: Record<string, string> = {};
+	for (const [name, entry] of Object.entries(value as Record<string, unknown>)) {
+		const text = Array.isArray(entry) ? entry.join(",") : typeof entry === "string" ? entry : "";
+		if (text.trim().length > 0) record[name] = text;
+	}
+	return record;
+}
+
+export interface CediaAgentConfigRow {
+	readonly name: string;
+	readonly source: string;
+	readonly enabled: boolean;
+	readonly model?: string;
+	readonly prewalk?: string;
+	readonly advisor?: string;
+}
+
+/**
+ * List every discovered agent with its effective hub config: the same table the Agent
+ * Hub renders, minus the terminal overlay. Enabled comes from the disabled list, the
+ * three overrides from their maps; empties are omitted exactly as the hub reads them.
+ */
+export async function listCediaAgentConfigs(deps: CediaAgentConfigDeps): Promise<{ agents: CediaAgentConfigRow[] }> {
+	const { agents } = await discoverAgents(deps.cwd, undefined, undefined);
+	const disabled = new Set(deps.settings.get("task.disabledAgents") as unknown as string[]);
+	const rows = agents
+		.slice()
+		.sort((a, b) => a.name.localeCompare(b.name))
+		.map(agent => {
+			const row: Record<string, unknown> = { name: agent.name, source: agent.source, enabled: !disabled.has(agent.name) };
+			for (const property of ["model", "prewalk", "advisor"] as const) {
+				const overrides = readRecord(deps.settings, recordKeyFor(property));
+				const value = overrides[agent.name]?.trim();
+				if (value !== undefined && value.length > 0) row[property] = value;
+			}
+			return row as unknown as CediaAgentConfigRow;
+		});
+	return { agents: rows };
+}
+
+/**
+ * Configure one discovered agent through the session's own settings, with the hub's
+ * own persist semantics: the disabled list is rebuilt sorted, override maps are
+ * rewritten whole with empties omitted, and the write is flushed before answering.
+ */
+export async function setCediaAgentConfig(
+	input: CediaAgentConfigInput,
+	deps: CediaAgentConfigDeps,
+): Promise<CediaAgentConfigResult> {
+	const name = input.agent.trim();
+	if (name.length === 0) throw new Error("agents.config.set needs an agent name");
+	const { agents } = await discoverAgents(deps.cwd, undefined, undefined);
+	if (!agents.some(agent => agent.name === name)) throw new Error(`Unknown agent: ${name}`);
+
+	if (input.enabled !== undefined) {
+		const disabled = new Set(deps.settings.get("task.disabledAgents") as unknown as string[]);
+		if (input.enabled) disabled.delete(name);
+		else disabled.add(name);
+		deps.settings.set("task.disabledAgents", [...disabled].sort((a, b) => a.localeCompare(b)));
+	}
+	for (const property of ["model", "prewalk", "advisor"] as const) {
+		const value = input[property];
+		if (value === undefined) continue;
+		const key = recordKeyFor(property);
+		const record = readRecord(deps.settings, key);
+		const trimmed = value.trim();
+		if (trimmed.length === 0) delete record[name];
+		else record[name] = trimmed;
+		deps.settings.set(key, record);
+	}
+	await deps.settings.flush();
+
+	const disabled = new Set(deps.settings.get("task.disabledAgents") as unknown as string[]);
+	const record: Record<string, unknown> = { agent: name, enabled: !disabled.has(name) };
+	for (const property of ["model", "prewalk", "advisor"] as const) {
+		const overrides = readRecord(deps.settings, recordKeyFor(property));
+		const value = overrides[name]?.trim();
+		if (value !== undefined && value.length > 0) record[property] = value;
+	}
+	return record as unknown as CediaAgentConfigResult;
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-agents-lifecycle-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-agents-lifecycle-bridge.ts
new file mode 100644
index 0000000000..22a732d8d1
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-agents-lifecycle-bridge.ts
@@ -0,0 +1,75 @@
+/**
+ * Cedia's agent-lifecycle controls for OMP RPC mode (plan §8.2 O07).
+ *
+ * The Agent Hub table lets the terminal abort-and-release a row (`x` kill) and
+ * revive a parked row (`r` revive); headless clients get the same two operations
+ * here, through the session's own abort plus the lifecycle's own release/restore.
+ * Unlike the terminal (which fires revive without awaiting it and reports through
+ * a notice), the bridge awaits each call so the answer is definitive: kill names
+ * whether a running turn was aborted and whether the row was released, revive
+ * names the revived row. Refusals mirror the hub's own sentences (unknown id,
+ * read-only advisor transcript, revive of a non-parked row) instead of inventing
+ * new ones. Viewing an agent needs no sender: focusing is the focus controller
+ * attaching the main view to the live session, and Cedia opens the same child
+ * transcript through the runtime's existing `get_subagent_messages` command.
+ */
+import { AgentLifecycleManager } from "../../registry/agent-lifecycle";
+import { AgentRegistry, type AgentRef } from "../../registry/agent-registry";
+import { USER_INTERRUPT_LABEL } from "../../session/messages";
+
+export interface CediaAgentLifecycleDeps {
+	readonly registry?: Pick<AgentRegistry, "get">;
+	readonly lifecycle?: Pick<AgentLifecycleManager, "ensureLive" | "release">;
+}
+
+export interface CediaAgentKillResult {
+	readonly id: string;
+	readonly aborted: boolean;
+	readonly released: boolean;
+}
+
+export interface CediaAgentReviveResult {
+	readonly id: string;
+	readonly revived: true;
+}
+
+function lookup(registry: Pick<AgentRegistry, "get">, id: string): AgentRef {
+	const ref = registry.get(id);
+	if (!ref) throw new Error(`Unknown agent: ${id}`);
+	return ref;
+}
+
+/**
+ * Abort a running agent turn (when one is attached) and release its row with a
+ * tombstone, exactly like the hub's kill path: abort-then-release, advisor rows
+ * refused, nothing half-done silently.
+ */
+export async function killCediaAgent(id: string, deps: CediaAgentLifecycleDeps = {}): Promise<CediaAgentKillResult> {
+	const registry = deps.registry ?? AgentRegistry.global();
+	const lifecycle = deps.lifecycle ?? AgentLifecycleManager.global();
+	const ref = lookup(registry, id);
+	if (ref.kind === "advisor") throw new Error(`"${id}" is a read-only advisor transcript — cannot be killed.`);
+	let aborted = false;
+	if (ref.status === "running" && ref.session) {
+		await ref.session.abort({ reason: USER_INTERRUPT_LABEL });
+		aborted = true;
+	}
+	const released = await lifecycle.release(ref.id, ref, { tombstone: true });
+	return { id: ref.id, aborted, released };
+}
+
+/**
+ * Revive a parked agent through the lifecycle's own restore. Only parked rows
+ * revive; anything else (including advisor transcripts) is refused with the
+ * hub's own sentence. Unlike the terminal, which fires without awaiting, the
+ * bridge awaits the restore so the answer names the outcome.
+ */
+export async function reviveCediaAgent(id: string, deps: CediaAgentLifecycleDeps = {}): Promise<CediaAgentReviveResult> {
+	const registry = deps.registry ?? AgentRegistry.global();
+	const lifecycle = deps.lifecycle ?? AgentLifecycleManager.global();
+	const ref = lookup(registry, id);
+	if (ref.kind === "advisor") throw new Error(`"${id}" is a read-only advisor transcript — nothing to revive.`);
+	if (ref.status !== "parked") throw new Error(`Agent "${id}" is ${ref.status} — only parked agents can be revived.`);
+	await lifecycle.ensureLive(ref.id);
+	return { id: ref.id, revived: true as const };
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-btw-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-btw-bridge.ts
new file mode 100644
index 0000000000..c779054abd
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-btw-bridge.ts
@@ -0,0 +1,161 @@
+/**
+ * Cedia's side-question projection for OMP RPC mode (plan §8.2 O02).
+ *
+ * `/btw` asks an ephemeral question against the session context: the answer never touches
+ * the transcript, and the answered question may be promoted into a branched session. The
+ * terminal carries this in its overlay controller; headless clients get the same two halves
+ * here, with the answered question held server-side between them:
+ *
+ * - `ask` runs the session's own `runEphemeralTurn` with the same rendered kickoff the
+ *   terminal uses, and holds the question, reply and assistant message for a later branch.
+ *   Like the terminal (which fires the run without awaiting it), `ask` answers the answering
+ *   state at once; the answer lands in the held state and `state` reports it. A headless call
+ *   must never occupy the transport for a whole model turn, so there is no timeout cliff to
+ *   tune per model. Only one ask runs at a time; asking while one runs is refused.
+ * - `state` reads idle/answering/ready/failed with the bounded answer and whether a branch
+ *   would be accepted right now.
+ * - `branch` promotes the held answer through the session's own `branchFromBtw` and answers
+ *   the branched session file for the host to adopt. A stale, missing or already-consumed
+ *   answer is refused before anything is forked.
+ *
+ * The wire carries the bounded question echo and answer text only. The full question and
+ * the assistant message stay server-side: the branch consumes them, never the client.
+ */
+import type { AssistantMessage } from "@oh-my-pi/pi-ai";
+import { prompt } from "@oh-my-pi/pi-utils";
+import btwUserPrompt from "../../prompts/system/btw-user.md" with { type: "text" };
+import type { AgentSession } from "../../session/agent-session";
+import type { RpcCediaBtwBranchData, RpcCediaBtwData } from "./rpc-types";
+
+/** Largest side-question echo an answer may carry. */
+export const CEDIA_BTW_QUESTION_MAX_CHARS = 2000;
+
+/** Largest side answer an answer may carry. */
+export const CEDIA_BTW_ANSWER_MAX_CHARS = 16384;
+
+type HeldBtwAnswer = {
+	question: string;
+	assistantMessage: AssistantMessage;
+	leafId: string | null;
+	sessionId: string;
+};
+
+function bound(value: string, max: number): { text: string; truncated: boolean } {
+	if (value.length <= max) return { text: value, truncated: false };
+	return { text: value.slice(0, max), truncated: true };
+}
+
+/** A side-question bridge bound to one session. Created per session like the plan bridge. */
+export function createCediaBtwBridge(options: { session: AgentSession }): {
+	ask(question: string): Promise<RpcCediaBtwData>;
+	read(): RpcCediaBtwData;
+	branch(): Promise<RpcCediaBtwBranchData>;
+} {
+	const { session } = options;
+	let answering = false;
+	let held: HeldBtwAnswer | undefined;
+	let questionEcho = "";
+	let questionEchoTruncated = false;
+	let answer = "";
+	let answerTruncated = false;
+	let failed: string | undefined;
+	let answered = false;
+
+	function branchability(): { branchable: boolean; branchUnavailableReason: string | null } {
+		if (!held) return { branchable: false, branchUnavailableReason: "no answered side question" };
+		if (held.leafId === null || held.leafId.length === 0) {
+			return { branchable: false, branchUnavailableReason: "the session has no branch point" };
+		}
+		if (
+			session.sessionManager.getSessionId() !== held.sessionId ||
+			session.sessionManager.getLeafId() !== held.leafId
+		) {
+			return {
+				branchable: false,
+				branchUnavailableReason: "the session changed since the side question was answered",
+			};
+		}
+		if (session.isStreaming) return { branchable: false, branchUnavailableReason: "a turn is still running" };
+		return { branchable: true, branchUnavailableReason: null };
+	}
+
+	function read(): RpcCediaBtwData {
+		const branch = branchability();
+		return {
+			state: answering ? "answering" : answered ? "ready" : failed !== undefined ? "failed" : "idle",
+			question: answered || answering || failed !== undefined ? questionEcho : null,
+			questionTruncated: questionEchoTruncated,
+			answer: answered ? answer : null,
+			answerTruncated,
+			branchable: branch.branchable,
+			branchUnavailableReason: branch.branchUnavailableReason,
+			reason: failed ?? null,
+		};
+	}
+
+	async function ask(question: string): Promise<RpcCediaBtwData> {
+		const trimmed = question.trim();
+		if (trimmed.length === 0) throw new Error("Cedia side question needs a question");
+		if (answering) throw new Error("A side question is already running");
+		if (!session.model) throw new Error("No active model available for a side question.");
+		const promptText = prompt.render(btwUserPrompt, { question: trimmed });
+		const leafId = session.sessionManager.getLeafId();
+		const sessionId = session.sessionManager.getSessionId();
+		answering = true;
+		answered = false;
+		failed = undefined;
+		held = undefined;
+		const echo = bound(trimmed, CEDIA_BTW_QUESTION_MAX_CHARS);
+		questionEcho = echo.text;
+		questionEchoTruncated = echo.truncated;
+		answer = "";
+		answerTruncated = false;
+		// Fire and forget, like the terminal: the run settles the held state on completion
+		// and this call answers the answering snapshot at once. Awaiting the turn here would
+		// occupy the transport for a whole model turn (and inherit a timeout cliff per model).
+		void runAsk(promptText, trimmed, leafId, sessionId).catch(() => {
+			// runAsk records every outcome into the held state; this guards the shape, not the run.
+		});
+		return read();
+
+		async function runAsk(promptText: string, trimmed: string, leafId: string | null, sessionId: string): Promise<void> {
+			try {
+				const { replyText, assistantMessage } = await session.runEphemeralTurn({ promptText });
+				held = { question: trimmed, assistantMessage, leafId, sessionId };
+				const bounded = bound(replyText, CEDIA_BTW_ANSWER_MAX_CHARS);
+				answer = bounded.text;
+				answerTruncated = bounded.truncated;
+				answered = true;
+			} catch (error) {
+				failed = error instanceof Error ? error.message : String(error);
+			} finally {
+				answering = false;
+			}
+		}
+	}
+
+	async function branch(): Promise<RpcCediaBtwBranchData> {
+		const branch = branchability();
+		const current = held;
+		// branchable implies a non-null leaf, but the type cannot see the branchability
+		// computation, so the null leaf is refused explicitly rather than cast away.
+		if (!current || !branch.branchable || current.leafId === null) {
+			throw new Error(
+				`Cannot branch the side question: ${branch.branchUnavailableReason ?? "no answered side question"}`,
+			);
+		}
+		const result = await session.branchFromBtw(current.question, current.assistantMessage, current.leafId, current.sessionId);
+		if (!result.cancelled) {
+			held = undefined;
+			answered = false;
+			failed = undefined;
+			questionEcho = "";
+			questionEchoTruncated = false;
+			answer = "";
+			answerTruncated = false;
+		}
+		return { cancelled: result.cancelled, sessionFile: result.sessionFile ?? null };
+	}
+
+	return { ask, read, branch };
+}
