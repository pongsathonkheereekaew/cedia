+/**
+ * Cedia's local owner endpoint for one running session (plan §8.2 O08).
+ *
+ * The exclusive session lock this runtime already takes decides *who* owns a session. It does not
+ * tell any other process where that owner is or how to talk to it, so an external Cedia client
+ * (the qualified CLI launcher) has nothing to attach to and has to guess from a PID.
+ *
+ * This module publishes the missing half: a mode-0600 record naming this process, its session and
+ * incarnation, and a Unix socket beside it. A client that can read the record knows the owner's
+ * identity and token; the socket is the liveness proof, so a record left behind by a process that
+ * died is refused rather than believed.
+ *
+ * Deliberately narrow. Requests are one word from a static table - never a function, executable
+ * or source text - and every answer is read-only metadata. Nothing here can start, stop or
+ * replace an owner: a second owner is the lock's business, not this endpoint's.
+ */
+import { execFileSync } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import * as fs from "node:fs";
+import * as fsp from "node:fs/promises";
+import * as net from "node:net";
+import * as path from "node:path";
+import * as postmortem from "@oh-my-pi/pi-utils/postmortem";
+/**
+ * Owner wire protocol version, previously imported from the CEDIA-side
+ * `packages/protocol` (not present in this repo). Kept at 3: records written
+ * with any other version are refused by `readCediaOwnerRecord` below.
+ */
+export const CEDIA_OWNER_BRIDGE_VERSION = 3;
+
+/**
+ * Boot-stable start-time token for `pid`, previously imported from
+ * `packages/protocol` (not present in this repo). Read from `ps -o lstart`
+ * so the write-time and validate-time reads agree exactly and a recycled pid
+ * is rejected by string comparison. `undefined` when the process is gone or
+ * the platform cannot report it.
+ */
+export function readCediaProcessStartIdentity(pid: number): string | undefined {
+	try {
+		const start = execFileSync("/bin/ps", ["-p", String(pid), "-o", "lstart="], {
+			encoding: "utf8",
+			env: { ...process.env, LC_ALL: "C", TZ: "UTC" },
+		})
+			.trim()
+			.replace(/\s+/g, " ");
+		if (start.length === 0) return undefined;
+		return `darwin-ps-lstart:v1:${start}`;
+	} catch {
+		return undefined;
+	}
+}
+
+/** Whether an owner can be selected as Cedia's controller or is presence/read-only only. */
+export type CediaOwnerMode = "controller" | "inspect_only";
+
+const RECORD_NAME = "owner.json";
+const SOCKET_NAME = "owner.sock";
+/** Per-frame bounds; a persistent client is still capped by client and in-flight request limits. */
+const MAX_CONTROLLER_FRAME_BYTES = 1024 * 1024;
+const MAX_CONTROLLER_BACKLOG_BYTES = 8 * 1024 * 1024;
+const MAX_INPUT_BUFFER_BYTES = 8 * 1024 * 1024;
+const MAX_CONTROLLER_IN_FLIGHT = 64;
+const MAX_IN_FLIGHT_PER_CLIENT = 16;
+const MAX_IN_FLIGHT_READS = 64;
+
+export interface CediaOwnerRecord {
+	readonly version: number;
+	readonly protocolVersion: number;
+	readonly sessionId: string;
+	readonly incarnation: string;
+	readonly pid: number;
+	readonly processStartIdentity: string;
+	/** Bridge-issued incarnation timestamp; not a kernel-reported process birth time. */
+	readonly ownerStartedAt: string;
+	readonly startedAt: string;
+	readonly cwd: string;
+	readonly sessionFile?: string;
+	readonly socket: string;
+	readonly token: string;
+	/** Explicit capability advertised by new v2 owners; legacy records default to controller. */
+	readonly mode: CediaOwnerMode;
+}
+
+export interface CediaOwnerBridgeOptions {
+	readonly directory: string;
+	readonly sessionId: string;
+	readonly incarnation: string;
+	readonly cwd: string;
+	readonly sessionFile?: string;
+	/** Defaults to controller for the existing CEDIA RPC owner. */
+	readonly mode?: CediaOwnerMode;
+	/** Test seam: the clock the record's own timestamps come from. */
+	readonly now?: () => Date;
+}
+
+export interface CediaOwnerBridge {
+	readonly record: CediaOwnerRecord;
+	/** Bind after the RPC dispatcher exists. */
+	setReadBroker(handler: (command: CediaOwnerReadCommand) => Promise<Record<string, unknown>>): void;
+	setControllerBroker(broker: CediaOwnerControllerBroker): void;
+	setPrimaryDetached(detached: boolean): void;
+	sendControllerFrame(frame: unknown, expectedLeaseId?: string): boolean;
+	readonly activeControllerLeaseId: string | undefined;
+	/** Remove the record and socket; never touches another process's files. */
+	close(): Promise<void>;
+}
+
+export interface CediaOwnerControllerBroker {
+	readonly ready: unknown;
+	readonly guardActive: boolean;
+	dispatchCommand(frame: Record<string, unknown>, clientRequestId: string, leaseId: string): Promise<unknown>;
+	dispatchSidechannel(frame: Record<string, unknown>, leaseId: string): boolean;
+	onDetach(leaseId: string): void;
+}
+
+export function cediaOwnerRecordPath(directory: string): string {
+	return path.join(directory, RECORD_NAME);
+}
+
+export function cediaOwnerSocketPath(directory: string): string {
+	return path.join(directory, SOCKET_NAME);
+}
+
+/** Read a record this module wrote; an unreadable or malformed record is `undefined`, not a guess. */
+export function readCediaOwnerRecord(directory: string): CediaOwnerRecord | undefined {
+	let parsed: unknown;
+	try {
+		parsed = JSON.parse(fs.readFileSync(cediaOwnerRecordPath(directory), "utf8"));
+	} catch {
+		return undefined;
+	}
+	if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return undefined;
+	const row = parsed as Record<string, unknown>;
+	const text = (value: unknown): value is string => typeof value === "string" && value.length > 0;
+	if (row.version !== 1 || row.protocolVersion !== CEDIA_OWNER_BRIDGE_VERSION) return undefined;
+	if (!text(row.sessionId) || !text(row.incarnation) || !text(row.cwd) || !text(row.socket) || !text(row.token))
+		return undefined;
+	if (!text(row.startedAt) || !text(row.ownerStartedAt) || !text(row.processStartIdentity) || row.processStartIdentity.length > 128) return undefined;
+	if (typeof row.pid !== "number" || !Number.isSafeInteger(row.pid) || row.pid <= 0) return undefined;
+	if (row.mode !== undefined && row.mode !== "controller" && row.mode !== "inspect_only") return undefined;
+	return {
+		version: 1,
+		protocolVersion: CEDIA_OWNER_BRIDGE_VERSION,
+		sessionId: row.sessionId,
+		incarnation: row.incarnation,
+		pid: row.pid,
+		processStartIdentity: row.processStartIdentity,
+		ownerStartedAt: row.ownerStartedAt,
+		startedAt: row.startedAt,
+		cwd: row.cwd,
+		...(text(row.sessionFile) ? { sessionFile: row.sessionFile } : {}),
+		socket: row.socket,
+		token: row.token,
+		mode: row.mode === "inspect_only" ? "inspect_only" : "controller",
+	};
+}
+
+/** Discovery request names; RPC reads have a separate, strict command allowlist. */
+export type CediaOwnerRequestName = "identify" | "status";
+export type CediaOwnerReadCommand = "get_state" | "get_available_commands";
+
+export interface CediaOwnerRequest {
+	readonly token: string;
+	readonly request: CediaOwnerRequestName;
+}
+
+export function isCediaOwnerRequestName(value: unknown): value is CediaOwnerRequestName {
+	return value === "identify" || value === "status";
+}
+
