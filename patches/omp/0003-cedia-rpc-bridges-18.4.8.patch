+fn overlay(path: &std::path::Path, text: &str) -> FileOverlay {
+	FileOverlay {
+		path: path.to_owned(),
+		text: text.to_owned(),
+		editor_base: EditorBase {
+			handle_id:        "editor-handle".into(),
