+		...agentsConfigListOperations,
+		...agentsConfigSetOperations,
+		...toolsCodeModeOperations,
+		...toolsRefreshOperations,
+		...toolsActiveOperations,
+	];
+	// A descriptor that claims `available` without a handler is the one failure
+	// that must not be reachable by accident: the table is the same list the
+	// dispatcher uses, and this check makes the invariant explicit for tests.
+	const onlyOperations = options.operations;
+	const runnable =
+		onlyOperations === undefined ? registered : registered.filter(operation => onlyOperations.includes(operation.id));
+	const handled = new Set(runnable.map(operation => operation.id));
+	for (const descriptor of table) {
+		if (descriptor.state === "available" && !handled.has(descriptor.id))
+			throw new Error(`Cedia capability ${descriptor.id} is advertised without a handler`);
+	}
+
+	return {
+		table: snapshot,
+		control: async (request: RpcCediaControlRequest): Promise<RpcCediaControlOutcome> => {
+			const operationId = typeof request.operation === "string" ? request.operation.trim() : "";
+			if (!operationId)
