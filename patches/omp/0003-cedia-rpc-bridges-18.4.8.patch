+		const { CEDIA_SETTINGS_SERVICE_OPERATIONS } = await import("../src/modes/rpc/cedia-settings-entry");
+		const settings = await Settings.loadIsolated({ agentDir, cwd });
+		const filtered = createCediaCapabilityBridge({
+			ompRevision: "omp/18.4.8",
+			operations: [...CEDIA_SETTINGS_SERVICE_OPERATIONS],
+			handlers: {
+				"settings.revision": () => service.settingsRevisionOfInstance(settings),
+				"settings.get": (path: string) => service.readSettingsValue(settings, path, "global"),
+				"settings.set": async (path: string, value: unknown) => value,
+				"settings.unset": (path: string) => service.unsetGlobalSetting(settings, path, undefined, "global"),
+				"settings.mutate": (payload: import("../src/modes/rpc/rpc-types").RpcCediaSettingsMutatePayload) =>
+					service.mutateGlobalSettings(settings, payload, "global"),
+				"settings.reset.preview": (paths: string[]) => service.previewGlobalReset(settings, paths, "global"),
+			} as never,
+		});
+		const ids = filtered
+			.table()
+			.capabilities.filter(entry => entry.state === "available")
+			.map(entry => entry.id);
+		expect(ids.sort()).toEqual([...CEDIA_SETTINGS_SERVICE_OPERATIONS].sort());
+		expect(
+			await filtered.control({
+				operation: "goal.set",
+				payload: { op: "set", objective: "x" },
+			}),
+		).toMatchObject({ ok: false, code: "cedia_control_unknown_operation" });
+	});
+});
