+			.then(next => {
+				if (closed) {
+					next.dispose?.();
+					return;
+				}
+				component = next;
+				if (options?.overlay) {
+					const overlayOptions =
+						typeof options.overlayOptions === "function" ? options.overlayOptions() : options.overlayOptions;
