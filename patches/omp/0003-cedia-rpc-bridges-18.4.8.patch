index 0000000000..6d2e1ccaaa
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-prewalk-bridge.ts
@@ -0,0 +1,17 @@
+/**
+ * Cedia's prewalk-state projection for OMP RPC mode (plan §8.2 O07).
+ *
+ * The session owns prewalk arming: `getPrewalkState()` answers the prewalk when armed
+ * and active, undefined otherwise. The bridge projects that to a single boolean for
+ * Cedia's status surface. A missing method result (undefined, null) reads as disarmed;
+ * anything else that is not an object is refused, never defaulted.
+ */
+import type { RpcCediaPrewalkData } from "./rpc-types";
+
+/** Whether the session's prewalk handoff is armed, for Cedia's status surface. */
+export function readCediaPrewalkState(session: { getPrewalkState(): unknown }): RpcCediaPrewalkData {
+	const state = session.getPrewalkState();
+	if (state === undefined || state === null) return { armed: false };
+	if (typeof state !== "object") throw new Error("Cedia prewalk state must be an object or undefined");
+	return { armed: true };
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-python-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-python-bridge.ts
new file mode 100644
index 0000000000..86f9d65be4
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-python-bridge.ts
@@ -0,0 +1,49 @@
+/**
+ * Cedia's Python execution projection for OMP RPC mode (plan §8.2 O11).
+ *
+ * This runs code one-shot through the session's shared kernel — the same kernel the eval
+ * tool collaborates on — with no chunk streaming on this path: an exec answers when it
+ * finishes, is aborted, or the kernel refuses it. Rich display outputs (plots, HTML, images
+ * from `display_data`) are reported as a count, never as embedded bytes. Aborting confirms
+ * delivery: a running execution answers cancelled, and with nothing running the call is still
+ * accepted. Execution runs with the kernel's own routing, environment and extension hooks;
+ * Cedia adds no second routing and no second kernel.
+ */
+import type { AgentSession } from "../../session/agent-session";
+import type { RpcCediaPythonData } from "./rpc-types";
+
+/** Largest code text an exec may carry; longer text is refused, never cut. */
+export const CEDIA_PYTHON_MAX_CHARS = 64 * 1024;
+
+/** Largest output text an answer may carry; the runtime truncates far below this. */
+export const CEDIA_PYTHON_MAX_OUTPUT_CHARS = 256 * 1024;
+
+/** Run code through the session's shared kernel and answer the bounded result. */
+export async function execCediaPython(session: AgentSession, code: string): Promise<RpcCediaPythonData> {
+	if (typeof code !== "string" || code.trim().length === 0)
+		throw new Error("python.exec needs code as a non-empty string");
+	if (code.length > CEDIA_PYTHON_MAX_CHARS)
+		throw new Error(`python.exec code exceeds ${CEDIA_PYTHON_MAX_CHARS} characters`);
+	const result = await session.executePython(code);
+	const output = result.output;
+	if (output.length > CEDIA_PYTHON_MAX_OUTPUT_CHARS)
+		throw new Error(`python.exec output exceeds ${CEDIA_PYTHON_MAX_OUTPUT_CHARS} characters`);
+	const displayOutputs = Array.isArray(result.displayOutputs) ? result.displayOutputs.length : 0;
+	return {
+		exitCode: result.exitCode ?? null,
+		output,
+		outputTruncated: result.truncated,
+		cancelled: result.cancelled,
+		displayOutputs,
+	};
+}
+
+/**
+ * Ask the session to cancel running Python execution. The answer confirms delivery: a
+ * running execution answers with cancelled, and with nothing running the call is still
+ * accepted. What was running is visible in the exec outcome, not here.
+ */
+export function abortCediaPython(session: AgentSession): { aborted: boolean } {
+	session.abortEval();
+	return { aborted: true };
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-queue-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-queue-bridge.ts
new file mode 100644
index 0000000000..6d53e3d215
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-queue-bridge.ts
@@ -0,0 +1,76 @@
+/**
+ * Cedia's queue projection for OMP RPC mode (plan §8.2 O01).
+ *
+ * OMP holds submissions the owner made while a turn was running: the steering queue and the
+ * follow-up queue. The terminal surface reads them with `getQueuedMessages()` and removes one at
+ * a time with `popLastQueuedMessage()` (the dequeue keybinding), or all at once with
+ * `clearQueue()` (`/queue` followed by the clear action). This module only projects what the
+ * session already holds, so Cedia's queue surface cannot become a second queue:
+ *
+ * - a submission becomes its text, whether that text was cut, and how many images travel with it;
+ *   image bytes never cross this projection.
+ * - a drop answers what it removed, so the window can restore the text into the draft the same way
+ *   the terminal keybinding restores it to the editor.
+ *
+ * Removing a queued submission is not an interruption of the running turn. OMP's own
+ * `clearQueue` keeps non-user queued messages (advisor cards, hidden goal/plan/budget turns), and
+ * the dropped turn identities let the host settle only the user submissions OMP actually removed.
+ */
+import type { AgentSession } from "../../session/agent-session";
+import type { RestoredQueuedMessage } from "../../session/agent-session-types";
+import type { RpcCediaQueueData, RpcCediaQueuedMessage } from "./rpc-types";
+
+/** Bound on the text one queued submission puts on the wire; a longer one is named as truncated. */
+export const CEDIA_QUEUE_MAX_TEXT_CHARS = 4096;
+
+/** Bound on how many submissions one queue answer lists. */
+export const CEDIA_QUEUE_MAX_ITEMS = 50;
+
+function queuedMessage(text: string, images: number): RpcCediaQueuedMessage {
+	const truncated = text.length > CEDIA_QUEUE_MAX_TEXT_CHARS;
+	return {
+		text: truncated ? text.slice(0, CEDIA_QUEUE_MAX_TEXT_CHARS) : text,
+		truncated,
+		images,
+	};
+}
+
+function restoredMessage(restored: RestoredQueuedMessage): RpcCediaQueuedMessage {
+	return queuedMessage(restored.text, restored.images?.length ?? 0);
+}
+
+function restoredIntentIds(restored: readonly RestoredQueuedMessage[]): string[] {
+	return restored.flatMap(message => (typeof message.cediaIntentId === "string" ? [message.cediaIntentId] : []));
+}
+
+function bounded(messages: readonly RestoredQueuedMessage[]): RpcCediaQueuedMessage[] {
+	return messages.slice(0, CEDIA_QUEUE_MAX_ITEMS).map(restoredMessage);
+}
+
+/** The queue OMP is holding for this session, as one snapshot. */
+export function readCediaQueue(session: AgentSession): RpcCediaQueueData {
+	const held = session.getQueuedMessageDetails();
+	return { steering: bounded(held.steering), followUp: bounded(held.followUp) };
+}
+
+/**
+ * Remove one queued submission (`last`, what the dequeue keybinding does) or every queued user
+ * submission (`all`), and answer both what was removed and the queue that remains.
+ *
+ * A drop with nothing to remove is not an error and not a silent success: the answer carries an
+ * empty `dropped` beside the state it read, so a control can say that there was nothing to drop.
+ */
+export function dropCediaQueueItems(session: AgentSession, mode: "last" | "all"): RpcCediaQueueData {
+	if (mode === "all") {
+		const cleared = session.clearQueue();
+		const restored = [...cleared.steering, ...cleared.followUp];
+		const dropped = restored.slice(0, CEDIA_QUEUE_MAX_ITEMS).map(restoredMessage);
+		return { ...readCediaQueue(session), dropped, droppedIntentIds: restoredIntentIds(restored) };
+	}
+	const popped = session.popLastQueuedMessage();
+	return {
+		...readCediaQueue(session),
+		dropped: popped === undefined ? [] : [restoredMessage(popped)],
+		droppedIntentIds: popped?.cediaIntentId === undefined ? [] : [popped.cediaIntentId],
+	};
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-settings-entry.ts b/packages/coding-agent/src/modes/rpc/cedia-settings-entry.ts
new file mode 100644
index 0000000000..3b94d90466
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-settings-entry.ts
@@ -0,0 +1,220 @@
+/**
+ * Taskless configuration-only entry point (plan §6.4.1 S2).
+ *
+ * Serves OMP's settings operations over the existing RPC transport with no
+ * execution session, no loaded executable packages and no model contact: the
+ * process boots Settings, claims the RPC input and answers the settings slice
+ * of the Cedia capability bridge. Reads use Settings.loadReadOnly semantics
+ * where possible; mutations use the writable lifecycle with flush and readback.
+ * A caller that names a session operation gets an explicit refusal, never a
+ * session: opening Settings must not start an executor.
+ */
+import { VERSION } from "@oh-my-pi/pi-utils";
+import { orderedSettings } from "../../config/all-settings";
+import { lookup } from "../../config/registry";
+import { Settings } from "../../config/settings";
+import {
+	CediaSettingsError,
+	SETTINGS_CREDENTIAL_WRITE,
+	SETTINGS_REJECTED,
+	SETTINGS_STALE_REVISION,
+	SETTINGS_UNKNOWN_PATH,
+	loadProjectSettingsForRead,
+	mutateGlobalSettings,
+	mutateProjectSettings,
+	previewGlobalReset,
+	readSettingsValue,
+	settingsRevisionOfInstance,
+	unsetGlobalSetting,
+} from "../../config/cedia-settings-service";
+import { createCediaCapabilityBridge } from "./cedia-capability-bridge";
+import { claimRpcInput, readRpcInputFrames } from "./rpc-input";
+import { MAX_RPC_FRAME_BYTES, MAX_RPC_REASSEMBLED_BYTES, RpcFrameEncoder } from "./rpc-frame";
+import { RpcOutputWriter } from "./rpc-output";
+import type { RpcCediaSettingsMutatePayload } from "./rpc-types";
+
+/** Operations the configuration service answers; everything else is refused. */
+export const CEDIA_SETTINGS_SERVICE_OPERATIONS = [
+	"settings.keys.list",
+	"settings.keys.describe",
+	"settings.get",
+	"settings.set",
+	"settings.unset",
+	"settings.mutate",
+	"settings.reset.preview",
+] as const;
+
+export const CEDIA_SETTINGS_SERVICE_VERSION = 1;
+
+type JsonRecord = Record<string, unknown>;
+
+function isRecord(value: unknown): value is JsonRecord {
+	return !!value && typeof value === "object" && !Array.isArray(value);
+}
+
+/**
+ * Run the configuration service on the RPC transport. Never returns: stdin EOF
+ * (the host closing) flushes and exits, anything else is answered or refused.
+ */
+export async function runCediaSettingsService(input = claimRpcInput()): Promise<never> {
+	process.env.PI_NOTIFICATIONS = "off";
+	const settings = await Settings.init({});
+	const frameEncoder = new RpcFrameEncoder();
+	const output = new RpcOutputWriter(process.stdout, failure => {
+		process.stderr.write(`Cedia settings service output failed: ${String(failure)}\n`);
+		process.exit(1);
+	});
+	const write = (frame: Record<string, unknown>): void => {
+		for (const line of frameEncoder.encodeFrames(frame)) output.write([line]);
+	};
+	const success = (id: string | undefined, command: string, data?: object | null) =>
+		id === undefined
+			? { type: "response", command, success: true }
+			: { type: "response", id, command, success: true, ...(data === undefined ? {} : { data }) };
+	const failure = (id: string | undefined, command: string, message: string, code?: string) => ({
+		type: "response",
+		...(id === undefined ? {} : { id }),
+		command,
+		success: false,
+		error: message,
+		...(code === undefined ? {} : { code }),
+	});
+
+	const bridge = createCediaCapabilityBridge({
+		ompRevision: `omp/${VERSION}`,
+		operations: [...CEDIA_SETTINGS_SERVICE_OPERATIONS],
+		handlers: {
+			"settings.revision": () => settingsRevisionOfInstance(settings),
+			"settings.get": (path: string, scope?: "global" | "project" | "session", projectDir?: string) => {
+				if (scope === undefined || scope === "global") return readSettingsValue(settings, path, "global");
+				if (scope === "session")
+					throw new Error(
+						"settings.get with session scope needs a live task owner; this service owns configuration only",
+					);
+				return loadProjectSettingsForRead(String(projectDir)).then(project =>
+					readSettingsValue(project, path, "project"),
+				);
+			},
+			"settings.set": async (path: string, value: unknown) => {
+				const handle = orderedSettings().find(setting => setting.id === path) ?? lookup(path);
+				if (handle === undefined) throw new Error(`${path} is not a setting this runtime defines`);
+				handle.set(settings, value as never);
+				await settings.flush();
+				return readSettingsValue(settings, path, "global");
+			},
+			"settings.unset": (path: string, expectedRevision?: string) =>
+				unsetGlobalSetting(settings, path, expectedRevision, "global"),
+			"settings.mutate": (payload: RpcCediaSettingsMutatePayload) => {
+				if (payload.context.scope === "project")
+					return mutateProjectSettings(payload.context.projectDir, payload.changes, payload.expectedRevision).then(
+						result => ({ scope: "project", values: result.values }),
+					);
+				return mutateGlobalSettings(settings, payload, "global");
+			},
+			"settings.reset.preview": (paths: string[]) => previewGlobalReset(settings, paths, "global"),
+			// The operations filter above guarantees only settings handlers run; the cast
+			// covers session-only handlers this service never advertises.
+		} as unknown as import("./cedia-capability-bridge").CediaCapabilityHandlers,
+	});
+
+	write({
+		type: "ready",
+		protocolVersion: 1,
+		supportedProtocolVersions: [1, 2],
+		maxFrameBytes: MAX_RPC_FRAME_BYTES,
+		maxReassembledFrameBytes: MAX_RPC_REASSEMBLED_BYTES,
+		cediaCapabilitiesVersion: 1,
+		cediaSettingsServiceVersion: CEDIA_SETTINGS_SERVICE_VERSION,
+	});
+
+	const onFrame = (frame: unknown): void => {
+		void (async () => {
+			if (!isRecord(frame) || typeof frame.type !== "string") return;
+			const id = typeof frame.id === "string" ? frame.id : undefined;
+			if (frame.type === "negotiate_protocol") {
+				if (frame.protocolVersion !== 2) {
+					write(
+						failure(
+							id,
+							"negotiate_protocol",
+							`Unsupported RPC protocol version: ${String(frame.protocolVersion)}`,
+						),
+					);
+					return;
+				}
+				frameEncoder.setProtocolVersion(2);
+				write(success(id, "negotiate_protocol", { protocolVersion: 2 }));
+				return;
+			}
+			if (frame.type === "cedia_get_capabilities") {
+				write(success(id, "cedia_get_capabilities", bridge.table() as unknown as object));
+				return;
+			}
+			if (frame.type === "cedia_control") {
+				const operation = typeof frame.operation === "string" ? frame.operation : "";
+				let outcome: Awaited<ReturnType<typeof bridge.control>>;
+				try {
+					outcome = await bridge.control({
+						operation,
+						...(isRecord(frame.payload) ? { payload: frame.payload } : {}),
+						...(typeof frame.capabilityRevision === "string"
+							? { capabilityRevision: frame.capabilityRevision }
+							: {}),
+					});
+				} catch (error) {
+					// A handler refusal carries its typed code instead of killing the
+					// transport: a stale revision is a retryable conflict, never a crash.
+					if (error instanceof CediaSettingsError) {
+						const code =
+							error.code === SETTINGS_STALE_REVISION
+								? "cedia_control_stale_settings_revision"
+								: error.code === SETTINGS_UNKNOWN_PATH ||
+										error.code === SETTINGS_CREDENTIAL_WRITE ||
+										error.code === SETTINGS_REJECTED
+									? "cedia_control_invalid_payload"
+									: "cedia_control_handler_error";
+						write(failure(id, "cedia_control", error.message, code));
+						return;
+					}
+					throw error;
+				}
+				if (!outcome.ok) {
+					write(failure(id, "cedia_control", outcome.error, outcome.code));
+					return;
+				}
+				write(
+					success(id, "cedia_control", {
+						operation: outcome.operation,
+						capabilityRevision: outcome.capabilityRevision,
+						result: outcome.result as object,
+					}),
+				);
+				return;
+			}
+			write(
+				failure(
+					id,
+					String(frame.type),
+					`The configuration service answers settings operations only: ${String(frame.type)} is refused without starting a session`,
+					"cedia_settings_service_only",
+				),
+			);
+		})();
+	};
+
+	let exited = false;
+	const exit = (code: number): void => {
+		if (exited) return;
+		exited = true;
+		void output.close().finally(() => process.exit(code));
+	};
+	process.on("SIGTERM", () => exit(0));
+	process.on("SIGINT", () => exit(0));
+
+	await readRpcInputFrames(input, onFrame, message => {
+		process.stderr.write(`Cedia settings service input: ${message}\n`);
+	});
+	await settings.flush().catch(() => undefined);
+	exit(0);
+	return new Promise<never>(() => undefined);
+}
diff --git a/packages/coding-agent/src/modes/rpc/cedia-tools-bridge.ts b/packages/coding-agent/src/modes/rpc/cedia-tools-bridge.ts
new file mode 100644
index 0000000000..59a2d32240
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/cedia-tools-bridge.ts
@@ -0,0 +1,132 @@
+/**
+ * Cedia's read-only tool-catalog projection for OMP RPC mode (plan §8.2 O06).
+ *
+ * This is the discovery half of O06, not its management half: it answers what the session's own
+ * tool registry holds right now so a client can draw an honest catalog and classify dynamic tools
+ * (O05 `generate_image`/`tts`, O06 custom/extension and `mcp__<server>_<tool>` rows) as present or
+ * absent instead of guessing. It performs no registry mutation and never starts a discovery pass:
+ *
+ * - identity comes from the session's own `getAllToolInfos()` (the same `ToolInfo[]` the
+ *   extension API publishes, with `sourceInfo.source` as OMP classifies it);
+ * - activation comes from the session's own `getActiveToolNames()` (the tools currently exposed
+ *   at the top level, which is what the model can actually call);
+ * - the wire carries name, a bounded description, source class and active flag only. Full JSON
+ *   parameter schemas stay in the runtime: they are unbounded, versioned per tool, and a catalog
+ *   probe does not need them to say whether a tool exists.
+ *
+ * A tool the registry does not hold is absent from the answer rather than reported as disabled,
+ * and a description longer than the bound is truncated with its flag set instead of being sent
+ * whole. Management operations (`setActiveToolsByName`, `refreshMCPTools`, `refreshSkills`,
+ * `refreshRpcHostTools`, `reload`, code-mode partitions) remain O06 work with their own gates.
+ */
+import type { AgentSession } from "../../session/agent-session";
+
+/** Largest tool description a catalog answer may carry per row. */
+export const CEDIA_TOOL_CATALOG_DESCRIPTION_MAX_CHARS = 500;
+
+/** Largest tool catalog a catalog answer may carry. */
+export const CEDIA_TOOL_CATALOG_MAX_TOOLS = 500;
+
+/** Source classes OMP's own registry reports for one tool. */
+export type CediaToolSource = "builtin" | "mcp" | "sdk" | "extension";
+
+export type CediaToolCatalogEntry = {
+	name: string;
+	description: string;
+	descriptionTruncated: boolean;
+	source: CediaToolSource;
+	active: boolean;
+};
+
+export type CediaToolCatalogData = {
+	tools: CediaToolCatalogEntry[];
+	truncated: boolean;
+	total: number;
+	activeCount: number;
+};
+
+function sourceOf(raw: unknown): CediaToolSource {
+	return raw === "builtin" || raw === "mcp" || raw === "sdk" || raw === "extension" ? raw : "extension";
+}
+
+/** Largest tool-name list an activation write may carry. */
+export const CEDIA_TOOL_CATALOG_SET_MAX_NAMES = 500;
+
+/** Run the session's own activation change and answer the catalog that follows. */
+export async function setCediaActiveTools(
+	session: AgentSession,
+	toolNames: readonly string[],
+): Promise<CediaToolCatalogData> {
+	await session.setActiveToolsByName([...toolNames]);
+	return readCediaToolCatalog(session);
+}
+
+/** Re-run the session's own skill rediscovery and answer the catalog that follows. */
+export async function refreshCediaSkills(session: AgentSession): Promise<CediaToolCatalogData> {
+	await session.refreshSkills();
+	return readCediaToolCatalog(session);
+}
+
+/** Largest Code Mode projection a code-mode answer may carry. */
+export const CEDIA_CODE_MODE_MAX_NAMES = 500;
+export const CEDIA_CODE_MODE_MAX_PRELUDES = 100;
+
+export type CediaCodeModePrelude = {
+	name: string;
+	enabled: boolean;
+};
+
+export type CediaCodeModeData = {
+	/** Whether Code Mode's direct partition is engaged (undefined direct names read as off). */
+	active: boolean;
+	/** Tools left directly model-visible by Code Mode; null when Code Mode is inactive. */
+	directToolNames: string[] | null;
+	/** Eval prelude namespaces by name and live enabled flag. Sources never cross. */
+	preludes: CediaCodeModePrelude[];
+};
+
+/**
+ * Read the session's own Code Mode partition for the Cedia wire (plan §8.2 O06).
+ *
+ * This is the same `getCodeModeDirectToolNames()` the eval tool consults and the same
+ * `getEvalPreludes()` the browser/computer gates consult. The wire carries names and one
+ * boolean each: a prelude's `javascript`/`python` sources, documentation and exports stay
+ * in the runtime — a catalog probe must never name executable source text.
+ */
+export function readCediaCodeMode(session: AgentSession): CediaCodeModeData {
+	const direct = session.getCodeModeDirectToolNames();
+	const directToolNames = direct === undefined
+		? null
+		: direct.filter(name => typeof name === "string" && name.trim().length > 0).slice(0, CEDIA_CODE_MODE_MAX_NAMES);
+	const preludes: CediaCodeModePrelude[] = [];
+	for (const definition of session.getEvalPreludes().slice(0, CEDIA_CODE_MODE_MAX_PRELUDES)) {
+		if (!definition || typeof definition.name !== "string" || definition.name.trim().length === 0) continue;
+		preludes.push({ name: definition.name, enabled: definition.enabled?.() !== false });
+	}
+	return { active: direct !== undefined, directToolNames, preludes };
+}
+
+/** Read the session's own tool registry and activation state for the Cedia wire. */
+export function readCediaToolCatalog(session: AgentSession): CediaToolCatalogData {
+	const infos = session.getAllToolInfos();
+	const active = new Set(session.getActiveToolNames());
+	const entries: CediaToolCatalogEntry[] = [];
+	for (const info of infos.slice(0, CEDIA_TOOL_CATALOG_MAX_TOOLS)) {
+		if (!info || typeof info.name !== "string" || info.name.trim().length === 0) continue;
+		const description = typeof info.description === "string" ? info.description : "";
+		const source = sourceOf((info.sourceInfo as { source?: unknown } | undefined)?.source);
+		entries.push({
+			name: info.name,
+			description: description.slice(0, CEDIA_TOOL_CATALOG_DESCRIPTION_MAX_CHARS),
+			descriptionTruncated: description.length > CEDIA_TOOL_CATALOG_DESCRIPTION_MAX_CHARS,
+			source,
