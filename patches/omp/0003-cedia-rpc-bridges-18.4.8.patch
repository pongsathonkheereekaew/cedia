+/**
+ * Cedia's usage projection for OMP RPC mode (plan §8.2 O03).
+ *
+ * Usage belongs to OMP and to the provider: `fetchUsageReports` asks the auth storage, which asks
+ * each provider's own reporting endpoint. Cedia's job is to carry that answer without inventing
+ * one. Two rules shape this projection:
+ *
+ * - **Unknown is not zero.** A runtime whose auth storage cannot report usage answers `supported:
+ *   false`; a fetch that fails keeps the runtime's own message instead of an empty list that would
+ *   read like "no usage". The only zero here is a provider that reported zero.
+ * - **Bounded, and no credential.** Limits, notes and credit details are capped, and the projection
+ *   carries the account identity the provider itself reported (which an owner needs to tell two
+ *   accounts apart) rather than anything from the credential store.
+ *
+ * The fetch is also where OMP's own salvage sweep is triggered. That path stays OMP's: the sweep
+ * reads the session's effective `codexResets.autoRedeem`, so a Cedia-controlled session's guard
+ * (see `cedia-policy.ts`) applies to a usage read exactly as it does anywhere else.
+ */
+import type { AgentSession } from "../../session/agent-session";
+import type { RpcCediaUsageData, RpcCediaUsageLimit, RpcCediaUsageReport } from "./rpc-types";
+
+/** Bound on how many reports, limits and credit rows one answer carries. */
+export const CEDIA_USAGE_MAX_ITEMS = 20;
+
+/** Bound on one note string, so a provider cannot push an unbounded blob through this surface. */
+export const CEDIA_USAGE_MAX_NOTE_CHARS = 512;
+
+function bounded(items: readonly string[] | undefined): string[] | undefined {
+	if (items === undefined || items.length === 0) return undefined;
+	return items.slice(0, CEDIA_USAGE_MAX_ITEMS).map(note => note.slice(0, CEDIA_USAGE_MAX_NOTE_CHARS));
+}
+
+function limitOf(limit: {
+	id: string;
+	label: string;
+	scope?: { provider?: string; accountId?: string };
+	window?: { id: string; label: string; resetsAt?: number };
+	amount: { usedFraction?: number; used?: number; limit?: number; remainingFraction?: number; unit: string };
+	status?: string;
+	notes?: readonly string[];
+}): RpcCediaUsageLimit {
+	return {
+		id: limit.id,
+		label: limit.label,
+		...(limit.scope === undefined ? {} : { scope: { ...limit.scope } }),
+		...(limit.window === undefined ? {} : { window: { ...limit.window } }),
+		// The amount travels as the provider reported it: a field it did not send stays absent, which
+		// is what lets a client say "unknown" instead of drawing a zero.
+		amount: {
+			unit: limit.amount.unit,
+			...(limit.amount.usedFraction === undefined ? {} : { usedFraction: limit.amount.usedFraction }),
+			...(limit.amount.used === undefined ? {} : { used: limit.amount.used }),
+			...(limit.amount.limit === undefined ? {} : { limit: limit.amount.limit }),
+			...(limit.amount.remainingFraction === undefined ? {} : { remainingFraction: limit.amount.remainingFraction }),
+		},
+		...(limit.status === undefined ? {} : { status: limit.status }),
+		...(bounded(limit.notes) === undefined ? {} : { notes: bounded(limit.notes)! }),
+	};
+}
+
+function reportOf(report: {
+	provider: string;
+	fetchedAt: number;
+	limits: readonly Parameters<typeof limitOf>[0][];
+	resetCredits?: { availableCount: number; credits?: readonly { grantedAt?: string; expiresAt?: string; status?: string }[] };
+	notes?: readonly string[];
+	metadata?: Record<string, unknown>;
+}): RpcCediaUsageReport {
+	const accountId = typeof report.metadata?.accountId === "string" ? report.metadata.accountId : undefined;
+	const accountEmail = typeof report.metadata?.email === "string" ? report.metadata.email : undefined;
+	const limitReached = typeof report.metadata?.limitReached === "boolean" ? report.metadata.limitReached : undefined;
+	return {
+		provider: report.provider,
+		fetchedAt: report.fetchedAt,
+		limits: report.limits.slice(0, CEDIA_USAGE_MAX_ITEMS).map(limitOf),
+		...(report.resetCredits === undefined
+			? {}
+			: {
+					resetCredits: {
+						availableCount: report.resetCredits.availableCount,
+						...(report.resetCredits.credits === undefined
+							? {}
+							: {
+									credits: report.resetCredits.credits.slice(0, CEDIA_USAGE_MAX_ITEMS).map(credit => ({
+										...(credit.grantedAt === undefined ? {} : { grantedAt: credit.grantedAt }),
+										...(credit.expiresAt === undefined ? {} : { expiresAt: credit.expiresAt }),
+										...(credit.status === undefined ? {} : { status: credit.status }),
+									})),
+								}),
+					},
+				}),
+		...(bounded(report.notes) === undefined ? {} : { notes: bounded(report.notes)! }),
+		...(accountId === undefined ? {} : { accountId }),
+		...(accountEmail === undefined ? {} : { accountEmail }),
+		...(limitReached === undefined ? {} : { limitReached }),
+	};
+}
+
+/**
+ * Ask OMP for a fresh usage snapshot.
+ *
+ * A runtime that cannot report usage at all says so (`supported: false`); a fetch that fails keeps
+ * the runtime's own message in `unavailable` beside whatever reports already arrived, so a client
+ * can show the failure instead of an empty table.
+ */
+export async function readCediaUsage(session: AgentSession): Promise<RpcCediaUsageData> {
+	let reports: Awaited<ReturnType<AgentSession["fetchUsageReports"]>> = [];
+	try {
+		reports = await session.fetchUsageReports();
+	} catch (error) {
+		return { reports: [], unavailable: error instanceof Error ? error.message : String(error) };
+	}
+	if (reports === null) {
+		return {
+			reports: [],
+			supported: false,
+			unavailable: "This runtime's auth storage does not report provider usage.",
+		};
+	}
+	return { reports: reports.slice(0, CEDIA_USAGE_MAX_ITEMS).map(reportOf) };
+}
