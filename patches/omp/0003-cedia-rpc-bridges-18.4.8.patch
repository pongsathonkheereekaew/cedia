+/**
+ * Cedia's capability contract for OMP RPC mode (plan §8.2 O04).
+ *
+ * Two negotiated operations make the runtime's own capability table readable
+ * and its registered controls callable:
+ *
+ * - `cedia_get_capabilities` answers the descriptor table below plus the
+ *   revision that identifies exactly that table.
+ * - `cedia_control` runs one *registered* operation by id. The id is looked up
+ *   in this file's static table, so a payload can never name arbitrary
+ *   JavaScript, an executable or source text: an unknown key inside a payload is
+ *   rejected by that operation's own validator, and an unknown operation is
+ *   rejected before any handler runs.
+ *
+ * The handlers are injected by the RPC mode rather than imported from it, so
+ * this file stays free of a cycle and every registered operation reuses the one
+ * implementation OMP already has.
+ *
+ * Scope of this file: the table, its revision, payload validation and dispatch.
+ * Authorization is deliberately not here - the runtime has exactly one transport
+ * client, so a descriptor declares its `principal` and the embedding host, which
+ * does know whether a caller is the owner or a controller, enforces it.
+ */
+import { createHash } from "node:crypto";
+import type { AgentMessage } from "@oh-my-pi/pi-agent-core";
+import type { ServiceTier, ServiceTierFamily } from "@oh-my-pi/pi-ai";
+import { isRecord, sanitizeText } from "@oh-my-pi/pi-utils";
+import { shortenPath, toPathList } from "@oh-my-pi/pi-tui/render/render-utils";
+import { resolveAssistantErrorPresentation } from "@oh-my-pi/pi-tui/chat/transcript-render-helpers";
+import type { Settings } from "../../config/settings";
+import { orderedSettings } from "../../config/all-settings";
+import { lookup } from "../../config/registry";
+import { buildSettingsInventory, prevalidateChanges } from "../../config/cedia-settings-service";
+import { validateProviderMaxInFlightRequests } from "../../session/settings";
+import type { AgentSession } from "../../session/agent-session";
+import { CEDIA_ADVISOR_CONFIG_MAX_CHARS } from "./cedia-advisor-config-bridge";
+import { CEDIA_PYTHON_MAX_CHARS } from "./cedia-python-bridge";
+import type { SessionTreeNode } from "../../session/session-entries";
+import type {
+	RpcCediaCapabilitiesData,
+	RpcCediaCapabilityDescriptor,
+	RpcCediaCapabilityFamily,
+	RpcCediaCapabilityState,
+	RpcCediaControlOutcome,
+	RpcCediaControlRequest,
+	RpcCediaSettingsKey,
+	RpcCediaSettingsKeysData,
+	RpcCediaSettingsMutatePayload,
+	RpcCediaSettingsScope,
+} from "./rpc-types";
+import { CEDIA_TOOL_CATALOG_SET_MAX_NAMES } from "./cedia-tools-bridge";
+const CEDIA_TREE_MAX_NODES = 500;
+const CEDIA_TREE_MAX_PATH_IDS = 200;
+const CEDIA_TREE_LABEL_MAX_CHARS = 160;
+const CEDIA_TREE_EDITOR_TEXT_MAX_CHARS = 65_536;
+
+type CediaTreeNodeData = {
+	id: string;
+	parentId: string | null;
+	kind: string;
+	timestamp: string;
+	label: string;
+	labelTruncated: boolean;
+};
+
+type CediaTreeData = {
+	leafId: string | null;
+	nodes: CediaTreeNodeData[];
+	pathIds: string[];
+	truncated: boolean;
+	lineage: {
+		sessionFile: string;
+		parentSession: string | null;
+		previousSessionFiles: string[];
+	};
+};
+
+/** The tree selector's text extraction keeps only text blocks and folds line breaks into spaces. */
+function cediaTreeText(content: unknown): string {
+	if (typeof content === "string") return content;
+	if (!Array.isArray(content)) return "";
+	let result = "";
+	for (const block of content) {
+		if (
+			typeof block === "object" &&
+			block !== null &&
+			"type" in block &&
+			block.type === "text" &&
+			"text" in block &&
+			typeof block.text === "string"
+		)
+			result += block.text;
+	}
+	return result;
+}
+
+function normalizeCediaTreeText(text: string): string {
+	return text.replace(/[\n\t]/g, " ").trim();
+}
+
+function sanitizeCediaTreeField(value: string): string {
+	return sanitizeText(value)
+		.replace(/[\n\t]/g, " ")
+		.trim();
+}
+
+function cediaAdvisorTreeDisplay(details: unknown): { qualifier: string; text: string } {
+	if (!isRecord(details) || !Array.isArray(details.notes)) return { qualifier: "", text: "" };
+	const notes: string[] = [];
+	const advisors: string[] = [];
+	const severities: string[] = [];
+	for (const note of details.notes) {
+		if (!isRecord(note)) continue;
+		if (typeof note.note === "string") notes.push(note.note);
+		if (typeof note.advisor === "string") {
+			const advisor = sanitizeCediaTreeField(note.advisor);
+			if (advisor && advisor !== "default" && !advisors.includes(advisor)) advisors.push(advisor);
+		}
+		if (typeof note.severity === "string") {
+			const severity = sanitizeCediaTreeField(note.severity);
+			if (severity && !severities.includes(severity)) severities.push(severity);
+		}
+	}
+	return { qualifier: [...advisors, ...severities].join(", "), text: notes.join(" ") };
+}
+
+function stripCediaTreeSystemWrapperTags(content: string): string {
+	const trimmed = content.trim();
+	const opening = /^<(system-[\w-]+)/i.exec(trimmed);
+	if (!opening) return content;
+
+	const attributeStart = opening[0].length;
+	const firstAttributeCharacter = trimmed[attributeStart];
+	if (firstAttributeCharacter !== ">" && !/\s/.test(firstAttributeCharacter ?? "")) return content;
+
+	let quote: '"' | "'" | undefined;
+	let openingEnd = -1;
+	for (let index = attributeStart; index < trimmed.length; index++) {
+		const character = trimmed[index];
+		if (quote) {
+			if (character === quote) quote = undefined;
+		} else if (character === '"' || character === "'") {
+			quote = character;
+		} else if (character === "<") {
+			return content;
+		} else if (character === ">") {
+			openingEnd = index;
+			break;
+		}
+	}
+	if (openingEnd === -1 || quote) return content;
+
+	const closingTag = `</${opening[1]}>`;
+	const closingStart = trimmed.length - closingTag.length;
+	if (closingStart <= openingEnd || trimmed.slice(closingStart).toLowerCase() !== closingTag.toLowerCase())
+		return content;
+	return trimmed.slice(openingEnd + 1, closingStart).trim();
+}
+
+function formatCediaTreeToolCall(name: string, args: Record<string, unknown>): string {
+	switch (name) {
+		case "read": {
+			const path = shortenPath(String(args.path || args.file_path || ""));
+			const offset = args.offset as number | undefined;
+			const limit = args.limit as number | undefined;
+			let display = path;
+			if (offset !== undefined || limit !== undefined) {
+				const start = offset ?? 1;
+				const end = limit !== undefined ? start + limit - 1 : "";
+				display += `:${start}${end ? `-${end}` : ""}`;
+			}
+			return `[read: ${display}]`;
+		}
+		case "write": {
+			const path = shortenPath(String(args.path || args.file_path || ""));
+			return `[write: ${path}]`;
+		}
+		case "edit": {
+			const path = shortenPath(String(args.path || args.file_path || ""));
+			return `[edit: ${path}]`;
+		}
+		case "bash": {
+			const rawCommand = String(args.command || "");
+			const command = rawCommand
+				.replace(/[\n\t]/g, " ")
+				.trim()
+				.slice(0, 50);
+			return `[bash: ${command}${rawCommand.length > 50 ? "..." : ""}]`;
+		}
+		case "grep": {
+			const pattern = String(args.pattern || "");
+			const pathsInput =
+				typeof args.paths === "string" || Array.isArray(args.paths)
+					? (args.paths as string | string[])
+					: typeof args.path === "string"
+						? args.path
+						: undefined;
+			const paths = toPathList(pathsInput);
+			const scope = paths.length > 0 ? paths.join(", ") : ".";
+			return `[grep: /${pattern}/ in ${shortenPath(scope)}]`;
+		}
+		case "glob": {
+			const globInput =
+				typeof args.path === "string"
+					? args.path
+					: typeof args.paths === "string" || Array.isArray(args.paths)
+						? (args.paths as string | string[])
+						: undefined;
+			const paths = toPathList(globInput);
+			const scope = paths.length > 0 ? paths.join(", ") : ".";
+			return `[glob: ${shortenPath(scope)}]`;
+		}
+		case "ls":
+			return `[ls: ${shortenPath(String(args.path || "."))}]`;
+		default: {
+			const serialized = JSON.stringify(args);
+			const bounded = serialized.slice(0, 40);
+			return `[${name}: ${bounded}${serialized.length > 40 ? "..." : ""}]`;
+		}
+	}
+}
+
+function cediaTreeEntryLabel(
+	node: SessionTreeNode,
+	toolCalls: ReadonlyMap<string, { name: string; arguments: Record<string, unknown> }>,
+): string {
+	const entry = node.entry;
+	let label: string;
+	if (entry.type === "message") {
+		const message = entry.message as unknown as Record<string, unknown> & { role: string };
+		const role = message.role;
+		if (role === "user" || role === "developer") {
+			const prefix = role === "user" ? "user: " : "developer: ";
+			label = prefix + normalizeCediaTreeText(cediaTreeText(message.content).slice(0, 200));
+		} else if (role === "assistant") {
+			const presentation = resolveAssistantErrorPresentation(
+				entry.message as Extract<AgentMessage, { role: "assistant" }>,
+			);
+			if (presentation.kind === "compact-recovered") {
+				label = `assistant: ${presentation.text}`;
+			} else {
+				const text = normalizeCediaTreeText(cediaTreeText(message.content));
+				if (text) label = `assistant: ${text}`;
+				else if (presentation.kind === "full")
+					label = `assistant: ${normalizeCediaTreeText(presentation.text).slice(0, 80)}`;
+				else if (message.stopReason === "aborted") label = "assistant: (aborted)";
+				else label = "assistant: (no content)";
+			}
+		} else if (role === "toolResult") {
+			const toolCallId = typeof message.toolCallId === "string" ? message.toolCallId : undefined;
+			const toolCall = toolCallId === undefined ? undefined : toolCalls.get(toolCallId);
+			label = toolCall
+				? formatCediaTreeToolCall(toolCall.name, toolCall.arguments)
+				: `[${String(message.toolName ?? "tool")}]`;
+		} else if (role === "bashExecution") {
+			label = `[bash]: ${normalizeCediaTreeText(String(message.command ?? ""))}`;
+		} else {
+			label = `[${role}]`;
+		}
+	} else {
+		switch (entry.type) {
+			case "custom_message": {
+				if (entry.customType === "advisor") {
+					const { qualifier, text } = cediaAdvisorTreeDisplay(entry.details);
+					label = `${qualifier ? `advisor (${qualifier})` : "advisor"}: ${normalizeCediaTreeText(text)}`;
+				} else {
+					const content = stripCediaTreeSystemWrapperTags(cediaTreeText(entry.content));
+					label = `[${entry.customType}]: ${normalizeCediaTreeText(content)}`;
+				}
+				break;
+			}
+			case "compaction":
+				label = `[compaction: ${Math.round(entry.tokensBefore / 1000)}k tokens]`;
+				break;
+			case "branch_summary":
+				label = `[branch summary]: ${normalizeCediaTreeText(entry.summary)}`;
+				break;
+			case "model_change":
+				label = `[model: ${entry.model}]`;
+				break;
+			case "model_usage": {
+				const purpose = sanitizeCediaTreeField(entry.purpose);
+				const role = sanitizeCediaTreeField(entry.role ?? "");
+				const provider = sanitizeCediaTreeField(entry.provider);
+				const model = sanitizeCediaTreeField(entry.model);
+				label = `[model usage: ${purpose} ${role ? `${role} ` : ""}${provider}/${model}]`;
+				break;
+			}
+			case "thinking_level_change":
+				label = `[thinking: ${entry.thinkingLevel ?? "off"}]`;
+				break;
+			case "custom":
+				label = `[custom: ${entry.customType}]`;
+				break;
+			case "label":
+				label = `[label: ${entry.label ?? "(cleared)"}]`;
+				break;
+			case "service_tier_change": {
+				const tiers = entry.serviceTier
+					? Object.entries(entry.serviceTier)
+							.map(([family, tier]) => `${family}:${tier}`)
+							.join(" ")
+					: "(default)";
+				label = `[service tier: ${tiers}]`;
+				break;
+			}
+			case "title_change":
+				label = `[title: ${normalizeCediaTreeText(entry.title)}]`;
+				break;
+			case "mode_change":
+				label = `[mode: ${entry.mode}]`;
+				break;
+			case "credential_pin":
+				label = `[credential pin: ${entry.provider}]`;
+				break;
+			default:
+				label = `[${entry.type.replaceAll("_", " ")}]`;
+		}
+	}
+	return node.label ? `[${node.label}] ${label}` : label;
+}
+
+function flattenCediaTree(roots: readonly SessionTreeNode[]): SessionTreeNode[] {
+	const flattened: SessionTreeNode[] = [];
+	const stack = [...roots].reverse();
+	while (stack.length > 0) {
+		const node = stack.pop()!;
+		flattened.push(node);
+		for (let index = node.children.length - 1; index >= 0; index--) stack.push(node.children[index]);
+	}
+	return flattened;
+}
+
+/** Read the runtime's own session tree and selector labels for the Cedia wire. */
+export function readCediaTree(session: AgentSession): CediaTreeData {
+	const manager = session.sessionManager;
+	const tree = manager.getTree();
+	const flattened = flattenCediaTree(tree);
+	const toolCalls = new Map<string, { name: string; arguments: Record<string, unknown> }>();
+	for (const node of flattened) {
+		if (
+			node.entry.type !== "message" ||
+			node.entry.message.role !== "assistant" ||
+			!Array.isArray(node.entry.message.content)
+		)
+			continue;
+		for (const block of node.entry.message.content) {
+			if (
+				typeof block === "object" &&
+				block !== null &&
+				"type" in block &&
+				block.type === "toolCall" &&
+				"id" in block &&
+				typeof block.id === "string" &&
+				"name" in block &&
+				typeof block.name === "string" &&
+				"arguments" in block &&
+				typeof block.arguments === "object" &&
+				block.arguments !== null &&
+				!Array.isArray(block.arguments)
+			)
+				toolCalls.set(block.id, { name: block.name, arguments: block.arguments as Record<string, unknown> });
+		}
+	}
+	const nodes = flattened.slice(0, CEDIA_TREE_MAX_NODES).map(node => {
+		const fullLabel = cediaTreeEntryLabel(node, toolCalls);
+		return {
+			id: node.entry.id,
+			parentId: node.entry.parentId,
+			kind: node.entry.type === "message" ? node.entry.message.role : node.entry.type,
+			timestamp: node.entry.timestamp,
+			label: fullLabel.slice(0, CEDIA_TREE_LABEL_MAX_CHARS),
+			labelTruncated: fullLabel.length > CEDIA_TREE_LABEL_MAX_CHARS,
+		};
+	});
+	const leafId = manager.getLeafId();
+	const pathIds = manager
+		.getBranch()
+		.map(entry => entry.id)
+		.slice(0, CEDIA_TREE_MAX_PATH_IDS);
+	const header = manager.getHeader();
+	return {
+		leafId,
+		nodes,
+		pathIds,
+		truncated: flattened.length > CEDIA_TREE_MAX_NODES || manager.getBranch().length > CEDIA_TREE_MAX_PATH_IDS,
+		lineage: {
+			sessionFile: manager.getSessionFile() ?? "",
+			parentSession: header?.parentSession ?? null,
+			previousSessionFiles: header?.previousSessionFiles === undefined ? [] : [...header.previousSessionFiles],
+		},
+	};
+}
+
+/** Navigate through OMP's own session method and reduce its result to the Cedia wire. */
+export async function navigateCediaTree(
+	session: AgentSession,
+	payload: { entryId: string; summarize?: boolean },
+): Promise<{
+	moved: boolean;
+	cancelled: boolean;
+	aborted: boolean;
+	askReopen: boolean;
+	summarized: boolean;
+	editorText: string | null;
+	editorTextTruncated: boolean;
+	editorImageCount: number;
+	leafId: string | null;
+}> {
+	const beforeLeafId = session.sessionManager.getLeafId();
+	const result = await session.navigateTree(payload.entryId, { summarize: payload.summarize === true });
+	const afterLeafId = session.sessionManager.getLeafId();
+	const askReopen = result.reopenAsk !== undefined;
+	const aborted = result.aborted === true;
+	const cancelled = result.cancelled === true;
+	const editorText = result.editorText;
+	const boundedEditorText = editorText === undefined ? null : editorText.slice(0, CEDIA_TREE_EDITOR_TEXT_MAX_CHARS);
+	return {
+		// User/custom-message targets hand their text back to the editor while leaving the leaf on
+		// the target's parent. Compare the requested target as well as the resulting leaf so that
+		// this real navigation is not mistaken for a no-op merely because the leaf id is unchanged.
+		moved: !cancelled && !aborted && !askReopen && (payload.entryId !== beforeLeafId || beforeLeafId !== afterLeafId),
+		cancelled,
+		aborted,
+		askReopen,
+		summarized: result.summaryEntry !== undefined,
+		editorText: boundedEditorText,
+		editorTextTruncated: editorText !== undefined && editorText.length > CEDIA_TREE_EDITOR_TEXT_MAX_CHARS,
+		editorImageCount: result.editorImages?.length ?? 0,
+		leafId: afterLeafId,
+	};
+}
+
+/** Bridge generation. Bumping it changes what a client may assume. */
+export const CEDIA_CAPABILITY_BRIDGE_VERSION = 1;
+
+/** Schema generation of the descriptor and each operation's payload. */
+export const CEDIA_CAPABILITY_SCHEMA_VERSION = 1;
+
+/** Runtime service-tier vocabulary exposed to the model picker. */
+export const CEDIA_SERVICE_TIER_FAMILIES = [
+	"openai",
+	"anthropic",
+	"google",
+] as const satisfies readonly ServiceTierFamily[];
+export const CEDIA_SERVICE_TIERS = [
+	"auto",
+	"default",
+	"flex",
+	"scale",
+	"priority",
+] as const satisfies readonly ServiceTier[];
+
+/** A registered operation: its descriptor, its payload rule and its handler. */
+interface CediaRegisteredOperation {
+	readonly id: string;
+	readonly family: RpcCediaCapabilityFamily;
+	readonly scope: RpcCediaCapabilityDescriptor["scope"];
+	readonly apply: RpcCediaCapabilityDescriptor["apply"];
+	readonly surfaces: RpcCediaCapabilityDescriptor["surfaces"];
+	readonly principal: RpcCediaCapabilityDescriptor["principal"];
+	readonly source: string;
+	readonly receipt?: string;
+	/**
+	 * Reject a payload by returning a message. A registered operation that takes
+	 * no fields refuses a non-empty payload instead of ignoring it, and one that
+	 * takes a field checks it against OMP's own schema here, so an unknown key is
+	 * refused before a handler runs.
+	 */
+	readonly validate: (payload: Record<string, unknown> | undefined) => string | undefined;
+	readonly run: (payload: Record<string, unknown>) => unknown | Promise<unknown>;
+}
+
+/** An operation this contract knows about but does not run through `cedia_control` yet. */
+interface CediaDeclaredOperation {
+	readonly id: string;
+	readonly family: RpcCediaCapabilityFamily;
+	readonly scope: RpcCediaCapabilityDescriptor["scope"];
+	readonly apply: RpcCediaCapabilityDescriptor["apply"];
+	readonly surfaces: RpcCediaCapabilityDescriptor["surfaces"];
+	readonly principal: RpcCediaCapabilityDescriptor["principal"];
+	readonly source: string;
+	readonly receipt?: string;
+	readonly state: Exclude<RpcCediaCapabilityState, "available">;
+	readonly reason: string;
+}
+
+/** Handlers the RPC mode injects: each one delegates to the existing OMP path. */
+export interface CediaCapabilityHandlers {
+	readonly "model.roles.get": () => unknown;
+	/** The session's live model, effort and per-family service-tier state. */
+	readonly "model.state.get": () => unknown;
+	/** Set one live service-tier override and answer the resulting tier state. */
+	readonly "model.service-tier.set": (payload: Record<string, unknown>) => unknown | Promise<unknown>;
+	readonly "auth.providers.list": () => unknown;
+	/** The current provider's stored OAuth accounts, reduced to safe identity fields. */
+	readonly "auth.accounts.list": () => unknown | Promise<unknown>;
+	/** Pin one current-provider OAuth account and answer the refreshed account list. */
+	readonly "auth.account.pin": (payload: Record<string, unknown>) => unknown | Promise<unknown>;
+	readonly "turn.queue.get": () => unknown;
+	/** The user-restorable submissions the runtime is holding for this session (§8.2 O01). */
+	readonly "queue.get": () => unknown;
+	/** Drop one queued submission, or every one; the answer carries what the drop removed. */
+	readonly "queue.drop": (payload: Record<string, unknown>) => unknown;
+	/** Whether the process run-pause gate is engaged, with the epoch ms the pause began. */
+	readonly "pause.get": () => unknown;
