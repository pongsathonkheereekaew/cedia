index 0000000000..3985d9dd9c
--- /dev/null
+++ b/packages/coding-agent/test/cedia-pause-bridge.test.ts
@@ -0,0 +1,42 @@
+/**
+ * Cedia's run-pause projection (plan §8.2 O01).
+ *
+ * These fixtures drive the real process gate — there is no narrower seam: the bridge answers
+ * the gate as it stands and drives nothing else. Each test restores the gate to the state it
+ * found, so no other test can observe a pause this file left behind. No runtime, model or
+ * provider is involved.
+ */
+import { afterEach, describe, expect, it } from "bun:test";
+import { agentPauseGate } from "@oh-my-pi/pi-agent-core";
+import { readCediaRunPause, setCediaRunPause } from "../src/modes/rpc/cedia-pause-bridge";
+
+const initiallyPaused = agentPauseGate.paused;
+afterEach(() => {
+	if (agentPauseGate.paused === initiallyPaused) return;
+	if (initiallyPaused) agentPauseGate.pause();
+	else agentPauseGate.resume();
+});
+
+describe("Cedia run-pause projection", () => {
+	it("reads the gate as it stands, with no pausedAt key while running", () => {
+		setCediaRunPause(false);
+		expect(readCediaRunPause()).toEqual({ paused: false });
+		agentPauseGate.pause();
+		const paused = readCediaRunPause();
+		expect(paused.paused).toBe(true);
+		expect(typeof paused.pausedAt).toBe("number");
+	});
+
+	it("pausing answers the state that follows and repeats idempotently", () => {
+		const first = setCediaRunPause(true);
+		expect(first.paused).toBe(true);
+		expect(typeof first.pausedAt).toBe("number");
+		const second = setCediaRunPause(true);
+		expect(second).toEqual(first);
+	});
+
+	it("resuming a running gate answers running with no pausedAt key", () => {
+		setCediaRunPause(true);
+		expect(setCediaRunPause(false)).toEqual({ paused: false });
+	});
+});
diff --git a/packages/coding-agent/test/cedia-plan-bridge.test.ts b/packages/coding-agent/test/cedia-plan-bridge.test.ts
new file mode 100644
index 0000000000..bd5c2527e9
--- /dev/null
+++ b/packages/coding-agent/test/cedia-plan-bridge.test.ts
@@ -0,0 +1,228 @@
+import { describe, expect, it } from "bun:test";
+import {
+	attachCediaPlanReview,
+	CEDIA_PLAN_REVIEW_MAX_CHARS,
+	createCediaPlanBridge,
+	type CediaPlanBridgeMode,
+} from "../src/modes/rpc/cedia-plan-bridge";
+import type { AgentSession } from "../src/session/agent-session";
+import type { RpcCediaPlanFrame } from "../src/modes/rpc/rpc-types";
+
+/**
+ * The session-mode bridge is a thin adapter over OMP's own plan/vibe state. These cases pin that the
+ * state is read from the session, that a transition runs through the session's own terminal owner,
+ * that a refusal keeps the runtime's own words, and that a held plan review is answered exactly once
+ * by the client that is attached.
+ */
+
+type FakePlanState = { enabled: boolean; planFilePath: string; workflow?: "parallel" | "iterative"; reentry?: boolean };
+
+interface Harness {
+	readonly frames: RpcCediaPlanFrame[];
+	readonly calls: string[];
+	readonly plan: { current: FakePlanState | undefined };
+	readonly vibe: { current: { enabled: boolean } | undefined };
+	readonly draft: { current: boolean };
+	readonly parked: { current: boolean };
+	readonly bridge: ReturnType<typeof createCediaPlanBridge>;
+}
+
+/**
+ * A session and a terminal owner that behave the way the runtime's own do: the mode command flips
+ * the state and reports what it did through the notice sink the runtime installs.
+ */
+function harness(options: { withMode?: boolean } = {}): Harness {
+	const frames: RpcCediaPlanFrame[] = [];
+	const calls: string[] = [];
+	const plan = { current: undefined as FakePlanState | undefined };
+	const vibe = { current: undefined as { enabled: boolean } | undefined };
+	const draft = { current: false };
+	// The terminal's toggle is three-state: on -> parked -> off.
+	const parked = { current: false };
+	let noticeSink: ((notice: { kind: "status" | "warning"; text: string }) => void) | undefined;
+	const mode: CediaPlanBridgeMode = {
+		handlePlanModeCommand: async (_prompt, _input, commandOptions) => {
+			calls.push(commandOptions?.exitConfirmed ? "plan.exit.confirmed" : "plan.toggle");
+			if (plan.current?.enabled) {
+				noticeSink?.({ kind: "status", text: "Plan mode disabled." });
+				parked.current = true;
+				plan.current = undefined;
+				return false;
+			}
+			if (parked.current) {
+				noticeSink?.({ kind: "status", text: "Plan mode disabled." });
+				parked.current = false;
+				return false;
+			}
+			noticeSink?.({ kind: "status", text: "Plan mode enabled." });
+			plan.current = { enabled: true, planFilePath: "local://PLAN.md", workflow: "parallel" };
+			return false;
+		},
+		get planModePaused() {
+			return parked.current;
+		},
+		handleVibeModeCommand: async () => {
+			calls.push("vibe.toggle");
+			if (vibe.current?.enabled) {
+				vibe.current = undefined;
+				return false;
+			}
+			if (plan.current?.enabled) {
+				noticeSink?.({ kind: "warning", text: "Exit plan mode first." });
+				return false;
+			}
+			vibe.current = { enabled: true };
+			return false;
+		},
+		hasPlanModeDraft: async () => {
+			calls.push("plan.hasDraft");
+			return draft.current;
+		},
+		setPlanReviewDelegate: () => {},
+		setRpcNoticeSink: sink => {
+			noticeSink = sink ?? undefined;
+		},
+	};
+	const session = {
+		getPlanModeState: () => plan.current,
+		getVibeModeState: () => vibe.current,
+		setPlanModeState: (state: FakePlanState | undefined) => {
+			plan.current = state;
+		},
+	};
+	const owner = options.withMode === false ? undefined : mode;
+	const bridge = createCediaPlanBridge({
+		session: session as unknown as AgentSession,
+		mode: () => owner,
+		output: frame => frames.push(frame),
+	});
+	attachCediaPlanReview(bridge, owner);
+	return { frames, calls, plan, vibe, draft, parked, bridge };
+}
+
+describe("Cedia session-mode bridge", () => {
+	it("answers the session's own state, without inventing a mode", async () => {
+		const h = harness();
+		expect(await h.bridge.run({ op: "read" })).toMatchObject({
+			plan: null,
+			vibe: { enabled: false },
+			review: null,
+			changed: false,
+		});
+		h.vibe.current = { enabled: true };
+		expect(await h.bridge.run({ op: "read" })).toMatchObject({ vibe: { enabled: true } });
+	});
+
+	it("refuses honestly when the session has no terminal owner to drive", async () => {
+		const h = harness({ withMode: false });
+		const refused = await h.bridge.run({ op: "enter" });
+		expect(refused.changed).toBe(false);
+		expect(refused.reason).toContain("no Cedia virtual UI attached");
+		expect(h.calls).toEqual([]);
+	});
+
+	it("enters plan mode through the session's own command and reports the change once", async () => {
+		const h = harness();
+		expect(await h.bridge.run({ op: "enter" })).toMatchObject({
+			changed: true,
+			plan: { enabled: true, planFilePath: "local://PLAN.md", workflow: "parallel" },
+		});
+		expect(h.calls).toEqual(["plan.toggle"]);
+		expect(h.frames.filter(frame => frame.type === "cedia_plan_state")).toHaveLength(1);
+		// Already on: no second transition, and no claim that anything changed.
+		expect(await h.bridge.run({ op: "enter" })).toMatchObject({ changed: false, plan: { enabled: true } });
+		expect(h.calls).toEqual(["plan.toggle"]);
+	});
+
+	it("carries the workflow and plan file the client named through the runtime's own state", async () => {
+		const h = harness();
+		const entered = await h.bridge.run({ op: "enter", workflow: "iterative", planFilePath: "local://my-plan.md" });
+		expect(entered.plan).toMatchObject({ workflow: "iterative", planFilePath: "local://my-plan.md" });
+	});
+
+	it("asks before dropping an unapproved draft and refuses with the reason until it is confirmed", async () => {
+		const h = harness();
+		await h.bridge.run({ op: "enter" });
+		h.draft.current = true;
+		const refused = await h.bridge.run({ op: "exit" });
+		expect(refused).toMatchObject({ changed: false, plan: { enabled: true } });
+		expect(refused.reason).toContain("unapproved plan draft");
+		expect(h.calls).toEqual(["plan.toggle", "plan.hasDraft"]);
+		const confirmed = await h.bridge.run({ op: "exit", confirm: true });
+		// The terminal's first toggle parks plan mode; a client that asked to exit means off, so the
+		// bridge takes the same second toggle the terminal's third `/plan` takes.
+		expect(confirmed).toMatchObject({ changed: true, plan: null });
+		expect(h.calls).toEqual(["plan.toggle", "plan.hasDraft", "plan.exit.confirmed", "plan.toggle"]);
+		// Off means the other modes are unblocked again.
+		expect(await h.bridge.run({ op: "vibe.enter" })).toMatchObject({ changed: true, vibe: { enabled: true } });
+	});
+
+	it("brings plan mode back on from the parked state instead of turning it off", async () => {
+		const h = harness();
+		// What the terminal's own `/plan` toggle leaves behind: no session state, still parked.
+		h.parked.current = true;
+		// The parked state is visible, because it still blocks vibe and goal mode.
+		expect(await h.bridge.run({ op: "read" })).toMatchObject({ plan: { enabled: false, paused: true } });
+		const reentered = await h.bridge.run({ op: "enter" });
+		expect(reentered).toMatchObject({ changed: true, plan: { enabled: true, paused: false } });
+	});
+
+	it("keeps the runtime's own refusal text when a mode command will not start", async () => {
+		const h = harness();
+		await h.bridge.run({ op: "enter" });
+		const refused = await h.bridge.run({ op: "vibe.enter" });
+		expect(refused).toMatchObject({ changed: false, vibe: { enabled: false } });
+		expect(refused.reason).toBe("Exit plan mode first.");
+	});
+
+	it("settles one held plan review with the client's decision", async () => {
+		const h = harness();
+		const held = h.bridge.holdReview({
+			title: "Plan",
+			planFilePath: "local://PLAN.md",
+			planContent: "Do the thing.",
+		});
+		const frame = h.frames.find(entry => entry.type === "cedia_plan_review");
+		expect(frame).toBeDefined();
+		const reviewId = frame && frame.type === "cedia_plan_review" ? frame.payload.reviewId : -1;
+		expect((await h.bridge.run({ op: "read" })).review).toMatchObject({ reviewId, title: "Plan" });
+		const decided = await h.bridge.run({
+			op: "review.decide",
+			reviewId,
+			decision: "approve",
+			compactBeforeExecute: true,
+		});
+		expect(decided).toMatchObject({ changed: true, review: null });
+		expect(await held).toEqual({ kind: "approve", preserveContext: false, compactBeforeExecute: true });
+		// One review is answered once: the same id is no longer open.
+		const stale = await h.bridge.run({ op: "review.decide", reviewId, decision: "cancel" });
+		expect(stale).toMatchObject({ changed: false });
+		expect(stale.reason).toContain("no longer open");
+	});
+
+	it("marks a plan too long for the wire as truncated instead of quietly shortening it", async () => {
+		const h = harness();
+		const held = h.bridge.holdReview({
+			title: "Big plan",
+			planFilePath: "local://PLAN.md",
+			planContent: "x".repeat(CEDIA_PLAN_REVIEW_MAX_CHARS + 10),
+		});
+		const frame = h.frames.find(entry => entry.type === "cedia_plan_review");
+		expect(frame && frame.type === "cedia_plan_review" ? frame.payload.truncated : false).toBe(true);
+		await h.bridge.run({ op: "review.decide", reviewId: 1, decision: "cancel" });
+		expect(await held).toEqual({ kind: "cancel" });
+	});
+
+	it("cancels a held review when the client goes away, so nothing waits forever", async () => {
+		const h = harness();
+		const held = h.bridge.holdReview({ title: "Plan", planFilePath: "local://PLAN.md", planContent: "Body" });
+		h.bridge.dispose("The client disconnected.");
+		expect(await held).toEqual({ kind: "cancel" });
+		// Reads stay honest, and no further transition can be started by a bridge that is gone.
+		expect(await h.bridge.run({ op: "read" })).toMatchObject({ changed: false, review: null });
+		const after = await h.bridge.run({ op: "enter" });
+		expect(after.changed).toBe(false);
+		expect(after.reason).toContain("shutting down");
+	});
+
+});
diff --git a/packages/coding-agent/test/cedia-prewalk-bridge.test.ts b/packages/coding-agent/test/cedia-prewalk-bridge.test.ts
