+/**
+ * Cedia's rule-forging projection (plan §8.2 O02).
+ *
+ * Fixtures drive draft/state/save/abort with a stubbed ephemeral turn plus the registered
+ * operations through the bridge with an injected handler. Rule files land in temporary
+ * directories; no model or provider is involved.
+ */
+import { describe, expect, it } from "bun:test";
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+	createCediaCapabilityBridge,
+	type CediaCapabilityBridgeOptions,
+} from "../src/modes/rpc/cedia-capability-bridge";
+import { createCediaOmfgBridge } from "../src/modes/rpc/cedia-omfg-bridge";
+
+const RULE_JSON = JSON.stringify({
+	name: "no-eval",
+	description: "Forbid eval",
+	condition: ["needle"],
+	scope: ["text"],
+	body: "Use the safer pattern.",
+});
+
+const IDLE = {
+	state: "idle" as const,
+	complaint: null,
+	complaintTruncated: false,
+	draft: null,
+	draftTruncated: false,
+	ruleName: null,
+	validated: false,
+	validationFeedback: null,
+	savedPath: null,
+	reason: null,
+};
+
+function sessionFixture(options: { reply?: string; messages?: unknown[] } = {}) {
+	const added: unknown[] = [];
+	const projectDir = mkdtempSync(join(tmpdir(), "cedia-omfg-project-"));
+	const agentDir = mkdtempSync(join(tmpdir(), "cedia-omfg-agent-"));
+	return {
+		added,
+		projectDir,
+		agentDir,
+		model: { provider: "fixture", id: "fixture-model" },
+		messages: options.messages ?? [{ role: "assistant", content: [{ type: "text", text: "needle" }] }],
+		settings: { getAgentDir: () => agentDir },
+		sessionManager: { getCwd: () => projectDir },
+		ttsrManager: { addRule: (rule: unknown) => added.push(rule) },
+		runEphemeralTurn: async () => {
+			if (options.reply === undefined) throw new Error("fixture model is unavailable");
+			return { replyText: options.reply, assistantMessage: { role: "assistant", content: [] } };
+		},
+	};
+}
+
+describe("Cedia rule-forging bridge", () => {
+	it("starts idle with nothing held", () => {
+		expect(createCediaOmfgBridge({ session: sessionFixture() as never }).read()).toEqual(IDLE);
+	});
+
+	it("drafts through the ephemeral turn, validates, and holds the candidate", async () => {
+		const session = sessionFixture({ reply: RULE_JSON });
+		const bridge = createCediaOmfgBridge({ session: session as never });
+		const dispatched = await bridge.draft({ complaint: "Stop that." });
+		expect(dispatched.state).toBe("drafting");
+		await new Promise(resolve => setTimeout(resolve, 10));
+		const ready = bridge.read();
+		expect(ready.state).toBe("ready");
+		expect(ready.ruleName).toBe("no-eval");
+		expect(ready.validated).toBe(true);
+		expect(ready.draft).toContain("no-eval");
+		expect(ready.draftTruncated).toBe(false);
+	});
+
+	it("reports a failed draft honestly and refuses to save it", async () => {
+		const session = sessionFixture();
+		const bridge = createCediaOmfgBridge({ session: session as never });
+		expect((await bridge.draft({ complaint: "Stop that." })).state).toBe("drafting");
+		await new Promise(resolve => setTimeout(resolve, 10));
+		const failed = bridge.read();
+		expect(failed.state).toBe("failed");
+		expect(failed.reason).toContain("fixture model is unavailable");
+		await expect(bridge.save({ scope: "project" })).rejects.toThrow(/No rule draft to save/);
+	});
+
+	it("saves into the named scope, registers live, and consumes the draft", async () => {
+		const session = sessionFixture({ reply: RULE_JSON });
+		const bridge = createCediaOmfgBridge({ session: session as never });
+		await bridge.draft({ complaint: "Stop that." });
+		await new Promise(resolve => setTimeout(resolve, 10));
+		const saved = await bridge.save({ scope: "project" });
+		expect(saved).toMatchObject({ saved: true, scope: "project", name: "no-eval", validated: true });
+		expect(saved.path).toBe(join(session.projectDir, ".omp", "rules", "no-eval.md"));
+		expect(session.added).toHaveLength(1);
+		expect(bridge.read()).toEqual(IDLE);
+		const text = await Bun.file(saved.path).text();
+		expect(text).toContain("no-eval");
+	});
+
+	it("refuses an existing file without overwrite and an unvalidated draft without opt-in", async () => {
+		const session = sessionFixture({ reply: RULE_JSON });
+		const bridge = createCediaOmfgBridge({ session: session as never });
+		await bridge.draft({ complaint: "Stop that." });
+		await new Promise(resolve => setTimeout(resolve, 10));
+		await bridge.save({ scope: "global" });
+		await bridge.draft({ complaint: "Stop that." });
+		await new Promise(resolve => setTimeout(resolve, 10));
+		await expect(bridge.save({ scope: "global" })).rejects.toThrow(/already exists/);
+		const overwritten = await bridge.save({ scope: "global", overwrite: true });
+		expect(overwritten.path).toBe(join(session.agentDir, "rules", "no-eval.md"));
+	});
+
+	it("refuses blank complaints, bad scopes, and traversal names", async () => {
+		const session = sessionFixture({ reply: RULE_JSON });
+		const bridge = createCediaOmfgBridge({ session: session as never });
+		await expect(bridge.draft({ complaint: "  " })).rejects.toThrow(/needs a complaint/);
+		await expect(bridge.save({ scope: "everywhere" as "project" })).rejects.toThrow(/No rule draft/);
+	});
+
+	it("advertises the four operations with the O02 controller/owner contract", () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"omfg.state.get": () => IDLE,
+				"omfg.draft": () => ({ ...IDLE, state: "drafting" }),
+				"omfg.save": () => ({ saved: true, scope: "project", name: "x", path: "/tmp/x.md", validated: true }),
+				"omfg.abort": () => IDLE,
+				"settings.revision": () => "fixture-revision",
+			},
+		} as unknown as CediaCapabilityBridgeOptions);
+		const rows = new Map(
+			built
+				.table()
+				.capabilities.filter(row => row.id.startsWith("omfg."))
+				.map(row => [row.id, row]),
+		);
+		expect([...rows.keys()]).toEqual(["omfg.abort", "omfg.draft", "omfg.save", "omfg.state.get"]);
+		expect(rows.get("omfg.state.get")).toMatchObject({ family: "O02", principal: "controller" });
+		expect(rows.get("omfg.draft")).toMatchObject({ family: "O02", principal: "owner" });
+		expect(rows.get("omfg.save")).toMatchObject({ family: "O02", principal: "owner" });
+		expect(rows.get("omfg.abort")).toMatchObject({ family: "O02", principal: "owner" });
+	});
+
+	it("runs omfg.draft and omfg.save through cedia_control with validated payloads", async () => {
+		const seen: unknown[] = [];
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"omfg.state.get": () => IDLE,
+				"omfg.draft": (payload: Record<string, unknown>) => {
+					seen.push(payload);
+					return { ...IDLE, state: "drafting" };
+				},
+				"omfg.save": (payload: Record<string, unknown>) => {
+					seen.push(payload);
+					return { saved: true, scope: "project", name: "x", path: "/tmp/x.md", validated: true };
+				},
+				"omfg.abort": () => IDLE,
+				"settings.revision": () => "fixture-revision",
+			},
+		} as unknown as CediaCapabilityBridgeOptions);
+		const drafted = await built.control({ operation: "omfg.draft", payload: { complaint: "Stop.", feedback: "More." } });
+		expect(seen).toEqual([{ complaint: "Stop.", feedback: "More." }]);
+		expect(drafted).toMatchObject({ ok: true, operation: "omfg.draft" });
+		const saved = await built.control({ operation: "omfg.save", payload: { scope: "global", overwrite: true } });
+		expect(seen[1]).toEqual({ scope: "global", overwrite: true });
+		expect(saved).toMatchObject({ ok: true, operation: "omfg.save" });
+		for (const [operation, payload] of [
+			["omfg.draft", undefined],
+			["omfg.draft", {}],
+			["omfg.draft", { complaint: "  " }],
+			["omfg.draft", { complaint: "x", extra: 1 }],
+			["omfg.save", undefined],
+			["omfg.save", { scope: "everywhere" }],
+			["omfg.save", { scope: "project", overwrite: "yes" }],
+		] as const) {
+			const refused = await built.control({ operation, payload: payload as Record<string, unknown> });
+			expect(refused).toMatchObject({ ok: false });
+		}
+	});
+});
