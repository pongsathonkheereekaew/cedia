+import { describe, expect, test } from "bun:test";
+import { mkdir } from "node:fs/promises";
+import * as path from "node:path";
+import { isRecord, readJsonl, TempDir } from "@oh-my-pi/pi-utils";
+
+type RpcFrame = Record<string, unknown>;
+
+function isFrame(value: unknown): value is RpcFrame {
+	return isRecord(value);
+}
+
+async function startRpcVirtualUiProbe(): Promise<{
+	frames: RpcFrame[];
+	request: (command: RpcFrame) => Promise<RpcFrame>;
+	providerRequests: () => number;
+	stop: () => Promise<void>;
+}> {
+	const profile = TempDir.createSync("@omp-rpc-virtual-ui-start-");
+	const cwd = profile.path();
+	const packageRoot = path.join(import.meta.dir, "..");
+	const agentDir = path.join(profile.path(), "agent");
+	await mkdir(agentDir, { recursive: true });
+	let providerRequestCount = 0;
+	const tripwire = Bun.serve({
+		hostname: "127.0.0.1",
+		port: 0,
+		fetch() {
+			providerRequestCount++;
+			return Response.json({ error: "provider tripwire" }, { status: 500 });
+		},
+	});
+	await Bun.write(
+		path.join(agentDir, "models.yml"),
+		JSON.stringify({
+			providers: {
+				"cedia-loopback": {
+					baseUrl: `http://127.0.0.1:${tripwire.port}/v1`,
+					api: "openai-completions",
+					auth: "none",
+					models: [
+						{
+							id: "cedia-virtual-ui-fixture",
+							name: "Cedia Virtual UI Fixture",
+							reasoning: false,
+							input: ["text"],
+							contextWindow: 8_192,
+							maxTokens: 1_024,
+						},
+					],
+				},
+			},
+		}),
+	);
+	const child = Bun.spawn(
+		[
+			process.execPath,
+			path.join(packageRoot, "src", "cli.ts"),
+			"--mode",
+			"rpc",
+			"--provider",
+			"cedia-loopback",
+			"--model",
+			"cedia-virtual-ui-fixture",
+			"--no-session",
+			"--no-extensions",
+			"--no-skills",
+			"--no-rules",
+			"--no-tools",
+			"--no-lsp",
+		],
+		{
+			cwd,
+			env: {
+				...Bun.env,
+				HOME: profile.path(),
+				XDG_CONFIG_HOME: profile.path(),
+				XDG_DATA_HOME: profile.path(),
+				PI_CODING_AGENT_DIR: agentDir,
+				CEDIA_RPC_VIRTUAL_UI: "1",
+				PI_NO_TITLE: "1",
+				NO_COLOR: "1",
+			},
+			stdin: "pipe",
+			stdout: "pipe",
+			stderr: "pipe",
+		},
+	);
+	const stderr = new Response(child.stderr).text();
+	const frames: RpcFrame[] = [];
+	const iterator = readJsonl<unknown>(child.stdout as ReadableStream<Uint8Array>)[Symbol.asyncIterator]();
+	const nextFrame = async (): Promise<RpcFrame> => {
+		const result = await Promise.race([
+			iterator.next(),
+			Bun.sleep(10_000).then(() => {
+				throw new Error("Timed out waiting for RPC frame");
+			}),
+		]);
+		if (result.done || !isFrame(result.value)) throw new Error("RPC output ended before the expected frame");
+		frames.push(result.value);
+		return result.value;
+	};
+	const waitFor = async (predicate: (frame: RpcFrame) => boolean): Promise<RpcFrame> => {
+		for (;;) {
+			const frame = await nextFrame();
+			if (predicate(frame)) return frame;
+		}
+	};
+	const stop = async (): Promise<void> => {
+		try {
+			child.stdin.end();
+		} catch {
+			// The child may already have exited after a startup failure.
+		}
+		child.kill();
+		await child.exited.catch(() => {});
+		await stderr;
+		await tripwire.stop(true);
+		profile.removeSync();
+	};
+	const request = async (command: RpcFrame): Promise<RpcFrame> => {
+		child.stdin.write(`${JSON.stringify(command)}\n`);
+		await child.stdin.flush();
+		return waitFor(frame => frame.type === "response" && frame.id === command.id);
+	};
+
+	try {
+		await waitFor(frame => frame.type === "ready");
+		return { frames, request, providerRequests: () => providerRequestCount, stop };
+	} catch (error) {
+		await stop();
+		throw error;
+	}
+}
+
+describe("RPC virtual UI startup", () => {
+	test("negotiates a shared virtual terminal without claiming process stdin", async () => {
+		const probe = await startRpcVirtualUiProbe();
