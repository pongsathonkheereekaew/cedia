+		"history.transcript": noop,
+	};
+	const built = createCediaCapabilityBridge({
+		ompRevision: "omp/18.1.18",
+		handlers,
+	} satisfies CediaCapabilityBridgeOptions);
+	return {
+		built,
+		calls,
+		setAccounts: (next: Record<string, unknown>) => (accounts = next),
+		setPinAccepted: (next: boolean) => (pinAccepted = next),
