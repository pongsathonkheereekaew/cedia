+			expect(baseIds).not.toContain(id);
+		}
+		expect(
+			(await base.control({ operation: "settings.mutate", payload: { context: { scope: "global" }, changes: [] } }))
+				.ok,
+		).toBe(false);
+	});
+
+	it("describes schema metadata with label, default and env, and no values", async () => {
+		const { built } = await settingsBridge();
+		const outcome = await built.control({ operation: "settings.keys.describe" });
+		expect(outcome.ok).toBe(true);
+		if (!outcome.ok) return;
+		const result = outcome.result as { keys: Record<string, unknown>[]; settingsRevision: string };
+		expect(result.keys.length).toBeGreaterThan(500);
+		const endpoint = result.keys.find(key => key.path === "searxng.endpoint");
+		expect(endpoint).toMatchObject({ label: "SearXNG Endpoint", envVar: "SEARXNG_ENDPOINT" });
+		expect(typeof endpoint?.description).toBe("string");
+		for (const key of result.keys) {
+			expect(Object.keys(key)).not.toContain("value");
+			expect(Object.keys(key)).not.toContain("default");
+			if (key.credential === true) expect(key.defaultJson).toBeUndefined();
+		}
+		expect(result.settingsRevision).toMatch(/^[0-9a-f]{32}$/);
+	});
+
+	it("refuses credential writes at the bridge, before any handler runs", async () => {
