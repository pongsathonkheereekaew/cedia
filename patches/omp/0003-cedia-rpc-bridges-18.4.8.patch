@@ -0,0 +1,225 @@
+import { describe, expect, it } from "bun:test";
+import {
+	createCediaCapabilityBridge,
+	type CediaCapabilityBridgeOptions,
+} from "../src/modes/rpc/cedia-capability-bridge";
+import {
+	CEDIA_TOOL_CATALOG_DESCRIPTION_MAX_CHARS,
+	readCediaToolCatalog,
+	refreshCediaSkills,
+	setCediaActiveTools,
+} from "../src/modes/rpc/cedia-tools-bridge";
+
+type FakeSession = {
+	getAllToolInfos: () => {
+		name: string;
+		description: string;
+		sourceInfo: { source: string };
+	}[];
+	getActiveToolNames: () => string[];
+};
+
+function sessionFixture(overrides: Partial<FakeSession> = {}) {
+	return {
+		getAllToolInfos: () => [
+			{ name: "read", description: "Read a file", sourceInfo: { source: "builtin" } },
+			{ name: "mcp__github_get_issue", description: "Fetch an issue", sourceInfo: { source: "mcp" } },
+			{ name: "custom-widget", description: "Extension widget", sourceInfo: { source: "extension" } },
+		],
+		getActiveToolNames: () => ["read", "mcp__github_get_issue"],
+		...overrides,
+	};
+}
+
+describe("Cedia O06 tool catalog bridge", () => {
+	it("projects identity, source class and activation without parameter schemas", () => {
+		const catalog = readCediaToolCatalog(sessionFixture() as never);
+		expect(catalog.total).toBe(3);
+		expect(catalog.activeCount).toBe(2);
+		expect(catalog.truncated).toBe(false);
+		expect(catalog.tools.map(tool => [tool.name, tool.source, tool.active])).toEqual([
+			["read", "builtin", true],
+			["mcp__github_get_issue", "mcp", true],
+			["custom-widget", "extension", false],
+		]);
+		for (const tool of catalog.tools) {
+			expect(Object.keys(tool).sort()).toEqual(
+				["active", "description", "descriptionTruncated", "name", "source"],
+			);
+		}
+	});
+
+	it("bounds long descriptions instead of sending them whole", () => {
+		const long = "x".repeat(CEDIA_TOOL_CATALOG_DESCRIPTION_MAX_CHARS + 40);
+		const catalog = readCediaToolCatalog(
+			sessionFixture({
+				getAllToolInfos: () => [{ name: "read", description: long, sourceInfo: { source: "builtin" } }],
+				getActiveToolNames: () => ["read"],
+			}) as never,
+		);
+		expect(catalog.tools[0]?.description.length).toBe(CEDIA_TOOL_CATALOG_DESCRIPTION_MAX_CHARS);
+		expect(catalog.tools[0]?.descriptionTruncated).toBe(true);
+	});
+
+	it("reports an unknown source class as extension instead of refusing the row", () => {
+		const catalog = readCediaToolCatalog(
+			sessionFixture({
+				getAllToolInfos: () => [
+					{ name: "odd", description: "Odd origin", sourceInfo: { source: "future-class" } },
+				],
+				getActiveToolNames: () => [],
+			}) as never,
+		);
+		expect(catalog.tools[0]).toMatchObject({ name: "odd", source: "extension", active: false });
+	});
+
+	it("advertises tools.catalog.get as a controller-visible O06 session read", () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"tools.catalog.get": () => ({ tools: [], truncated: false, total: 0, activeCount: 0 }),
+			} as unknown as CediaCapabilityBridgeOptions["handlers"],
+		});
+		const row = built.table().capabilities.find(entry => entry.id === "tools.catalog.get");
+		expect(row).toMatchObject({
+			id: "tools.catalog.get",
+			family: "O06",
+			scope: "session",
+			apply: "immediate",
+			principal: "controller",
+			surfaces: ["agent", "ide", "web", "iphone"],
+			state: "available",
+		});
+	});
+
+	it("applies the enabled set through the session's own activation and answers the catalog that follows", async () => {
+		let enabled = ["read", "mcp__github_get_issue"];
+		const applied: string[][] = [];
+		const session = {
+			getAllToolInfos: () => [
+				{ name: "read", description: "Read a file", sourceInfo: { source: "builtin" } },
+				{ name: "mcp__github_get_issue", description: "Fetch an issue", sourceInfo: { source: "mcp" } },
+				{ name: "custom-widget", description: "Extension widget", sourceInfo: { source: "extension" } },
+			],
+			getActiveToolNames: () => enabled,
+			setActiveToolsByName: async (names: string[]) => {
+				applied.push(names);
+				enabled = names;
+			},
+		};
+		const catalog = await setCediaActiveTools(session as never, ["read"]);
+		expect(applied).toEqual([["read"]]);
+		expect(catalog.tools.map(tool => [tool.name, tool.active])).toEqual([
+			["read", true],
+			["mcp__github_get_issue", false],
+			["custom-widget", false],
+		]);
+		expect(catalog.activeCount).toBe(1);
+	});
+
+	it("advertises tools.active.set as an owner-only O06 session write", () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"tools.active.set": () => ({ tools: [], truncated: false, total: 0, activeCount: 0 }),
+			} as unknown as CediaCapabilityBridgeOptions["handlers"],
+		});
+		const row = built.table().capabilities.find(entry => entry.id === "tools.active.set");
+		expect(row).toMatchObject({
+			id: "tools.active.set",
+			family: "O06",
+			scope: "session",
+			apply: "immediate",
+			principal: "owner",
+			surfaces: ["agent", "ide"],
+			state: "available",
+		});
+	});
+
+	it("refuses an active-set payload with unknown fields or empty names", async () => {
+		const calls: string[][] = [];
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"tools.active.set": (payload: Record<string, unknown>) => {
+					calls.push(payload.toolNames as string[]);
+					return { tools: [], truncated: false, total: 0, activeCount: 0 };
+				},
+			} as unknown as CediaCapabilityBridgeOptions["handlers"],
+		});
+		const ok = await built.control({ operation: "tools.active.set", payload: { toolNames: ["read"] } });
+		expect(ok.ok).toBe(true);
+		expect(calls).toEqual([["read"]]);
+		const missing = await built.control({ operation: "tools.active.set" });
+		expect(missing.ok).toBe(false);
+		const extra = await built.control({ operation: "tools.active.set", payload: { toolNames: ["read"], extra: true } });
+		expect(extra.ok).toBe(false);
+		const empty = await built.control({ operation: "tools.active.set", payload: { toolNames: [""] } });
+		expect(empty.ok).toBe(false);
+	});
+
+	it("re-runs skill rediscovery through the session's own refresh and answers the catalog", async () => {
+		let refreshed = false;
+		const session = {
+			getAllToolInfos: () => [
+				{ name: "read", description: "Read a file", sourceInfo: { source: "builtin" } },
+			],
+			getActiveToolNames: () => ["read"],
+			refreshSkills: async () => {
+				refreshed = true;
+			},
+		};
+		const catalog = await refreshCediaSkills(session as never);
+		expect(refreshed).toBe(true);
+		expect(catalog.tools.map(tool => tool.name)).toEqual(["read"]);
+	});
+
+	it("advertises tools.refresh-skills as an owner-only O06 session write", () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"tools.refresh-skills": () => ({ tools: [], truncated: false, total: 0, activeCount: 0 }),
+			} as unknown as CediaCapabilityBridgeOptions["handlers"],
+		});
+		const row = built.table().capabilities.find(entry => entry.id === "tools.refresh-skills");
+		expect(row).toMatchObject({
+			id: "tools.refresh-skills",
+			family: "O06",
+			scope: "session",
+			apply: "immediate",
+			principal: "owner",
+			surfaces: ["agent", "ide"],
+			state: "available",
+		});
+	});
+
+	it("refuses a refresh payload instead of ignoring it", async () => {
+		let calls = 0;
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"tools.refresh-skills": () => {
+					calls += 1;
+					return { tools: [], truncated: false, total: 0, activeCount: 0 };
+				},
+			} as unknown as CediaCapabilityBridgeOptions["handlers"],
+		});
+		const ok = await built.control({ operation: "tools.refresh-skills" });
+		expect(ok.ok).toBe(true);
+		expect(calls).toBe(1);
+		const refused = await built.control({ operation: "tools.refresh-skills", payload: { extra: true } });
+		expect(refused.ok).toBe(false);
+		expect(calls).toBe(1);
+	});
+
+	it("runs tools.catalog.get through cedia_control with no payload", async () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"tools.catalog.get": () => ({ tools: [], truncated: false, total: 0, activeCount: 0 }),
+			} as unknown as CediaCapabilityBridgeOptions["handlers"],
+		});
+		const outcome = await built.control({ operation: "tools.catalog.get" });
+		expect(outcome.ok).toBe(true);
+	});
+});
diff --git a/packages/coding-agent/test/cedia-tools-codemode-bridge.test.ts b/packages/coding-agent/test/cedia-tools-codemode-bridge.test.ts
new file mode 100644
index 0000000000..acd1c6e7aa
--- /dev/null
+++ b/packages/coding-agent/test/cedia-tools-codemode-bridge.test.ts
@@ -0,0 +1,105 @@
+/**
+ * Cedia's Code Mode partition projection (plan §8.2 O06).
+ *
+ * Fixtures drive the read directly plus the registered operation through the bridge with
+ * an injected handler. No runtime, model or provider is involved. Prelude sources
+ * (javascript/python/documentation) must never cross the projection.
+ */
+import { describe, expect, it } from "bun:test";
+import {
+	createCediaCapabilityBridge,
+	type CediaCapabilityBridgeOptions,
+} from "../src/modes/rpc/cedia-capability-bridge";
+import { readCediaCodeMode } from "../src/modes/rpc/cedia-tools-bridge";
+
+type FakeSession = {
+	getCodeModeDirectToolNames: () => readonly string[] | undefined;
+	getEvalPreludes: () => {
+		name: string;
+		documentation: string;
+		javascript: string;
+		python: string;
+		enabled?: () => boolean;
+	}[];
+};
+
+function sessionFixture(overrides: Partial<FakeSession> = {}): FakeSession {
+	return {
+		getCodeModeDirectToolNames: () => ["read", "glob", "grep"],
+		getEvalPreludes: () => [
+			{ name: "browser", documentation: "# browser", javascript: "globalThis.x = 1;", python: "x = 1", enabled: () => true },
+			{ name: "computer", documentation: "# computer", javascript: "globalThis.y = 2;", python: "y = 2", enabled: () => false },
+		],
+		...overrides,
+	};
+}
+
+describe("Cedia O06 Code Mode bridge", () => {
+	it("projects direct names and prelude flags without prelude sources", () => {
+		const mode = readCediaCodeMode(sessionFixture() as never);
+		expect(mode).toEqual({
+			active: true,
+			directToolNames: ["read", "glob", "grep"],
+			preludes: [
+				{ name: "browser", enabled: true },
+				{ name: "computer", enabled: false },
+			],
+		});
+		expect(JSON.stringify(mode)).not.toContain("globalThis");
+		expect(JSON.stringify(mode)).not.toContain("# browser");
+	});
+
+	it("reads an inactive Code Mode as off with a null direct list", () => {
+		const mode = readCediaCodeMode(
+			sessionFixture({ getCodeModeDirectToolNames: () => undefined, getEvalPreludes: () => [] }) as never,
+		);
+		expect(mode).toEqual({ active: false, directToolNames: null, preludes: [] });
+	});
+
+	it("skips malformed rows instead of refusing the read", () => {
+		const mode = readCediaCodeMode(
+			sessionFixture({
+				getCodeModeDirectToolNames: () => ["read", 42, "  "] as unknown as readonly string[],
+				getEvalPreludes: () => [{ name: "", documentation: "", javascript: "", python: "" }],
+			}) as never,
+		);
+		expect(mode.directToolNames).toEqual(["read"]);
+		expect(mode.preludes).toEqual([]);
+	});
+
+	it("advertises tools.codemode.get as a controller-visible O06 session read", () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"tools.codemode.get": () => ({ active: false, directToolNames: null, preludes: [] }),
+				"settings.revision": () => "fixture-revision",
+			},
+		} as unknown as CediaCapabilityBridgeOptions);
+		const row = built.table().capabilities.find(entry => entry.id === "tools.codemode.get");
+		expect(row).toMatchObject({
+			id: "tools.codemode.get",
+			family: "O06",
+			scope: "session",
+			apply: "immediate",
+			principal: "controller",
+			state: "available",
+			surfaces: ["agent", "ide", "web", "iphone"],
+		});
+	});
+
+	it("runs tools.codemode.get through cedia_control with no payload", async () => {
+		const built = createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers: {
+				"tools.codemode.get": () => ({ active: false, directToolNames: null, preludes: [] }),
+				"settings.revision": () => "fixture-revision",
+			},
+		} as unknown as CediaCapabilityBridgeOptions);
+		const outcome = await built.control({ operation: "tools.codemode.get" });
+		expect(outcome).toMatchObject({
+			ok: true,
+			operation: "tools.codemode.get",
+			result: { active: false, directToolNames: null, preludes: [] },
+		});
+	});
+});
diff --git a/packages/coding-agent/test/cedia-tree-bridge.test.ts b/packages/coding-agent/test/cedia-tree-bridge.test.ts
new file mode 100644
index 0000000000..c422475fc4
--- /dev/null
+++ b/packages/coding-agent/test/cedia-tree-bridge.test.ts
@@ -0,0 +1,372 @@
+import { describe, expect, it } from "bun:test";
+import {
+	createCediaCapabilityBridge,
+	type CediaCapabilityBridgeOptions,
+	type CediaCapabilityHandlers,
+} from "../src/modes/rpc/cedia-capability-bridge";
+import { navigateCediaTree, readCediaTree } from "../src/modes/rpc/cedia-capability-bridge";
+
+type TreeAnswer = {
+	leafId: string | null;
+	nodes: {
+		id: string;
+		parentId: string | null;
+		kind: string;
+		timestamp: string;
+		label: string;
+		labelTruncated: boolean;
+	}[];
+	pathIds: string[];
+	truncated: boolean;
+	lineage: { sessionFile: string; parentSession: string | null; previousSessionFiles: string[] };
+};
+
+type NavigationAnswer = {
+	moved: boolean;
+	cancelled: boolean;
+	aborted: boolean;
+	askReopen: boolean;
+	summarized: boolean;
+	editorText: string | null;
+	editorTextTruncated: boolean;
+	editorImageCount: number;
+	leafId: string | null;
+};
+
+const emptyTree: TreeAnswer = {
+	leafId: null,
+	nodes: [],
+	pathIds: [],
+	truncated: false,
+	lineage: { sessionFile: "fixture/session.jsonl", parentSession: null, previousSessionFiles: [] },
+};
+
+function bridgeFixture(
+	options: {
+		tree?: TreeAnswer;
+		navigate?: (payload: Record<string, unknown>) => NavigationAnswer;
+	} = {},
+) {
+	const calls: { operation: string; payload?: Record<string, unknown> }[] = [];
+	const tree = options.tree ?? emptyTree;
+	const navigate =
+		options.navigate ??
+		(() => ({
+			moved: true,
+			cancelled: false,
+			aborted: false,
+			askReopen: false,
+			summarized: false,
+			editorText: null,
+			editorTextTruncated: false,
+			editorImageCount: 0,
+			leafId: "entry-3",
+		}));
+	const noop = () => undefined;
+	const handlers = new Proxy({} as CediaCapabilityHandlers, {
+		get: (_target, property: string) => {
+			if (property === "tree.get")
+				return () => {
+					calls.push({ operation: "tree.get" });
+					return tree;
+				};
+			if (property === "tree.navigate")
+				return (payload: Record<string, unknown>) => {
+					calls.push({ operation: "tree.navigate", payload });
+					return navigate(payload);
+				};
+			if (property === "settings.revision") return () => "fixture-revision";
+			return noop;
+		},
+	});
+	return {
+		built: createCediaCapabilityBridge({
+			ompRevision: "omp/18.1.18",
+			handlers,
+		} satisfies CediaCapabilityBridgeOptions),
+		calls,
+	};
+}
+
+describe("Cedia session tree bridge", () => {
+	it("advertises both tree operations with the O02 controller contract", () => {
+		const { built } = bridgeFixture();
+		const rows = new Map(
+			built
+				.table()
+				.capabilities.filter(row => row.id.startsWith("tree."))
+				.map(row => [row.id, row]),
+		);
+		expect([...rows.keys()]).toEqual(["tree.get", "tree.navigate"]);
+		for (const id of rows.keys()) {
+			expect(rows.get(id)).toMatchObject({
+				family: "O02",
+				scope: "session",
+				apply: "immediate",
+				principal: "controller",
+				state: "available",
+				surfaces: ["agent", "ide", "web", "iphone"],
+			});
+		}
+	});
+
+	it("reads an empty tree and a bounded branched tree through the injected runtime projection", async () => {
+		const empty = bridgeFixture();
+		const emptyResult = await empty.built.control({ operation: "tree.get" });
+		expect(emptyResult.ok).toBe(true);
+		if (emptyResult.ok) expect(emptyResult.result).toEqual(emptyTree);
+
+		const longLabel = `user: ${"x".repeat(200)}`;
+		const branched: TreeAnswer = {
+			leafId: "branch-b",
+			nodes: [
+				{
+					id: "root",
+					parentId: null,
+					kind: "user",
+					timestamp: "2026-09-24T00:00:00.000Z",
+					label: "user: root",
+					labelTruncated: false,
+				},
+				{
+					id: "branch-a",
+					parentId: "root",
+					kind: "assistant",
+					timestamp: "2026-09-24T00:01:00.000Z",
+					label: "assistant: first",
+					labelTruncated: false,
+				},
+				{
+					id: "branch-a-child",
+					parentId: "branch-a",
+					kind: "user",
+					timestamp: "2026-09-24T00:02:00.000Z",
+					label: "user: alternate",
+					labelTruncated: false,
+				},
+				{
+					id: "branch-b",
+					parentId: "root",
+					kind: "user",
+					timestamp: "2026-09-24T00:03:00.000Z",
+					label: longLabel.slice(0, 160),
+					labelTruncated: true,
+				},
+			],
+			pathIds: ["root", "branch-b"],
+			truncated: false,
+			lineage: {
+				sessionFile: "fixture/session.jsonl",
+				parentSession: "fixture/parent.jsonl",
+				previousSessionFiles: ["fixture/old.jsonl"],
+			},
+		};
+		const fixture = bridgeFixture({ tree: branched });
+		const result = await fixture.built.control({ operation: "tree.get" });
+		expect(result.ok).toBe(true);
+		if (result.ok) {
+			const answer = result.result as TreeAnswer;
+			expect(answer.nodes.map(node => node.id)).toEqual(["root", "branch-a", "branch-a-child", "branch-b"]);
+			expect(answer.pathIds).toEqual(["root", "branch-b"]);
+			expect(answer.nodes.at(-1)).toMatchObject({ label: longLabel.slice(0, 160), labelTruncated: true });
+			expect(answer.lineage).toEqual(branched.lineage);
+		}
+	});
+
+	it("derives flattened rows, active path and selector labels from OMP's session manager", () => {
+		const longText = "x".repeat(240);
+		const root = {
+			id: "root",
+			parentId: null,
+			timestamp: "2026-09-24T00:00:00.000Z",
+			type: "message",
+			message: { role: "user", content: [{ type: "text", text: "root" }] },
+		};
+		const first = {
+			id: "first",
+			parentId: "root",
+			timestamp: "2026-09-24T00:01:00.000Z",
+			type: "message",
+			message: { role: "assistant", content: [{ type: "text", text: "first" }] },
+		};
+		const alternate = {
+			id: "alternate",
+			parentId: "root",
+			timestamp: "2026-09-24T00:02:00.000Z",
+			type: "message",
+			message: { role: "user", content: [{ type: "text", text: longText }] },
+		};
+		const session = {
+			sessionManager: {
+				getTree: () => [
+					{
+						entry: root,
+						children: [
+							{ entry: first, children: [] },
+							{ entry: alternate, children: [] },
+						],
+					},
+				],
+				getLeafId: () => "alternate",
+				getBranch: () => [root, alternate],
+				getHeader: () => ({
+					type: "session",
+					id: "session-1",
+					timestamp: "2026-09-24T00:00:00.000Z",
+					cwd: "/tmp",
+					parentSession: "parent.jsonl",
+					previousSessionFiles: ["old.jsonl"],
+				}),
+				getSessionFile: () => "session.jsonl",
+			},
+		} as never;
+		const result = readCediaTree(session);
+		expect(result.leafId).toBe("alternate");
+		expect(result.nodes.map(node => node.id)).toEqual(["root", "first", "alternate"]);
+		expect(result.pathIds).toEqual(["root", "alternate"]);
+		expect(result.nodes[2]).toMatchObject({
+			kind: "user",
+			label: `user: ${longText}`.slice(0, 160),
+			labelTruncated: true,
+		});
+		expect(result.lineage).toEqual({
+			sessionFile: "session.jsonl",
+			parentSession: "parent.jsonl",
+			previousSessionFiles: ["old.jsonl"],
+		});
+	});
+
+	it("reduces OMP navigation outcomes and bounds editor text while counting image nouns", async () => {
+		let leafId: string | null = "old";
+		let receivedOptions: unknown;
+		const session = {
+			sessionManager: { getLeafId: () => leafId },
+			navigateTree: async (_entryId: string, options: unknown) => {
+				receivedOptions = options;
+				leafId = "new";
+				return {
+					cancelled: false,
+					aborted: false,
+					summaryEntry: { id: "summary" },
+					editorText: "x".repeat(65_537),
+					editorImages: [{ type: "image", data: "ignored" }],
+				};
+			},
+		} as never;
+		const result = await navigateCediaTree(session, { entryId: "new", summarize: true });
+		expect(receivedOptions).toEqual({ summarize: true });
+		expect(result).toMatchObject({
+			moved: true,
+			summarized: true,
+			editorTextTruncated: true,
+			editorImageCount: 1,
+			leafId: "new",
+		});
+		expect(result.editorText).toHaveLength(65_536);
+	});
+
+	it("counts a user-target editor rewind as moved even when OMP keeps the parent leaf", async () => {
+		let leafId: string | null = "parent";
+		const session = {
+			sessionManager: { getLeafId: () => leafId },
+			navigateTree: async () => {
+				// OMP rewinds past a user target and leaves the leaf on its parent.
+				return { cancelled: false, editorText: "draft" };
+			},
+		} as never;
+		const result = await navigateCediaTree(session, { entryId: "user-child" });
+		expect(result).toMatchObject({ moved: true, editorText: "draft", leafId: "parent" });
+	});
+
+	it("refuses malformed navigation payloads before the handler and never enables ask reopening", async () => {
+		const fixture = bridgeFixture();
+		for (const payload of [
+			{ entryId: "entry-2", extra: true },
+			{ summarize: true },
+			{ entryId: "entry-2", summarize: "yes" },
+			{ entryId: "entry-2", allowAskReopen: true },
+		]) {
+			expect(await fixture.built.control({ operation: "tree.navigate", payload })).toMatchObject({
+				ok: false,
+				code: "cedia_control_invalid_payload",
+			});
+		}
+		expect(fixture.calls).toEqual([]);
+	});
+
+	it("answers a real move and passes only entryId/summarize to the runtime", async () => {
+		const fixture = bridgeFixture({
+			navigate: payload => ({
+				moved: true,
+				cancelled: false,
+				aborted: false,
+				askReopen: false,
+				summarized: payload.summarize === true,
+				editorText: "reopened",
+				editorTextTruncated: false,
+				editorImageCount: 1,
+				leafId: String(payload.entryId),
+			}),
+		});
+		const result = await fixture.built.control({
+			operation: "tree.navigate",
+			payload: { entryId: "entry-2", summarize: true },
+		});
+		expect(result.ok).toBe(true);
+		expect(fixture.calls).toEqual([{ operation: "tree.navigate", payload: { entryId: "entry-2", summarize: true } }]);
+		if (result.ok)
+			expect(result.result).toMatchObject({ moved: true, summarized: true, leafId: "entry-2", editorImageCount: 1 });
+	});
+
+	it("preserves cancelled and reopenAsk answers as non-moves", async () => {
+		const cancelled = bridgeFixture({
+			navigate: () => ({
+				moved: false,
+				cancelled: true,
+				aborted: false,
+				askReopen: false,
+				summarized: false,
+				editorText: null,
+				editorTextTruncated: false,
+				editorImageCount: 0,
+				leafId: "entry-3",
+			}),
+		});
+		const cancelledResult = await cancelled.built.control({
+			operation: "tree.navigate",
+			payload: { entryId: "entry-2" },
+		});
+		expect(cancelledResult.ok).toBe(true);
+		if (cancelledResult.ok)
+			expect(cancelledResult.result).toMatchObject({ moved: false, cancelled: true, askReopen: false });
+
+		const reopen = bridgeFixture({
+			navigate: () => ({
+				moved: false,
+				cancelled: false,
