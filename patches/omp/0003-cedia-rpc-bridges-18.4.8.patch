@@ -0,0 +1,105 @@
+/**
+ * Cedia's usage projection (plan §8.2 O03).
+ *
+ * The fixtures are SDK-free and offline. The point they pin is the difference the plan asks for:
+ * an amount the provider did not report stays absent (a client says "unknown"), a runtime that
+ * cannot report usage says so, and a failed fetch keeps the runtime's own message instead of an
+ * empty table that would read like "no usage".
+ */
+import { describe, expect, it } from "bun:test";
+import type { AgentSession } from "../src/session/agent-session";
+import type { UsageReport } from "@oh-my-pi/pi-ai";
+import { CEDIA_USAGE_MAX_ITEMS, readCediaUsage } from "../src/modes/rpc/cedia-usage-bridge";
+
+function report(overrides: Partial<UsageReport> = {}): UsageReport {
+	return {
+		provider: "openai-codex",
+		fetchedAt: 1_700_000_000_000,
+		limits: [
+			{
+				id: "openai-codex:primary",
+				label: "5 Hour",
+				scope: { provider: "openai-codex", accountId: "acct-1" },
+				window: { id: "5h", label: "5 Hour", resetsAt: 1_700_003_600_000 },
+				amount: { usedFraction: 0.5, unit: "percent" },
+			},
+		],
+		metadata: { accountId: "acct-1", email: "owner@example.com", limitReached: false },
+		...overrides,
+	} as UsageReport;
+}
+
+function session(reports: UsageReport[] | null | (() => Promise<never>)): AgentSession {
+	return {
+		fetchUsageReports: async () => {
+			if (typeof reports === "function") return await reports();
+			return reports;
+		},
+	} as unknown as AgentSession;
+}
+
+describe("Cedia usage projection", () => {
+	it("carries units, windows, reset times and the account they belong to", async () => {
+		const data = await readCediaUsage(session([report()]));
+		expect(data.unavailable).toBeUndefined();
+		expect(data.reports).toHaveLength(1);
+		const first = data.reports[0]!;
+		expect(first.provider).toBe("openai-codex");
+		expect(first.limits[0]).toMatchObject({
+			id: "openai-codex:primary",
+			label: "5 Hour",
+			window: { id: "5h", label: "5 Hour", resetsAt: 1_700_003_600_000 },
+			amount: { unit: "percent", usedFraction: 0.5 },
+		});
+		expect(first.accountId).toBe("acct-1");
+		expect(first.accountEmail).toBe("owner@example.com");
+		expect(first.limitReached).toBe(false);
+	});
+
+	it("keeps an amount the provider did not report absent instead of drawing a zero", async () => {
+		const sparse = report({
+			limits: [{ id: "l", label: "Limit", amount: { unit: "tokens", used: 10 } }] as UsageReport["limits"],
+		});
+		const limit = (await readCediaUsage(session([sparse]))).reports[0]!.limits[0]!;
+		expect(Object.hasOwn(limit.amount, "usedFraction")).toBe(false);
+		expect(Object.hasOwn(limit.amount, "remainingFraction")).toBe(false);
+		expect(limit.amount.used).toBe(10);
+		expect(Object.hasOwn(limit, "window")).toBe(false);
+	});
+
+	it("says a runtime cannot report usage rather than showing an empty table", async () => {
+		const data = await readCediaUsage(session(null));
+		expect(data.reports).toEqual([]);
+		expect(data.supported).toBe(false);
+		expect(String(data.unavailable)).toContain("does not report provider usage");
+	});
+
+	it("keeps the runtime's own message when the fetch fails", async () => {
+		const data = await readCediaUsage(session(async () => {
+			throw new Error("usage endpoint refused the request");
+		}));
+		expect(data.reports).toEqual([]);
+		expect(data.unavailable).toBe("usage endpoint refused the request");
+	});
+
+	it("bounds reports, limits, credit details and notes", async () => {
+		const many = report({
+			limits: Array.from({ length: CEDIA_USAGE_MAX_ITEMS + 5 }, (_, index) => ({
+				id: `l-${index}`,
+				label: `Limit ${index}`,
+				amount: { usedFraction: 0, unit: "percent" },
+			})) as UsageReport["limits"],
+			resetCredits: {
+				availableCount: 3,
+				credits: Array.from({ length: CEDIA_USAGE_MAX_ITEMS + 5 }, () => ({ status: "available" })),
+			},
+			notes: Array.from({ length: CEDIA_USAGE_MAX_ITEMS + 5 }, (_, index) => `note ${index}`),
+		});
+		const data = await readCediaUsage(session([many, many, many]));
+		expect(data.reports.length).toBeLessThanOrEqual(CEDIA_USAGE_MAX_ITEMS);
+		expect(data.reports[0]!.limits.length).toBe(CEDIA_USAGE_MAX_ITEMS);
+		expect(data.reports[0]!.resetCredits?.credits?.length).toBe(CEDIA_USAGE_MAX_ITEMS);
+		expect(data.reports[0]!.notes?.length).toBe(CEDIA_USAGE_MAX_ITEMS);
+		expect(data.reports[0]!.resetCredits?.availableCount).toBe(3);
+	});
+});
