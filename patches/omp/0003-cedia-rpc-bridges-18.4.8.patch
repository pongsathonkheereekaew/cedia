+}
+
+describe("Cedia model and OAuth account state bridge", () => {
+	it("advertises all four O03 operations with their session ownership contract", () => {
+		const { built } = bridge();
+		const rows = new Map(
+			built
+				.table()
+				.capabilities.filter(
