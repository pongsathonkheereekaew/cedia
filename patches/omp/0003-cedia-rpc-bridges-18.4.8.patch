+		await setup({
+			handler: async () => {
+				calls++;
+				if (calls === 1) {
+					firstCall.resolve();
+					await releaseFirstCall.promise;
+				}
+				return { content: ["done"] };
+			},
+		});
+		const events: AgentSessionEvent[] = [];
+		session!.subscribe(event => events.push(event));
+
+		const first = session!.prompt("A", { cediaIntentId: "A" });
+		await firstCall.promise;
+		await session!.followUp("B", undefined, { cediaIntentId: "B" });
+		await session!.followUp("C", undefined, { cediaIntentId: "C" });
+		expect(session!.getCediaTurnQueue().current?.intentId).toBe("A");
+		expect(boundaryShapes(events)).toEqual([]);
+		releaseFirstCall.resolve();
+		await first;
+		await session!.waitForIdle();
+		expect(boundaryShapes(events)).toEqual([
+			{ type: "cedia_turn_boundary", completedIntentIds: ["A"], runningIntentIds: ["B"] },
+			{ type: "cedia_turn_boundary", completedIntentIds: ["B"], runningIntentIds: ["C"] },
