+		});
+		expect(await built.control({ operation: "advisor.history", payload: { raw: true } })).toMatchObject({
+			ok: false,
+			code: "cedia_control_invalid_payload",
+		});
+		expect(await built.control({ operation: "advisor.get", payload: { enabled: true } })).toMatchObject({
+			ok: false,
+			code: "cedia_control_invalid_payload",
+		});
+		expect(calls).toEqual(["advisor.get", "advisor.set:true", "advisor.history:true"]);
+	});
+
+	it("refuses an operation the table does not register, and advertises none it cannot run", async () => {
+		const { built, calls } = bridge();
+		const unknown = await built.control({ operation: "not.a.real.operation" });
+		expect(unknown).toMatchObject({ ok: false, code: "cedia_control_unknown_operation" });
+
+		// This generation has nothing left in the declared seam: the four owner-only writes that
+		// used to sit there are registered and runnable, and the table is not allowed to advertise an
+		// operation without a handler. The seam stays for the next generation's not-yet-runnable
+		// descriptors, and the dispatcher still refuses one by name with its own reason.
+		expect(built.table().capabilities.filter(row => row.state === "integration_missing")).toEqual([]);
+
+		const pending = await built.control({ operation: "model.pending", payload: { revision: 7 } });
+		expect(pending.ok).toBe(true);
+		if (pending.ok) expect(pending.result).toMatchObject({ revision: 7 });
+		expect(calls).toEqual(["model.pending:7"]);
+	});
+
+	it("refuses an empty operation id", async () => {
+		const { built } = bridge();
+		expect(await built.control({ operation: "   " })).toMatchObject({
+			ok: false,
+			code: "cedia_control_unknown_operation",
+		});
+	});
+
+	it("refuses a payload the operation does not take, so a payload can never name code", async () => {
+		const { built, calls } = bridge();
+		const withFields = await built.control({ operation: "model.roles.get", payload: { js: "return 1" } });
+		expect(withFields).toMatchObject({ ok: false, code: "cedia_control_invalid_payload" });
+		if (!withFields.ok) expect(withFields.error).toContain("js");
+
+		const notAnObject = await built.control({
+			operation: "model.roles.get",
+			payload: ["x"] as unknown as Record<string, unknown>,
+		});
+		expect(notAnObject).toMatchObject({ ok: false, code: "cedia_control_invalid_payload" });
+
+		// An empty object is the same as no payload: the operation still ran.
+		expect((await built.control({ operation: "model.roles.get", payload: {} })).ok).toBe(true);
+		expect(calls).toEqual(["model.roles.get"]);
+	});
+
+	it("refuses a stale capability revision instead of running an operation the caller did not see", async () => {
+		const { built } = bridge();
+		const stale = await built.control({ operation: "turn.queue.get", capabilityRevision: "00000000deadbeef" });
