+++ b/packages/coding-agent/test/cedia-agents-config-bridge.test.ts
@@ -0,0 +1,73 @@
+import { describe, expect, it } from "bun:test";
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { listCediaAgentConfigs, setCediaAgentConfig, type CediaAgentConfigDeps } from "../src/modes/rpc/cedia-agents-config-bridge";
+
+function fakeDeps(): CediaAgentConfigDeps & { store: Map<string, unknown> } {
+	const store = new Map<string, unknown>([
+		["task.disabledAgents", [] as string[]],
+		["task.agentModelOverrides", {}],
+		["task.agentPrewalk", {}],
+		["task.agentAdvisor", {}],
+	]);
+	return {
+		store,
+		cwd: mkdtempSync(join(tmpdir(), "cedia-agent-config-")),
+		settings: {
+			get: ((path: string) => store.get(path)) as CediaAgentConfigDeps["settings"]["get"],
+			set: ((path: string, value: unknown) => {
+				store.set(path, value);
+			}) as CediaAgentConfigDeps["settings"]["set"],
+			async flush() {},
+		},
+	};
+}
+
+describe("setCediaAgentConfig", () => {
+	it("refuses an agent the discovery never had by name", async () => {
+		const deps = fakeDeps();
+		await expect(setCediaAgentConfig({ agent: "no-such-agent", enabled: false }, deps)).rejects.toThrow(
+			"Unknown agent: no-such-agent",
+		);
+	});
+
+	it("disables and re-enables with the hub's sorted-array semantics", async () => {
+		const deps = fakeDeps();
+		const off = await setCediaAgentConfig({ agent: "task", enabled: false }, deps);
+		expect(off).toEqual({ agent: "task", enabled: false });
+		expect(deps.store.get("task.disabledAgents")).toEqual(["task"]);
+		const on = await setCediaAgentConfig({ agent: "task", enabled: true }, deps);
+		expect(on).toEqual({ agent: "task", enabled: true });
+		expect(deps.store.get("task.disabledAgents")).toEqual([]);
+	});
+
+	it("sets and clears overrides with whole-map persist, omitting empties", async () => {
+		const deps = fakeDeps();
+		const set = await setCediaAgentConfig({ agent: "task", model: "fixture/model", prewalk: "on" }, deps);
+		expect(set).toEqual({ agent: "task", enabled: true, model: "fixture/model", prewalk: "on" });
+		expect(deps.store.get("task.agentModelOverrides")).toEqual({ task: "fixture/model" });
+		const cleared = await setCediaAgentConfig({ agent: "task", model: "  " }, deps);
+		expect(cleared.model).toBeUndefined();
+		expect(deps.store.get("task.agentModelOverrides")).toEqual({});
+		// The untouched map is preserved, not reset.
+		expect(deps.store.get("task.agentPrewalk")).toEqual({ task: "on" });
+	});
+});
+
+describe("listCediaAgentConfigs", () => {
+	it("lists discovered agents with effective config, omitting empties", async () => {
+		const deps = fakeDeps();
+		const empty = await listCediaAgentConfigs(deps);
+		const task = empty.agents.find(agent => agent.name === "task");
+		expect(task).toMatchObject({ name: "task", enabled: true });
+		expect(task!.model).toBeUndefined();
+		await setCediaAgentConfig({ agent: "task", enabled: false, model: "fixture/model" }, deps);
+		const after = await listCediaAgentConfigs(deps);
+		expect(after.agents.find(agent => agent.name === "task")).toMatchObject({
+			name: "task",
+			enabled: false,
+			model: "fixture/model",
+		});
+	});
+});
diff --git a/packages/coding-agent/test/cedia-agents-lifecycle-bridge.test.ts b/packages/coding-agent/test/cedia-agents-lifecycle-bridge.test.ts
new file mode 100644
index 0000000000..afa21e8057
--- /dev/null
+++ b/packages/coding-agent/test/cedia-agents-lifecycle-bridge.test.ts
@@ -0,0 +1,172 @@
+/**
+ * Cedia's agent-lifecycle controls (plan §8.2 O07).
+ *
+ * Fixtures drive the hub's abort-and-release and revive-parked paths directly
+ * through a real registry plus a recording lifecycle: refusals use the hub's own
+ * sentences, kill aborts only an attached running session before releasing with
+ * a tombstone, and revive restores only parked rows. No runtime, model or
+ * provider is involved.
+ */
+import { describe, expect, it } from "bun:test";
+import { AgentRegistry, type AgentRef } from "../src/registry/agent-registry";
+import type { AgentSession } from "../src/session/agent-session";
+import { USER_INTERRUPT_LABEL } from "../src/session/messages";
+import { killCediaAgent, reviveCediaAgent } from "../src/modes/rpc/cedia-agents-lifecycle-bridge";
+
+function ref(overrides: Partial<AgentRef> & { id: string }): AgentRef {
+	return {
+		displayName: overrides.id,
+		kind: "sub",
+		status: "idle",
+		session: null,
+		sessionFile: null,
+		createdAt: 1,
+		lastActivity: 2,
+		...overrides,
+	} as AgentRef;
+}
+
+function stubSession(calls: Array<Record<string, unknown>>) {
+	return {
+		abort: async (options?: Record<string, unknown>) => {
+			calls.push(options ?? {});
+		},
+	} as unknown as AgentSession;
+}
+
+function lifecycleStub(studio: {
+	ensureLiveCalls: string[];
+	releaseCalls: Array<{ id: string; tombstone: boolean }>;
+	ensureLive?: (id: string) => Promise<AgentSession>;
+	release?: (id: string) => Promise<boolean>;
+}) {
+	return {
+		ensureLive: async (id: string) => {
+			studio.ensureLiveCalls.push(id);
+			if (studio.ensureLive) return studio.ensureLive(id);
+			return {} as AgentSession;
+		},
+		release: async (id: string, _expected?: unknown, options?: { tombstone?: boolean }) => {
+			studio.releaseCalls.push({ id, tombstone: options?.tombstone === true });
+			if (studio.release) return studio.release(id);
+			return true;
+		},
+	};
+}
+
+function registryWith(rows: AgentRef[]): AgentRegistry {
+	const registry = new AgentRegistry();
+	for (const row of rows) {
+		registry.register({
+			id: row.id,
+			displayName: row.displayName,
+			kind: row.kind,
+			...(row.parentId === undefined ? {} : { parentId: row.parentId }),
+			session: row.session,
+			...(row.sessionFile === null ? {} : { sessionFile: row.sessionFile ?? undefined }),
+			status: row.status,
+			createdAt: row.createdAt,
+			lastActivity: row.lastActivity,
+		});
+	}
+	return registry;
+}
+
+describe("Cedia agent kill", () => {
+	it("refuses an unknown id without touching the lifecycle", async () => {
+		const studio = { ensureLiveCalls: [] as string[], releaseCalls: [] as Array<{ id: string; tombstone: boolean }> };
+		const registry = registryWith([]);
+		await expect(killCediaAgent("ghost", { registry, lifecycle: lifecycleStub(studio) })).rejects.toThrow("Unknown agent: ghost");
+		expect(studio.releaseCalls).toEqual([]);
+	});
+
+	it("refuses an advisor transcript without touching it", async () => {
+		const studio = { ensureLiveCalls: [] as string[], releaseCalls: [] as Array<{ id: string; tombstone: boolean }> };
+		const registry = registryWith([ref({ id: "adv-1", kind: "advisor", status: "idle" })]);
+		await expect(killCediaAgent("adv-1", { registry, lifecycle: lifecycleStub(studio) })).rejects.toThrow("cannot be killed");
+		expect(studio.releaseCalls).toEqual([]);
+	});
+
+	it("aborts an attached running turn, then releases with a tombstone", async () => {
+		const aborts: Array<Record<string, unknown>> = [];
+		const studio = { ensureLiveCalls: [] as string[], releaseCalls: [] as Array<{ id: string; tombstone: boolean }> };
+		const registry = registryWith([ref({ id: "run-1", status: "running", session: stubSession(aborts) })]);
+		const result = await killCediaAgent("run-1", { registry, lifecycle: lifecycleStub(studio) });
+		expect(aborts).toEqual([{ reason: USER_INTERRUPT_LABEL }]);
+		expect(studio.releaseCalls).toEqual([{ id: "run-1", tombstone: true }]);
+		expect(result).toEqual({ id: "run-1", aborted: true, released: true });
+	});
+
+	it("releases without aborting when no live session is attached", async () => {
+		const aborts: Array<Record<string, unknown>> = [];
+		const studio = { ensureLiveCalls: [] as string[], releaseCalls: [] as Array<{ id: string; tombstone: boolean }> };
+		const registry = registryWith([ref({ id: "idle-1", status: "idle", session: stubSession(aborts) })]);
+		const result = await killCediaAgent("idle-1", { registry, lifecycle: lifecycleStub(studio) });
+		expect(aborts).toEqual([]);
+		expect(studio.releaseCalls).toEqual([{ id: "idle-1", tombstone: true }]);
+		expect(result).toEqual({ id: "idle-1", aborted: false, released: true });
+	});
+
+	it("reports a release the lifecycle refused", async () => {
+		const studio = {
+			ensureLiveCalls: [] as string[],
+			releaseCalls: [] as Array<{ id: string; tombstone: boolean }>,
+			release: async () => false,
+		};
+		const registry = registryWith([ref({ id: "gone-1", status: "aborted" })]);
+		const result = await killCediaAgent("gone-1", { registry, lifecycle: lifecycleStub(studio) });
+		expect(result).toEqual({ id: "gone-1", aborted: false, released: false });
+	});
+
+	it("lets an abort failure propagate without releasing", async () => {
+		const studio = { ensureLiveCalls: [] as string[], releaseCalls: [] as Array<{ id: string; tombstone: boolean }> };
+		const registry = registryWith([
+			ref({
+				id: "boom-1",
+				status: "running",
+				session: {
+					abort: async () => {
+						throw new Error("abort exploded");
+					},
+				} as unknown as AgentSession,
+			}),
+		]);
+		await expect(killCediaAgent("boom-1", { registry, lifecycle: lifecycleStub(studio) })).rejects.toThrow("abort exploded");
+		expect(studio.releaseCalls).toEqual([]);
+	});
+});
+
+describe("Cedia agent revive", () => {
+	it("refuses unknown, advisor and non-parked rows without restoring", async () => {
+		const studio = { ensureLiveCalls: [] as string[], releaseCalls: [] as Array<{ id: string; tombstone: boolean }> };
+		const registry = registryWith([
+			ref({ id: "run-1", status: "running" }),
+			ref({ id: "adv-1", kind: "advisor", status: "idle" }),
+		]);
+		const lifecycle = lifecycleStub(studio);
+		await expect(reviveCediaAgent("ghost", { registry, lifecycle })).rejects.toThrow("Unknown agent: ghost");
+		await expect(reviveCediaAgent("adv-1", { registry, lifecycle })).rejects.toThrow("nothing to revive");
+		await expect(reviveCediaAgent("run-1", { registry, lifecycle })).rejects.toThrow('Agent "run-1" is running — only parked agents can be revived.');
+		expect(studio.ensureLiveCalls).toEqual([]);
+	});
+
+	it("restores a parked row through the lifecycle", async () => {
+		const studio = { ensureLiveCalls: [] as string[], releaseCalls: [] as Array<{ id: string; tombstone: boolean }> };
+		const registry = registryWith([ref({ id: "parked-1", status: "parked" })]);
+		const result = await reviveCediaAgent("parked-1", { registry, lifecycle: lifecycleStub(studio) });
+		expect(studio.ensureLiveCalls).toEqual(["parked-1"]);
+		expect(result).toEqual({ id: "parked-1", revived: true });
+	});
+
+	it("lets a restore failure propagate", async () => {
+		const studio = {
+			ensureLiveCalls: [] as string[],
+			releaseCalls: [] as Array<{ id: string; tombstone: boolean }>,
+			ensureLive: async () => {
+				throw new Error("revive exploded");
+			},
+		};
+		const registry = registryWith([ref({ id: "parked-1", status: "parked" })]);
+		await expect(reviveCediaAgent("parked-1", { registry, lifecycle: lifecycleStub(studio) })).rejects.toThrow("revive exploded");
+	});
+});
diff --git a/packages/coding-agent/test/cedia-ast-editor.test.ts b/packages/coding-agent/test/cedia-ast-editor.test.ts
new file mode 100644
index 0000000000..7a8416ba41
--- /dev/null
+++ b/packages/coding-agent/test/cedia-ast-editor.test.ts
@@ -0,0 +1,270 @@
+import { readFileSync, writeFileSync, realpathSync } from "node:fs";
+import { afterEach, beforeEach, expect, test } from "bun:test";
+import { mkdtemp, realpath, rm, writeFile, readFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { createHash } from "node:crypto";
+import { Settings } from "../src/config/settings";
+import { AstEditTool } from "../src/tools/ast-edit";
+import { ToolChoiceQueue } from "../src/session/tool-choice-queue";
+import type { ClientBridge, ClientBridgeEditorDocumentSnapshot } from "../src/session/client-bridge";
+import type { ToolSession } from "../src/tools";
+import { getNativeEditorObservation } from "../src/tools/native-editor-observations";
+let dir: string;
+beforeEach(async () => {
+	dir = await realpath(await mkdtemp(join(tmpdir(), "cedia-ast-")));
+});
+afterEach(async () => {
+	await rm(dir, { recursive: true, force: true });
+});
+const doc = (path: string, text: string, version = 1): ClientBridgeEditorDocumentSnapshot => ({
+	path,
+	text,
+	documentVersion: version,
+	sha256: createHash("sha256").update(text).digest("hex"),
+	handle: { id: path, uri: `file://${path}` },
+	dirty: true,
+});
+function fixture(initial: ClientBridgeEditorDocumentSnapshot[]) {
+	const documents = new Map(initial.map(document => [document.path, document]));
+	const snapshots: string[] = [],
+		applied: string[] = [];
+	let disconnected = false;
+	let failApplyPath: string | undefined;
+	let raceDiskPath: string | undefined;
+	const bridge: ClientBridge = {
+		capabilities: { nativeEditor: true },
+		nativeEditor: {
+			applyDisk: async params => {
+				if (params.path === raceDiskPath) writeFileSync(params.path, "manualAfterPreflight();\n");
+				if (
+					realpathSync(params.path) !== params.expectedCanonicalPath ||
+					readFileSync(params.path, "utf8") !== params.expectedText
+				)
+					throw new Error("host rejected changed disk at write boundary");
+				writeFileSync(params.path, params.content);
+				return { text: params.content, saved: true, canonicalPath: params.expectedCanonicalPath };
+			},
+			snapshot: async ({ path }) => {
+				if (disconnected) throw new Error("editor disconnected");
+				snapshots.push(path);
+				return { document: documents.get(path) ?? null };
+			},
+			apply: async request => {
+				if (request.path === failApplyPath) throw new Error("transport closed after delivery");
+				const current = documents.get(request.path)!;
+				expect(request.expectedVersion).toBe(current.documentVersion);
+				expect(request.expectedHash).toBe(current.sha256);
+				applied.push(request.path);
+				const next = doc(request.path, request.content, current.documentVersion + 1);
+				documents.set(request.path, next);
+				return { text: next.text, document: next, saved: false, undoPreserved: true };
+			},
+		},
+	};
+	const queue = new ToolChoiceQueue();
+	const session: ToolSession = {
+		cwd: dir,
+		hasUI: true,
+		getSessionFile: () => null,
+		getSessionSpawns: () => "*",
+		enableLsp: false,
+		settings: Settings.isolated({ "tools.xdev": false }),
+		getClientBridge: () => bridge,
+		getToolChoiceQueue: () => queue,
+		buildToolChoice: () => ({ type: "tool" as const, name: "resolve" }),
+		steer: () => {},
+	};
+	const tool = new AstEditTool(session);
+	return {
+		documents,
+		snapshots,
+		applied,
+		session,
+		failApply(path: string) {
+			failApplyPath = path;
+		},
+		raceDisk(path: string) {
+			raceDiskPath = path;
+		},
+		disableDisk() {
+			bridge.nativeEditor!.applyDisk = undefined;
+		},
+		disconnect() {
+			disconnected = true;
+		},
+		preview: (paths = ["*.ts"]) =>
+			tool.execute("preview", { paths, ops: [{ pat: "oldCall($$$ARGS)", out: "newCall($$$ARGS)" }] }),
+		apply: () => queue.peekPendingInvoker()!({ action: "apply", reason: "fixture acceptance" }),
+	};
+}
+const text = (result: unknown) => JSON.stringify(result);
+
+test("AST glob discovers dirty-only matches and uses guarded apply without saving", async () => {
+	const a = join(dir, "a.ts"),
+		b = join(dir, "b.ts");
+	await writeFile(a, "diskOnly();\n");
+	await writeFile(b, "untouched();\n");
+	const f = fixture([doc(a, "oldCall('dirty');\n"), doc(b, "untouched();\n")]);
+	expect(text(await f.preview())).toContain("oldCall");
+	expect(f.snapshots).toContain(a);
+	expect(f.snapshots).toContain(b);
+	expect(getNativeEditorObservation(f.session, a)).toBeUndefined();
+	expect(text(await f.apply())).toContain("Applied 1 replacement");
+	expect(f.applied).toEqual([a]);
+	expect(f.documents.get(a)!.text).toBe("newCall('dirty');\n");
+	expect(await readFile(a, "utf8")).toBe("diskOnly();\n");
+	expect(getNativeEditorObservation(f.session, a)?.documentVersion).toBe(2);
+});
+
+test("later stale file with same replacement count prevents all AST writes", async () => {
+	const a = join(dir, "a.ts"),
+		b = join(dir, "b.ts");
+	for (const path of [a, b]) await writeFile(path, "oldCall('disk');\n");
+	const f = fixture([doc(a, "oldCall('a');\n"), doc(b, "oldCall('b');\n")]);
+	await f.preview();
+	f.documents.set(b, doc(b, "oldCall('manual');\n", 2));
+	await expect(f.apply()).rejects.toThrow("stale");
+	expect(f.applied).toHaveLength(0);
+	expect(f.documents.get(a)!.text).toBe("oldCall('a');\n");
+	expect(await readFile(b, "utf8")).toBe("oldCall('disk');\n");
+});
+
+test("disconnected editor never falls back to disk AST writes", async () => {
+	const a = join(dir, "a.ts");
+	await writeFile(a, "oldCall('disk');\n");
+	const f = fixture([doc(a, "oldCall('dirty');\n")]);
+	await f.preview();
+	f.disconnect();
+	await expect(f.apply()).rejects.toThrow("disconnected");
+	expect(f.applied).toHaveLength(0);
+	expect(await readFile(a, "utf8")).toBe("oldCall('disk');\n");
+});
+
+test("headless AST plan rejects changed disk before any write", async () => {
+	const a = join(dir, "a.ts"),
+		b = join(dir, "b.ts");
+	for (const path of [a, b]) await writeFile(path, "oldCall('disk');\n");
+	const f = fixture([]);
+	await f.preview();
+	await writeFile(b, "oldCall('manual');\n");
+	await expect(f.apply()).rejects.toThrow("stale");
+	expect(await readFile(a, "utf8")).toBe("oldCall('disk');\n");
+	expect(await readFile(b, "utf8")).toBe("oldCall('manual');\n");
+});
+
+test("unchanged headless AST plan applies previewed output", async () => {
+	const a = join(dir, "a.ts");
+	await writeFile(a, "oldCall('disk');\n");
+	const f = fixture([]);
+	await f.preview([a]);
+	expect(text(await f.apply())).toContain("Applied 1 replacement");
+	expect(await readFile(a, "utf8")).toBe("newCall('disk');\n");
+});
+
+test("concurrent resolves cannot apply the same AST plan twice", async () => {
+	const a = join(dir, "a.ts");
+	await writeFile(a, "oldCall('disk');\n");
+	const f = fixture([doc(a, "oldCall('dirty');\n")]);
+	await f.preview();
+	const outcomes = await Promise.allSettled([f.apply(), f.apply()]);
+	expect(outcomes.filter(result => result.status === "fulfilled")).toHaveLength(1);
+	expect(outcomes.filter(result => result.status === "rejected")).toHaveLength(1);
+	expect(f.applied).toEqual([a]);
+});
+
+test("partial AST failure is explicit and its plan cannot be replayed", async () => {
+	const a = join(dir, "a.ts"),
+		b = join(dir, "b.ts");
+	for (const path of [a, b]) await writeFile(path, "oldCall('disk');\n");
+	const f = fixture([doc(a, "oldCall('a');\n"), doc(b, "oldCall('b');\n")]);
+	await f.preview();
+	f.failApply(b);
+	await expect(f.apply()).rejects.toThrow("may have partially changed");
+	await expect(f.apply()).rejects.toThrow("already attempted");
+	expect(f.applied).toEqual([a]);
+	expect(f.documents.get(a)!.text).toBe("newCall('a');\n");
+	expect(f.documents.get(b)!.text).toBe("oldCall('b');\n");
+});
+
+test("host boundary rejects disk mutation after the final async preflight", async () => {
+	const a = join(dir, "a.ts");
+	await writeFile(a, "oldCall('disk');\n");
+	const f = fixture([]);
+	await f.preview();
+	f.raceDisk(a);
+	await expect(f.apply()).rejects.toThrow("host rejected changed disk");
+	expect(await readFile(a, "utf8")).toBe("manualAfterPreflight();\n");
+});
+
+test("missing guarded disk capability never falls back to local writing", async () => {
+	const a = join(dir, "a.ts");
+	await writeFile(a, "oldCall('disk');\n");
+	const f = fixture([]);
+	await f.preview();
+	f.disableDisk();
+	await expect(f.apply()).rejects.toThrow("Guarded headless AST apply is unavailable");
+	expect(await readFile(a, "utf8")).toBe("oldCall('disk');\n");
+});
+
+test("multiple native scopes enforce capture capacity before editor snapshots", async () => {
+	const a = join(dir, "a.ts"),
+		b = join(dir, "b.ts");
+	const source = `/*${"x".repeat(9 * 1024 * 1024)}*/\noldCall();\n`;
+	await writeFile(a, source);
+	await writeFile(b, source);
+	const f = fixture([]);
+	await expect(f.preview([a, b])).rejects.toThrow("aggregate capture capacity");
+	expect(f.snapshots).toHaveLength(0);
+	expect((await readFile(a)).length).toBe(Buffer.byteLength(source));
+}, 15_000);
+
+test("AST bridge uses canonical paths while retaining alias retarget guards", async () => {
+	const { symlink, unlink } = await import("node:fs/promises");
+	const { prepareAstEditorPlan } = await import("../src/tools/ast-editor-plan");
+	const a = join(dir, "a.ts"),
+		b = join(dir, "b.ts"),
+		alias = join(dir, "alias.ts");
+	await writeFile(a, "oldCall();\n");
+	await writeFile(b, "other();\n");
+	await symlink(a, alias);
+	const f = fixture([doc(a, "oldCall();\n")]);
+	const run = async () => ({
+		applied: false,
+		sources: [{ path: "alias.ts", before: "oldCall();\n", after: "newCall();\n" }],
+	});
+	const plan = await prepareAstEditorPlan(f.session, run, () => alias);
+	expect(f.snapshots).toEqual([a]);
+	await unlink(alias);
+	await symlink(b, alias);
+	await expect(plan.apply()).rejects.toThrow("changed its target");
+	expect(f.applied).toHaveLength(0);
+	expect(await readFile(a, "utf8")).toBe("oldCall();\n");
+});
+
+test("AST preserves lexical disk identity through the final asynchronous preflight", async () => {
+	const { symlink, unlink } = await import("node:fs/promises");
+	const { prepareAstEditorPlan } = await import("../src/tools/ast-editor-plan");
+	const a = join(dir, "a.ts"),
+		b = join(dir, "b.ts"),
+		alias = join(dir, "alias.ts");
+	for (const path of [a, b]) await writeFile(path, "oldCall();\n");
+	await symlink(a, alias);
+	const f = fixture([]);
+	const bridge = f.session.getClientBridge!()!;
+	let snapshots = 0;
+	bridge.nativeEditor!.snapshot = async () => {
+		if (++snapshots === 3) {
+			await unlink(alias);
+			await symlink(b, alias);
+		}
+		return { document: null };
+	};
+	const plan = await prepareAstEditorPlan(
+		f.session,
+		async () => ({ applied: false, sources: [{ path: "alias.ts", before: "oldCall();\n", after: "newCall();\n" }] }),
+		() => alias,
+	);
+	await expect(plan.apply()).rejects.toThrow("host rejected changed disk");
