+import { afterEach, describe, expect, it } from "bun:test";
+import { canUseInteractiveBashPty } from "../src/tools/bash-pty-selection";
+
+describe("Cedia bash PTY selection", () => {
+	const previous = process.env.PI_NO_PTY;
+
+	afterEach(() => {
+		if (previous === undefined) delete process.env.PI_NO_PTY;
+		else process.env.PI_NO_PTY = previous;
+	});
+
+	it("uses the local overlay when rpc-ui has UI context and PI_NO_PTY is unset", () => {
+		delete process.env.PI_NO_PTY;
+		expect(canUseInteractiveBashPty(true, { hasUI: true, ui: {} })).toBe(true);
+	});
+
+	it("stays closed when PI_NO_PTY=1 even if a UI context exists", () => {
+		process.env.PI_NO_PTY = "1";
