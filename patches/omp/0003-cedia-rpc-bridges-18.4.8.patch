+					ok: false,
+					code: "cedia_control_unknown_operation",
+					error: "A capability operation id is required",
+				};
+			const operation = runnable.find(candidate => candidate.id === operationId);
+			if (!operation) {
+				const declaredEntry = table.find(candidate => candidate.id === operationId);
+				return {
+					ok: false,
+					code: "cedia_control_unknown_operation",
+					error: declaredEntry
