+					code: "cedia_control_invalid_payload",
+					error: "A capability payload must be an object",
+				};
+			const invalid = operation.validate(payload as Record<string, unknown> | undefined);
+			if (invalid) return { ok: false, code: "cedia_control_invalid_payload", error: invalid };
+			// A settings write is the one operation whose effect depends on what the runtime holds
+			// right now, so a caller that named the settings revision it read is refused when that
+			// revision moved - including a change made through OMP's own `config` CLI.
+			// Unset and global-scope mutations share the same global revision; a project-scope
+			// mutation is checked inside the service against its own project revision.
+			const globalWrite =
+				operation.id === "settings.set" ||
+				operation.id === "settings.unset" ||
+				(operation.id === "settings.mutate" &&
+					isRecord((payload as Record<string, unknown>).context) &&
+					((payload as Record<string, unknown>).context as Record<string, unknown>).scope === "global");
+			if (globalWrite) {
+				const expected = (payload as Record<string, unknown>).expectedRevision;
+				if (typeof expected === "string") {
+					const current = options.handlers["settings.revision"]();
+					if (expected !== current)
