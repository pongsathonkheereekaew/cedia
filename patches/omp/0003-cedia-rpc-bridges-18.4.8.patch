+/**
+ * Cedia's product policy layer over OMP's own settings (plan §2.8 "Product invariants versus
+ * shared terminal configuration").
+ *
+ * OMP ships a setting that can spend a saved Codex reset on its own: with
+ * `codexResets.autoRedeem = "yes"` a usage fetch can trigger a background redemption, and with
+ * `"unset"` an interactive terminal is asked once and the answer is persisted. Cedia's product rule
+ * is narrower than that: an application the owner did not explicitly tell to spend must never spend
+ * a credit, so a Cedia-controlled runtime refuses both the automatic and the prompted paths.
+ *
+ * The rule is applied as an *effective* value, never as a write. The owner's shared configuration
+ * (and any terminal session using the same files) keeps the value it had: this module answers what
+ * CEDIA's session acts on, plus the reason, so a surface can show stored vs effective instead of
+ * silently rewriting a preference someone else owns. That is also what makes an external live owner
+ * inspect-only: a runtime started by someone else does not carry Cedia's flag, so Cedia must not
+ * claim it as Cedia-controlled.
+ */
+import { cfgCodexResetsAutoRedeem } from "./settings";
+import type { SettingValueOf } from "../config/registry";
+
+/** The auto-redeem mode a Cedia session acts on; `unset` keeps OMP's first-use prompt. */
+export type CodexAutoRedeemMode = SettingValueOf<typeof cfgCodexResetsAutoRedeem>;
+/**
+ * The flag the Cedia host sets on every runtime it starts.
+ *
+ * Absent means "not a Cedia-controlled process": stock OMP behaviour stays selected, which is what
+ * keeps a developer's own `omp` run untouched by this layer.
+ */
+export const CEDIA_CREDIT_GUARD_ENV = "CEDIA_POLICY_CREDIT_GUARD";
+
+/** What this process's policy layer does, and why. */
+export interface CediaCreditPolicy {
+	/** True when Cedia owns this process and the guard therefore applies. */
+	readonly guardActive: boolean;
+	readonly reason: string;
+}
+
+/** Read the policy layer this process runs under. Read once per session so it cannot flip mid-turn. */
+export function readCediaCreditPolicy(env: NodeJS.ProcessEnv = process.env): CediaCreditPolicy {
+	if (env[CEDIA_CREDIT_GUARD_ENV] === "1") {
+		return {
+			guardActive: true,
+			reason:
+				"Cedia never spends a saved reset on its own: automatic redemption and the first-use prompt are both off for this session, and the stored setting is left untouched.",
+		};
+	}
+	return {
+		guardActive: false,
+		reason: "No Cedia credit guard is set for this process, so OMP's own codexResets behaviour applies.",
+	};
+}
+
+/** The auto-redeem mode a Cedia session acts on, which is what the planner and the prompt path use. */
+export function effectiveCodexAutoRedeem(
+	stored: CodexAutoRedeemMode,
+	policy: CediaCreditPolicy,
+): { mode: CodexAutoRedeemMode; overridden: boolean } {
+	// `"no"` is already the guarded answer, so an owner who turned it off keeps seeing their own
+	// value named as the stored one rather than as Cedia's override.
+	if (!policy.guardActive || stored === "no") return { mode: stored, overridden: false };
+	return { mode: "no", overridden: true };
+}
+
+/** The policy as a client may read it: what is stored, what this session acts on, and why they differ. */
+export function cediaCreditPolicySnapshot(
+	stored: CodexAutoRedeemMode,
+	policy: CediaCreditPolicy,
+): {
+	guardActive: boolean;
+	stored: CodexAutoRedeemMode;
+	effective: CodexAutoRedeemMode;
+	overridden: boolean;
+	reason: string;
+} {
+	const effective = effectiveCodexAutoRedeem(stored, policy);
+	return {
+		guardActive: policy.guardActive,
+		stored,
+		effective: effective.mode,
+		overridden: effective.overridden,
+		reason: policy.reason,
+	};
+}
