+		}
+		return undefined;
+	}
+
+	signal?.throwIfAborted();
+	const created = await bridge.nativeEditor.create({ path: absolutePath, content }, signal);
+	const expectedHash = createHash("sha256").update(content).digest("hex");
+	const post = created.document;
+	if (
+		created.saved !== false ||
+		created.undoPreserved !== true ||
+		created.text !== content ||
+		post.text !== content ||
+		post.sha256.toLowerCase() !== expectedHash ||
+		canonicalNativeEditorPath(post.path) !== canonicalNativeEditorPath(absolutePath)
+	) {
+		throw new Error("Native editor create outcome is unknown; inspect the buffer before retrying");
+	}
+	recordNativeEditorObservation(session, absolutePath, post);
+	if (session.enableLsp ?? true) {
+		await notifyWorkspaceWatchedFiles(
+			session.cwd,
+			[{ filePath: absolutePath, type: FileChangeType.Created }],
+			signal,
+		);
+	}
+	invalidateFsScanAfterWrite(absolutePath);
+	session.bumpFileMutationVersion?.(absolutePath);
+	return created;
+}
+
+/** Apply an exact preview/read base; never refresh it into an unconditional write. */
+export async function applyNativeEditorSnapshot(
+	session: ToolSession,
+	absolutePath: string,
+	requestedPath: string,
+	base: ClientBridgeEditorDocumentSnapshot,
+	content: string,
+	signal?: AbortSignal,
+): Promise<ClientBridgeEditorApplyResponse> {
+	const bridge = session.getClientBridge?.();
+	if (!bridge?.capabilities.nativeEditor || !bridge.nativeEditor) throw new Error("Native editor disconnected");
+	signal?.throwIfAborted();
+	await assertEditableFile(absolutePath, requestedPath, session.settings);
+	const applied = await bridge.nativeEditor.apply(
+		{
+			path: absolutePath,
+			handle: base.handle,
+			expectedVersion: base.documentVersion,
+			expectedHash: base.sha256,
+			content,
+		},
+		signal,
+	);
+	const expectedHash = createHash("sha256").update(content).digest("hex");
+	const post = applied.document;
+	if (
+		applied.saved !== false ||
+		applied.undoPreserved !== true ||
+		applied.text !== content ||
+		post.text !== content ||
+		post.sha256.toLowerCase() !== expectedHash ||
+		post.handle.id !== base.handle.id ||
+		post.handle.uri !== base.handle.uri ||
+		post.documentVersion < base.documentVersion ||
+		canonicalNativeEditorPath(post.path) !== canonicalNativeEditorPath(absolutePath)
+	) {
+		throw new Error("Native editor apply outcome is unknown; inspect the buffer before retrying");
+	}
+	// Store only an exact, confirmed post-apply snapshot. If apply throws or the
+	// host returns an unverifiable outcome, the prior observation remains intact
+	// and the next write is still guarded by that revision.
+	recordNativeEditorObservation(session, absolutePath, post);
+	if (session.enableLsp ?? true) {
+		await notifyWorkspaceWatchedFiles(
+			session.cwd,
+			[{ filePath: absolutePath, type: FileChangeType.Changed }],
+			signal,
+		);
+	}
+	invalidateFsScanAfterWrite(absolutePath);
+	session.bumpFileMutationVersion?.(absolutePath);
+	return applied;
+}
