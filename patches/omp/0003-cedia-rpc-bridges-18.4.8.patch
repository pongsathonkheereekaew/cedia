+				type: "cedia_terminal_negotiate",
+				id: "virtual-ui-negotiate",
+				version: 1,
+				cols: 100,
+				rows: 30,
+			});
+
+			expect(negotiation).toMatchObject({
+				type: "response",
+				id: "virtual-ui-negotiate",
+				success: true,
+				command: "cedia_terminal_negotiate",
+			});
+			const terminalId = (negotiation.data as { terminalId?: unknown } | undefined)?.terminalId;
+			expect(typeof terminalId).toBe("string");
+			expect(probe.frames).toContainEqual(expect.objectContaining({ type: "cedia_terminal_open", terminalId }));
+			expect(
+				probe.frames.some(frame => frame.type === "cedia_terminal_output" && frame.terminalId === terminalId),
+			).toBe(true);
+			expect(probe.providerRequests()).toBe(0);
+
+			const input = await probe.request({
+				type: "cedia_terminal_input",
+				id: "virtual-ui-input",
+				terminalId,
+				data: "x",
+			});
+			expect(input).toMatchObject({
+				type: "response",
+				id: "virtual-ui-input",
+				success: true,
+				command: "cedia_terminal_input",
+			});
+		} finally {
+			await probe.stop();
+		}
+	});
+});
